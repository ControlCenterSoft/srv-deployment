#!/usr/bin/env bash
set -Eeuo pipefail

BASE=/usr/local/lib/control-center/control-center-os-update-base-1.0.8
POLICY=/usr/sbin/policy-rc.d
POLICY_BACKUP="/run/control-center-policy-rc.d.os-update.$$"
POLICY_HAD=0
POLICY_ACTIVE=0
APT_LOCK=/run/control-center-apt.lock

[[ -x "$BASE" ]] || { echo "OS updater base is missing: $BASE" >&2; exit 1; }

restore_policy(){
  [[ "$POLICY_ACTIVE" == 1 ]] || return 0
  rm -f "$POLICY"
  if [[ "$POLICY_HAD" == 1 && ( -e "$POLICY_BACKUP" || -L "$POLICY_BACKUP" ) ]]; then
    cp -a "$POLICY_BACKUP" "$POLICY"
  fi
  rm -f "$POLICY_BACKUP"
  POLICY_ACTIVE=0
}
trap restore_policy EXIT

if [[ -e "$POLICY" || -L "$POLICY" ]]; then
  cp -a "$POLICY" "$POLICY_BACKUP"
  rm -f "$POLICY"
  POLICY_HAD=1
  cat >"$POLICY" <<EOF
#!/bin/sh
if [ "\${1:-}" = "dnsmasq" ]; then exit 101; fi
exec "$POLICY_BACKUP" "\$@"
EOF
else
  cat >"$POLICY" <<'EOF'
#!/bin/sh
if [ "${1:-}" = "dnsmasq" ]; then exit 101; fi
exit 0
EOF
fi
chmod 0755 "$POLICY"
POLICY_ACTIVE=1

# Repair half-configured packages left by interrupted/failed apt transactions.
exec 7>"$APT_LOCK"
flock -w 900 7 || exit 75
export DEBIAN_FRONTEND=noninteractive
dpkg --configure -a || true
apt-get -f install -y
dpkg --configure -a
flock -u 7

set +e
bash "$BASE"
rc=$?
set -e

if [[ "$rc" == 0 ]] && systemctl is-active --quiet control-center-dhcp-server.service 2>/dev/null; then
  if dnsmasq --test --conf-file=/etc/dnsmasq.d/control-center-dhcp.conf >/dev/null 2>&1; then
    systemctl restart control-center-dhcp-server.service
  fi
fi

exit "$rc"
