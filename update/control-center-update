#!/usr/bin/env bash
set -Eeuo pipefail
BASE=/usr/local/lib/control-center/control-center-update-base-1.0.7
[[ -x "$BASE" ]] || { echo "Control Center updater base is missing: $BASE" >&2; exit 1; }
TMP="$(mktemp /tmp/control-center-update-1.0.8.XXXXXX)"
trap 'rm -f "$TMP"' EXIT
python3 - "$BASE" "$TMP" <<'PY'
from pathlib import Path
import re,sys
src,dst=map(Path,sys.argv[1:])
text=src.read_text()
needle='flock -n 9 || exit 0\n'
insert='''flock -n 9 || exit 0
FORCE_UPDATE=0
if [[ -f "$STATE_DIR/update-now" ]]; then
  FORCE_UPDATE=1
  rm -f "$STATE_DIR/update-now"
fi
'''
if needle not in text: raise SystemExit('updater lock marker not found')
text=text.replace(needle,insert,1)
old='[[ "${cfg[0]}" == "1" ]] || exit 0'
new='[[ "$FORCE_UPDATE" == "1" || "${cfg[0]}" == "1" ]] || exit 0'
if old not in text: raise SystemExit('automatic update gate marker not found')
text=text.replace(old,new,1)
old='(( now - cfg[3] >= cfg[2] )) || exit 0'
new='[[ "$FORCE_UPDATE" == "1" ]] || (( now - cfg[3] >= cfg[2] )) || exit 0'
if old not in text: raise SystemExit('update interval gate marker not found')
text=text.replace(old,new,1)
text,n=re.subn(r'\nmain_version="\$\(grep -E .*?\n\[\[ "\$main_version" == "\$latest" \]\] \|\| \{ write_status error .*?; exit 1; \}\n','\n',text,count=1)
if n != 1: raise SystemExit('legacy APP_VERSION verification block not found')
dst.write_text(text)
PY
chmod 0755 "$TMP"
bash "$TMP"
