#!/usr/bin/env bash
set -Eeuo pipefail
STATE=/var/lib/control-center
SYSTEM=/var/lib/control-center-system
ROOT=/var/lib/control-center-root
PENDING="$STATE/storage-pending.json"
MODULE="$SYSTEM/modules/storage.json"
SAMBA="$SYSTEM/modules/samba.json"
STATUS="$SYSTEM/storage-status.json"
SMB=/etc/samba/smb.conf
DATA=/srv/control-center/storage/public
AUDITS="$SYSTEM/cleanup-audits"
APT_LOCK=/run/control-center-apt.lock
CTX="$ROOT/storage-install-context.json"
CTX_ARCHIVE="$ROOT/storage-install-prestate.tar.gz"
[[ -s "$PENDING" ]] || exit 0
install -d -o root -g control-center -m 0750 "$SYSTEM" "$SYSTEM/modules" "$AUDITS"
install -d -o root -g root -m 0700 "$ROOT"
status(){ python3 - "$STATUS" "$1" "$2" "${3:-}" <<'PY'
import json,sys,time,os,tempfile
p,state,msg,detail=sys.argv[1:];d={'state':state,'message':msg,'detail':detail,'timestamp':int(time.time())}
fd,tmp=tempfile.mkstemp(prefix='.storage-status.',dir=os.path.dirname(p))
with os.fdopen(fd,'w') as f:json.dump(d,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,p)
PY
chown root:control-center "$STATUS";chmod 0640 "$STATUS"; }
snapshot_prestate(){
  [[ -s "$CTX" ]]&&return 0
  if [[ -s "$SMB" ]]&&! grep -q '^# Managed by Control Center Storage' "$SMB";then status rejected 'Обнаружена внешняя Samba-конфигурация. Автоматический takeover запрещён.' "$SMB";return 1;fi
  if [[ -s "$SMB" ]]&&grep -q '^# Managed by Control Center Storage' "$SMB";then rm -f "$SMB";fi
  python3 - "$CTX" <<'PY'
import json,os,pwd,subprocess,sys,time
p=sys.argv[1]
def cmd(a):
 r=subprocess.run(a,text=True,capture_output=True);return r.returncode,r.stdout.strip()
pkg=cmd(['dpkg-query','-W','-f=${Status}','samba'])
services={}
for s in ('smbd.service','nmbd.service','winbind.service'):
 services[s]={'active':cmd(['systemctl','is-active',s])[1],'enabled':cmd(['systemctl','is-enabled',s])[1]}
try:pwd.getpwnam('control-center-storage');user=True
except KeyError:user=False
paths=['/etc/samba','/var/lib/samba','/var/cache/samba','/var/log/samba']
data={'created_at':int(time.time()),'package_present':pkg[0]==0 and 'install ok installed' in pkg[1],'service_user_present':user,'services':services,'paths':{x:os.path.lexists(x) for x in paths}}
with open(p,'w') as f:json.dump(data,f,ensure_ascii=False,indent=2);f.write('\n')
os.chmod(p,0o600)
PY
  PATHS=();for p in etc/samba var/lib/samba var/cache/samba var/log/samba;do [[ -e "/$p" || -L "/$p" ]]&&PATHS+=("$p");done
  if (( ${#PATHS[@]} ));then tar -C / --acls --xattrs -czpf "$CTX_ARCHIVE" "${PATHS[@]}";else tar -czpf "$CTX_ARCHIVE" --files-from /dev/null;fi
  chmod 0600 "$CTX" "$CTX_ARCHIVE"
}
restore_prestate(){
  [[ -s "$CTX" ]]||return 0
  systemctl stop smbd.service nmbd.service winbind.service >/dev/null 2>&1||true
  rm -rf /etc/samba /var/lib/samba /var/cache/samba /var/log/samba
  [[ -s "$CTX_ARCHIVE" ]]&&tar -C / -xzpf "$CTX_ARCHIVE" --acls --xattrs
  python3 - "$CTX" >"$ROOT/storage-service-restore.tsv" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]));print('PACKAGE\t'+('1' if j.get('package_present') else '0'))
for s,v in (j.get('services') or {}).items():print(s+'\t'+str(v.get('active',''))+'\t'+str(v.get('enabled','')))
PY
  while IFS=$'\t' read -r unit active enabled;do
    [[ "$unit" == PACKAGE ]]&&continue
    case "$enabled" in enabled)systemctl enable "$unit" >/dev/null 2>&1||true;;disabled)systemctl disable "$unit" >/dev/null 2>&1||true;;masked)systemctl mask "$unit" >/dev/null 2>&1||true;;esac
    if [[ "$active" == active ]];then systemctl start "$unit" >/dev/null 2>&1||true;else systemctl stop "$unit" >/dev/null 2>&1||true;fi
  done <"$ROOT/storage-service-restore.tsv"
  rm -f "$ROOT/storage-service-restore.tsv"
}
write_domain_share(){
  local name="$1" backup="$ROOT/smb.conf.storage.rollback";cp -a "$SMB" "$backup"
  python3 - "$SMB" "$name" "$DATA" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]);name,path=sys.argv[2:];text=p.read_text(errors='replace');b='\n# BEGIN CONTROL CENTER STORAGE\n';e='# END CONTROL CENTER STORAGE\n'
if b in text and e in text:text=text.split(b,1)[0]+text.split(e,1)[1]
block=f'''\n# BEGIN CONTROL CENTER STORAGE\n[{name}]\n\tpath = {path}\n\tbrowseable = yes\n\tread only = no\n\tguest ok = no\n\tinherit acls = yes\n\tmap acl inherit = yes\n\tvfs objects = acl_xattr\n# END CONTROL CENTER STORAGE\n''';p.write_text(text.rstrip()+block)
PY
  if samba-tool testparm >/dev/null 2>&1&&systemctl restart samba-ad-dc.service&&systemctl is-active --quiet samba-ad-dc.service;then return 0;fi
  cp -a "$backup" "$SMB";systemctl restart samba-ad-dc.service >/dev/null 2>&1||true;return 1
}
write_module(){ python3 - "$MODULE" "$@" <<'PY'
import json,sys,time,os
p,provider,explicit,owned,name,path,user_owned=sys.argv[1:]
try:d=json.load(open(p))
except Exception:d={}
package_owned=(owned=='1') or bool(d.get('package_owned',False));svc_owned=(user_owned=='1') or bool(d.get('service_user_owned',False))
d.update({'installed':True,'provider':provider,'mode':'domain' if provider=='samba_ad_dc' else 'standalone','explicit':explicit=='1','package_owned':package_owned,'service_user_owned':svc_owned,'dependency_by':['domain'] if provider=='samba_ad_dc' else [],'share_name':name,'path':path,'rbac_ready':True,'installed_at':d.get('installed_at') or int(time.time()),'prestate_context':d.get('prestate_context') or '/var/lib/control-center-root/storage-install-context.json'})
open(p,'w').write(json.dumps(d,ensure_ascii=False,indent=2)+'\n');os.chmod(p,0o640)
PY
chown root:control-center "$MODULE"; }
DOMAIN_ACTIVE=0
if [[ -s "$SAMBA" ]]&&python3 - "$SAMBA" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except Exception:raise SystemExit(1)
raise SystemExit(0 if j.get('managed') and j.get('state')=='active' else 1)
PY
then DOMAIN_ACTIVE=1;fi
readarray -t REQUEST < <(python3 - "$PENDING" <<'PY'
import json,re,sys
j=json.load(open(sys.argv[1]));a=str(j.get('action') or '');name=str(j.get('share_name') or 'Public').strip()
if not re.fullmatch(r'[A-Za-zА-Яа-яЁё0-9][A-Za-zА-Яа-яЁё0-9 _.-]{0,31}',name):raise SystemExit(2)
print(a);print(name)
PY
)||{ rm -f "$PENDING";status error 'Storage request rejected';exit 1; }
ACTION="${REQUEST[0]}";SHARE="${REQUEST[1]}"

if [[ "$ACTION" == configure ]];then
  [[ -s "$MODULE" || "$DOMAIN_ACTIVE" == 1 ]]||{ rm -f "$PENDING";status error 'Сетевое хранилище не установлено';exit 1; }
  if [[ "$DOMAIN_ACTIVE" == 1 ]];then
    status applying 'Применение SMB ресурса в доменном режиме…';install -d -m 0770 "$DATA"
    if write_domain_share "$SHARE";then
      readarray -t X < <(python3 - "$MODULE" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except Exception:j={}
print('1' if j.get('explicit') else '0');print('1' if j.get('package_owned') else '0');print('1' if j.get('service_user_owned') else '0')
PY
);write_module samba_ad_dc "${X[0]}" "${X[1]}" "$SHARE" "$DATA" "${X[2]}";rm -f "$PENDING";status applied "Доменное хранилище [$SHARE] применено";exit 0;fi
    rm -f "$PENDING";status rollback 'Ошибка применения SMB ресурса. smb.conf восстановлен.';exit 1
  fi
  readarray -t X < <(python3 - "$MODULE" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]));print('1' if j.get('package_owned') else '0');print('1' if j.get('service_user_owned') else '0')
PY
);OWNED="${X[0]}";USER_OWNED="${X[1]}";EXPLICIT=1
elif [[ "$ACTION" == install ]];then
  if [[ "$DOMAIN_ACTIVE" == 1 ]];then
    install -d -m 0770 "$DATA";write_domain_share "$SHARE"||{ rm -f "$PENDING";status error 'Не удалось активировать SMB share в домене';exit 1; }
    OWNED=0;USER_OWNED=0;[[ -s "$MODULE" ]]&&readarray -t X < <(python3 - "$MODULE" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]));print('1' if j.get('package_owned') else '0');print('1' if j.get('service_user_owned') else '0')
PY
)&&OWNED="${X[0]}"&&USER_OWNED="${X[1]}";write_module samba_ad_dc 1 "$OWNED" "$SHARE" "$DATA" "$USER_OWNED";rm -f "$PENDING";status applied 'Сетевое хранилище отмечено как явно установленное в составе Домена';exit 0
  fi
  status installing 'Установка standalone SMB-хранилища…';snapshot_prestate||{ rm -f "$PENDING";exit 1; }
  readarray -t PRE < <(python3 - "$CTX" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]));print('1' if j.get('package_present') else '0');print('1' if j.get('service_user_present') else '0')
PY
);exec 8>"$APT_LOCK";flock -w 900 8||{ rm -f "$PENDING";status error 'Менеджер пакетов занят';exit 75; };export DEBIAN_FRONTEND=noninteractive;apt-get update;apt-get install -y samba smbclient acl attr
  OWNED=$((1-PRE[0]));USER_OWNED=$((1-PRE[1]));EXPLICIT=1
elif [[ "$ACTION" == remove ]];then
  [[ "$DOMAIN_ACTIVE" == 0 ]]||{ rm -f "$PENDING";status rejected 'Сетевое хранилище является обязательной зависимостью активного Домена';exit 1; }
  [[ -s "$MODULE" ]]||{ rm -f "$PENDING";status removed 'Сетевое хранилище уже отсутствует';exit 0; }
  readarray -t X < <(python3 - "$MODULE" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]));print('1' if j.get('package_owned') else '0');print('1' if j.get('service_user_owned') else '0')
PY
);OWNED="${X[0]}";USER_OWNED="${X[1]}";status removing 'Удаление standalone SMB-хранилища и восстановление pre-state…'
  systemctl disable --now smbd.service nmbd.service winbind.service >/dev/null 2>&1||true
  if [[ -f "$SMB" ]]&&grep -q '^# Managed by Control Center Storage' "$SMB";then rm -f "$SMB";fi
  if [[ "$USER_OWNED" == 1 ]]&&id control-center-storage >/dev/null 2>&1;then chown -R root:root /srv/control-center/storage 2>/dev/null||true;userdel control-center-storage >/dev/null 2>&1||true;fi
  if [[ "$OWNED" == 1 ]];then exec 8>"$APT_LOCK";flock -w 900 8;export DEBIAN_FRONTEND=noninteractive;apt-get purge -y samba samba-dsdb-modules samba-vfs-modules winbind||true;apt-get autoremove -y||true;fi
  restore_prestate||true;rm -f "$MODULE" "$PENDING"
  TS=$(date +%s);AUDIT="$AUDITS/storage-$TS.json";RC=0
  python3 - "$AUDIT" "$SMB" "$CTX" "$DATA" <<'PY' || RC=$?
import json,os,pwd,subprocess,sys,time
p,smb,ctxp,data=sys.argv[1:]
def cmd(a):
 r=subprocess.run(a,text=True,capture_output=True);return r.returncode,r.stdout.strip()
try:ctx=json.load(open(ctxp))
except Exception:ctx={}
pkg=cmd(['dpkg-query','-W','-f=${Status}','samba']);present=pkg[0]==0 and 'install ok installed' in pkg[1]
try:pwd.getpwnam('control-center-storage');user=True
except KeyError:user=False
checks={'managed_marker_removed':not os.path.exists(smb) or '# Managed by Control Center Storage' not in open(smb,errors='ignore').read(),'package_presence_restored':present==bool(ctx.get('package_present',False)),'service_user_presence_restored':user==bool(ctx.get('service_user_present',False))}
for unit,old in (ctx.get('services') or {}).items():
 active=cmd(['systemctl','is-active',unit])[1];enabled=cmd(['systemctl','is-enabled',unit])[1]
 if ctx.get('package_present'):checks['active:'+unit]=active==old.get('active');checks['enabled:'+unit]=enabled==old.get('enabled')
 else:checks['inactive:'+unit]=active!='active'
for path,was in (ctx.get('paths') or {}).items():checks['path:'+path]=(os.path.lexists(path)==bool(was))
clean=all(checks.values());obj={'service':'storage','action':'remove','clean':clean,'checks':checks,'timestamp':int(time.time()),'prestate_restored':bool(ctx),'preserved_user_data':data if os.path.exists(data) else None,'allowed_remaining':['Control Center cleanup audit','user data under /srv/control-center/storage','pre-existing Samba artifacts restored by ownership/existence boundary']}
with open(p,'w') as f:json.dump(obj,f,ensure_ascii=False,indent=2);f.write('\n')
os.chmod(p,0o640);raise SystemExit(0 if clean else 2)
PY
  chown root:control-center "$AUDIT";if [[ $RC -ne 0 ]];then status error 'Хранилище удалено, cleanup-audit обнаружил отличие от pre-state' "$AUDIT";exit 1;fi
  rm -f "$CTX" "$CTX_ARCHIVE" "$ROOT/smb.conf.storage-standalone.rollback" "$ROOT/smb.conf.storage.rollback"
  status removed 'Сетевое хранилище удалено. Pre-state восстановлен; пользовательские данные сохранены.' "$AUDIT";exit 0
else rm -f "$PENDING";status error 'Неизвестное действие Storage';exit 1;fi

if ! id control-center-storage >/dev/null 2>&1;then useradd --system --home /nonexistent --shell /usr/sbin/nologin control-center-storage;fi
install -d -o control-center-storage -g control-center-storage -m 0770 "$DATA";install -d -m 0755 /etc/samba
BACKUP="$ROOT/smb.conf.storage-standalone.rollback";[[ -f "$SMB" ]]&&cp -a "$SMB" "$BACKUP"||rm -f "$BACKUP"
cat >"$SMB" <<EOF
# Managed by Control Center Storage
[global]
    workgroup = WORKGROUP
    server role = standalone server
    security = user
    map to guest = Bad User
    server min protocol = SMB2
    load printers = no
    disable spoolss = yes
    dns proxy = no

[$SHARE]
    path = $DATA
    browseable = yes
    read only = no
    guest ok = yes
    force user = control-center-storage
    create mask = 0660
    directory mask = 0770
EOF
chmod 0644 "$SMB"
if testparm -s "$SMB" >/dev/null 2>&1&&systemctl enable --now smbd.service&&systemctl restart smbd.service&&systemctl is-active --quiet smbd.service;then write_module samba_standalone "$EXPLICIT" "$OWNED" "$SHARE" "$DATA" "$USER_OWNED";rm -f "$PENDING";status applied "Standalone SMB-хранилище работает: [$SHARE]";exit 0;fi
[[ -f "$BACKUP" ]]&&cp -a "$BACKUP" "$SMB"||rm -f "$SMB";systemctl restart smbd.service >/dev/null 2>&1||true;rm -f "$PENDING";status rollback 'Ошибка SMB. Предыдущая конфигурация восстановлена.';exit 1
