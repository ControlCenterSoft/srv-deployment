#!/usr/bin/env bash
set -Eeuo pipefail
STATE=/var/lib/control-center
SYSTEM_STATE=/var/lib/control-center-system
PENDING="$STATE/market-pending.json"
MODULE_DIR="$SYSTEM_STATE/modules"
DHCP_STATE="$MODULE_DIR/dhcp.json"
STATUS="$SYSTEM_STATE/market-status.json"
APT_LOCK=/run/control-center-apt.lock
DNSMASQ_MASK=/etc/systemd/system/dnsmasq.service
MASK_CREATED=0
[[ -s "$PENDING" ]] || exit 0
install -d -o root -g control-center -m 0750 "$SYSTEM_STATE" "$MODULE_DIR"
status(){ python3 - "$STATUS" "$1" "$2" <<'PY'
import json,sys,time
open(sys.argv[1],'w').write(json.dumps({'state':sys.argv[2],'message':sys.argv[3],'timestamp':int(time.time())},ensure_ascii=False,indent=2)+'\n')
PY
chown root:control-center "$STATUS"; chmod 0640 "$STATUS"; }
unmask_dnsmasq(){
  if [[ "$MASK_CREATED" == 1 && -L "$DNSMASQ_MASK" && "$(readlink "$DNSMASQ_MASK")" == /dev/null ]]; then
    rm -f "$DNSMASQ_MASK"
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
}
on_error(){ local rc=$?; trap - ERR; unmask_dnsmasq; status error "Операция Маркета завершилась ошибкой (код $rc)" || true; exit "$rc"; }
trap on_error ERR
readarray -t x < <(python3 - "$PENDING" <<'PY'
import json,sys
j=json.load(open(sys.argv[1])); print(j.get('module','')); print(j.get('action',''))
PY
)
rm -f "$PENDING"
[[ "${x[0]}" == dhcp && ( "${x[1]}" == install || "${x[1]}" == remove ) ]] || { status error 'Некорректная операция Маркета'; trap - ERR; exit 1; }
exec 8>"$APT_LOCK"
flock -w 900 8 || { status error 'Менеджер пакетов занят'; trap - ERR; exit 1; }
export DEBIAN_FRONTEND=noninteractive
if [[ "${x[1]}" == install ]]; then
  if [[ -f "$DHCP_STATE" ]] && python3 - "$DHCP_STATE" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except:raise SystemExit(1)
raise SystemExit(0 if j.get('installed') else 1)
PY
  then
    status applied 'DHCP Server уже установлен Control Center'
    trap - ERR
    exit 0
  fi
  if dpkg-query -W -f='${Status}' dnsmasq 2>/dev/null | grep -q 'install ok installed'; then
    status error 'Обнаружен dnsmasq, установленный вне Control Center. Автоматический захват существующей службы запрещён.'
    trap - ERR
    exit 1
  fi
  status applying 'Установка DHCP Server…'
  if [[ -L "$DNSMASQ_MASK" ]]; then
    status error 'Обнаружена существующая ссылка dnsmasq.service. Автоматическое изменение запрещено.'
    trap - ERR
    exit 1
  elif [[ -e "$DNSMASQ_MASK" ]]; then
    status error 'Нельзя временно замаскировать dnsmasq.service: путь уже занят.'
    trap - ERR
    exit 1
  fi
  ln -s /dev/null "$DNSMASQ_MASK"
  MASK_CREATED=1
  systemctl daemon-reload
  apt-get update
  apt-get install -y dnsmasq
  unmask_dnsmasq
  MASK_CREATED=0
  systemctl disable --now dnsmasq.service >/dev/null 2>&1 || true
  install -d -m 0755 /etc/dnsmasq.d
  cat >/etc/dnsmasq.d/control-center-dhcp.conf <<'EOF'
# DHCP Server is installed but not configured yet.
# Configure it in Control Center -> DHCP.
port=0
EOF
  printf '%s\n' '{"installed":true,"package":"dnsmasq","package_owned":true,"configured":false}' >"$DHCP_STATE"
  chown root:control-center "$DHCP_STATE"; chmod 0640 "$DHCP_STATE"
  status applied 'DHCP Server установлен. Настройте диапазон в меню DHCP.'
else
  if [[ ! -f "$DHCP_STATE" ]]; then
    status error 'DHCP Server не зарегистрирован как модуль Control Center. Удаление внешнего dnsmasq запрещено.'
    trap - ERR
    exit 1
  fi
  readarray -t OWN < <(python3 - "$DHCP_STATE" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except:raise SystemExit(1)
print('true' if j.get('installed') else 'false')
print('true' if j.get('package_owned',False) else 'false')
PY
)
  [[ "${OWN[0]}" == true ]] || { status error 'DHCP module state is not installed'; trap - ERR; exit 1; }
  status applying 'Удаление DHCP Server…'
  systemctl disable --now control-center-dhcp-server.service >/dev/null 2>&1 || true
  rm -f /etc/dnsmasq.d/control-center-dhcp.conf "$DHCP_STATE" "$SYSTEM_STATE/dhcp-config.json" "$SYSTEM_STATE/dhcp-status.json"
  if [[ "${OWN[1]}" == true ]]; then apt-get remove -y dnsmasq || true; fi
  status applied 'DHCP Server удалён'
fi
trap - ERR
