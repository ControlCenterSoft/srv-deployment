#!/usr/bin/env bash
set -Eeuo pipefail

BASE=/usr/local/lib/control-center/control-center-market-apply-base-1.0.8
STATE=/var/lib/control-center
SYSTEM_STATE=/var/lib/control-center-system
PENDING="$STATE/market-pending.json"
MARKER="$SYSTEM_STATE/dhcp-recovery-legacy.json"
DHCP_CONF=/etc/dnsmasq.d/control-center-dhcp.conf
DHCP_STATE="$SYSTEM_STATE/modules/dhcp.json"
RECOVERY=0

[[ -x "$BASE" ]] || { echo "Market helper base is missing: $BASE" >&2; exit 1; }

pending_install=0
if [[ -s "$PENDING" ]]; then
  pending_install="$(python3 - "$PENDING" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except Exception: print(0); raise SystemExit
print(1 if j.get('module')=='dhcp' and j.get('action')=='install' else 0)
PY
)"
fi

has_external_config(){
  local f
  for f in /etc/dnsmasq.conf /etc/dnsmasq.d/*; do
    [[ -f "$f" ]] || continue
    [[ "$f" == "$DHCP_CONF" ]] && continue
    if grep -Eq '^[[:space:]]*[^#[:space:]]' "$f"; then
      echo "External dnsmasq configuration detected: $f" >&2
      return 0
    fi
  done
  return 1
}

if [[ "$pending_install" == 1 && -f "$MARKER" ]]; then
  if dpkg-query -W -f='${Status}' dnsmasq 2>/dev/null | grep -q 'install ok installed' && ! has_external_config; then
    install -d -m 0755 /etc/dnsmasq.d
    if [[ ! -f "$DHCP_CONF" ]]; then
      cat >"$DHCP_CONF" <<'EOF'
# Managed by Control Center.
# Recovery placeholder for a legacy 1.0.6 Market installation that returned apt code 100.
# DHCP remains disabled until configured in Control Center.
port=0
EOF
    fi
    RECOVERY=1
  fi
fi

set +e
bash "$BASE"
rc=$?
set -e

if [[ "$rc" == 0 && "$RECOVERY" == 1 && -f "$DHCP_STATE" ]]; then
  python3 - "$DHCP_STATE" <<'PY'
import json,sys,time,os,tempfile
path=sys.argv[1]
data=json.load(open(path))
data['package_owned']=True
data['legacy_recovered']=True
data['legacy_recovered_at']=int(time.time())
fd,tmp=tempfile.mkstemp(prefix='.dhcp-state.',dir=os.path.dirname(path))
with os.fdopen(fd,'w') as f:
    json.dump(data,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,path)
PY
  chown root:control-center "$DHCP_STATE"
  chmod 0640 "$DHCP_STATE"
  rm -f "$MARKER"
fi

exit "$rc"
