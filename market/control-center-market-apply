#!/usr/bin/env bash
set -Eeuo pipefail

STATE=/var/lib/control-center
SYSTEM_STATE=/var/lib/control-center-system
PENDING="$STATE/market-pending.json"
MODULE_DIR="$SYSTEM_STATE/modules"
DHCP_STATE="$MODULE_DIR/dhcp.json"
STATUS="$SYSTEM_STATE/market-status.json"
EVENTS="$SYSTEM_STATE/market-events.jsonl"
LOG="$SYSTEM_STATE/market-last.log"
DHCP_CONF=/etc/dnsmasq.d/control-center-dhcp.conf
APT_LOCK=/run/control-center-apt.lock
POLICY=/usr/sbin/policy-rc.d
POLICY_BACKUP="$SYSTEM_STATE/policy-rc.d.$$.backup"
POLICY_HAD=0
POLICY_ACTIVE=0
ACTION=""
SERVICE="DHCP Server"

[[ -s "$PENDING" ]] || exit 0
install -d -o root -g control-center -m 0750 "$SYSTEM_STATE" "$MODULE_DIR"
: >"$LOG"
chown root:control-center "$LOG"
chmod 0640 "$LOG"
exec > >(tee -a "$LOG") 2>&1

status(){
  local state="$1" message="$2" detail="${3:-}"
  python3 - "$STATUS" "$state" "$ACTION" "$message" "$detail" <<'PY'
import json,sys,time,os,tempfile
path,state,action,message,detail=sys.argv[1:]
data={'state':state,'module':'dhcp','service':'DHCP Server','action':action,'message':message,'detail':detail,'timestamp':int(time.time())}
fd,tmp=tempfile.mkstemp(prefix='.market-status.',dir=os.path.dirname(path))
with os.fdopen(fd,'w') as f:
    json.dump(data,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,path)
PY
  chown root:control-center "$STATUS"
  chmod 0640 "$STATUS"
}

event(){
  local phase="$1" state="$2" message="$3" detail="${4:-}"
  python3 - "$EVENTS" "$ACTION" "$phase" "$state" "$message" "$detail" <<'PY'
import json,sys,time,os,tempfile
path,action,phase,state,message,detail=sys.argv[1:]
event={'module':'dhcp','service':'DHCP Server','action':action,'phase':phase,'state':state,'message':message,'detail':detail,'timestamp':int(time.time())}
try:
    lines=open(path,encoding='utf-8').read().splitlines()
except Exception:
    lines=[]
lines.append(json.dumps(event,ensure_ascii=False,separators=(',',':')))
lines=lines[-200:]
fd,tmp=tempfile.mkstemp(prefix='.market-events.',dir=os.path.dirname(path))
with os.fdopen(fd,'w',encoding='utf-8') as f:
    f.write('\n'.join(lines)+'\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,path)
PY
  chown root:control-center "$EVENTS"
  chmod 0640 "$EVENTS"
}

log_tail(){
  tail -n 24 "$LOG" 2>/dev/null | sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g' | tail -c 2400 || true
}

cleanup_policy(){
  [[ "$POLICY_ACTIVE" == 1 ]] || return 0
  rm -f "$POLICY"
  if [[ "$POLICY_HAD" == 1 && -e "$POLICY_BACKUP" ]]; then
    cp -a "$POLICY_BACKUP" "$POLICY"
  fi
  rm -f "$POLICY_BACKUP"
  POLICY_ACTIVE=0
}

prepare_policy(){
  if [[ -e "$POLICY" || -L "$POLICY" ]]; then
    cp -a "$POLICY" "$POLICY_BACKUP"
    POLICY_HAD=1
    cat >"$POLICY" <<EOF
#!/bin/sh
if [ "\${1:-}" = "dnsmasq" ]; then exit 101; fi
exec "$POLICY_BACKUP" "\$@"
EOF
  else
    POLICY_HAD=0
    cat >"$POLICY" <<'EOF'
#!/bin/sh
if [ "${1:-}" = "dnsmasq" ]; then exit 101; fi
exit 0
EOF
  fi
  chmod 0755 "$POLICY"
  POLICY_ACTIVE=1
}

fail_now(){
  local message="$1" detail="${2:-}" code="${3:-1}"
  trap - ERR
  status error "$message" "$detail" || true
  event failed error "$message" "$detail" || true
  exit "$code"
}

on_error(){
  local rc=$?
  trap - ERR
  local detail
  detail="$(log_tail)"
  local message
  if [[ "$ACTION" == install ]]; then
    message="Установка DHCP Server завершилась ошибкой (код $rc)"
  elif [[ "$ACTION" == remove ]]; then
    message="Удаление DHCP Server завершилось ошибкой (код $rc)"
  else
    message="Операция DHCP Server завершилась ошибкой (код $rc)"
  fi
  status error "$message" "$detail" || true
  event failed error "$message" "$detail" || true
  exit "$rc"
}

trap cleanup_policy EXIT
trap on_error ERR

PREVIOUS_RECOVERY="$(python3 - "$STATUS" "$DHCP_CONF" <<'PY'
import json,sys,os
path,conf=sys.argv[1:]
recover=os.path.exists(conf)
try:
    j=json.load(open(path))
    state=str(j.get('state','')).lower(); msg=str(j.get('message','')).lower()
    if state in {'error','applying','installing'} and ('dhcp' in msg or 'маркет' in msg or j.get('module')=='dhcp'):
        recover=True
except Exception:
    pass
print('1' if recover else '0')
PY
)"

readarray -t request_data < <(python3 - "$PENDING" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]))
print(j.get('module',''))
print(j.get('action',''))
print(j.get('request_id',''))
print(int(j.get('requested_at',0) or 0))
PY
)
rm -f "$PENDING"
[[ "${request_data[0]}" == dhcp ]] || fail_now 'Некорректный модуль Маркета' '' 2
ACTION="${request_data[1]}"
[[ "$ACTION" == install || "$ACTION" == remove ]] || fail_now 'Некорректная операция Маркета' '' 2

exec 8>"$APT_LOCK"
flock -w 900 8 || fail_now 'Менеджер пакетов занят' 'Не удалось получить /run/control-center-apt.lock за 900 секунд.' 75
export DEBIAN_FRONTEND=noninteractive

if [[ "$ACTION" == install ]]; then
  status installing 'Установка DHCP Server выполняется…' 'Market worker проверяет пакет, конфигурацию и systemd.'
  event started installing 'Установка началась: DHCP Server' ''

  if [[ -f "$DHCP_STATE" ]] && python3 - "$DHCP_STATE" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except Exception:raise SystemExit(1)
raise SystemExit(0 if j.get('installed') else 1)
PY
  then
    if dpkg-query -W -f='${Status}' dnsmasq 2>/dev/null | grep -q 'install ok installed'; then
      status running 'DHCP Server уже установлен и зарегистрирован Control Center' ''
      event succeeded running 'Установка успешно завершена: DHCP Server уже был установлен' ''
      trap - ERR
      exit 0
    fi
    rm -f "$DHCP_STATE"
  fi

  PACKAGE_OWNED=true
  PACKAGE_PRESENT=0
  if dpkg-query -W -f='${Status}' dnsmasq 2>/dev/null | grep -q 'install ok installed'; then
    PACKAGE_PRESENT=1
    PACKAGE_OWNED=false
  fi

  CONFLICT=0
  for f in /etc/dnsmasq.conf /etc/dnsmasq.d/*; do
    [[ -f "$f" ]] || continue
    [[ "$f" == "$DHCP_CONF" ]] && continue
    if grep -Eq '^[[:space:]]*(dhcp-range|dhcp-host|dhcp-option)[= ]' "$f"; then
      echo "External DHCP directive detected in $f"
      CONFLICT=1
    fi
  done
  [[ "$CONFLICT" == 0 ]] || fail_now 'Установка DHCP Server остановлена: обнаружена внешняя DHCP-конфигурация dnsmasq' "$(log_tail)" 3

  if [[ "$PACKAGE_PRESENT" == 1 && "$PREVIOUS_RECOVERY" != 1 ]]; then
    fail_now 'Обнаружен dnsmasq, установленный вне Control Center. Автоматический захват существующей службы запрещён.' 'Если это остаток предыдущей неудачной установки Control Center, повторите после проверки market-status/конфигурации.' 3
  fi

  if [[ -L /etc/systemd/system/dnsmasq.service && "$(readlink /etc/systemd/system/dnsmasq.service)" == /dev/null ]]; then
    if [[ "$PREVIOUS_RECOVERY" == 1 ]]; then
      echo 'Removing stale dnsmasq.service mask from previous Control Center attempt'
      rm -f /etc/systemd/system/dnsmasq.service
      systemctl daemon-reload
    else
      fail_now 'dnsmasq.service замаскирован вне Control Center' 'Существующая системная mask не изменена.' 3
    fi
  fi

  if [[ "$PACKAGE_PRESENT" == 1 && "$PREVIOUS_RECOVERY" == 1 ]]; then
    echo 'Recovering previous incomplete Control Center DHCP installation'
  else
    prepare_policy
    apt-get update
    apt-get -f install -y
    apt-get install -y dnsmasq
    cleanup_policy
    PACKAGE_OWNED=true
  fi

  dpkg-query -W -f='${Status}' dnsmasq | grep -q 'install ok installed'
  command -v dnsmasq >/dev/null
  systemctl disable --now dnsmasq.service >/dev/null 2>&1 || true
  install -d -m 0755 /etc/dnsmasq.d
  cat >"$DHCP_CONF" <<'EOF'
# Managed by Control Center.
# DHCP Server is installed but not configured yet.
# Configure interface/range in Control Center -> DHCP.
port=0
EOF
  dnsmasq --test --conf-file="$DHCP_CONF"

  python3 - "$DHCP_STATE" "$PACKAGE_OWNED" <<'PY'
import json,sys,time,os,tempfile
path,owned=sys.argv[1:]
data={'installed':True,'package':'dnsmasq','package_owned':owned=='true','configured':False,'lifecycle_state':'running','installed_at':int(time.time())}
fd,tmp=tempfile.mkstemp(prefix='.dhcp-state.',dir=os.path.dirname(path))
with os.fdopen(fd,'w') as f:
    json.dump(data,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,path)
PY
  chown root:control-center "$DHCP_STATE"
  chmod 0640 "$DHCP_STATE"
  status running 'DHCP Server установлен и готов к настройке' 'Пакет dnsmasq проверен. Настройте интерфейс и диапазон в разделе DHCP.'
  event succeeded running 'Установка успешно завершена: DHCP Server' 'Пакет dnsmasq установлен и проверен.'
else
  [[ -f "$DHCP_STATE" ]] || fail_now 'DHCP Server не зарегистрирован как модуль Control Center. Удаление внешнего dnsmasq запрещено.' '' 3
  readarray -t owned < <(python3 - "$DHCP_STATE" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]))
print('true' if j.get('installed') else 'false')
print('true' if j.get('package_owned',False) else 'false')
PY
)
  [[ "${owned[0]}" == true ]] || fail_now 'DHCP module state is not installed' '' 3
  status removing 'Удаление DHCP Server выполняется…' ''
  event started removing 'Удаление началось: DHCP Server' ''
  systemctl disable --now control-center-dhcp-server.service >/dev/null 2>&1 || true
  rm -f "$DHCP_CONF" "$DHCP_STATE" "$SYSTEM_STATE/dhcp-config.json" "$SYSTEM_STATE/dhcp-status.json"
  if [[ "${owned[1]}" == true ]]; then
    prepare_policy
    apt-get remove -y dnsmasq
    cleanup_policy
  fi
  status removed 'DHCP Server удалён' ''
  event succeeded removed 'Удаление успешно завершено: DHCP Server' ''
fi

trap - ERR
