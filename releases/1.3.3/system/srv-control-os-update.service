[Unit]
Description=SRV Control Center manual OS/package update
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/libexec/srv-control-os-update

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/srv-control-os-update
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=0
