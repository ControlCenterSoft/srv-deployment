#!/usr/bin/env python3
from __future__ import annotations

from datetime import datetime, timezone
import grp
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
from typing import Any


STATE_DIR = Path("/var/lib/srv-control")
REGISTRY = STATE_DIR / "minecraft-instances.json"
OUTPUT = STATE_DIR / "minecraft-instances-status.json"
APP_GROUP = "srv-control"
LEGACY_PROPERTY_CANDIDATES = (
    Path("/opt/minecraft-bedrock/server.properties"),
    Path("/opt/minecraft/server.properties"),
    Path("/srv/minecraft/server.properties"),
    Path("/var/lib/minecraft/server.properties"),
)
LEGACY_SERVICE_CANDIDATES = (
    "minecraft-bedrock.service",
    "minecraft.service",
    "bedrock-server.service",
)
EDITABLE_KEYS = (
    "server-name",
    "gamemode",
    "difficulty",
    "allow-cheats",
    "max-players",
    "server-port",
    "server-portv6",
    "online-mode",
    "allow-list",
    "view-distance",
    "tick-distance",
    "player-idle-timeout",
    "level-name",
)
VERSION_RE = re.compile(r"(?:Version|version)\s*[:= ]\s*v?([0-9]+(?:\.[0-9]+){2,4})")
CONNECT_RE = re.compile(r"Player connected:\s*([^,]+).*?(?:xuid:\s*([0-9]+))?", re.I)
DISCONNECT_RE = re.compile(r"Player disconnected:\s*([^,]+)", re.I)


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def run(command: list[str], timeout: int = 10) -> tuple[int, str]:
    try:
        completed = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
            env={**os.environ, "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8"},
        )
    except Exception as exc:
        return 1, str(exc)
    return completed.returncode, (completed.stdout or "").strip()


def write_json(path: Path, value: dict[str, Any], mode: int = 0o640) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        json.dump(value, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), mode)
        tmp = Path(handle.name)
    finally:
        handle.close()
    try:
        gid = grp.getgrnam(APP_GROUP).gr_gid
        os.chown(tmp, 0, gid)
    except Exception:
        pass
    os.replace(tmp, path)


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def service_exists(unit: str) -> bool:
    code, output = run(["systemctl", "show", unit, "-p", "LoadState", "--value"], 5)
    return code == 0 and output not in {"", "not-found"}


def service_state(unit: str | None) -> tuple[str, bool]:
    if not unit or not service_exists(unit):
        return "not-installed", False
    _, state = run(["systemctl", "is-active", unit], 5)
    code, enabled = run(["systemctl", "is-enabled", unit], 5)
    return state or "inactive", code == 0 and enabled in {"enabled", "static"}


def working_directory_for_service(unit: str) -> Path | None:
    code, output = run(["systemctl", "show", unit, "-p", "WorkingDirectory", "--value"], 5)
    if code == 0 and output and output != "~":
        path = Path(output)
        if path.is_dir():
            return path
    return None


def legacy_instance() -> dict[str, Any] | None:
    service = next((unit for unit in LEGACY_SERVICE_CANDIDATES if service_exists(unit)), None)
    working = working_directory_for_service(service) if service else None
    props = None
    if working and (working / "server.properties").is_file():
        props = working / "server.properties"
    else:
        props = next((path for path in LEGACY_PROPERTY_CANDIDATES if path.is_file()), None)
        if props is not None:
            working = props.parent
    if not service and not props:
        return None
    properties = read_properties(props) if props else {}
    return {
        "id": "default",
        "display_name": properties.get("server-name") or "Minecraft Bedrock",
        "working_directory": str(working) if working else None,
        "service": service,
        "managed": False,
        "published": True,
        "update_mode": "manual",
        "update_channel": "stable",
        "server_port": int(properties.get("server-port") or 19132),
        "server_portv6": int(properties.get("server-portv6") or 19133),
        "created_at": now(),
        "imported": True,
    }


def load_registry() -> dict[str, Any]:
    value = read_json(REGISTRY, None)
    if not isinstance(value, dict) or not isinstance(value.get("instances"), list):
        value = {"schema_version": 1, "instances": []}
    if not value["instances"]:
        legacy = legacy_instance()
        if legacy:
            value["instances"].append(legacy)
            write_json(REGISTRY, value)
    return value


def read_properties(path: Path | None) -> dict[str, str]:
    result: dict[str, str] = {}
    if path is None or not path.is_file():
        return result
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except Exception:
        return result
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        result[key.strip()] = value.strip()
    return result


def parse_players(working: Path | None, journal: str) -> dict[str, Any]:
    allowlist: list[dict[str, Any]] = []
    permissions: dict[str, str] = {}
    if working:
        allow_raw = read_json(working / "allowlist.json", [])
        if isinstance(allow_raw, list):
            for item in allow_raw:
                if isinstance(item, dict):
                    name = str(item.get("name") or "").strip()
                    if name:
                        allowlist.append({
                            "name": name,
                            "xuid": str(item.get("xuid") or "") or None,
                            "ignores_player_limit": bool(item.get("ignoresPlayerLimit")),
                        })
        permission_raw = read_json(working / "permissions.json", [])
        if isinstance(permission_raw, list):
            for item in permission_raw:
                if isinstance(item, dict):
                    xuid = str(item.get("xuid") or "").strip()
                    permission = str(item.get("permission") or "").strip()
                    if xuid and permission:
                        permissions[xuid] = permission

    online: dict[str, dict[str, Any]] = {}
    known: dict[str, dict[str, Any]] = {}
    for item in allowlist:
        known[item["name"].casefold()] = {
            **item,
            "permission": permissions.get(str(item.get("xuid") or "")),
            "online": False,
            "source": "allowlist",
        }
    for line in journal.splitlines():
        match = CONNECT_RE.search(line)
        if match:
            name = match.group(1).strip()
            xuid = (match.group(2) or "").strip() or None
            record = known.get(name.casefold(), {"name": name, "xuid": xuid, "source": "journal"})
            if xuid:
                record["xuid"] = xuid
                record["permission"] = permissions.get(xuid)
            record["online"] = True
            online[name.casefold()] = record
            known[name.casefold()] = record
            continue
        match = DISCONNECT_RE.search(line)
        if match:
            name = match.group(1).strip()
            online.pop(name.casefold(), None)
            if name.casefold() in known:
                known[name.casefold()]["online"] = False
    for key, record in online.items():
        known[key] = record
    return {
        "known": sorted(known.values(), key=lambda item: str(item.get("name") or "").casefold()),
        "online": sorted(online.values(), key=lambda item: str(item.get("name") or "").casefold()),
        "allowlist": allowlist,
    }


def journal_snapshot(unit: str | None) -> str:
    if not unit:
        return ""
    code, output = run(["journalctl", "-u", unit, "-n", "600", "--no-pager", "-o", "cat"], 10)
    return output if code == 0 else ""


def version_from_journal(journal: str) -> str | None:
    matches = VERSION_RE.findall(journal)
    return matches[-1] if matches else None


def instance_snapshot(raw: dict[str, Any]) -> dict[str, Any]:
    instance_id = str(raw.get("id") or "").strip()
    working = Path(str(raw.get("working_directory"))) if raw.get("working_directory") else None
    service = str(raw.get("service") or "").strip() or None
    properties_path = working / "server.properties" if working else None
    properties = read_properties(properties_path)
    state, enabled = service_state(service)
    journal = journal_snapshot(service)
    players = parse_players(working, journal)
    port = int(properties.get("server-port") or raw.get("server_port") or 19132)
    port6 = int(properties.get("server-portv6") or raw.get("server_portv6") or 19133)
    return {
        **raw,
        "id": instance_id,
        "display_name": raw.get("display_name") or properties.get("server-name") or instance_id,
        "working_directory": str(working) if working else None,
        "service": service,
        "state": state,
        "enabled": enabled,
        "published": bool(raw.get("published", True)),
        "update_mode": str(raw.get("update_mode") or "manual"),
        "update_channel": str(raw.get("update_channel") or "stable"),
        "properties_path": str(properties_path) if properties_path else None,
        "properties": {key: properties.get(key) for key in EDITABLE_KEYS if key in properties},
        "server_port": port,
        "server_portv6": port6,
        "version": version_from_journal(journal) or raw.get("version"),
        "command_channel": (Path("/run/srv-control/minecraft") / f"{instance_id}.sock").is_socket() if instance_id else False,
        "players": players,
    }


def main() -> int:
    registry = load_registry()
    instances = [instance_snapshot(item) for item in registry.get("instances", []) if isinstance(item, dict)]
    payload = {
        "schema_version": 1,
        "checked_at": now(),
        "instances": instances,
        "available_ports": {"ipv4_start": 19132, "ipv6_start": 19133},
        "error": None,
    }
    write_json(OUTPUT, payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
