def _pxe_denied(mac: str, reason: str = 'This computer is not authorized for installation.') -> PlainTextResponse:
    safe_mac = str(mac or '').replace('\r', '').replace('\n', '')[:32]
    safe_reason = str(reason or 'Installation denied.').replace('\r', ' ').replace('\n', ' ')[:160]
    return PlainTextResponse(
        '#!ipxe\necho SRV PXE Server\n'
        f'echo {safe_reason}\n'
        f'echo MAC: {safe_mac}\n'
        'sleep 5\nexit\n',
        media_type='text/plain',
        headers={'Cache-Control': 'no-store'},
    )


def _pxe_firmware_compatible(firmware: str, buildarch: str, image_arch: str) -> bool:
    fw = str(firmware or '').strip().lower()
    boot_arch = str(buildarch or '').strip().lower()
    image = str(image_arch or '').strip().lower()
    aliases = {
        'amd64': 'x86_64', 'x86_64': 'x86_64',
        'i386': 'i386', 'x86': 'i386', 'ia32': 'i386',
        'arm64': 'arm64', 'aarch64': 'arm64',
        'arm32': 'arm32',
    }
    image = aliases.get(image, image)
    boot_arch = aliases.get(boot_arch, boot_arch)

    if fw in {'pcbios', 'bios'}:
        # The managed Legacy chain is x86 BIOS. ARM operating-system images are
        # UEFI-only and must be rejected before a destructive installer starts.
        return image in {'i386', 'x86_64'}
    if fw == 'efi':
        if image not in {'i386', 'x86_64', 'arm32', 'arm64'}:
            return False
        return not boot_arch or image == boot_arch
    # Older/custom iPXE builds may omit platform metadata. Do not regress those
    # clients; the published installer still performs its own firmware check.
    return True


@router.get('/pxe/boot.ipxe', response_class=PlainTextResponse)
def pxe_boot(request: Request, mac: str, platform: str = '', buildarch: str = ''):
    try:
        profile = peek_boot_profile(mac)
    except ValueError:
        profile = None
    if not profile:
        return _pxe_denied(mac)

    profile_id = int(profile['id'])
    boot_file = Path(f'/srv/pxe/profiles/{profile_id}/boot.ipxe')
    if not boot_file.is_file():
        # Do not consume one-time authorization on a publication/storage error.
        return _pxe_denied(mac, 'PXE profile is not published. Authorization retained; retry after server repair.')

    firmware = str(platform or '').strip().lower()
    arch = str(buildarch or '').strip().lower()
    image_arch = str(profile.get('architecture') or 'amd64').strip().lower()
    if not _pxe_firmware_compatible(firmware, arch, image_arch):
        return _pxe_denied(
            mac,
            f'Image architecture {image_arch} is not compatible with firmware {firmware or "unknown"}/{arch or "unknown"}.',
        )

    return PlainTextResponse(
        boot_file.read_text(encoding='utf-8'),
        media_type='text/plain',
        headers={'Cache-Control': 'no-store'},
    )


@router.get('/pxe/profile/{profile_id}/{token}/{artifact:path}')
def pxe_profile_artifact(profile_id: int, token: str, artifact: str):
    if not profile_boot_token_valid(profile_id, token):
        raise HTTPException(status_code=404, detail='PXE artifact not found')
    root = (Path('/srv/pxe/profiles') / str(profile_id)).resolve()
    target = (root / artifact).resolve()
    if target != root and root not in target.parents:
        raise HTTPException(status_code=404, detail='PXE artifact not found')
    if not target.is_file():
        raise HTTPException(status_code=404, detail='PXE artifact not found')
    return FileResponse(
        target,
        headers={'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff'},
    )


@router.get('/pxe/consume/{profile_id}/{token}', response_class=PlainTextResponse)
def pxe_consume(profile_id: int, token: str, mac: str):
    try:
        consumed = consume_boot_profile(profile_id, mac, token)
    except ValueError:
        consumed = False
    if not consumed:
        raise HTTPException(status_code=409, detail='PXE authorization is no longer valid')
    return PlainTextResponse('SRV PXE authorization consumed\n', headers={'Cache-Control': 'no-store'})


@router.post('/pxe/report/{profile_id}/{token}/{result}')
def pxe_report(profile_id: int, token: str, result: str):
    if result not in {'success', 'failed'} or not report_pxe(profile_id, token, result):
        raise HTTPException(status_code=404, detail='report token not found')
    return {'ok': True}


