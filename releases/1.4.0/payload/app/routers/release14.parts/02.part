@router.get('/pxe/boot.ipxe', response_class=PlainTextResponse)
def pxe_boot(request: Request, mac: str):
    try:
        profile = boot_profile(mac)
    except ValueError:
        profile = None
    if not profile:
        safe_mac = mac.replace('\r', '').replace('\n', '')[:32]
        return PlainTextResponse(
            '#!ipxe\necho SRV PXE Server\necho This computer is not authorized for installation.\n'
            f'echo MAC: {safe_mac}\nsleep 5\nexit\n', media_type='text/plain'
        )
    profile_id = int(profile['id'])
    boot_file = Path(f'/srv/pxe/profiles/{profile_id}/boot.ipxe')
    if not boot_file.is_file():
        return PlainTextResponse('#!ipxe\necho PXE profile is not published. Installation denied.\nsleep 5\nexit\n', media_type='text/plain')
    return PlainTextResponse(boot_file.read_text(encoding='utf-8'), media_type='text/plain')


@router.post('/pxe/report/{profile_id}/{token}/{result}')
def pxe_report(profile_id: int, token: str, result: str):
    if result not in {'success', 'failed'} or not report_pxe(profile_id, token, result):
        raise HTTPException(status_code=404, detail='report token not found')
    return {'ok': True}


