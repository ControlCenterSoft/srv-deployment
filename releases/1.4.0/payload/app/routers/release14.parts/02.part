@router.get('/api/v1/release14/backups/retention')
def retention_get(request: Request):
    require_session(request)
    return {'ok': True, 'data': backup_retention(), 'error': None}


@router.post('/api/v1/release14/backups/retention')
async def retention_set(request: Request):
    session = require_session(request)
    require_csrf(request, session)
    identity = session.get('identity')
    if not isinstance(identity, Identity) or not identity.is_admin:
        raise HTTPException(status_code=403, detail='server administrator permission required')
    payload = await _json(request)
    try:
        max_copies = int(payload.get('max_copies') or 0)
    except Exception as exc:
        raise HTTPException(status_code=400, detail='max_copies должен быть целым числом') from exc
    if max_copies < 0 or max_copies > 10000:
        raise HTTPException(status_code=400, detail='max_copies должен быть 0..10000; 0 = без ограничения')
    queued = enqueue('backup-retention-apply', identity.username, _client_ip(request), {'max_copies': max_copies})
    return {'ok': True, 'data': queued, 'error': None}


