async def pxe_profile_create(kind: str, request: Request):
    _, _ = _identity(request, 'pxe', 'write', csrf=True)
    try:
        profile = create_pxe_profile(kind, await _json(request))
    except (ValueError, TypeError) as exc:
        raise HTTPException(status_code=409 if 'уже находится' in str(exc) else 400, detail=str(exc)) from exc
    return {'ok': True, 'data': profile, 'error': None}


