@router.get('/api/v1/release14/services')
def release14_services(request: Request):
    session = require_session(request)
    identity = session.get('identity')
    if not isinstance(identity, Identity):
        raise HTTPException(status_code=401, detail='authentication required')
    visible = []
    for item in services_snapshot():
        module = str(item.get('permission_module') or '')
        if identity.is_admin or has_permission(identity, module, 'read'):
            row = dict(item)
            row['can_write'] = identity.is_admin or has_permission(identity, module, 'write')
            visible.append(row)
    return {'ok': True, 'data': {'items': visible, 'actions': action_history(10)}, 'error': None}


@router.post('/api/v1/release14/services/{service_id}/{operation}')
def release14_service_action(service_id: str, operation: str, request: Request):
    mapping = {
        ('dhcp-server', 'install'): ('network', 'service-install-dhcp'),
        ('dhcp-server', 'remove'): ('network', 'service-remove-dhcp'),
        ('pxe-server', 'install'): ('pxe', 'service-install-pxe14'),
        ('pxe-server', 'remove'): ('pxe', 'service-remove-pxe14'),
    }
    target = mapping.get((service_id, operation))
    if not target:
        raise HTTPException(status_code=404, detail='service operation not found')
    _, identity = _identity(request, target[0], 'write', csrf=True)
    return {'ok': True, 'data': enqueue(target[1], identity.username, _client_ip(request)), 'error': None}


@router.get('/api/v1/release14/dhcp')
def dhcp_get(request: Request):
    _identity(request, 'network', 'read')
    return {'ok': True, 'data': dhcp_snapshot(), 'error': None}


@router.put('/api/v1/release14/dhcp/config')
async def dhcp_config_put(request: Request):
    _, identity = _identity(request, 'network', 'write', csrf=True)
    try:
        config = save_dhcp_config(await _json(request))
