#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
from datetime import datetime, timezone
from urllib.parse import urlparse
import urllib.request


ACTION_DIR = Path("/var/lib/srv-control/system-actions")
RESULT_DIR = Path("/var/lib/srv-control/system-results")
GITHUB_CONFIG = Path("/var/lib/srv-control/github-update-config.json")
OS_CONFIG = Path("/var/lib/srv-control/os-update-config.json")
BACKUP_CONFIG = Path("/var/lib/srv-control/backup-config.json")
BACKUP_TIMER = Path("/etc/systemd/system/srv-control-backup.timer")
OS_TIMER = Path("/etc/systemd/system/srv-control-os-auto-update.timer")
BACKUP_WORKER = "/usr/local/libexec/srv-control-backup"
UPDATER_CONFIG = "/usr/local/sbin/srvcc-configure-auto-updates"
UPDATER = "/usr/local/sbin/srvcc-github-agent"
ADGUARD_MONITOR = "/usr/local/libexec/srv-control-adguard-monitor"
ADGUARD_INSTALLER = (
    "https://raw.githubusercontent.com/AdguardTeam/AdGuardVPNCLI/master/scripts/release/install.sh"
)
MINECRAFT_PROPERTIES = (
    Path("/opt/minecraft-bedrock/server.properties"),
    Path("/opt/minecraft/server.properties"),
    Path("/srv/minecraft/server.properties"),
    Path("/var/lib/minecraft/server.properties"),
)
MINECRAFT_SERVICES = (
    "minecraft-bedrock.service",
    "minecraft.service",
    "bedrock-server.service",
)
MINECRAFT_KEYS = {
    "server-name",
    "gamemode",
    "difficulty",
    "allow-cheats",
    "max-players",
    "server-port",
    "server-portv6",
    "online-mode",
    "allow-list",
    "view-distance",
    "tick-distance",
    "player-idle-timeout",
    "level-name",
}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def write_json(path: Path, payload: dict, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        json.dump(payload, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), mode)
        tmp = Path(handle.name)
    finally:
        handle.close()
    os.replace(tmp, path)


def read_json(path: Path, default: dict) -> dict:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
        return payload if isinstance(payload, dict) else dict(default)
    except Exception:
        return dict(default)


def write_result(request_id: str, payload: dict) -> None:
    RESULT_DIR.mkdir(parents=True, exist_ok=True)
    write_json(RESULT_DIR / f"{request_id}.json", payload, 0o644)


def run(command: list[str], *, input_text: str | None = None, timeout: int = 900) -> str:
    completed = subprocess.run(
        command,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
        env={**os.environ, "DEBIAN_FRONTEND": "noninteractive", "HOME": "/root"},
    )
    output = (completed.stdout or "")[-8000:]
    if completed.returncode != 0:
        raise RuntimeError(
            f"command failed ({completed.returncode}): {' '.join(command)}\n{output}"
        )
    return output


def backup_before_update(actor: str, reason: str) -> str | None:
    config = read_json(
        BACKUP_CONFIG,
        {"scheduled": False, "daily_time": "03:00", "backup_before_update": True},
    )
    if not bool(config.get("backup_before_update", True)):
        return None
    output = run([BACKUP_WORKER, "create", "--actor", actor, "--reason", reason], timeout=600)
    try:
        return str(json.loads(output.strip().splitlines()[-1]).get("id") or "") or None
    except Exception:
        return None


def validate_github_source(value: str) -> str:
    parsed = urlparse(value.strip())
    if parsed.scheme != "https" or parsed.hostname not in {"github.com", "www.github.com"}:
        raise RuntimeError("GitHub source must be an https://github.com repository URL")
    if not parsed.path or parsed.path.count("/") < 2:
        raise RuntimeError("invalid GitHub repository URL")
    return value.strip()


def configure_github(payload: dict) -> str:
    source = validate_github_source(str(payload.get("source") or ""))
    mode = str(payload.get("mode") or "").strip().lower()
    if mode not in {"manual", "automatic"}:
        raise RuntimeError("GitHub update mode must be manual or automatic")
    try:
        interval = int(payload.get("interval_minutes"))
    except Exception as exc:
        raise RuntimeError("GitHub update interval must be an integer") from exc
    if interval < 1 or interval > 1440:
        raise RuntimeError("GitHub update interval must be between 1 and 1440 minutes")
    return run(
        [UPDATER_CONFIG, "--repo", source, "--mode", mode, "--interval-minutes", str(interval), "--no-check-now"],
        timeout=120,
    )


def github_operation(operation: str, actor: str) -> str:
    if operation not in {"check", "apply"}:
        raise RuntimeError("invalid GitHub updater operation")
    return run([UPDATER, operation, "--actor", actor], timeout=1200)


def configure_os_updates(payload: dict) -> str:
    mode = str(payload.get("mode") or "").strip().lower()
    if mode not in {"manual", "automatic"}:
        raise RuntimeError("OS update mode must be manual or automatic")
    try:
        hours = int(payload.get("interval_hours"))
    except Exception as exc:
        raise RuntimeError("OS update interval must be an integer") from exc
    if hours < 1 or hours > 24:
        raise RuntimeError("OS update interval must be between 1 and 24 hours")

    write_json(OS_CONFIG, {"schema_version": 1, "mode": mode, "interval_hours": hours})
    OS_TIMER.write_text(
        "[Unit]\nDescription=SRV Control Center automatic OS/package update schedule\n\n"
        "[Timer]\nOnBootSec=10min\n"
        f"OnUnitActiveSec={hours}h\nPersistent=true\nAccuracySec=5min\n"
        "Unit=srv-control-os-auto-update.service\n\n[Install]\nWantedBy=timers.target\n",
        encoding="utf-8",
    )
    os.chmod(OS_TIMER, 0o644)
    run(["systemctl", "daemon-reload"], timeout=30)
    if mode == "automatic":
        run(["systemctl", "enable", "--now", "srv-control-os-auto-update.timer"], timeout=30)
    else:
        subprocess.run(["systemctl", "disable", "--now", "srv-control-os-auto-update.timer"], check=False)
    return f"OS update mode={mode} interval_hours={hours}"


def manual_os_update(actor: str) -> str:
    config = read_json(OS_CONFIG, {"mode": "manual", "interval_hours": 24})
    if config.get("mode") != "manual":
        raise RuntimeError("manual OS update is available only in manual mode")
    active = subprocess.run(
        ["systemctl", "is-active", "--quiet", "srv-control-os-update.service"], check=False
    ).returncode == 0
    if active:
        raise RuntimeError("OS update job is already running")
    backup_id = backup_before_update(actor, "pre-os-update")
    run(["systemctl", "start", "srv-control-os-update.service"], timeout=20)
    return "OS update job started" + (f"; backup={backup_id}" if backup_id else "")


def configure_backup(payload: dict) -> str:
    scheduled = bool(payload.get("scheduled"))
    before_update = bool(payload.get("backup_before_update"))
    daily_time = str(payload.get("daily_time") or "").strip()
    parts = daily_time.split(":")
    if len(parts) != 2 or not all(part.isdigit() for part in parts):
        raise RuntimeError("backup time must use HH:MM")
    hour, minute = map(int, parts)
    if not (0 <= hour <= 23 and 0 <= minute <= 59):
        raise RuntimeError("backup time is outside 00:00..23:59")
    daily_time = f"{hour:02d}:{minute:02d}"
    write_json(
        BACKUP_CONFIG,
        {"schema_version": 1, "scheduled": scheduled, "daily_time": daily_time, "backup_before_update": before_update},
    )
    BACKUP_TIMER.write_text(
        "[Unit]\nDescription=SRV Control Center backup schedule\n\n"
        f"[Timer]\nOnCalendar=*-*-* {daily_time}:00\nPersistent=true\nAccuracySec=1min\n"
        "Unit=srv-control-backup.service\n\n[Install]\nWantedBy=timers.target\n",
        encoding="utf-8",
    )
    os.chmod(BACKUP_TIMER, 0o644)
    run(["systemctl", "daemon-reload"], timeout=30)
    if scheduled:
        run(["systemctl", "enable", "--now", "srv-control-backup.timer"], timeout=30)
    else:
        subprocess.run(["systemctl", "disable", "--now", "srv-control-backup.timer"], check=False)
    return f"backup scheduled={scheduled} daily_time={daily_time} before_update={before_update}"


def backup_action(action: str, payload: dict, actor: str) -> str:
    if action == "backup-create":
        return run([BACKUP_WORKER, "create", "--actor", actor, "--reason", "manual"], timeout=600)
    backup_id = str(payload.get("backup_id") or "").strip()
    if not backup_id:
        raise RuntimeError("backup_id is required")
    if action == "backup-delete":
        return run([BACKUP_WORKER, "delete", backup_id], timeout=60)
    if action == "backup-restore":
        return run([BACKUP_WORKER, "restore", backup_id, "--actor", actor], timeout=1200)
    raise RuntimeError("unknown backup action")


def download_adguard_installer() -> str:
    request = urllib.request.Request(ADGUARD_INSTALLER, headers={"User-Agent": "SRV-Control-Center/1.2"})
    with urllib.request.urlopen(request, timeout=30) as response:
        data = response.read()
    if not data.startswith(b"#!/"):
        raise RuntimeError("unexpected AdGuard VPN installer payload")
    handle = tempfile.NamedTemporaryFile(prefix="adguardvpn-install.", suffix=".sh", delete=False)
    try:
        handle.write(data)
        handle.flush()
        return handle.name
    finally:
        handle.close()


def manage_adguard(uninstall: bool) -> str:
    script = download_adguard_installer()
    try:
        args = ["sh", script, "-v"]
        if uninstall:
            args.append("-u")
        return run(args, input_text="y\ny\ny\n", timeout=900)
    finally:
        try:
            os.unlink(script)
        except FileNotFoundError:
            pass


def adguard_binary() -> str:
    binary = shutil.which("adguardvpn-cli")
    if binary:
        return binary
    path = Path("/opt/adguardvpn_cli/adguardvpn-cli")
    if path.exists():
        return str(path)
    raise RuntimeError("AdGuard VPN CLI is not installed")


def refresh_adguard() -> None:
    if Path(ADGUARD_MONITOR).exists():
        run([ADGUARD_MONITOR], timeout=30)


def configure_adguard(payload: dict) -> str:
    binary = adguard_binary()
    mode = str(payload.get("mode") or "SOCKS").strip().upper()
    if mode != "SOCKS":
        raise RuntimeError("only SOCKS mode is managed by Control Center")
    host = str(payload.get("socks_host") or "127.0.0.1").strip()
    if not host or len(host) > 255 or any(ch in host for ch in "\r\n\x00"):
        raise RuntimeError("invalid SOCKS host")
    try:
        port = int(payload.get("socks_port", 1080))
    except Exception as exc:
        raise RuntimeError("SOCKS port must be an integer") from exc
    if port < 1 or port > 65535:
        raise RuntimeError("SOCKS port must be between 1 and 65535")
    run([binary, "config", "set-mode", "SOCKS"], timeout=30)
    run([binary, "config", "set-socks-host", host], timeout=30)
    run([binary, "config", "set-socks-port", str(port)], timeout=30)
    refresh_adguard()
    return f"AdGuard VPN mode=SOCKS socks={host}:{port}"


def connect_adguard_socks() -> str:
    binary = adguard_binary()
    run([binary, "config", "set-mode", "SOCKS"], timeout=30)
    output = run([binary, "connect", "--fastest", "--yes", "--ipv4only"], timeout=120)
    refresh_adguard()
    return output[-3000:] or "connected"


def disconnect_adguard() -> str:
    output = run([adguard_binary(), "disconnect"], timeout=60)
    refresh_adguard()
    return output[-3000:] or "disconnected"


def update_adguard() -> str:
    output = run([adguard_binary(), "update", "--yes"], timeout=900)
    refresh_adguard()
    return output[-3000:] or "updated"


def install_pxe() -> str:
    run(["apt-get", "update", "-y"], timeout=300)
    output = run(["apt-get", "install", "-y", "--no-install-recommends", "tftpd-hpa", "ipxe"], timeout=900)
    Path("/srv/tftp").mkdir(parents=True, exist_ok=True)
    defaults = Path("/etc/default/tftpd-hpa")
    if not defaults.exists():
        defaults.write_text(
            'TFTP_USERNAME="tftp"\nTFTP_DIRECTORY="/srv/tftp"\nTFTP_ADDRESS=":69"\nTFTP_OPTIONS="--secure"\n',
            encoding="utf-8",
        )
    subprocess.run(["systemctl", "enable", "--now", "tftpd-hpa.service"], check=False)
    return output[-3000:] or "PXE server installed"


def remove_pxe() -> str:
    subprocess.run(["systemctl", "disable", "--now", "tftpd-hpa.service"], check=False)
    output = run(["apt-get", "remove", "-y", "tftpd-hpa"], timeout=900)
    return output[-3000:] or "PXE server removed; /srv/tftp data preserved"


def minecraft_service() -> str:
    for unit in MINECRAFT_SERVICES:
        result = subprocess.run(
            ["systemctl", "show", unit, "-p", "LoadState", "--value"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if result.returncode == 0 and result.stdout.strip() not in {"", "not-found"}:
            return unit
    raise RuntimeError("Minecraft Bedrock systemd service not found")


def minecraft_properties() -> Path:
    for path in MINECRAFT_PROPERTIES:
        if path.is_file():
            return path
    try:
        unit = minecraft_service()
        result = subprocess.run(
            ["systemctl", "show", unit, "-p", "WorkingDirectory", "--value"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if result.returncode == 0 and result.stdout.strip():
            candidate = Path(result.stdout.strip()) / "server.properties"
            if candidate.is_file():
                return candidate
    except Exception:
        pass
    raise RuntimeError("Minecraft server.properties not found")


def _minecraft_value(key: str, value: object) -> str:
    raw = str(value).strip()
    if any(ch in raw for ch in "\r\n\x00"):
        raise RuntimeError(f"invalid Minecraft value for {key}")
    if key in {"allow-cheats", "online-mode", "allow-list"}:
        normalized = raw.lower()
        if normalized in {"1", "yes", "on"}:
            normalized = "true"
        if normalized in {"0", "no", "off"}:
            normalized = "false"
        if normalized not in {"true", "false"}:
            raise RuntimeError(f"{key} must be true or false")
        return normalized
    if key == "gamemode" and raw not in {"survival", "creative", "adventure"}:
        raise RuntimeError("invalid gamemode")
    if key == "difficulty" and raw not in {"peaceful", "easy", "normal", "hard"}:
        raise RuntimeError("invalid difficulty")
    ranges = {
        "max-players": (1, 1000),
        "server-port": (1, 65535),
        "server-portv6": (1, 65535),
        "view-distance": (5, 64),
        "tick-distance": (4, 12),
        "player-idle-timeout": (0, 100000),
    }
    if key in ranges:
        try:
            number = int(raw)
        except Exception as exc:
            raise RuntimeError(f"{key} must be an integer") from exc
        low, high = ranges[key]
        if number < low or number > high:
            raise RuntimeError(f"{key} must be between {low} and {high}")
        return str(number)
    if key in {"server-name", "level-name"}:
        if not raw or len(raw) > 80:
            raise RuntimeError(f"invalid {key}")
    return raw


def configure_minecraft(payload: dict) -> str:
    path = minecraft_properties()
    values = payload.get("properties") if isinstance(payload.get("properties"), dict) else payload
    updates = {
        str(key): _minecraft_value(str(key), value)
        for key, value in values.items()
        if str(key) in MINECRAFT_KEYS
    }
    if not updates:
        raise RuntimeError("no supported Minecraft settings supplied")
    original = path.read_text(encoding="utf-8", errors="replace")
    lines = original.splitlines()
    found: set[str] = set()
    output: list[str] = []
    for line in lines:
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and "=" in line:
            key = line.split("=", 1)[0].strip()
            if key in updates:
                output.append(f"{key}={updates[key]}")
                found.add(key)
                continue
        output.append(line)
    for key, value in updates.items():
        if key not in found:
            output.append(f"{key}={value}")

    stat = path.stat()
    backup = path.with_suffix(path.suffix + ".srvcc.bak")
    shutil.copy2(path, backup)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        handle.write("\n".join(output).rstrip() + "\n")
        handle.flush()
        os.fchmod(handle.fileno(), stat.st_mode & 0o777)
        tmp = Path(handle.name)
    finally:
        handle.close()
    os.chown(tmp, stat.st_uid, stat.st_gid)
    os.replace(tmp, path)

    unit = minecraft_service()
    if subprocess.run(["systemctl", "is-active", "--quiet", unit], check=False).returncode == 0:
        run(["systemctl", "restart", unit], timeout=60)
    return f"Minecraft settings saved: {', '.join(sorted(updates))}"


def control_minecraft(operation: str) -> str:
    if operation not in {"start", "stop", "restart"}:
        raise RuntimeError("invalid Minecraft operation")
    unit = minecraft_service()
    run(["systemctl", operation, unit], timeout=60)
    return f"Minecraft {operation}: {unit}"


def handle(request: dict) -> dict:
    request_id = str(request.get("request_id") or "")
    action = str(request.get("action") or "")
    actor = str(request.get("actor") or "unknown")
    payload = request.get("payload") if isinstance(request.get("payload"), dict) else {}
    result = {
        "request_id": request_id,
        "action": action,
        "actor": actor,
        "started_at": now(),
        "finished_at": None,
        "result": "running",
        "detail": None,
    }
    write_result(request_id, result)
    try:
        if action == "reboot":
            run(["systemd-run", "--unit=srv-control-reboot", "--on-active=3s", "/usr/bin/systemctl", "reboot"], timeout=20)
            result["detail"] = "reboot scheduled"
        elif action == "github-update-config":
            result["detail"] = configure_github(payload)
        elif action == "github-check":
            result["detail"] = github_operation("check", actor)
        elif action == "github-update":
            result["detail"] = github_operation("apply", actor)
        elif action == "os-update-config":
            result["detail"] = configure_os_updates(payload)
        elif action == "os-update":
            result["detail"] = manual_os_update(actor)
        elif action == "backup-config":
            result["detail"] = configure_backup(payload)
        elif action in {"backup-create", "backup-delete", "backup-restore"}:
            result["detail"] = backup_action(action, payload, actor)
        elif action == "service-install-adguard-vpn":
            try:
                adguard_binary()
            except RuntimeError:
                manage_adguard(False)
            refresh_adguard()
            result["detail"] = "AdGuard VPN installed"
        elif action == "service-remove-adguard-vpn":
            try:
                adguard_binary()
            except RuntimeError:
                pass
            else:
                manage_adguard(True)
            refresh_adguard()
            result["detail"] = "AdGuard VPN removed"
        elif action == "service-refresh-adguard-vpn":
            refresh_adguard()
            result["detail"] = "AdGuard VPN status refreshed"
        elif action == "service-connect-adguard-vpn-socks":
            result["detail"] = connect_adguard_socks()
        elif action == "service-disconnect-adguard-vpn":
            result["detail"] = disconnect_adguard()
        elif action == "service-update-adguard-vpn":
            result["detail"] = update_adguard()
        elif action == "service-configure-adguard-vpn":
            result["detail"] = configure_adguard(payload)
        elif action == "service-install-pxe":
            result["detail"] = install_pxe()
        elif action == "service-remove-pxe":
            result["detail"] = remove_pxe()
        elif action == "minecraft-configure":
            result["detail"] = configure_minecraft(payload)
        elif action == "minecraft-start":
            result["detail"] = control_minecraft("start")
        elif action == "minecraft-stop":
            result["detail"] = control_minecraft("stop")
        elif action == "minecraft-restart":
            result["detail"] = control_minecraft("restart")
        else:
            raise RuntimeError("unsupported system action")
        result["result"] = "success"
    except Exception as exc:
        result["result"] = "failed"
        result["detail"] = str(exc)[-8000:]
        try:
            refresh_adguard()
        except Exception:
            pass
    result["finished_at"] = now()
    write_result(request_id, result)
    return result


def main() -> int:
    ACTION_DIR.mkdir(parents=True, exist_ok=True)
    requests = sorted(ACTION_DIR.glob("*.json"), key=lambda path: path.stat().st_mtime)
    if not requests:
        return 0
    path = requests[0]
    try:
        request = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(request, dict):
            raise ValueError("request must be a JSON object")
        request_id = str(request.get("request_id") or path.stem)
        if request_id != path.stem:
            raise ValueError("request id does not match filename")
        handle(request)
    except Exception as exc:
        write_result(
            path.stem,
            {
                "request_id": path.stem,
                "action": None,
                "started_at": now(),
                "finished_at": now(),
                "result": "failed",
                "detail": str(exc),
            },
        )
    finally:
        path.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
