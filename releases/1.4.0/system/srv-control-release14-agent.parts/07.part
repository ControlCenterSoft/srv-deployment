def network_rollback(token: str) -> str:
    pending=read_json(NETWORK_PENDING,{})
    if not pending or pending.get('token')!=token: return 'no matching network rollback pending'
    backup=Path(str(pending.get('backup') or '')); absent=Path(str(pending.get('absent') or '')); previous=pending.get('previous_config') if isinstance(pending.get('previous_config'),dict) else {}
    if backup.is_file(): shutil.copy2(backup,NETPLAN_FILE)
    elif absent.is_file(): NETPLAN_FILE.unlink(missing_ok=True)
    run(['netplan','generate'],timeout=60); run(['netplan','apply'],timeout=120)
    try: configure_special_wan(previous)
    except Exception: stop_special_wan()
    try: configure_wifi(previous)
    except Exception: _stop_wifi_services()
    write_json(NETWORK_CONFIG,previous,0o640); NETWORK_PENDING.unlink(missing_ok=True)
    return f'network rollback completed token={token}'


def write_result(req: dict, result: str, detail: str) -> None:
    RESULT_DIR.mkdir(parents=True,exist_ok=True); write_json(RESULT_DIR/f"{req.get('request_id','unknown')}.json",{
        'request_id':req.get('request_id'),'action':req.get('action'),'actor':req.get('actor'),'started_at':req.get('_started_at'),'finished_at':now(),'result':result,'detail':detail[-8000:]},0o640)


def handle(req: dict) -> None:
    req['_started_at']=now(); action=str(req.get('action') or ''); payload=req.get('payload') if isinstance(req.get('payload'),dict) else {}
    try:
        funcs={
            'service-install-dhcp':lambda:install_dhcp(),'service-remove-dhcp':lambda:remove_dhcp(),'dhcp-apply':lambda:apply_dhcp(),
            'service-install-pxe14':lambda:install_pxe(),'service-remove-pxe14':lambda:remove_pxe(),'pxe-image-prepare':lambda:prepare_image(payload),'pxe-profile-publish':lambda:publish_profile(payload),
            'backup-retention-apply':lambda:apply_backup_retention(payload),'network-apply':lambda:network_apply(payload),'network-confirm':lambda:network_confirm(),
        }
        if action not in funcs: raise RuntimeError('unsupported release14 action')
        write_result(req,'success',str(funcs[action]()))
    except Exception as exc:
        write_result(req,'failed',str(exc)); raise


def process_queue() -> int:
    ACTION_DIR.mkdir(parents=True,exist_ok=True)
    while True:
        paths=sorted(ACTION_DIR.glob('*.json'),key=lambda p:p.stat().st_mtime)
        if not paths:return 0
        path=paths[0]
        try:
            req=read_json(path,{})
            if not isinstance(req,dict) or req.get('request_id')!=path.stem: raise RuntimeError('invalid action request')
            handle(req)
        except Exception:
            pass
        finally:path.unlink(missing_ok=True)


def main() -> int:
    ap=argparse.ArgumentParser();ap.add_argument('--prune-backups',action='store_true');ap.add_argument('--network-rollback');args=ap.parse_args()
    if args.prune_backups: print(prune_backups());return 0
    if args.network_rollback: print(network_rollback(args.network_rollback));return 0
    return process_queue()

if __name__=='__main__': raise SystemExit(main())
