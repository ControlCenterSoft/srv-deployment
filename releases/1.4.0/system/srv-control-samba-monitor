#!/usr/bin/env python3
from __future__ import annotations

import base64
from datetime import datetime, timezone
import grp
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import time
from typing import Any


OUTPUT = Path("/var/lib/srv-control/samba-domain-status.json")
APP_GROUP = "srv-control"
PROTECTED_USERS = {"administrator", "guest", "krbtgt"}
PROTECTED_GROUPS = {
    "administrators",
    "domain admins",
    "domain computers",
    "domain controllers",
    "domain guests",
    "domain users",
    "enterprise admins",
    "group policy creator owners",
    "schema admins",
}
USER_ATTRIBUTES = (
    "distinguishedName",
    "sAMAccountName",
    "givenName",
    "sn",
    "displayName",
    "mail",
    "telephoneNumber",
    "homeDrive",
    "homeDirectory",
    "profilePath",
    "scriptPath",
    "description",
    "userAccountControl",
    "accountExpires",
    "primaryGroupID",
    "whenCreated",
    "lastLogonTimestamp",
    "lockoutTime",
)
DIRECTORY_ATTRIBUTES = (
    "objectClass",
    *USER_ATTRIBUTES,
    "member",
    "objectSid",
)
DIRECTORY_FILTER = (
    "(|"
    "(&(objectClass=user)(!(objectClass=computer))(sAMAccountName=*))"
    "(&(objectClass=group)(sAMAccountName=*))"
    ")"
)


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def run(command: list[str], timeout: int = 20) -> tuple[int, str]:
    try:
        completed = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
            env={**os.environ, "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8"},
        )
    except Exception as exc:
        return 1, str(exc)
    return completed.returncode, (completed.stdout or "").strip()


def scalar(command: list[str], default: str | None = None) -> str | None:
    code, output = run(command)
    if code != 0 or not output:
        return default
    return output.splitlines()[-1].strip() or default


def systemd_state() -> tuple[str | None, str]:
    for unit in ("samba-ad-dc.service", "samba.service"):
        code, loaded = run(["systemctl", "show", unit, "-p", "LoadState", "--value"], 5)
        if code == 0 and loaded and loaded != "not-found":
            _, state = run(["systemctl", "is-active", unit], 5)
            return unit, state or "inactive"
    return None, "not-installed"


def testparm_value(name: str) -> str | None:
    value = scalar(["testparm", "-s", "--parameter-name", name], None)
    if value is None:
        return None
    return value.strip()


def parse_domain_sid() -> str | None:
    code, output = run(["net", "getdomainsid"], 10)
    if code != 0:
        return None
    matches = re.findall(r"S-1-(?:\d+-)+\d+", output)
    return matches[0] if matches else None


def parse_domain_levels() -> dict[str, str | None]:
    code, output = run(["samba-tool", "domain", "level", "show"], 12)
    result: dict[str, str | None] = {
        "forest": None,
        "domain": None,
        "dc": None,
    }
    if code != 0:
        return result
    for line in output.splitlines():
        key, sep, value = line.partition(":")
        if not sep:
            continue
        normalized = key.strip().casefold()
        value = value.strip()
        if normalized.startswith("forest function"):
            result["forest"] = value
        elif normalized.startswith("domain function"):
            result["domain"] = value
        elif normalized.startswith("lowest function") or normalized.startswith("dc function"):
            result["dc"] = value
    return result


def parse_password_policy() -> dict[str, Any]:
    code, output = run(["samba-tool", "domain", "passwordsettings", "show"], 12)
    if code != 0:
        return {"error": output[-1200:] or "unable to read password policy"}
    mapping = {
        "password complexity": "complexity",
        "store plaintext passwords": "store_plaintext",
        "password history length": "history_length",
        "minimum password length": "min_length",
        "minimum password age (days)": "min_age_days",
        "maximum password age (days)": "max_age_days",
        "account lockout duration (mins)": "lockout_duration_minutes",
        "account lockout threshold (attempts)": "lockout_threshold",
        "reset account lockout after (mins)": "lockout_reset_minutes",
    }
    result: dict[str, Any] = {}
    for line in output.splitlines():
        key, sep, value = line.partition(":")
        if not sep:
            continue
        target = mapping.get(key.strip().casefold())
        if not target:
            continue
        raw = value.strip()
        if raw.casefold() in {"on", "off"}:
            result[target] = raw.casefold() == "on"
            continue
        try:
            result[target] = int(raw)
        except ValueError:
            result[target] = raw
    return result


def _unfold_ldif(text: str) -> list[str]:
    result: list[str] = []
    for raw in text.splitlines():
        if raw.startswith(" ") and result:
            result[-1] += raw[1:]
        else:
            result.append(raw)
    return result


def parse_ldif(text: str) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for line in _unfold_ldif(text):
        if not line or line.startswith("#"):
            continue
        if ":: " in line:
            key, raw = line.split(":: ", 1)
            try:
                value = base64.b64decode(raw).decode("utf-8", errors="replace")
            except Exception:
                value = ""
        elif ": " in line:
            key, value = line.split(": ", 1)
        elif line.endswith(":"):
            key, value = line[:-1], ""
        else:
            continue
        key = key.strip()
        if key in result:
            existing = result[key]
            if isinstance(existing, list):
                existing.append(value)
            else:
                result[key] = [existing, value]
        else:
            result[key] = value
    return result


def parse_ldif_records(text: str) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    current: list[str] = []
    for line in _unfold_ldif(text):
        if not line:
            if current:
                record = parse_ldif("\n".join(current))
                if record:
                    records.append(record)
                current = []
            continue
        current.append(line)
    if current:
        record = parse_ldif("\n".join(current))
        if record:
            records.append(record)
    return records


def values(record: dict[str, Any], key: str) -> list[str]:
    raw = record.get(key)
    if raw is None:
        return []
    if isinstance(raw, list):
        return [str(item) for item in raw if str(item)]
    value = str(raw)
    return [value] if value else []


def normalized_dn(value: Any) -> str:
    return str(value or "").strip().casefold()


def integer(record: dict[str, Any], key: str, default: int = 0) -> int:
    try:
        return int(str(record.get(key) or default))
    except (TypeError, ValueError):
        return default


def samdb_location() -> Path | None:
    private_dir = testparm_value("private dir") or "/var/lib/samba/private"
    path = Path(private_dir) / "sam.ldb"
    return path if path.is_file() else None


def naming_context(samdb: Path) -> str | None:
    code, output = run(
        ["ldbsearch", "-H", str(samdb), "-b", "", "-s", "base", "defaultNamingContext"],
        8,
    )
    if code != 0:
        return None
    value = parse_ldif(output).get("defaultNamingContext")
    return str(value) if value else None


def directory_snapshot() -> tuple[list[dict[str, Any]], list[dict[str, Any]], str | None]:
    """Read users, groups and memberships with one local SamDB query.

    Release 1.3.0 originally spawned two samba-tool processes per user and one
    per group. A normal AD therefore required dozens of Python/Samba process
    startups every refresh. Local ldbsearch returns the same directory data in
    one read transaction; memberships are reconstructed from group member DNs
    and primaryGroupID.
    """
    samdb = samdb_location()
    if samdb is None:
        return [], [], "Samba SamDB not found"
    base_dn = naming_context(samdb)
    if not base_dn:
        return [], [], "Samba default naming context not found"

    command = [
        "ldbsearch",
        "-H",
        str(samdb),
        "-b",
        base_dn,
        "-s",
        "sub",
        DIRECTORY_FILTER,
        *DIRECTORY_ATTRIBUTES,
    ]
    code, output = run(command, 15)
    if code != 0:
        return [], [], (output[-1600:] or "unable to read Samba directory")

    user_records: list[dict[str, Any]] = []
    group_records: list[dict[str, Any]] = []
    for record in parse_ldif_records(output):
        classes = {item.casefold() for item in values(record, "objectClass")}
        sam = str(record.get("sAMAccountName") or "").strip()
        if not sam:
            continue
        if "computer" in classes:
            continue
        if "group" in classes:
            group_records.append(record)
        elif "user" in classes:
            user_records.append(record)

    users_by_dn: dict[str, str] = {}
    groups_by_dn: dict[str, str] = {}
    group_rids: dict[int, str] = {}
    for record in user_records:
        sam = str(record.get("sAMAccountName") or "").strip()
        dn = normalized_dn(record.get("distinguishedName") or record.get("dn"))
        if dn:
            users_by_dn[dn] = sam
    for record in group_records:
        name = str(record.get("sAMAccountName") or "").strip()
        dn = normalized_dn(record.get("distinguishedName") or record.get("dn"))
        if dn:
            groups_by_dn[dn] = name
        sid = str(record.get("objectSid") or "")
        match = re.search(r"-(\d+)$", sid)
        if match:
            group_rids[int(match.group(1))] = name

    direct_group_members: dict[str, list[str]] = {}
    direct_user_groups: dict[str, set[str]] = {
        str(record.get("sAMAccountName") or "").strip(): set() for record in user_records
    }
    for record in group_records:
        group_name = str(record.get("sAMAccountName") or "").strip()
        members: list[str] = []
        for member_dn in values(record, "member"):
            key = normalized_dn(member_dn)
            principal = users_by_dn.get(key) or groups_by_dn.get(key)
            if not principal:
                continue
            members.append(principal)
            user_name = users_by_dn.get(key)
            if user_name:
                direct_user_groups.setdefault(user_name, set()).add(group_name)
        direct_group_members[group_name] = sorted(set(members), key=str.casefold)

    # primaryGroupID (normally Domain Users / RID 513) is not represented in
    # the group's member attribute, so add it explicitly.
    for record in user_records:
        sam = str(record.get("sAMAccountName") or "").strip()
        primary_name = group_rids.get(integer(record, "primaryGroupID"))
        if primary_name:
            direct_user_groups.setdefault(sam, set()).add(primary_name)

    # Preserve the effective-group behaviour of `samba-tool user getgroups` by
    # propagating membership through nested groups.
    changed = True
    while changed:
        changed = False
        for username, memberships in direct_user_groups.items():
            inherited: set[str] = set()
            for parent, members in direct_group_members.items():
                if any(member in memberships for member in members if member in direct_group_members):
                    inherited.add(parent)
            before = len(memberships)
            memberships.update(inherited)
            changed = changed or len(memberships) != before

    users: list[dict[str, Any]] = []
    for record in user_records:
        sam = str(record.get("sAMAccountName") or "").strip()
        uac = integer(record, "userAccountControl")
        lockout = integer(record, "lockoutTime")
        users.append(
            {
                "username": sam,
                "dn": record.get("distinguishedName") or record.get("dn"),
                "given_name": record.get("givenName"),
                "surname": record.get("sn"),
                "display_name": record.get("displayName"),
                "email": record.get("mail"),
                "phone": record.get("telephoneNumber"),
                "home_drive": record.get("homeDrive"),
                "home_directory": record.get("homeDirectory"),
                "profile_path": record.get("profilePath"),
                "script_path": record.get("scriptPath"),
                "description": record.get("description"),
                "account_expires": record.get("accountExpires"),
                "primary_group_id": record.get("primaryGroupID"),
                "created_at": record.get("whenCreated"),
                "last_logon_timestamp": record.get("lastLogonTimestamp"),
                "enabled": not bool(uac & 0x2),
                "locked": lockout > 0,
                "groups": sorted(direct_user_groups.get(sam, set()), key=str.casefold),
                "protected": sam.casefold() in PROTECTED_USERS,
            }
        )

    groups = [
        {
            "name": str(record.get("sAMAccountName") or "").strip(),
            "members": direct_group_members.get(str(record.get("sAMAccountName") or "").strip(), []),
            "protected": str(record.get("sAMAccountName") or "").strip().casefold() in PROTECTED_GROUPS,
        }
        for record in group_records
    ]
    users.sort(key=lambda item: str(item.get("username") or "").casefold())
    groups.sort(key=lambda item: str(item.get("name") or "").casefold())
    return users, groups, None


def replication_snapshot() -> dict[str, Any]:
    code, output = run(["samba-tool", "drs", "showrepl", "--summary"], 12)
    if code != 0:
        return {"available": False, "healthy": None, "summary": output[-2000:] or None}
    lower = output.casefold()
    unhealthy = any(token in lower for token in ("fail", "error", "unavailable"))
    return {"available": True, "healthy": not unhealthy, "summary": output[-4000:]}


def write_json(payload: dict[str, Any]) -> None:
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=OUTPUT.parent,
        prefix=OUTPUT.name + ".tmp.",
        delete=False,
    )
    try:
        json.dump(payload, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), 0o640)
        tmp = Path(handle.name)
    finally:
        handle.close()
    try:
        gid = grp.getgrnam(APP_GROUP).gr_gid
        os.chown(tmp, 0, gid)
    except Exception:
        pass
    os.replace(tmp, OUTPUT)


def main() -> int:
    started = time.monotonic()
    samba_tool = shutil.which("samba-tool")
    samba_binary = shutil.which("samba")
    unit, state = systemd_state()
    installed = bool(samba_tool and samba_binary)
    payload: dict[str, Any] = {
        "schema_version": 2,
        "installed": installed,
        "state": state,
        "checked_at": now(),
        "collection_ms": None,
        "directory_source": None,
        "service": unit,
        "version": scalar(["samba", "--version"], None) if samba_binary else None,
        "domain": {},
        "password_policy": {},
        "users": [],
        "groups": [],
        "replication": {},
        "error": None,
    }
    if installed:
        payload["domain"] = {
            "realm": testparm_value("realm"),
            "netbios_domain": testparm_value("workgroup"),
            "dc_name": testparm_value("netbios name"),
            "server_role": testparm_value("server role"),
            "sid": parse_domain_sid(),
            "functional_levels": parse_domain_levels(),
        }
        payload["password_policy"] = parse_password_policy()
        users, groups, directory_error = directory_snapshot()
        payload["users"] = users
        payload["groups"] = groups
        payload["directory_source"] = "local-samdb-bulk"
        if directory_error:
            payload["error"] = directory_error
        payload["replication"] = replication_snapshot()
    payload["collection_ms"] = int((time.monotonic() - started) * 1000)
    write_json(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
