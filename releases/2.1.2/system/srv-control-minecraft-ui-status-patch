#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import re
import sys

target = Path(sys.argv[1] if len(sys.argv) > 1 else '/opt/srv-control/templates/minecraft.html')
if not target.is_file():
    raise SystemExit(f'Minecraft template is missing: {target}')

text = target.read_text(encoding='utf-8')
script = '<script src="/static/js/minecraft-status-2.1.2.js?v=2.1.2"></script>'
if script in text:
    print('MINECRAFT STATUS UI PATCH: already present')
    raise SystemExit(0)

pattern = re.compile(r'(<script\s+src="/static/js/minecraft\.js\?[^\"]+"\s*></script>)')
match = pattern.search(text)
if match:
    text = text[:match.end()] + '\n' + script + text[match.end():]
elif '</body>' in text:
    text = text.replace('</body>', script + '\n</body>', 1)
else:
    raise SystemExit('Minecraft template has no insertion point')

tmp = target.with_name('.' + target.name + '.2.1.2.tmp')
tmp.write_text(text, encoding='utf-8')
tmp.chmod(target.stat().st_mode & 0o777)
tmp.replace(target)
print('MINECRAFT STATUS UI PATCH: installed')
