#!/usr/bin/env python3
from __future__ import annotations

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

ROLE = Path(sys.argv[0]).name
UNIT = 'srv-control-minecraft-bedrock.service'
DELEGATE_ROOT = Path('/usr/local/libexec/srv-control-minecraft-2.1.1')
VALID_ROLES = {
    'srv-control-minecraft',
    'srv-control-minecraft-worlds',
    'srv-control-minecraft-players',
    'srv-control-minecraft-restore',
    'srv-control-minecraft-live',
}


def run(command: list[str], *, timeout: int = 1800, check: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=check,
    )


def emit(payload: dict, code: int = 0) -> int:
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return code


def delegate_path() -> Path:
    if ROLE not in VALID_ROLES:
        raise RuntimeError(f'unsupported helper role: {ROLE}')
    path = DELEGATE_ROOT / ROLE
    if not path.is_file() or not os.access(path, os.X_OK):
        raise RuntimeError(f'2.1.1 delegate is unavailable: {path}')
    return path


def delegate(args: list[str]) -> int:
    path = delegate_path()
    os.execv(str(path), [str(path), *args])
    return 1


def show(prop: str) -> str:
    result = run(['systemctl', 'show', UNIT, '-p', prop, '--value'], timeout=20)
    return (result.stdout or '').strip()


def unit_exists() -> bool:
    return run(['systemctl', 'cat', UNIT], timeout=20).returncode == 0


def unit_active() -> bool:
    return show('ActiveState') == 'active'


def unit_enabled() -> bool:
    result = run(['systemctl', 'is-enabled', UNIT], timeout=20)
    return result.returncode == 0 and (result.stdout or '').strip() in {'enabled', 'enabled-runtime'}


def runtime() -> Path | None:
    raw = show('WorkingDirectory')
    if not raw:
        return None
    try:
        return Path(raw).resolve()
    except Exception:
        return Path(raw)


def read_props(path: Path | None) -> dict[str, str]:
    if path is None:
        return {}
    prop_file = path / 'server.properties'
    if not prop_file.is_file():
        return {}
    values: dict[str, str] = {}
    for line in prop_file.read_text(encoding='utf-8', errors='replace').splitlines():
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        key, value = line.split('=', 1)
        values[key.strip()] = value.strip()
    return values


def int_value(raw: str | None, default: int | None = None) -> int | None:
    try:
        value = int(str(raw or '').strip())
        return value
    except Exception:
        return default


def udp_listening(port: int | None) -> bool:
    if not port:
        return False
    result = run(['ss', '-H', '-lun'], timeout=20)
    if result.returncode != 0:
        return False
    needle = f':{port}'
    for line in (result.stdout or '').splitlines():
        local = line.split()
        if any(field.endswith(needle) for field in local):
            return True
    return False


def detect_version(rt: Path | None) -> str | None:
    if rt:
        for name in ('version.txt', '.version', 'bedrock.version'):
            path = rt / name
            if path.is_file():
                text = path.read_text(encoding='utf-8', errors='ignore').strip()
                match = re.search(r'\d+(?:\.\d+){2,4}', text)
                if match:
                    return match.group(0)
    result = run(['journalctl', '-u', UNIT, '-n', '500', '--no-pager'], timeout=30)
    text = result.stdout or ''
    patterns = (
        r'(?:Version|version)[: ]+v?(\d+(?:\.\d+){2,4})',
        r'bedrock-server-(\d+(?:\.\d+){2,4})',
    )
    for pattern in patterns:
        matches = re.findall(pattern, text)
        if matches:
            return matches[-1]
    return None


def memory_fields() -> tuple[int | None, str | None]:
    raw = int_value(show('MemoryCurrent'))
    if raw is None or raw < 0 or raw >= (1 << 63):
        return None, None
    if raw == 0:
        return 0, '0 MiB'
    return raw, f'{raw / (1024 * 1024):.1f} MiB'


def canonical_status() -> dict:
    if not unit_exists():
        return {
            'ok': True,
            'service': UNIT,
            'active': False,
            'healthy': False,
            'state': 'missing',
            'status_label': 'Служба не установлена',
            'status_error': f'{UNIT} is missing',
            'checked_at': datetime.now(timezone.utc).isoformat(),
        }

    rt = runtime()
    props = read_props(rt)
    active_state = show('ActiveState') or 'unknown'
    sub_state = show('SubState') or 'unknown'
    active = active_state == 'active'
    pid = int_value(show('MainPID'), 0) or None
    port = int_value(props.get('server-port'), 19132)
    level = props.get('level-name') or None
    world_exists = bool(rt and level and (rt / 'worlds' / level).is_dir())
    port_ok = udp_listening(port) if active else False
    runtime_valid = bool(rt and rt.is_dir() and (rt / 'bedrock_server').is_file())
    memory_bytes, memory_human = memory_fields()
    healthy = bool(active and runtime_valid and port_ok and world_exists)

    if not runtime_valid:
        state = 'error'
        label = 'Ошибка конфигурации'
        status_error = f'Некорректный runtime: {str(rt) if rt else "не определён"}'
    elif not active:
        state = 'stopped'
        label = 'Остановлен'
        status_error = None
    elif healthy:
        state = 'running'
        label = 'Работает'
        status_error = None
    else:
        state = 'degraded'
        label = 'Запущен с ошибкой'
        problems = []
        if not port_ok:
            problems.append(f'UDP {port} не слушается')
        if not world_exists:
            problems.append(f'мир {level or "не определён"} недоступен')
        status_error = '; '.join(problems) or f'systemd state={active_state}/{sub_state}'

    max_players = int_value(props.get('max-players'))
    started = show('ActiveEnterTimestamp') if active else None

    return {
        'ok': True,
        'service': UNIT,
        'unit_enabled': unit_enabled(),
        'active': active,
        'healthy': healthy,
        'state': state,
        'status_label': label,
        'status_error': status_error,
        'active_state': active_state,
        'sub_state': sub_state,
        'main_pid': pid,
        'runtime': str(rt) if rt else None,
        'runtime_valid': runtime_valid,
        'port': port,
        'port_listening': port_ok,
        'server_name': props.get('server-name'),
        'level_name': level,
        'world_exists': world_exists,
        'gamemode': props.get('gamemode'),
        'difficulty': props.get('difficulty'),
        'max_players': max_players,
        'version': detect_version(rt),
        'memory_bytes': memory_bytes,
        'memory_human': memory_human,
        'started': started or None,
        'checked_at': datetime.now(timezone.utc).isoformat(),
    }


def systemctl(action: str) -> None:
    result = run(['systemctl', action, UNIT], timeout=180)
    if result.returncode != 0:
        raise RuntimeError((result.stdout or '')[-4000:] or f'failed to {action} {UNIT}')


def wait_for(action: str, timeout: int = 90) -> dict:
    deadline = time.monotonic() + timeout
    last = canonical_status()
    while time.monotonic() < deadline:
        last = canonical_status()
        if action == 'stop' and not last.get('active'):
            return last
        if action in {'start', 'restart'} and last.get('active') and last.get('healthy'):
            return last
        time.sleep(1)
    raise RuntimeError(
        'Minecraft state did not converge after '
        f'{action}: state={last.get("state")} active={last.get("active")} '
        f'healthy={last.get("healthy")} error={last.get("status_error")}'
    )


def service_action(action: str) -> dict:
    if action not in {'start', 'stop', 'restart'}:
        raise RuntimeError('service action must be start, stop or restart')
    systemctl(action)
    status = wait_for(action)
    status['action'] = action
    if action == 'stop':
        status['message'] = (
            f'Minecraft Bedrock остановлен. Состояние подтверждено: OFFLINE; '
            f'служба {UNIT}; мир {status.get("level_name") or "—"}.'
        )
    else:
        label = 'запущен' if action == 'start' else 'перезапущен'
        status['message'] = (
            f'Minecraft Bedrock {label}. Состояние подтверждено: ONLINE; '
            f'UDP {status.get("port") or "—"}; PID {status.get("main_pid") or "—"}; '
            f'мир {status.get("level_name") or "—"}.'
        )
    return status


def main() -> int:
    args = sys.argv[1:]
    try:
        if ROLE == 'srv-control-minecraft':
            operation = args[0] if args else ''
            if operation == 'status':
                return emit(canonical_status())
            if operation == 'service':
                if len(args) < 2:
                    raise RuntimeError('service action is required')
                return emit(service_action(args[1]))
        return delegate(args)
    except Exception as exc:
        return emit({'ok': False, 'error': str(exc)[-5000:]}, 1)


if __name__ == '__main__':
    raise SystemExit(main())
