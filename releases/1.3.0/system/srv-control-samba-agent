#!/usr/bin/env python3
from __future__ import annotations

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import tempfile
from typing import Any


ACTION_DIR = Path("/var/lib/srv-control/samba-actions")
RESULT_DIR = Path("/var/lib/srv-control/system-results")
SECRET_DIR = Path("/var/lib/srv-control/action-secrets")
IMPORT_DIR = Path("/var/lib/srv-control/domain-imports")
WORKER = Path("/usr/local/libexec/srv-control-samba-admin")
SMB_CONF = Path("/etc/samba/smb.conf")
SHARES_INCLUDE = Path("/etc/samba/srv-control-shares.conf")
SHARE_INCLUDE_LINE = f"include = {SHARES_INCLUDE}"
SHARE_ACTIONS = {"samba-share-create", "samba-share-update", "samba-share-delete"}
PROTECTED_EXTERNAL_SHARES = {"global", "netlogon", "sysvol", "homes", "printers", "print$", "ipc$"}
SHARE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$")
ACCOUNT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
SECTION_RE = re.compile(r"^\s*\[([^\]]+)\]\s*$")
INCLUDE_RE = re.compile(r"^\s*include\s*=\s*(.+?)\s*$", re.IGNORECASE)
PARAM_RE = re.compile(r"^\s*([^#;][^=]*?)\s*=\s*(.*?)\s*$")
EXTERNAL_ALLOWED_ROOTS = (Path("/srv"), Path("/home"), Path("/mnt"), Path("/media"))
SAMBA_AD_PACKAGES = (
    "samba",
    "samba-common-bin",
    "samba-ad-dc",
    "samba-ad-provision",
    "samba-dsdb-modules",
    "samba-vfs-modules",
    "smbclient",
    "winbind",
    "libnss-winbind",
    "libpam-winbind",
    "krb5-user",
    "acl",
    "attr",
    "quota",
    "xfsprogs",
    "btrfs-progs",
    "ldb-tools",
)


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def write_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        json.dump(value, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), 0o644)
        tmp = Path(handle.name)
    finally:
        handle.close()
    os.replace(tmp, path)


def cleanup_private_payload(request: dict[str, Any]) -> None:
    payload = request.get("payload") if isinstance(request.get("payload"), dict) else {}
    secret = str(payload.get("secret_ref") or "")
    if secret and all(ch.isalnum() or ch in "_-" for ch in secret):
        path = SECRET_DIR / secret
        try:
            if path.is_file() and not path.is_symlink():
                path.unlink()
        except Exception:
            pass
    import_ref = str(payload.get("import_ref") or "")
    if import_ref and all(ch.isalnum() or ch in "_-" for ch in import_ref):
        for suffix in (".upload", ".name"):
            path = IMPORT_DIR / f"{import_ref}{suffix}"
            try:
                if path.is_file() and not path.is_symlink():
                    path.unlink()
            except Exception:
                pass


def package_installed(name: str) -> bool:
    result = subprocess.run(
        ["dpkg-query", "-W", "-f=${Status}", name],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=15,
        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == "install ok installed"


def ensure_samba_ad_dependencies() -> None:
    missing = [name for name in SAMBA_AD_PACKAGES if not package_installed(name)]
    if not missing:
        return
    update = subprocess.run(
        ["apt-get", "update", "-y"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=900,
        check=False,
        env={**os.environ, "DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C.UTF-8"},
    )
    if update.returncode != 0:
        raise RuntimeError((update.stdout or "")[-6000:] or "apt-get update failed")
    install = subprocess.run(
        ["apt-get", "install", "-y", "--no-install-recommends", *missing],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=1800,
        check=False,
        env={**os.environ, "DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C.UTF-8"},
    )
    if install.returncode != 0:
        raise RuntimeError((install.stdout or "")[-6000:] or "failed to install Samba AD dependencies")


def _read_file_snapshot(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {"exists": False}
    info = path.stat()
    return {
        "exists": True,
        "data": path.read_bytes(),
        "mode": stat.S_IMODE(info.st_mode),
        "uid": info.st_uid,
        "gid": info.st_gid,
    }


def _restore_file_snapshot(path: Path, snapshot: dict[str, Any]) -> None:
    if not snapshot.get("exists"):
        path.unlink(missing_ok=True)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(dir=path.parent, prefix=path.name + ".restore.", delete=False)
    try:
        handle.write(snapshot["data"])
        handle.flush()
        os.fchmod(handle.fileno(), int(snapshot["mode"]))
        tmp = Path(handle.name)
    finally:
        handle.close()
    os.chown(tmp, int(snapshot["uid"]), int(snapshot["gid"]))
    os.replace(tmp, path)


def _atomic_text_preserve(path: Path, text: str, default_mode: int) -> None:
    if path.exists():
        info = path.stat()
        mode, uid, gid = stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid
    else:
        mode, uid, gid = default_mode, 0, 0
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        handle.write(text)
        handle.flush()
        os.fchmod(handle.fileno(), mode)
        tmp = Path(handle.name)
    finally:
        handle.close()
    os.chown(tmp, uid, gid)
    os.replace(tmp, path)


def _testparm_scalar(parameter: str, *, timeout: int = 30) -> str:
    if not SMB_CONF.is_file():
        return ""
    result = subprocess.run(
        ["testparm", "-s", "--suppress-prompt", f"--parameter-name={parameter}", str(SMB_CONF)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "")[-5000:]
        raise RuntimeError(detail or f"testparm failed while reading {parameter}")
    lines = [line.strip() for line in (result.stdout or "").splitlines() if line.strip()]
    return lines[-1] if lines else ""


def samba_role() -> str:
    return _testparm_scalar("server role").casefold()


def prepare_share_include() -> tuple[dict[str, Any], dict[str, Any], str]:
    if not SMB_CONF.is_file():
        raise RuntimeError("/etc/samba/smb.conf is missing")
    conf_snapshot = _read_file_snapshot(SMB_CONF)
    include_snapshot = _read_file_snapshot(SHARES_INCLUDE)
    original_role = samba_role()

    lines = SMB_CONF.read_text(encoding="utf-8", errors="strict").splitlines()
    marker = SHARE_INCLUDE_LINE.casefold()
    lines = [line for line in lines if line.strip().casefold() != marker]
    global_index = next((i for i, line in enumerate(lines) if line.strip().casefold() == "[global]"), None)
    if global_index is None:
        raise RuntimeError("smb.conf does not contain [global]")

    # An included file may switch parser context to [Share]. Therefore the
    # include must be the LAST directive of [global], immediately before the
    # first following service section. Inserting it right after [global] would
    # make the remaining realm/server-role directives belong to the share.
    insert_at = len(lines)
    for index in range(global_index + 1, len(lines)):
        if SECTION_RE.match(lines[index]) and lines[index].strip().casefold() != "[global]":
            insert_at = index
            break
    lines.insert(insert_at, f"    {SHARE_INCLUDE_LINE}")
    _atomic_text_preserve(SMB_CONF, "\n".join(lines).rstrip() + "\n", 0o644)
    if not SHARES_INCLUDE.exists():
        _atomic_text_preserve(
            SHARES_INCLUDE,
            "# Managed by SRV Control Center 1.3.0. Do not edit by hand.\n",
            0o640,
        )

    prepared_role = samba_role()
    if original_role and prepared_role != original_role:
        _restore_file_snapshot(SMB_CONF, conf_snapshot)
        _restore_file_snapshot(SHARES_INCLUDE, include_snapshot)
        raise RuntimeError(
            f"refusing share configuration: Samba role changed while normalizing include ({original_role} -> {prepared_role})"
        )
    return conf_snapshot, include_snapshot, original_role


def _reload_samba() -> None:
    for unit in ("samba-ad-dc.service", "samba.service", "smbd.service"):
        active = subprocess.run(
            ["systemctl", "is-active", "--quiet", unit],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if active.returncode == 0:
            completed = subprocess.run(
                ["systemctl", "reload", unit],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
                check=False,
            )
            if completed.returncode != 0:
                raise RuntimeError((completed.stdout or "")[-4000:] or f"failed to reload {unit}")
            return


def restore_share_context(context: tuple[dict[str, Any], dict[str, Any], str]) -> None:
    conf_snapshot, include_snapshot, _ = context
    _restore_file_snapshot(SMB_CONF, conf_snapshot)
    _restore_file_snapshot(SHARES_INCLUDE, include_snapshot)
    try:
        _reload_samba()
    except Exception:
        pass


def validate_share_context(context: tuple[dict[str, Any], dict[str, Any], str]) -> None:
    _, _, original_role = context
    final_role = samba_role()
    if original_role and final_role != original_role:
        restore_share_context(context)
        raise RuntimeError(
            f"Samba role changed after share operation ({original_role} -> {final_role}); configuration restored"
        )


def _clean_external_value(value: object, *, maximum: int, required: bool = False) -> str:
    raw = str(value if value is not None else "")
    if any(ch in raw for ch in "\r\n\x00"):
        raise RuntimeError("share value contains forbidden control characters")
    if len(raw) > maximum:
        raise RuntimeError("share value is too long")
    raw = raw.strip()
    if required and not raw:
        raise RuntimeError("share value is required")
    return raw


def _external_account(value: object) -> str:
    raw = _clean_external_value(value, maximum=64, required=True)
    if not ACCOUNT_RE.fullmatch(raw):
        raise RuntimeError("invalid share account login")
    return raw


def _external_group(value: object) -> str:
    raw = _clean_external_value(value, maximum=128, required=True)
    if any(ch in raw for ch in ('"', ',', '/', '\\')):
        raise RuntimeError("share group contains unsupported characters")
    return raw


def _workgroup() -> str:
    return _testparm_scalar("workgroup", timeout=20) or "DOMAIN"


def _external_subject_tokens(subjects: object) -> tuple[list[str], list[str], list[str]]:
    if not isinstance(subjects, list) or not subjects:
        raise RuntimeError("external share must have at least one access subject")
    domain = _workgroup()
    valid: list[str] = []
    read: list[str] = []
    write: list[str] = []
    seen: set[tuple[str, str]] = set()
    for raw in subjects:
        if not isinstance(raw, dict):
            raise RuntimeError("invalid external share subject")
        kind = str(raw.get("type") or "").strip().lower()
        access = str(raw.get("access") or "").strip().lower()
        if access not in {"read", "write"}:
            raise RuntimeError("share subject access must be read or write")
        if kind == "everyone":
            token = "Everyone"
        elif kind == "user":
            token = f"{domain}\\{_external_account(raw.get('name'))}"
        elif kind == "group":
            token = f'@"{domain}\\{_external_group(raw.get("name"))}"'
        else:
            raise RuntimeError("share subject type must be user, group or everyone")
        key = (token.casefold(), access)
        if key in seen:
            continue
        seen.add(key)
        if token not in valid:
            valid.append(token)
        (write if access == "write" else read).append(token)
    return valid, read, write


def _configured_files(root: Path) -> list[Path]:
    result: list[Path] = []
    visited: set[Path] = set()

    def visit(path: Path) -> None:
        try:
            resolved = path.resolve(strict=True)
        except Exception:
            return
        if resolved in visited or not resolved.is_file():
            return
        visited.add(resolved)
        result.append(resolved)
        try:
            lines = resolved.read_text(encoding="utf-8", errors="strict").splitlines()
        except Exception:
            return
        for raw in lines:
            stripped = raw.strip()
            if not stripped or stripped.startswith(("#", ";")):
                continue
            match = INCLUDE_RE.match(raw)
            if not match:
                continue
            value = match.group(1).strip().strip('"').strip("'")
            if not value or "%" in value or "*" in value or "?" in value or "[" in value:
                continue
            candidate = Path(value)
            if not candidate.is_absolute():
                candidate = resolved.parent / candidate
            visit(candidate)

    visit(root)
    return result


def _find_external_section(name: str) -> tuple[Path, list[str], int, int]:
    target = name.casefold()
    matches: list[tuple[Path, list[str], int, int]] = []
    for path in _configured_files(SMB_CONF):
        lines = path.read_text(encoding="utf-8", errors="strict").splitlines()
        starts: list[tuple[int, str]] = []
        for index, raw in enumerate(lines):
            section = SECTION_RE.match(raw)
            if section:
                starts.append((index, section.group(1).strip()))
        for position, (start, section_name) in enumerate(starts):
            if section_name.casefold() != target:
                continue
            end = starts[position + 1][0] if position + 1 < len(starts) else len(lines)
            matches.append((path, lines, start, end))
    if not matches:
        raise RuntimeError(f"external share definition not found: {name}")
    unique = {(str(path), start) for path, _, start, _ in matches}
    if len(unique) != 1:
        locations = ", ".join(sorted({str(path) for path, _, _, _ in matches}))
        raise RuntimeError(f"external share is defined more than once; edit refused: {locations}")
    path, lines, start, end = matches[0]
    try:
        if path.resolve() == SHARES_INCLUDE.resolve():
            raise RuntimeError("share belongs to the Control Center include but is missing from its registry")
    except FileNotFoundError:
        pass
    return path, lines, start, end


def _section_values(lines: list[str], start: int, end: int) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in lines[start + 1:end]:
        match = PARAM_RE.match(raw)
        if not match:
            continue
        values[match.group(1).strip().casefold()] = match.group(2).strip()
    return values


def _validate_external_path(raw: object, current: str | None) -> Path:
    value = _clean_external_value(raw, maximum=1024, required=True)
    path = Path(os.path.normpath(value))
    if not path.is_absolute():
        raise RuntimeError("external share path must be absolute")
    if not path.exists() or not path.is_dir():
        raise RuntimeError("external share path must be an existing directory")
    current_path = Path(os.path.normpath(current)) if current else None
    unchanged = current_path is not None and path == current_path
    if not unchanged:
        if path.is_symlink():
            raise RuntimeError("new external share path must not be a symbolic link")
        allowed = any(path != root and root in path.parents for root in EXTERNAL_ALLOWED_ROOTS)
        if not allowed:
            raise RuntimeError("new external share path must be below /srv, /home, /mnt or /media")
    return path


def _replace_external_section(
    lines: list[str], start: int, end: int, directives: list[tuple[str, str]]
) -> list[str]:
    managed_keys = {key.casefold() for key, _ in directives}
    body: list[str] = []
    for raw in lines[start + 1:end]:
        match = PARAM_RE.match(raw)
        if match and match.group(1).strip().casefold() in managed_keys:
            continue
        body.append(raw)
    while body and not body[-1].strip():
        body.pop()
    if body:
        body.append("")
    body.extend([f"    {key} = {value}" for key, value in directives])
    body.append("")
    return lines[:start + 1] + body + lines[end:]


def _refresh_share_snapshot() -> None:
    for unit in ("srv-control-samba-shares-monitor.service", "srv-control-samba-monitor.service"):
        subprocess.run(
            ["systemctl", "start", "--no-block", unit],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def update_external_share(payload: dict[str, Any]) -> str:
    name = _clean_external_value(payload.get("share_name"), maximum=63, required=True)
    if not SHARE_NAME_RE.fullmatch(name):
        raise RuntimeError("invalid external share name")
    if name.casefold() in PROTECTED_EXTERNAL_SHARES:
        raise RuntimeError("protected/system Samba share cannot be edited from the general share editor")
    requested_name = _clean_external_value(payload.get("name") or name, maximum=63, required=True)
    if requested_name.casefold() != name.casefold():
        raise RuntimeError("renaming an external share is not supported; create a new managed share instead")

    source, lines, start, end = _find_external_section(name)
    current = _section_values(lines, start, end)
    path = _validate_external_path(payload.get("path"), current.get("path"))
    comment = _clean_external_value(payload.get("comment") or "", maximum=1024)
    valid, read, write = _external_subject_tokens(payload.get("subjects"))
    directives = [
        ("path", str(path)),
        ("comment", comment),
        ("browseable", "yes" if bool(payload.get("browseable", True)) else "no"),
        ("read only", "yes"),
        ("valid users", ", ".join(valid)),
        ("read list", ", ".join(read)),
        ("write list", ", ".join(write)),
    ]

    snapshot = _read_file_snapshot(source)
    original_role = samba_role()
    updated = _replace_external_section(lines, start, end, directives)
    _atomic_text_preserve(source, "\n".join(updated).rstrip() + "\n", 0o640)
    try:
        validation = subprocess.run(
            ["testparm", "-s", "--suppress-prompt", str(SMB_CONF)],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=30,
            check=False,
        )
        if validation.returncode != 0:
            raise RuntimeError((validation.stdout or "")[-5000:] or "testparm rejected external share update")
        final_role = samba_role()
        if original_role and final_role != original_role:
            raise RuntimeError(f"Samba role changed ({original_role} -> {final_role})")
        _reload_samba()
    except Exception:
        _restore_file_snapshot(source, snapshot)
        try:
            _reload_samba()
        except Exception:
            pass
        raise
    _refresh_share_snapshot()
    return f"external share updated in place: {name}; source={source}; data_path_unchanged={str(path) == str(current.get('path') or '')}"


def invoke(request: dict[str, Any]) -> tuple[bool, str]:
    action = str(request.get("action") or "")
    payload = request.get("payload") if isinstance(request.get("payload"), dict) else {}
    external_update = action == "samba-share-update" and bool(payload.get("external_share"))

    if external_update:
        return True, update_external_share(payload)

    if not WORKER.is_file():
        return False, "Samba administration worker is not installed"
    if action == "service-install-samba-dc":
        ensure_samba_ad_dependencies()

    share_context: tuple[dict[str, Any], dict[str, Any], str] | None = None
    if action in SHARE_ACTIONS:
        share_context = prepare_share_include()

    completed = subprocess.run(
        [str(WORKER)],
        input=json.dumps(request, ensure_ascii=False),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=24 * 3600,
        check=False,
        env={**os.environ, "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8", "HOME": "/root"},
    )
    output = (completed.stdout or "")[-16000:]
    try:
        decoded = json.loads(output.strip().splitlines()[-1]) if output.strip() else {}
    except Exception:
        decoded = {}
    ok = completed.returncode == 0 and decoded.get("ok") is True
    detail = str(decoded.get("detail") or output or "Samba action returned no detail")[-12000:]

    if share_context is not None:
        if ok:
            try:
                validate_share_context(share_context)
            except Exception as exc:
                return False, str(exc)
        else:
            restore_share_context(share_context)
    return ok, detail


def process(path: Path) -> None:
    started = now()
    request_id = path.stem
    request: dict[str, Any] = {}
    result: dict[str, Any] = {
        "request_id": request_id,
        "action": None,
        "actor": None,
        "started_at": started,
        "finished_at": None,
        "result": "failed",
        "detail": None,
    }
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or path.is_symlink():
            raise RuntimeError("Samba action request must be a regular file")
        request = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(request, dict):
            raise RuntimeError("Samba action request must be a JSON object")
        if str(request.get("request_id") or "") != request_id:
            raise RuntimeError("Samba action request id does not match filename")
        result["action"] = request.get("action")
        result["actor"] = request.get("actor")
        ok, detail = invoke(request)
        result["result"] = "success" if ok else "failed"
        result["detail"] = detail
    except Exception as exc:
        result["detail"] = str(exc)[-12000:]
    finally:
        if result["result"] != "success":
            cleanup_private_payload(request)
        result["finished_at"] = now()
        write_json(RESULT_DIR / f"{request_id}.json", result)
        path.unlink(missing_ok=True)


def main() -> int:
    ACTION_DIR.mkdir(parents=True, exist_ok=True)
    requests = sorted(ACTION_DIR.glob("*.json"), key=lambda item: item.stat().st_mtime)
    if not requests:
        return 0
    process(requests[0])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
