#!/usr/bin/env python3
from __future__ import annotations

import grp
import json
import os
from pathlib import Path
import pwd
import subprocess
import sys
from typing import Any


CORE = Path("/usr/local/libexec/srv-control-minecraft-admin-core")
UPDATER = Path("/usr/local/libexec/srv-control-minecraft-update")
REGISTRY = Path("/var/lib/srv-control/minecraft-instances.json")
RUN_DIR = Path("/run/srv-control/minecraft")
MINECRAFT_USER = "minecraft"
MINECRAFT_GROUP = "minecraft"
UPDATE_ACTIONS = {"minecraft-update-check", "minecraft-update-apply"}


def ensure_account() -> tuple[int, int]:
    try:
        account = pwd.getpwnam(MINECRAFT_USER)
    except KeyError:
        subprocess.run(
            ["useradd", "--system", "--home-dir", "/srv/minecraft/instances", "--shell", "/usr/sbin/nologin", MINECRAFT_USER],
            check=True,
        )
        account = pwd.getpwnam(MINECRAFT_USER)
    return account.pw_uid, account.pw_gid


def ensure_runtime(uid: int, gid: int) -> None:
    RUN_DIR.parent.mkdir(parents=True, exist_ok=True)
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    os.chown(RUN_DIR, 0, gid)
    os.chmod(RUN_DIR, 0o770)


def read_registry() -> dict[str, Any]:
    try:
        value = json.loads(REGISTRY.read_text(encoding="utf-8"))
    except Exception:
        return {"instances": []}
    return value if isinstance(value, dict) else {"instances": []}


def repair_instance_file_ownership(uid: int, gid: int) -> None:
    registry = read_registry()
    for item in registry.get("instances", []):
        if not isinstance(item, dict) or not bool(item.get("managed")):
            continue
        raw = str(item.get("working_directory") or "")
        if not raw:
            continue
        working = Path(raw)
        try:
            resolved = working.resolve(strict=True)
        except Exception:
            continue
        expected_root = Path("/srv/minecraft/instances").resolve()
        if resolved.parent != expected_root:
            continue
        try:
            os.chown(resolved, uid, gid)
        except Exception:
            pass
        for name in ("server.properties", "allowlist.json", "permissions.json", "whitelist.json"):
            path = resolved / name
            try:
                if path.is_file() and not path.is_symlink():
                    os.chown(path, uid, gid)
                    os.chmod(path, 0o640)
            except Exception:
                pass


def invoke(worker: Path, request_text: str) -> subprocess.CompletedProcess[str]:
    if not worker.is_file() or not os.access(worker, os.X_OK):
        raise RuntimeError(f"Minecraft worker is missing: {worker}")
    return subprocess.run(
        [str(worker)],
        input=request_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=24 * 3600,
        check=False,
        env={**os.environ, "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8", "HOME": "/root"},
    )


def main() -> int:
    request_text = sys.stdin.read()
    try:
        request = json.loads(request_text)
    except Exception as exc:
        print(json.dumps({"ok": False, "detail": f"invalid request JSON: {exc}"}, ensure_ascii=False))
        return 1
    if not isinstance(request, dict):
        print(json.dumps({"ok": False, "detail": "request must be a JSON object"}, ensure_ascii=False))
        return 1

    uid, gid = ensure_account()
    ensure_runtime(uid, gid)
    action = str(request.get("action") or "")
    worker = UPDATER if action in UPDATE_ACTIONS else CORE
    try:
        completed = invoke(worker, request_text)
        output = completed.stdout or ""
        if output:
            sys.stdout.write(output)
            if not output.endswith("\n"):
                sys.stdout.write("\n")
        repair_instance_file_ownership(uid, gid)
        return completed.returncode
    except Exception as exc:
        repair_instance_file_ownership(uid, gid)
        print(json.dumps({"ok": False, "detail": str(exc)[-12000:]}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
