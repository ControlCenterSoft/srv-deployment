[Unit]
Description=SRV Control Center privileged Samba action agent
After=local-fs.target network.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/srv-control-samba-agent
User=root
Group=root
UMask=0027
Nice=5
PrivateTmp=true
ProtectHome=true
ProtectSystem=false

[Install]
WantedBy=multi-user.target
