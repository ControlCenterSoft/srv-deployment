STATE_DIR = Path("/var/lib/srv-control")
SECRET_DIR = STATE_DIR / "action-secrets"
IMPORT_DIR = STATE_DIR / "domain-imports"
DOMAIN_BACKUP_DIR = STATE_DIR / "domain-backups"
RESTORE_ROOT = STATE_DIR / "restored-domain"
SHARES_REGISTRY = STATE_DIR / "samba-shares.json"
SHARES_INCLUDE = Path("/etc/samba/srv-control-shares.conf")
SMB_CONF = Path("/etc/samba/smb.conf")
SAMBA_MONITOR = Path("/usr/local/libexec/srv-control-samba-monitor")
SHARES_MONITOR = Path("/usr/local/libexec/srv-control-samba-shares-monitor")
LDIF_EDITOR = Path("/usr/local/libexec/srv-control-samba-ldif-editor")
APP_GROUP = "srv-control"
SHARE_ROOT = Path("/srv/shares")
SHARE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$")
ACCOUNT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{20,128}$")
PROTECTED_USERS = {"administrator", "guest", "krbtgt"}
PROTECTED_GROUPS = {
    "administrators",
    "domain admins",
    "domain computers",
    "domain controllers",
    "domain guests",
    "domain users",
    "enterprise admins",
    "group policy creator owners",
    "schema admins",
}
RESERVED_SHARES = {"global", "netlogon", "sysvol", "homes", "printers", "print$", "ipc$"}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def run(
    command: list[str],
    *,
    input_text: str | None = None,
    timeout: int = 300,
    env: dict[str, str] | None = None,
    check: bool = True,
) -> str:
    completed = subprocess.run(
        command,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
        env={
            **os.environ,
            "LC_ALL": "C.UTF-8",
            "LANG": "C.UTF-8",
            "HOME": "/root",
            "DEBIAN_FRONTEND": "noninteractive",
            **(env or {}),
        },
    )
    output = (completed.stdout or "")[-12000:]
    if check and completed.returncode != 0:
        raise RuntimeError(
            f"command failed ({completed.returncode}): {' '.join(command)}\n{output}"
        )
    return output.strip()


def write_json(path: Path, value: dict[str, Any], mode: int = 0o640) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        json.dump(value, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), mode)
        tmp = Path(handle.name)
    finally:
        handle.close()
    try:
        gid = grp.getgrnam(APP_GROUP).gr_gid
        os.chown(tmp, 0, gid)
    except Exception:
        pass
    os.replace(tmp, path)


def read_json(path: Path, default: dict[str, Any] | None = None) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(value, dict):
            return value
    except Exception:
        pass
    return dict(default or {})


def refresh() -> None:
    for monitor in (SAMBA_MONITOR, SHARES_MONITOR):
        if monitor.is_file() and os.access(monitor, os.X_OK):
            try:
                run([str(monitor)], timeout=90)
            except Exception:
                pass


def clean_text(value: object, *, maximum: int = 2048, allow_empty: bool = True) -> str:
    raw = str(value if value is not None else "")
    if any(ch in raw for ch in "\r\n\x00"):
        raise RuntimeError("value contains forbidden control characters")
    if len(raw) > maximum:
        raise RuntimeError("value is too long")
    if not allow_empty and not raw.strip():
        raise RuntimeError("value is required")
    return raw.strip()


def account_name(value: object) -> str:
    raw = clean_text(value, maximum=64, allow_empty=False)
    if not ACCOUNT_RE.fullmatch(raw):
        raise RuntimeError("invalid account login")
    return raw


def group_name(value: object) -> str:
    raw = clean_text(value, maximum=128, allow_empty=False)
    if any(ch in raw for ch in ('"', ',', '/', '\\')):
        raise RuntimeError("group name contains unsupported characters")
    return raw


def share_name(value: object) -> str:
    raw = clean_text(value, maximum=63, allow_empty=False)
    if not SHARE_NAME_RE.fullmatch(raw):
        raise RuntimeError("share name must contain only ASCII letters, digits, '_' and '-'")
    if raw.casefold() in RESERVED_SHARES:
        raise RuntimeError("reserved Samba share name")
    return raw


def protected_user(username: str) -> bool:
    return username.casefold() in PROTECTED_USERS


def protected_group(name: str) -> bool:
    return name.casefold() in PROTECTED_GROUPS


def consume_secret(reference: object) -> str:
    token = str(reference or "")
    if not TOKEN_RE.fullmatch(token):
        raise RuntimeError("invalid secret reference")
    path = SECRET_DIR / token
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError("secret reference is not a regular file")
        if info.st_size <= 0 or info.st_size > 4096:
            raise RuntimeError("invalid secret length")
        value = os.read(fd, 4097).decode("utf-8", errors="strict")
    finally:
        os.close(fd)
        path.unlink(missing_ok=True)
    if not value or any(ch in value for ch in "\r\n\x00"):
        raise RuntimeError("invalid password value")
    return value


def password_prompt(command: list[str], password: str, timeout: int = 60) -> str:
    # samba-tool user add/setpassword prompt for a new password twice when the
    # password is omitted from argv. This keeps the secret out of process titles
    # and out of the Control Center action JSON/log.
    return run(command, input_text=password + "\n" + password + "\n", timeout=timeout)


def password_policy(payload: dict[str, Any]) -> str:
    mapping = {
        "complexity": ("--complexity", lambda v: "on" if bool(v) else "off"),
        "history_length": ("--history-length", lambda v: str(int(v))),
        "min_length": ("--min-pwd-length", lambda v: str(int(v))),
        "min_age_days": ("--min-pwd-age", lambda v: str(int(v))),
        "max_age_days": ("--max-pwd-age", lambda v: str(int(v))),
        "lockout_duration_minutes": ("--account-lockout-duration", lambda v: str(int(v))),
        "lockout_threshold": ("--account-lockout-threshold", lambda v: str(int(v))),
        "lockout_reset_minutes": ("--reset-account-lockout-after", lambda v: str(int(v))),
    }
    ranges = {
        "history_length": (0, 24),
        "min_length": (0, 255),
        "min_age_days": (0, 998),
        "max_age_days": (0, 999),
        "lockout_duration_minutes": (0, 1000000),
        "lockout_threshold": (0, 999),
        "lockout_reset_minutes": (0, 1000000),
    }
    command = ["samba-tool", "domain", "passwordsettings", "set"]
    changed: list[str] = []
    for key, (option, converter) in mapping.items():
        if key not in payload:
            continue
        value = payload[key]
        if key in ranges:
            number = int(value)
            low, high = ranges[key]
            if number < low or number > high:
                raise RuntimeError(f"{key} is outside supported range")
        command.append(f"{option}={converter(value)}")
        changed.append(key)
    if not changed:
        raise RuntimeError("no password policy fields supplied")
    run(command, timeout=60)
    actual = run(["samba-tool", "domain", "passwordsettings", "show"], timeout=30)
    return f"password policy updated: {', '.join(changed)}\n{actual[-3000:]}"


def apply_ldif_patch(kind: str, name: str, patch: dict[str, Any]) -> None:
    allowed = {"description", "telephoneNumber", "homeDrive", "homeDirectory", "profilePath", "scriptPath"}
    clean: dict[str, str | None] = {}
    for key, value in patch.items():
        if key not in allowed:
            continue
        if value is None or str(value) == "":
            clean[key] = None
        else:
            clean[key] = clean_text(value, maximum=2048)
    if not clean:
        return
    if not LDIF_EDITOR.is_file():
        raise RuntimeError("Samba LDIF editor helper is not installed")
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=STATE_DIR, prefix="samba-ldif-patch.", delete=False
    )
    try:
        json.dump(clean, handle, ensure_ascii=False)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), 0o600)
        patch_path = Path(handle.name)
    finally:
        handle.close()
    try:
        run(
            ["samba-tool", kind, "edit", name, f"--editor={LDIF_EDITOR}"],
            env={"SRVCC_LDIF_PATCH": str(patch_path)},
            timeout=90,
        )
    finally:
        patch_path.unlink(missing_ok=True)


def reconcile_groups(username: str, desired_raw: object) -> None:
    if not isinstance(desired_raw, list):
        return
    desired = {group_name(item) for item in desired_raw}
    output = run(["samba-tool", "user", "getgroups", username], timeout=30)
    current = {line.strip() for line in output.splitlines() if line.strip()}
    # Primary/builtin Domain Users membership is intentionally never removed.
    removable = {item for item in current if item.casefold() != "domain users"}
    for name in sorted(desired - current, key=str.casefold):
        run(["samba-tool", "group", "addmembers", name, username], timeout=30)
    for name in sorted(removable - desired, key=str.casefold):
        run(["samba-tool", "group", "removemembers", name, username], timeout=30)


def update_user(username: str, payload: dict[str, Any]) -> str:
    username = account_name(username)
    target = username
    rename_options: list[str] = []
    rename_map = {
        "given_name": "--given-name",
        "surname": "--surname",
        "display_name": "--display-name",
        "email": "--mail-address",
    }
    for key, option in rename_map.items():
        if key in payload:
            rename_options.append(f"{option}={clean_text(payload.get(key), maximum=256)}")
    if "new_username" in payload and str(payload.get("new_username") or "").strip():
        target = account_name(payload["new_username"])
        rename_options.append(f"--samaccountname={target}")
    if rename_options:
        run(["samba-tool", "user", "rename", username, *rename_options], timeout=60)

    extra_patch = {
        "telephoneNumber": payload.get("phone") if "phone" in payload else None,
        "homeDrive": payload.get("home_drive") if "home_drive" in payload else None,
        "homeDirectory": payload.get("home_directory") if "home_directory" in payload else None,
        "profilePath": payload.get("profile_path") if "profile_path" in payload else None,
        "scriptPath": payload.get("script_path") if "script_path" in payload else None,
        "description": payload.get("description") if "description" in payload else None,
    }
    # Do not interpret omitted keys as removals.
    field_to_attr = {
        "phone": "telephoneNumber",
        "home_drive": "homeDrive",
        "home_directory": "homeDirectory",
        "profile_path": "profilePath",
        "script_path": "scriptPath",
        "description": "description",
    }
    selected_patch = {
        attr: payload[field]
        for field, attr in field_to_attr.items()
        if field in payload
    }
    apply_ldif_patch("user", target, selected_patch)

    if "primary_group" in payload and str(payload.get("primary_group") or "").strip():
        run(
            ["samba-tool", "user", "setprimarygroup", target, group_name(payload["primary_group"])],
            timeout=30,
        )
    if "groups" in payload:
        reconcile_groups(target, payload.get("groups"))
    return target


def create_user(payload: dict[str, Any]) -> str:
    username = account_name(payload.get("username"))
    password = consume_secret(payload.get("secret_ref"))
    created = False
    try:
        password_prompt(["samba-tool", "user", "add", username], password, timeout=90)
        created = True
        update_user(username, payload)
        if bool(payload.get("must_change_password")):
            # Re-set the same secret with the change-at-next-login flag without
            # putting it in argv.
            password_prompt(
                ["samba-tool", "user", "setpassword", username, "--must-change-at-next-login"],
                password,
                timeout=60,
            )
        return f"domain user created: {username}"
    except Exception:
        if created and not protected_user(username):
            try:
                run(["samba-tool", "user", "delete", username], timeout=30)
            except Exception:
                pass
        raise


def reset_user_password(payload: dict[str, Any]) -> str:
    username = account_name(payload.get("username"))
    password = consume_secret(payload.get("secret_ref"))
    command = ["samba-tool", "user", "setpassword", username]
    if bool(payload.get("must_change_password")):
        command.append("--must-change-at-next-login")
    password_prompt(command, password, timeout=60)
    return f"password reset: {username}"


def user_operation(action: str, payload: dict[str, Any]) -> str:
    username = account_name(payload.get("username"))
    if action == "samba-user-update":
        new_name = update_user(username, payload)
        return f"domain user updated: {new_name}"
    if action == "samba-user-password":
        return reset_user_password(payload)
    if action == "samba-user-enable":
        run(["samba-tool", "user", "enable", username], timeout=30)
        return f"domain user enabled: {username}"
    if action == "samba-user-disable":
        if protected_user(username):
            raise RuntimeError("protected domain account cannot be disabled")
        run(["samba-tool", "user", "disable", username], timeout=30)
        return f"domain user disabled: {username}"
    if action == "samba-user-unlock":
        run(["samba-tool", "user", "unlock", username], timeout=30)
        return f"domain user unlocked: {username}"
    if action == "samba-user-delete":
        if protected_user(username):
            raise RuntimeError("protected domain account cannot be deleted")
        run(["samba-tool", "user", "delete", username], timeout=30)
        return f"domain user deleted: {username}"
    raise RuntimeError("unsupported user operation")


def group_operation(action: str, payload: dict[str, Any]) -> str:
    if action == "samba-group-create":
        name = group_name(payload.get("name"))
        command = ["samba-tool", "group", "add", name]
        if "description" in payload and str(payload.get("description") or "").strip():
            command.append(f"--description={clean_text(payload['description'], maximum=1024)}")
        run(command, timeout=30)
        members = payload.get("members")
        if isinstance(members, list):
            for member in members:
                run(["samba-tool", "group", "addmembers", name, account_name(member)], timeout=30)
        return f"domain group created: {name}"

    name = group_name(payload.get("group_name"))
    if protected_group(name) and action in {"samba-group-update", "samba-group-delete"}:
        raise RuntimeError("protected domain group cannot be renamed or deleted")
    if action == "samba-group-update":
        target = name
        if "new_name" in payload and str(payload.get("new_name") or "").strip():
            target = group_name(payload["new_name"])
            run(["samba-tool", "group", "rename", name, f"--samaccountname={target}"], timeout=30)
        if "description" in payload:
            apply_ldif_patch("group", target, {"description": payload.get("description")})
        return f"domain group updated: {target}"
    if action == "samba-group-members":
        operation = str(payload.get("operation") or "").strip().lower()
        members = payload.get("members")
        if operation not in {"add", "remove"} or not isinstance(members, list) or not members:
            raise RuntimeError("group membership requires operation add/remove and members")
        command = "addmembers" if operation == "add" else "removemembers"
        for member in members:
            member_name = clean_text(member, maximum=128, allow_empty=False)
            if any(ch in member_name for ch in "\r\n\x00,"):
                raise RuntimeError("invalid group member")
            run(["samba-tool", "group", command, name, member_name], timeout=30)
        return f"group members {operation}: {name}"
    if action == "samba-group-delete":
        run(["samba-tool", "group", "delete", name], timeout=30)
        return f"domain group deleted: {name}"
    raise RuntimeError("unsupported group operation")


def current_domain() -> dict[str, str | None]:
    def scalar(command: list[str]) -> str | None:
        output = run(command, timeout=15, check=False)
        return output.splitlines()[-1].strip() if output.strip() else None

    sid_output = run(["net", "getdomainsid"], timeout=15, check=False)
    match = re.search(r"S-1-(?:\d+-)+\d+", sid_output)
    return {
        "realm": scalar(["testparm", "-s", "--parameter-name", "realm"]),
        "netbios_domain": scalar(["testparm", "-s", "--parameter-name", "workgroup"]),
        "dc_name": scalar(["testparm", "-s", "--parameter-name", "netbios name"]),
        "sid": match.group(0) if match else None,
        "samba_version": scalar(["samba", "--version"]),
    }


def load_registry() -> dict[str, Any]:
    value = read_json(SHARES_REGISTRY, {"schema_version": 1, "shares": []})
    if not isinstance(value.get("shares"), list):
        value["shares"] = []
    value["schema_version"] = 1
    return value


def save_registry(registry: dict[str, Any]) -> None:
    write_json(SHARES_REGISTRY, registry, 0o640)


def registry_entry(registry: dict[str, Any], name: str) -> dict[str, Any] | None:
    for item in registry.get("shares", []):
        if isinstance(item, dict) and str(item.get("name") or "").casefold() == name.casefold():
            return item
    return None


def domain_prefix() -> str:
    value = run(["testparm", "-s", "--parameter-name", "workgroup"], timeout=10, check=False).strip()
    return value or "DOMAIN"


def subject_token(subject: dict[str, Any]) -> tuple[str, str]:
    kind = str(subject.get("type") or "").strip().lower()
    access = str(subject.get("access") or "").strip().lower()
    if access not in {"read", "write"}:
        raise RuntimeError("share subject access must be read or write")
    domain = domain_prefix()
    if kind == "everyone":
        return "Everyone", access
    if kind == "user":
        name = account_name(subject.get("name"))
        return f"{domain}\\{name}", access
    if kind == "group":
        name = group_name(subject.get("name"))
        return f'@"{domain}\\{name}"', access
    raise RuntimeError("share subject type must be user, group or everyone")


def validate_share_path(name: str, value: object | None) -> Path:
    if value is None or not str(value).strip():
        path = SHARE_ROOT / name
    else:
        path = Path(clean_text(value, maximum=1024, allow_empty=False))
    if not path.is_absolute():
        raise RuntimeError("share path must be absolute")
    normalized = Path(os.path.normpath(str(path)))
    root = Path(os.path.normpath(str(SHARE_ROOT)))
    if normalized == root or root not in normalized.parents:
        raise RuntimeError(f"managed share path must be under {SHARE_ROOT}")
    return normalized


def render_shares(registry: dict[str, Any]) -> str:
    blocks: list[str] = ["# Managed by SRV Control Center 1.3.0. Do not edit by hand.", ""]
    for item in sorted(registry.get("shares", []), key=lambda row: str(row.get("name") or "").casefold()):
        if not isinstance(item, dict):
            continue
        name = share_name(item.get("name"))
        path = validate_share_path(name, item.get("path"))
        comment = clean_text(item.get("comment") or "", maximum=1024)
        subjects_raw = item.get("subjects") if isinstance(item.get("subjects"), list) else []
        tokens = [subject_token(subject) for subject in subjects_raw if isinstance(subject, dict)]
        valid = [token for token, _ in tokens]
        read = [token for token, access in tokens if access == "read"]
        write = [token for token, access in tokens if access == "write"]
        if not valid:
            raise RuntimeError(f"share {name} must have at least one access subject")
        blocks.extend(
            [
                f"[{name}]",
                f"    path = {path}",
                f"    comment = {comment}",
                f"    browseable = {'yes' if bool(item.get('browseable', True)) else 'no'}",
                "    read only = yes",
                f"    valid users = {', '.join(valid)}",
                f"    read list = {', '.join(read)}" if read else "    read list =",
                f"    write list = {', '.join(write)}" if write else "    write list =",
                "    inherit acls = yes",
                "    inherit permissions = yes",
                "    map acl inherit = yes",
                "",
            ]
        )
    return "\n".join(blocks).rstrip() + "\n"


def ensure_include(conf_text: str, include_path: Path) -> str:
    marker = f"include = {include_path}"
    lines = conf_text.splitlines()
    if any(line.strip().casefold() == marker.casefold() for line in lines):
        return conf_text.rstrip() + "\n"
    global_index = next((i for i, line in enumerate(lines) if line.strip().casefold() == "[global]"), None)
    if global_index is None:
        raise RuntimeError("smb.conf does not contain [global]")
    lines.insert(global_index + 1, f"    {marker}")
    return "\n".join(lines).rstrip() + "\n"


def reload_samba() -> None:
    for unit in ("samba-ad-dc.service", "samba.service"):
        result = subprocess.run(["systemctl", "is-active", "--quiet", unit], check=False)
        if result.returncode == 0:
            run(["systemctl", "reload", unit], timeout=30)
            return


def apply_share_config(registry: dict[str, Any]) -> None:
    if not SMB_CONF.is_file():
        raise RuntimeError("/etc/samba/smb.conf is missing")
    old_conf = SMB_CONF.read_text(encoding="utf-8", errors="strict")
    old_include = SHARES_INCLUDE.read_text(encoding="utf-8", errors="strict") if SHARES_INCLUDE.is_file() else None
    include_text = render_shares(registry)
    candidate_dir = Path(tempfile.mkdtemp(prefix="srvcc-samba-config.", dir="/etc/samba"))
    try:
        candidate_include = candidate_dir / "shares.conf"
        candidate_conf = candidate_dir / "smb.conf"
        candidate_include.write_text(include_text, encoding="utf-8")
        candidate_conf.write_text(ensure_include(old_conf, candidate_include), encoding="utf-8")
        run(["testparm", "-s", "--suppress-prompt", str(candidate_conf)], timeout=30)

        SHARES_INCLUDE.parent.mkdir(parents=True, exist_ok=True)
        SHARES_INCLUDE.write_text(include_text, encoding="utf-8")
        os.chmod(SHARES_INCLUDE, 0o640)
        SMB_CONF.write_text(ensure_include(old_conf, SHARES_INCLUDE), encoding="utf-8")
        os.chmod(SMB_CONF, 0o644)
        try:
            run(["testparm", "-s", "--suppress-prompt", str(SMB_CONF)], timeout=30)
            reload_samba()
        except Exception:
            SMB_CONF.write_text(old_conf, encoding="utf-8")
            if old_include is None:
                SHARES_INCLUDE.unlink(missing_ok=True)
            else:
                SHARES_INCLUDE.write_text(old_include, encoding="utf-8")
            reload_samba()
            raise
    finally:
        shutil.rmtree(candidate_dir, ignore_errors=True)


def ensure_share_directory(path: Path) -> bool:
    if path.exists():
        if not path.is_dir() or path.is_symlink():
            raise RuntimeError("share path exists but is not a normal directory")
        return False
    parent = path.parent
    parent.mkdir(parents=True, exist_ok=True)
    fs = filesystem_info(parent)
    if fs.get("fstype") == "btrfs" and shutil.which("btrfs"):
        run(["btrfs", "subvolume", "create", str(path)], timeout=60)
    else:
        path.mkdir(mode=0o770)
    return True


def filesystem_info(path: Path) -> dict[str, Any]:
    output = run(
        ["findmnt", "-T", str(path), "-n", "-o", "FSTYPE,OPTIONS,TARGET,SOURCE"],
        timeout=10,
        check=False,
    )
    parts = output.split(None, 3)
    return {
        "fstype": parts[0] if parts else None,
        "options": parts[1] if len(parts) > 1 else "",
        "mountpoint": parts[2] if len(parts) > 2 else None,
        "source": parts[3] if len(parts) > 3 else None,
    }


def project_id_for(name: str, registry: dict[str, Any]) -> int:
    used = {
        int(item.get("quota", {}).get("project_id"))
        for item in registry.get("shares", [])
        if isinstance(item, dict)
        and isinstance(item.get("quota"), dict)
        and str(item.get("quota", {}).get("project_id") or "").isdigit()
    }
    candidate = 100000 + (zlib.crc32(name.casefold().encode("utf-8")) & 0x3FFFFFFF)
    while candidate in used:
        candidate += 1
    return candidate


def apply_quota(item: dict[str, Any], registry: dict[str, Any]) -> dict[str, Any]:
    raw = item.get("quota") if isinstance(item.get("quota"), dict) else {}
    limit_raw = raw.get("limit_gib")
    limit = 0 if limit_raw in {None, "", 0, "0"} else int(limit_raw)
    if limit < 0 or limit > 1024 * 1024:
        raise RuntimeError("share quota is outside supported range")
    path = validate_share_path(str(item["name"]), item.get("path"))
    info = filesystem_info(path)
    fstype = str(info.get("fstype") or "")
    options = {value.casefold() for value in str(info.get("options") or "").split(",")}
    mountpoint = str(info.get("mountpoint") or path)
    project_id = int(raw.get("project_id") or project_id_for(str(item["name"]), registry))
    actual: dict[str, Any] = {
        "limit_gib": limit or None,
        "project_id": project_id,
        "backend": None,
        "supported": False,
    }

    if fstype == "xfs" and options.intersection({"pquota", "prjquota"}) and shutil.which("xfs_quota"):
        run(["xfs_quota", "-x", "-c", f"project -s -p {path} {project_id}", mountpoint], timeout=300)
        hard = f"{limit}g" if limit else "0"
        run(["xfs_quota", "-x", "-c", f"limit -p bhard={hard} {project_id}", mountpoint], timeout=60)
        actual.update({"backend": "xfs-project", "supported": True})
        return actual

    if fstype in {"ext4", "ext3"} and "prjquota" in options and shutil.which("chattr") and shutil.which("setquota"):
        run(["chattr", "-R", "-p", str(project_id), str(path)], timeout=1800)
        run(["chattr", "+P", str(path)], timeout=60)
        hard = f"{limit}G" if limit else "0"
        run(["setquota", "-P", str(project_id), "0", hard, "0", "0", mountpoint], timeout=60)
        actual.update({"backend": "ext-project", "supported": True})
        return actual

    if fstype == "btrfs" and shutil.which("btrfs"):
        if run(["btrfs", "subvolume", "show", str(path)], timeout=30, check=False) == "":
            # `subvolume show` may legitimately print nothing only on unusual
            # versions; verify by return code with a direct call below.
            probe = subprocess.run(["btrfs", "subvolume", "show", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            if probe.returncode != 0:
                raise RuntimeError("Btrfs quota requires the share root to be a subvolume")
        run(["btrfs", "quota", "enable", mountpoint], timeout=60)
        run(["btrfs", "qgroup", "limit", f"{limit}G" if limit else "none", str(path)], timeout=60)
        actual.update({"backend": "btrfs-qgroup", "supported": True})
        return actual

    if fstype == "zfs" and shutil.which("zfs") and info.get("source") and Path(mountpoint) == path:
        dataset = str(info["source"])
        run(["zfs", "set", f"quota={limit}G" if limit else "quota=none", dataset], timeout=60)
        actual.update({"backend": "zfs-dataset", "supported": True})
        return actual

    if limit:
        raise RuntimeError("directory quota is not supported by the backing filesystem/mount")
    return actual


def apply_posix_acl(item: dict[str, Any]) -> None:
    if not shutil.which("setfacl"):
        return
    path = validate_share_path(str(item["name"]), item.get("path"))
    domain = domain_prefix()
    subjects = item.get("subjects") if isinstance(item.get("subjects"), list) else []
    run(["setfacl", "-b", str(path)], timeout=60)
    run(["chmod", "0770", str(path)], timeout=30)
    run(["setfacl", "-m", "u::rwx,g::rwx,o::---,m::rwx", str(path)], timeout=30)
    for subject in subjects:
        if not isinstance(subject, dict):
            continue
        kind = str(subject.get("type") or "").lower()
        access = str(subject.get("access") or "").lower()
        perms = "rwx" if access == "write" else "r-x"
        if kind == "everyone":
            run(["setfacl", "-m", f"o::{perms}", str(path)], timeout=30)
            run(["setfacl", "-m", f"d:o::{perms}", str(path)], timeout=30)
        elif kind == "user":
            principal = f"{domain}\\{account_name(subject.get('name'))}"
            run(["setfacl", "-m", f"u:{principal}:{perms}", str(path)], timeout=30)
            run(["setfacl", "-m", f"d:u:{principal}:{perms}", str(path)], timeout=30)
        elif kind == "group":
            principal = f"{domain}\\{group_name(subject.get('name'))}"
            run(["setfacl", "-m", f"g:{principal}:{perms}", str(path)], timeout=30)
            run(["setfacl", "-m", f"d:g:{principal}:{perms}", str(path)], timeout=30)
    run(["setfacl", "-m", "d:u::rwx,d:g::rwx,d:m::rwx", str(path)], timeout=30)


def normalize_share_payload(payload: dict[str, Any], existing: dict[str, Any] | None = None) -> dict[str, Any]:
    source = dict(existing or {})
    raw_name = payload.get("name") if "name" in payload else payload.get("share_name") or source.get("name")
    name = share_name(raw_name)
    source["name"] = name
    source["path"] = str(validate_share_path(name, payload.get("path") if "path" in payload else source.get("path")))
    if "comment" in payload:
        source["comment"] = clean_text(payload.get("comment") or "", maximum=1024)
    else:
        source.setdefault("comment", "")
    if "browseable" in payload:
        source["browseable"] = bool(payload.get("browseable"))
    else:
        source.setdefault("browseable", True)
    if "subjects" in payload:
        subjects = payload.get("subjects")
        if not isinstance(subjects, list):
            raise RuntimeError("share subjects must be a list")
        # Validation also occurs during rendering.
        for subject in subjects:
            if not isinstance(subject, dict):
                raise RuntimeError("invalid share subject")
            subject_token(subject)
        source["subjects"] = subjects
    elif "subjects" not in source:
        source["subjects"] = []
    if "quota" in payload:
        if not isinstance(payload.get("quota"), dict):
            raise RuntimeError("share quota must be an object")
        merged_quota = dict(source.get("quota") or {})
        merged_quota.update(payload["quota"])
        source["quota"] = merged_quota
    else:
        source.setdefault("quota", {})
    return source


def share_operation(action: str, payload: dict[str, Any]) -> str:
    registry = load_registry()
    if action == "samba-share-create":
        item = normalize_share_payload(payload)
        if registry_entry(registry, str(item["name"])) is not None:
            raise RuntimeError("managed share already exists")
        path = Path(str(item["path"]))
        created_dir = ensure_share_directory(path)
        registry["shares"].append(item)
        try:
            quota = apply_quota(item, registry)
            item["quota"] = quota
            apply_posix_acl(item)
            apply_share_config(registry)
            save_registry(registry)
        except Exception:
            if created_dir:
                try:
                    if path.is_dir() and not any(path.iterdir()):
                        if filesystem_info(path).get("fstype") == "btrfs" and shutil.which("btrfs"):
                            subprocess.run(["btrfs", "subvolume", "delete", str(path)], check=False)
                        else:
                            path.rmdir()
                except Exception:
                    pass
            raise
        return f"share created: {item['name']}"

    old_name = share_name(payload.get("share_name"))
    existing = registry_entry(registry, old_name)
    if existing is None:
        raise RuntimeError("managed share not found")
    if action == "samba-share-update":
        item = normalize_share_payload(payload, existing)
        if str(item["name"]).casefold() != old_name.casefold() and registry_entry(registry, str(item["name"])):
            raise RuntimeError("target share name already exists")
        path = Path(str(item["path"]))
        ensure_share_directory(path)
        index = registry["shares"].index(existing)
        registry["shares"][index] = item
        quota = apply_quota(item, registry)
        item["quota"] = quota
        apply_posix_acl(item)
        apply_share_config(registry)
        save_registry(registry)
        return f"share updated: {item['name']}"
    if action == "samba-share-delete":
        path = validate_share_path(old_name, existing.get("path"))
        registry["shares"] = [item for item in registry["shares"] if item is not existing]
        apply_share_config(registry)
        save_registry(registry)
        if bool(payload.get("delete_data")):
            if path.exists():
                if path.is_symlink() or SHARE_ROOT not in path.parents:
                    raise RuntimeError("refusing to delete unsafe share data path")
                if filesystem_info(path).get("fstype") == "btrfs" and shutil.which("btrfs"):
                    probe = subprocess.run(["btrfs", "subvolume", "show", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                    if probe.returncode == 0:
                        run(["btrfs", "subvolume", "delete", str(path)], timeout=1800)
                    else:
                        shutil.rmtree(path)
                else:
                    shutil.rmtree(path)
        return f"share removed: {old_name}; data_deleted={bool(payload.get('delete_data'))}"
    raise RuntimeError("unsupported share operation")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(4 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def share_roots(registry: dict[str, Any]) -> list[str]:
    roots: list[str] = []
    for item in registry.get("shares", []):
        if not isinstance(item, dict):
            continue
        name = share_name(item.get("name"))
        path = validate_share_path(name, item.get("path"))
        roots.append(str(path).lstrip("/"))
    return sorted(set(roots))


def create_domain_backup(payload: dict[str, Any], actor: str) -> str:
    mode = str(payload.get("mode") or "domain-config").strip().lower()
    if mode not in {"domain-config", "full"}:
        raise RuntimeError("invalid domain backup mode")
    if not shutil.which("samba-tool"):
        raise RuntimeError("Samba is not installed")
    DOMAIN_BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DOMAIN_BACKUP_DIR, 0o750)
    backup_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(4)
    archive = DOMAIN_BACKUP_DIR / f"{backup_id}.srvdom.tar"
    registry = load_registry()
    domain = current_domain()

    with tempfile.TemporaryDirectory(prefix="domain-backup.", dir=DOMAIN_BACKUP_DIR) as temp_name:
        temp = Path(temp_name)
        domain_dir = temp / "domain"
        control_dir = temp / "control"
        domain_dir.mkdir()
        control_dir.mkdir()

        # A dbcheck before backup detects known database damage without trying
        # to repair it automatically.
        dbcheck = run(["samba-tool", "dbcheck", "--cross-ncs"], timeout=600, check=False)
        if "ERROR:" in dbcheck.upper() or "ERROR(" in dbcheck.upper():
            raise RuntimeError("Samba dbcheck reported errors; backup aborted\n" + dbcheck[-3000:])

        run(["samba-tool", "domain", "backup", "offline", f"--targetdir={domain_dir}"], timeout=1800)
        domain_files = [path for path in domain_dir.iterdir() if path.is_file()]
        if not domain_files:
            raise RuntimeError("Samba domain backup did not create a backup file")

        if SHARES_REGISTRY.is_file():
            shutil.copy2(SHARES_REGISTRY, control_dir / "samba-shares.json")
        if SHARES_INCLUDE.is_file():
            shutil.copy2(SHARES_INCLUDE, control_dir / "srv-control-shares.conf")
        if SMB_CONF.is_file():
            shutil.copy2(SMB_CONF, control_dir / "smb.conf")

        roots = share_roots(registry)
        if roots and shutil.which("getfacl"):
            output = run(["getfacl", "-p", *["/" + item for item in roots]], timeout=300, check=False)
            (control_dir / "share-root-acls.txt").write_text(output + "\n", encoding="utf-8")

        component_hashes: dict[str, str] = {}
        for base in (domain_dir, control_dir):
            for path in sorted(base.rglob("*")):
                if path.is_file():
                    component_hashes[str(path.relative_to(temp))] = sha256_file(path)
        manifest = {
            "schema_version": 1,
            "product": "SRV Control Center",
            "release": "1.3.0",
            "backup_id": backup_id,
            "created_at": now(),
            "created_by": actor,
            "mode": mode,
            "domain": domain,
            "share_roots": roots,
            "component_sha256": component_hashes,
        }
        (temp / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

        run(
            [
                "tar", "--xattrs", "--acls", "--numeric-owner", "-cpf", str(archive),
                "-C", str(temp), "manifest.json", "domain", "control",
            ],
            timeout=600,
        )
        if mode == "full" and roots:
            existing_roots = [item for item in roots if (Path("/") / item).exists()]
            if existing_roots:
                run(
                    [
                        "tar", "--xattrs", "--acls", "--numeric-owner", "-rpf", str(archive),
                        "-C", "/", *existing_roots,
                    ],
                    timeout=24 * 3600,
                )

    os.chmod(archive, 0o600)
    metadata = {
        "schema_version": 1,
        "id": backup_id,
        "archive": archive.name,
        "created_at": now(),
        "mode": mode,
        "domain": domain,
        "sha256": sha256_file(archive),
        "size": archive.stat().st_size,
    }
    write_json(DOMAIN_BACKUP_DIR / f"{backup_id}.json", metadata, 0o640)
    return json.dumps(metadata, ensure_ascii=False)


def safe_member_name(name: str) -> PurePosixPath:
    raw = name.lstrip("./")
    path = PurePosixPath(raw)
    if not raw or path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
        raise RuntimeError(f"unsafe backup member: {name}")
    allowed = (
        raw == "manifest.json"
        or raw.startswith("domain/")
        or raw.startswith("control/")
        or raw.startswith("srv/shares/")
    )
    if not allowed:
        raise RuntimeError(f"unexpected backup member: {name}")
    return path


def validate_archive(archive: Path) -> tuple[dict[str, Any], list[str]]:
    if archive.is_symlink() or not archive.is_file():
        raise RuntimeError("domain import is not a regular archive")
    share_members: list[str] = []
    with tarfile.open(archive, mode="r:*") as tar:
        members = tar.getmembers()
        if len(members) > 5_000_000:
            raise RuntimeError("domain archive contains too many entries")
        for member in members:
            path = safe_member_name(member.name)
            if member.isdev() or member.isfifo():
                raise RuntimeError("device/FIFO entries are not allowed in domain archive")
            if member.issym() or member.islnk():
                link = PurePosixPath(member.linkname)
                if link.is_absolute() or any(part == ".." for part in link.parts):
                    raise RuntimeError("unsafe link in domain archive")
                if not str(path).startswith("srv/shares/"):
                    raise RuntimeError("links are allowed only in share data")
            if str(path).startswith("srv/shares/"):
                share_members.append(str(path))
        try:
            manifest_member = tar.getmember("manifest.json")
        except KeyError as exc:
            raise RuntimeError("domain archive manifest is missing") from exc
        handle = tar.extractfile(manifest_member)
        if handle is None:
            raise RuntimeError("domain archive manifest is unreadable")
        manifest = json.loads(handle.read(2 * 1024 * 1024).decode("utf-8"))
        if not isinstance(manifest, dict) or manifest.get("schema_version") != 1:
            raise RuntimeError("unsupported domain archive manifest")
    return manifest, share_members


def extract_control_components(archive: Path, destination: Path, manifest: dict[str, Any]) -> None:
    destination.mkdir(parents=True, exist_ok=True)
    with tarfile.open(archive, mode="r:*") as tar:
        selected = []
        for member in tar.getmembers():
            path = safe_member_name(member.name)
            raw = str(path)
            if raw == "manifest.json" or raw.startswith("domain/") or raw.startswith("control/"):
                if member.issym() or member.islnk() or member.isdev() or member.isfifo():
                    raise RuntimeError("links/devices are not allowed in domain/control metadata")
                selected.append(member)
        tar.extractall(destination, members=selected, filter="data")
    expected = manifest.get("component_sha256")
    if not isinstance(expected, dict):
        raise RuntimeError("component checksums missing from manifest")
    for raw_name, expected_hash in expected.items():
        name = safe_member_name(str(raw_name))
        if str(name).startswith("srv/shares/"):
            continue
        path = destination / str(name)
        if not path.is_file() or sha256_file(path) != str(expected_hash):
            raise RuntimeError(f"component checksum failed: {name}")


def provisioned_domain_exists() -> bool:
    common = (
        Path("/var/lib/samba/private/sam.ldb"),
        Path("/usr/local/samba/private/sam.ldb"),
    )
    if any(path.is_file() for path in common):
        return True
    role = run(["testparm", "-s", "--parameter-name", "server role"], timeout=10, check=False).casefold()
    return "active directory domain controller" in role


def current_netbios_name() -> str:
    raw = os.uname().nodename.split(".", 1)[0].upper()
    raw = re.sub(r"[^A-Z0-9-]", "-", raw).strip("-")[:15]
    if not raw:
        raise RuntimeError("unable to derive a valid NetBIOS DC name from hostname")
    return raw


def restore_domain_backup(payload: dict[str, Any]) -> str:
    token = str(payload.get("import_ref") or "")
    if not TOKEN_RE.fullmatch(token):
        raise RuntimeError("invalid domain import reference")
    archive = IMPORT_DIR / f"{token}.upload"
    name_file = IMPORT_DIR / f"{token}.name"
    if provisioned_domain_exists():
        raise RuntimeError(
            "domain restore is refused on an already provisioned Samba AD DC; use a newly installed, unprovisioned server"
        )
    try:
        manifest, share_members = validate_archive(archive)
        with tempfile.TemporaryDirectory(prefix="domain-import.", dir=IMPORT_DIR) as temp_name:
            temp = Path(temp_name)
            extract_control_components(archive, temp, manifest)
            domain_dir = temp / "domain"
            domain_files = sorted(path for path in domain_dir.iterdir() if path.is_file())
            if not domain_files:
                raise RuntimeError("Samba domain backup component is missing")
            backup_file = domain_files[0]
            restore_id = str(manifest.get("backup_id") or secrets.token_hex(8))
            if not re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", restore_id):
                restore_id = secrets.token_hex(8)
            target = RESTORE_ROOT / restore_id
            if target.exists():
                raise RuntimeError("restore target already exists")
            target.parent.mkdir(parents=True, exist_ok=True)
            new_dc = current_netbios_name()
            run(
                [
                    "samba-tool", "domain", "backup", "restore",
                    f"--backup-file={backup_file}",
                    f"--newservername={new_dc}",
                    f"--targetdir={target}",
                ],
                timeout=3600,
            )
            restored_conf = target / "etc" / "smb.conf"
            if not restored_conf.is_file():
                raise RuntimeError("restored Samba smb.conf is missing")
            run(["testparm", "-s", "--suppress-prompt", str(restored_conf)], timeout=30)

            old_conf = SMB_CONF.read_bytes() if SMB_CONF.is_file() else None
            old_registry = SHARES_REGISTRY.read_bytes() if SHARES_REGISTRY.is_file() else None
            old_include = SHARES_INCLUDE.read_bytes() if SHARES_INCLUDE.is_file() else None
            try:
                for unit in ("samba-ad-dc.service", "samba.service", "smbd.service", "nmbd.service", "winbind.service"):
                    subprocess.run(["systemctl", "stop", unit], check=False)
                SMB_CONF.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(restored_conf, SMB_CONF)
                control_dir = temp / "control"
                restored_registry = control_dir / "samba-shares.json"
                restored_include = control_dir / "srv-control-shares.conf"
                if restored_registry.is_file():
                    shutil.copy2(restored_registry, SHARES_REGISTRY)
                if restored_include.is_file():
                    shutil.copy2(restored_include, SHARES_INCLUDE)
                    conf = SMB_CONF.read_text(encoding="utf-8", errors="strict")
                    SMB_CONF.write_text(ensure_include(conf, SHARES_INCLUDE), encoding="utf-8")

                roots_raw = manifest.get("share_roots") if isinstance(manifest.get("share_roots"), list) else []
                roots = [str(safe_member_name(str(item))) for item in roots_raw]
                for root in roots:
                    if not root.startswith("srv/shares/"):
                        raise RuntimeError("manifest contains an unsafe share root")
                    (Path("/") / root).mkdir(parents=True, exist_ok=True)

                if str(manifest.get("mode")) == "full" and share_members and roots:
                    patterns: list[str] = []
                    for root in roots:
                        patterns.extend([root, root + "/*"])
                    run(
                        [
                            "tar", "--xattrs", "--acls", "--numeric-owner", "-xpf", str(archive),
                            "-C", "/", "--wildcards", *patterns,
                        ],
                        timeout=24 * 3600,
                    )
                acl_file = control_dir / "share-root-acls.txt"
                if acl_file.is_file() and shutil.which("setfacl"):
                    run(["setfacl", "--restore=-"], input_text=acl_file.read_text(encoding="utf-8"), timeout=600)

                run(["testparm", "-s", "--suppress-prompt", str(SMB_CONF)], timeout=30)
                subprocess.run(["systemctl", "daemon-reload"], check=False)
                started = False
                for unit in ("samba-ad-dc.service", "samba.service"):
                    probe = subprocess.run(["systemctl", "show", unit, "-p", "LoadState", "--value"], capture_output=True, text=True, check=False)
                    if probe.returncode == 0 and probe.stdout.strip() not in {"", "not-found"}:
                        run(["systemctl", "enable", "--now", unit], timeout=120)
                        started = True
                        break
                if not started:
                    raise RuntimeError("no Samba AD systemd service was found after restore")
                run(["samba-tool", "dbcheck", "--cross-ncs"], timeout=600)
            except Exception:
                for unit in ("samba-ad-dc.service", "samba.service"):
                    subprocess.run(["systemctl", "stop", unit], check=False)
                if old_conf is None:
                    SMB_CONF.unlink(missing_ok=True)
                else:
                    SMB_CONF.write_bytes(old_conf)
                if old_registry is None:
                    SHARES_REGISTRY.unlink(missing_ok=True)
                else:
                    SHARES_REGISTRY.write_bytes(old_registry)
                if old_include is None:
                    SHARES_INCLUDE.unlink(missing_ok=True)
                else:
                    SHARES_INCLUDE.write_bytes(old_include)
                raise
        refresh()
        return f"domain restored: backup={manifest.get('backup_id')} new_dc={current_netbios_name()}"
    finally:
        archive.unlink(missing_ok=True)
        name_file.unlink(missing_ok=True)


def install_samba() -> str:
    if shutil.which("samba-tool") and shutil.which("samba"):
        refresh()
        return "Samba AD DC packages are already installed; existing domain was not reprovisioned"
    run(["apt-get", "update", "-y"], timeout=600)
    packages = [
        "samba",
        "samba-common-bin",
        "smbclient",
        "winbind",
        "libnss-winbind",
        "libpam-winbind",
        "krb5-user",
        "acl",
        "attr",
        "quota",
        "xfsprogs",
        "btrfs-progs",
    ]
    run(["apt-get", "install", "-y", "--no-install-recommends", *packages], timeout=1800)
    refresh()
    return "Samba AD DC packages installed; domain is not provisioned automatically"


def remove_samba(actor: str) -> str:
    backup_detail = None
    if provisioned_domain_exists():
        backup_detail = create_domain_backup({"mode": "domain-config"}, actor)
    for unit in ("samba-ad-dc.service", "samba.service", "smbd.service", "nmbd.service", "winbind.service"):
        subprocess.run(["systemctl", "disable", "--now", unit], check=False)
    packages = ["samba", "samba-common-bin", "smbclient", "winbind", "libnss-winbind", "libpam-winbind"]
    run(["apt-get", "remove", "-y", *packages], timeout=1800)
    refresh()
    return "Samba packages removed without purging domain/share data" + (f"; backup={backup_detail}" if backup_detail else "")


def handle(request: dict[str, Any]) -> str:
    action = str(request.get("action") or "")
    payload = request.get("payload") if isinstance(request.get("payload"), dict) else {}
    actor = clean_text(request.get("actor") or "unknown", maximum=256)
    if action == "service-install-samba-dc":
        return install_samba()
    if action == "service-remove-samba-dc":
        if bool(payload.get("purge_domain_data")):
            raise RuntimeError("domain data purge is not supported by the standard remove action")
        return remove_samba(actor)
    if action == "samba-password-policy":
        result = password_policy(payload)
    elif action == "samba-user-create":
        result = create_user(payload)
    elif action.startswith("samba-user-"):
        result = user_operation(action, payload)
    elif action.startswith("samba-group-"):
        result = group_operation(action, payload)
    elif action in {"samba-share-create", "samba-share-update", "samba-share-delete"}:
        result = share_operation(action, payload)
    elif action == "samba-backup-create":
        result = create_domain_backup(payload, actor)
    elif action == "samba-backup-restore":
        return restore_domain_backup(payload)
    else:
        raise RuntimeError("unsupported Samba administration action")
    refresh()
    return result


def main() -> int:
    try:
        request = json.loads(sys.stdin.read())
    except Exception as exc:
        raise SystemExit(f"invalid request JSON: {exc}")
    if not isinstance(request, dict):
        raise SystemExit("request must be a JSON object")
    try:
        detail = handle(request)
        print(json.dumps({"ok": True, "detail": detail}, ensure_ascii=False))
        return 0
    except Exception as exc:
        print(json.dumps({"ok": False, "detail": str(exc)[-12000:]}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    import sys
    raise SystemExit(main())
