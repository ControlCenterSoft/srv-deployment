#!/usr/bin/env python3
from __future__ import annotations

from datetime import datetime, timezone
import grp
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
from typing import Any


OUTPUT = Path("/var/lib/srv-control/samba-shares-status.json")
REGISTRY = Path("/var/lib/srv-control/samba-shares.json")
APP_GROUP = "srv-control"
SYSTEM_SHARES = {"global", "netlogon", "sysvol", "homes", "printers", "print$"}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def run(command: list[str], timeout: int = 15) -> tuple[int, str]:
    try:
        completed = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
            env={**os.environ, "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8"},
        )
    except Exception as exc:
        return 1, str(exc)
    return completed.returncode, (completed.stdout or "").strip()


def read_registry() -> dict[str, dict[str, Any]]:
    try:
        value = json.loads(REGISTRY.read_text(encoding="utf-8"))
    except Exception:
        return {}
    shares = value.get("shares") if isinstance(value, dict) else None
    if not isinstance(shares, list):
        return {}
    result: dict[str, dict[str, Any]] = {}
    for item in shares:
        if not isinstance(item, dict):
            continue
        name = str(item.get("name") or "").strip()
        if name:
            result[name.casefold()] = item
    return result


def parse_testparm() -> dict[str, dict[str, str]]:
    code, output = run(["testparm", "-s", "--suppress-prompt"], 20)
    if code != 0:
        return {}
    sections: dict[str, dict[str, str]] = {}
    current: str | None = None
    for raw in output.splitlines():
        line = raw.strip()
        if not line:
            continue
        match = re.fullmatch(r"\[([^]]+)\]", line)
        if match:
            current = match.group(1).strip()
            sections.setdefault(current, {})
            continue
        if current is None or "=" not in line:
            continue
        key, value = line.split("=", 1)
        sections[current][key.strip().casefold()] = value.strip()
    return sections


def filesystem_info(path: str | None) -> dict[str, Any]:
    if not path:
        return {"exists": False, "quota_supported": False, "quota_backend": None}
    target = Path(path)
    exists = target.exists()
    code, output = run(["findmnt", "-T", str(target), "-n", "-o", "FSTYPE,OPTIONS,TARGET,SOURCE"], 8)
    if code != 0 or not output:
        return {"exists": exists, "quota_supported": False, "quota_backend": None}
    parts = output.split(None, 3)
    fstype = parts[0] if parts else ""
    options = parts[1] if len(parts) > 1 else ""
    mountpoint = parts[2] if len(parts) > 2 else None
    source = parts[3] if len(parts) > 3 else None
    option_set = {item.strip().casefold() for item in options.split(",")}
    backend = None
    supported = False
    reason = None
    if fstype == "xfs" and option_set.intersection({"pquota", "prjquota"}):
        backend = "xfs-project"
        supported = shutil.which("xfs_quota") is not None
        if not supported:
            reason = "xfs_quota не установлен"
    elif fstype in {"ext4", "ext3"} and "prjquota" in option_set:
        backend = "ext-project"
        supported = shutil.which("setquota") is not None and shutil.which("chattr") is not None
        if not supported:
            reason = "setquota/chattr не установлены"
    elif fstype == "btrfs":
        backend = "btrfs-qgroup"
        supported = shutil.which("btrfs") is not None
        if supported and exists:
            probe = subprocess.run(
                ["btrfs", "subvolume", "show", str(target)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            supported = probe.returncode == 0
            if not supported:
                reason = "корень шары не является Btrfs subvolume"
    elif fstype == "zfs":
        backend = "zfs-dataset"
        supported = shutil.which("zfs") is not None and mountpoint is not None and Path(mountpoint) == target
        if not supported:
            reason = "квота ZFS доступна только для корня dataset"
    else:
        reason = "файловая система/точка монтирования не поддерживает directory quota"
    return {
        "exists": exists,
        "fstype": fstype or None,
        "mount_options": options or None,
        "mountpoint": mountpoint,
        "source": source,
        "quota_supported": supported,
        "quota_backend": backend,
        "quota_reason": reason,
    }


def bool_value(value: str | None, default: bool) -> bool:
    if value is None:
        return default
    return value.strip().casefold() in {"yes", "true", "1"}


def list_value(value: str | None) -> list[str]:
    if not value:
        return []
    return [item.strip() for item in value.split(",") if item.strip()]


def main() -> int:
    installed = shutil.which("testparm") is not None
    registry = read_registry()
    sections = parse_testparm() if installed else {}
    shares: list[dict[str, Any]] = []
    for name, values in sorted(sections.items(), key=lambda item: item[0].casefold()):
        if name.casefold() == "global":
            continue
        path = values.get("path")
        managed = registry.get(name.casefold())
        shares.append(
            {
                "name": name,
                "comment": values.get("comment"),
                "path": path,
                "browseable": bool_value(values.get("browseable"), True),
                "read_only": bool_value(values.get("read only"), True),
                "valid_users": list_value(values.get("valid users")),
                "read_list": list_value(values.get("read list")),
                "write_list": list_value(values.get("write list")),
                "system": name.casefold() in SYSTEM_SHARES,
                "managed": managed is not None,
                "subjects": managed.get("subjects", []) if managed else [],
                "quota": managed.get("quota") if managed else None,
                "filesystem": filesystem_info(path),
            }
        )

    payload = {
        "schema_version": 1,
        "checked_at": now(),
        "installed": installed,
        "shares": shares,
        "managed_count": sum(1 for item in shares if item["managed"]),
        "error": None,
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=OUTPUT.parent, prefix=OUTPUT.name + ".tmp.", delete=False
    )
    try:
        json.dump(payload, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), 0o640)
        tmp = Path(handle.name)
    finally:
        handle.close()
    try:
        gid = grp.getgrnam(APP_GROUP).gr_gid
        os.chown(tmp, 0, gid)
    except Exception:
        pass
    os.replace(tmp, OUTPUT)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
