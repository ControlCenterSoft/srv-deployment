

def peek_boot_profile(mac_value: str) -> dict | None:
    """Return an authorized PXE profile without consuming one-time authorization.

    The boot authorization is deliberately consumed only after iPXE has fetched
    every boot-critical profile artifact. This prevents a transient HTTP/TFTP
    or publication failure from burning the one-time install permission.
    """
    mac = normalize_mac(mac_value)
    with engine.begin() as connection:
        row = connection.execute(text(
            '''SELECT p.id,p.status,p.install_authorized,p.one_time,p.config,
                      i.kind,i.id AS image_id,i.architecture,i.metadata,d.mac
               FROM pxe_profiles p
               JOIN devices d ON d.id=p.device_id
               JOIN os_images i ON i.id=p.os_image_id
               WHERE d.mac=:mac FOR UPDATE'''), {'mac': mac}).mappings().first()
        if not row or not row['install_authorized'] or row['status'] != 'authorized':
            return None
        config = row.get('config') or {}
        if isinstance(config, str):
            try:
                config = json.loads(config)
            except Exception:
                config = {}
        boot_token = str(config.get('boot_token') or '')
        if not boot_token:
            boot_token = secrets.token_urlsafe(32)
            config = {**config, 'boot_token': boot_token}
            connection.execute(
                text('UPDATE pxe_profiles SET config=CAST(:config AS jsonb),last_boot_at=now(),updated_at=now() WHERE id=:id'),
                {'config': json.dumps(config, ensure_ascii=False), 'id': int(row['id'])},
            )
        else:
            connection.execute(text('UPDATE pxe_profiles SET last_boot_at=now(),updated_at=now() WHERE id=:id'), {'id': int(row['id'])})
        result = dict(row)
        result['config'] = config
        return result


def profile_boot_token_valid(profile_id: int, token: str) -> bool:
    row = _one('SELECT id,status,config FROM pxe_profiles WHERE id=:id', {'id': profile_id})
    if not row or str(row.get('status') or '') not in {'authorized', 'installing'}:
        return False
    config = row.get('config') or {}
    if isinstance(config, str):
        try:
            config = json.loads(config)
        except Exception:
            config = {}
    expected = str(config.get('boot_token') or '')
    return bool(expected) and secrets.compare_digest(expected, str(token or ''))


def consume_boot_profile(profile_id: int, mac_value: str, token: str) -> bool:
    """Atomically consume an authorized profile after boot payload staging."""
    mac = normalize_mac(mac_value)
    with engine.begin() as connection:
        row = connection.execute(text(
            '''SELECT p.id,p.status,p.install_authorized,p.config,d.mac
               FROM pxe_profiles p JOIN devices d ON d.id=p.device_id
               WHERE p.id=:id AND d.mac=:mac FOR UPDATE'''),
            {'id': profile_id, 'mac': mac},
        ).mappings().first()
        if not row or not row['install_authorized'] or row['status'] != 'authorized':
            return False
        config = row.get('config') or {}
        if isinstance(config, str):
            try:
                config = json.loads(config)
            except Exception:
                config = {}
        expected = str(config.get('boot_token') or '')
        if not expected or not secrets.compare_digest(expected, str(token or '')):
            return False
        connection.execute(text(
            "UPDATE pxe_profiles SET install_authorized=false,status='installing',consumed_at=now(),last_boot_at=now(),updated_at=now() WHERE id=:id"
        ), {'id': profile_id})
        return True


# These options are generated by structured Control Center settings or are
# reserved for the managed PXE chain. Allowing a raw duplicate can create two
# contradictory DHCP answers and make failures firmware-dependent. Option 60
# is reserved because UEFI HTTP Boot requires the HTTPClient vendor class.
MANAGED_DHCP_OPTION_CODES = {3, 6, 60, 66, 67, 93, 175}


def _validate_extra_dhcp_option(code: int, value: str) -> tuple[int, str]:
    if code < 1 or code > 254:
        raise ValueError('код DHCP option должен быть 1..254')
    if code in MANAGED_DHCP_OPTION_CODES:
        raise ValueError(
            f'DHCP option {code} управляется Control Center/PXE и недоступен как дополнительный параметр'
        )
    clean = str(value or '').strip()
    if not clean or len(clean) > 1024 or any(ch in clean for ch in '\r\n\x00'):
        raise ValueError('некорректное значение DHCP option')
    return code, clean


def add_dhcp_option(code: int, value: str) -> dict:
    code, clean = _validate_extra_dhcp_option(int(code), value)
    row = _one(
        'INSERT INTO dhcp_options (code,value,enabled) VALUES (:code,:value,true) RETURNING id,code,value,enabled,updated_at',
        {'code': code, 'value': clean},
    )
    return row or {}


def update_dhcp_option(option_id: int, payload: dict) -> None:
    code, value = _validate_extra_dhcp_option(int(payload.get('code')), str(payload.get('value') or ''))
    enabled = bool(payload.get('enabled', True))
    _execute(
        'UPDATE dhcp_options SET code=:code,value=:value,enabled=:enabled,updated_at=now() WHERE id=:id',
        {'id': option_id, 'code': code, 'value': value, 'enabled': enabled},
    )


def _prepare_pxe_attempt(profile_id: int, *, emergency_retry: bool) -> dict:
    """Validate a profile and rotate attempt-scoped secrets before publication."""
    with engine.begin() as connection:
        profile = connection.execute(text(
            '''SELECT p.id,p.computer_name,p.os_image_id,p.status,p.config,
                      i.kind,i.enabled,i.metadata,d.mac
               FROM pxe_profiles p
               JOIN devices d ON d.id=p.device_id
               LEFT JOIN os_images i ON i.id=p.os_image_id
               WHERE p.id=:id FOR UPDATE'''), {'id': profile_id}).mappings().first()
        if not profile:
            raise ValueError('PXE-профиль не найден')
        status = str(profile.get('status') or 'draft')
        if status in {'publishing', 'authorized'}:
            raise ValueError('PXE-профиль уже публикуется или уже разрешён')
        if status == 'installing' and not emergency_retry:
            raise ValueError('PXE-установка уже была запущена; используйте аварийное повторное разрешение только после остановки предыдущей установки')
        if emergency_retry and status != 'installing':
            raise ValueError('аварийное повторное разрешение доступно только для профиля в состоянии installing')
        if not profile.get('os_image_id') or not profile.get('kind') or not profile.get('enabled'):
            raise ValueError('PXE-профиль не связан с доступным образом ОС')
        metadata = profile.get('metadata') or {}
        if isinstance(metadata, str):
            try:
                metadata = json.loads(metadata)
            except Exception:
                metadata = {}
        if metadata.get('status') not in {'ready', 'published'}:
            raise ValueError('образ ОС ещё не подготовлен для PXE')
        validate_computer_name(str(profile.get('computer_name') or ''), str(profile['kind']))

        config = profile.get('config') or {}
        if isinstance(config, str):
            try:
                config = json.loads(config)
            except Exception:
                config = {}
        # Tokens are attempt-scoped. Rotating both makes callbacks/artifacts from
        # an older interrupted installation cryptographically stale.
        config = {
            **config,
            'kind': str(profile['kind']),
            'boot_token': secrets.token_urlsafe(32),
            'report_token': secrets.token_urlsafe(32),
        }
        reason = 'emergency-retry-requested' if emergency_retry else None
        connection.execute(text(
            '''UPDATE pxe_profiles
               SET status='publishing',install_authorized=false,authorized_at=NULL,
                   consumed_at=NULL,last_result=:reason,config=CAST(:config AS jsonb),updated_at=now()
               WHERE id=:id'''),
            {'id': profile_id, 'reason': reason, 'config': json.dumps(config, ensure_ascii=False)},
        )
        return {
            'id': profile_id,
            'status': 'publishing',
            'install_authorized': False,
            'emergency_retry': emergency_retry,
        }


def authorize_pxe_profile(profile_id: int) -> dict:
    return _prepare_pxe_attempt(profile_id, emergency_retry=False)


def force_retry_pxe_profile(profile_id: int) -> dict:
    return _prepare_pxe_attempt(profile_id, emergency_retry=True)


def report_pxe(profile_id: int, token: str, result: str) -> bool:
    """Accept only the callback for the currently consumed installation attempt."""
    if result not in {'success', 'failed'}:
        return False
    with engine.begin() as connection:
        row = connection.execute(text(
            'SELECT id,status,config FROM pxe_profiles WHERE id=:id FOR UPDATE'
        ), {'id': profile_id}).mappings().first()
        if not row or str(row.get('status') or '') != 'installing':
            return False
        config = row.get('config') or {}
        if isinstance(config, str):
            try:
                config = json.loads(config)
            except Exception:
                config = {}
        expected = str(config.get('report_token') or '')
        if not expected or not secrets.compare_digest(expected, str(token or '')):
            return False
        status = 'installed' if result == 'success' else 'failed'
        connection.execute(text(
            '''UPDATE pxe_profiles
               SET status=:status,install_authorized=false,last_result=:result,updated_at=now()
               WHERE id=:id AND status='installing' '''
        ), {'status': status, 'result': result, 'id': profile_id})
        return True
