    security=str(wifi.get('security') or 'wpa2-wpa3'); same=bool(wifi.get('same_bands',True)); primary=str(wifi.get('interface') or '').strip(); secondary=str(wifi.get('secondary_interface') or '').strip()
    if not primary: raise RuntimeError('Wi-Fi AP/repeater interface is required')
    units=[]
    if mode=='repeater':
        apif=secondary
        pre=None
        if not apif:
            apif='srvap0'; pre=f'/bin/sh -c "/usr/sbin/iw dev {primary} interface add srvap0 type __ap 2>/dev/null || true"'
        ssid=str(wifi.get('ssid') or 'INFO'); password=_safe_secret(wifi.get('password'),'Wi-Fi password')
        conf=Path('/etc/hostapd/srv-control-24.conf'); _write_root_file(conf,_hostapd_config(apif,ssid,password,'2.4',int((wifi.get('band24') or {}).get('channel') or 6),security),0o600)
        _write_hostapd_unit('24',conf,pre); units.append('srv-control-hostapd-24.service')
        nft='table ip srvcc_repeater { chain forward { type filter hook forward priority 0; policy accept; } chain postrouting { type nat hook postrouting priority 100; oifname "'+primary+'" masquerade; } }\n'
        _write_root_file(Path('/etc/srv-control/repeater.nft'),nft,0o600); _write_root_file(Path('/etc/sysctl.d/90-srv-control-repeater.conf'),'net.ipv4.ip_forward=1\n',0o644); run(['sysctl','--system'],timeout=60,check=False)
        _write_root_file(Path('/etc/systemd/system/srv-control-repeater-nat.service'),'[Unit]\nDescription=SRV Control Center repeater NAT\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/sbin/nft -f /etc/srv-control/repeater.nft\nExecStop=/usr/sbin/nft delete table ip srvcc_repeater\n\n[Install]\nWantedBy=multi-user.target\n',0o644); units.append('srv-control-repeater-nat.service')
    else:
        password=_safe_secret(wifi.get('password'),'Wi-Fi password'); common_ssid=str(wifi.get('ssid') or 'INFO'); b24=wifi.get('band24') if isinstance(wifi.get('band24'),dict) else {}; b5=wifi.get('band5') if isinstance(wifi.get('band5'),dict) else {}
        ssid24=common_ssid if same else str(b24.get('ssid') or common_ssid); ssid5=common_ssid if same else str(b5.get('ssid') or common_ssid)
        conf24=Path('/etc/hostapd/srv-control-24.conf'); _write_root_file(conf24,_hostapd_config(primary,ssid24,password,'2.4',int(b24.get('channel') or 6),security),0o600); _write_hostapd_unit('24',conf24); units.append('srv-control-hostapd-24.service')
        if secondary:
            conf5=Path('/etc/hostapd/srv-control-5.conf'); _write_root_file(conf5,_hostapd_config(secondary,ssid5,password,'5',int(b5.get('channel') or 36),security),0o600); _write_hostapd_unit('5',conf5); units.append('srv-control-hostapd-5.service')
    run(['systemctl','daemon-reload'],timeout=30)
    for unit in units: run(['systemctl','enable','--now',unit],timeout=30)
    lan=config.get('lan') if isinstance(config.get('lan'),dict) else {}; lan_if=str(lan.get('interface') or '')
    rows=psql_json('SELECT interface FROM dhcp_configs WHERE id=1') or []
    if rows and rows[0].get('interface')==lan_if:
        psql_exec("UPDATE dhcp_configs SET interface='br0',updated_at=now() WHERE id=1;")
        try: apply_dhcp()
        except Exception: pass
    if mode=='ap' and not secondary:
        return 'AP active on one radio; simultaneous 2.4+5 GHz requires a second AP-capable interface/PHY'
    return f'Wi-Fi mode {mode} active'


def ensure_network_dependencies(config: dict) -> None:
    wan=config.get('wan') if isinstance(config.get('wan'),dict) else {}; wifi=config.get('wifi') if isinstance(config.get('wifi'),dict) else {}
    packages=[]
    if str(wan.get('mode') or 'dhcp')=='pppoe': packages += ['ppp']
    if str(wan.get('mode') or 'dhcp')=='l2tp': packages += ['ppp','xl2tpd']
    if str(wifi.get('mode') or 'disabled') in {'ap','repeater'}: packages += ['hostapd','iw','nftables']
    if packages: apt_install(*sorted(set(packages)))


def network_apply(payload: dict) -> str:
    config=payload.get('config') if isinstance(payload.get('config'),dict) else {}; ensure_network_dependencies(config); token=secrets.token_hex(12); backup_dir=STATE_DIR/'network-backups'; backup_dir.mkdir(parents=True,exist_ok=True)
    backup=backup_dir/f'{token}.yaml'; absent=backup_dir/f'{token}.absent'; previous=read_json(NETWORK_CONFIG,{})
    if NETPLAN_FILE.exists(): shutil.copy2(NETPLAN_FILE,backup)
    else: absent.write_text('absent\n',encoding='utf-8')
    content=render_netplan(config); NETPLAN_FILE.parent.mkdir(parents=True,exist_ok=True); NETPLAN_FILE.write_text(content,encoding='utf-8'); os.chmod(NETPLAN_FILE,0o600)
    run(['netplan','generate'],timeout=60)
    pending={'token':token,'backup':str(backup),'absent':str(absent),'created_at':now(),'previous_config':previous}; write_json(NETWORK_PENDING,pending,0o640); write_json(NETWORK_CONFIG,config,0o640)
    subprocess.run(['systemd-run','--unit=srv-control-network-rollback','--on-active=120s','/usr/local/libexec/srv-control-release14-agent','--network-rollback',token],check=True)
    run(['netplan','apply'],timeout=120)
    configure_special_wan(config); wifi_detail=configure_wifi(config)
    return f'network applied; {wifi_detail}; rollback token={token}; confirm within 120 seconds'


def network_confirm() -> str:
    pending=read_json(NETWORK_PENDING,{})
    subprocess.run(['systemctl','stop','srv-control-network-rollback.timer'],check=False); subprocess.run(['systemctl','stop','srv-control-network-rollback.service'],check=False)
    NETWORK_PENDING.unlink(missing_ok=True)
    return f"network confirmed token={pending.get('token') or 'none'}"


