            'dhcp-userclass=set:ipxe,iPXE',
            'dhcp-match=set:efi64,option:client-arch,7',
            'dhcp-match=set:efi64,option:client-arch,9',
            f"dhcp-boot=tag:ipxe,autoexec.ipxe,,{c['gateway']}",
            f"dhcp-boot=tag:efi64,ipxe.efi,,{c['gateway']}",
            f"dhcp-boot=tag:!efi64,undionly.kpxe,,{c['gateway']}",
        ]
    DHCP_CONF.parent.mkdir(parents=True, exist_ok=True)
    DHCP_CONF.write_text('\n'.join(lines) + '\n', encoding='utf-8'); os.chmod(DHCP_CONF,0o644)
    run(['dnsmasq','--test'], timeout=30)
    run(['systemctl','enable','--now','dnsmasq.service'], timeout=30)
    run(['systemctl','restart','dnsmasq.service'], timeout=30)
    return f"DHCP active on {c['interface']} range {c['range_start']}..{c['range_end']}"


def _find_ipxe(name: str) -> Path | None:
    for root in (Path('/usr/lib/ipxe'), Path('/usr/share/ipxe'), Path('/usr/lib/syslinux')):
        if root.exists():
            for p in root.rglob(name):
                if p.is_file(): return p
    return None


def ensure_pxe_samba_share() -> dict:
    if not shutil.which('smbpasswd') or not SMB_CONF.exists():
        apt_install('samba','samba-common-bin')
    try:
        run(['id','srv-pxe'], timeout=10)
    except Exception:
        run(['useradd','--system','--no-create-home','--shell','/usr/sbin/nologin','srv-pxe'], timeout=30)
    cred = read_json(PXE_CRED,{})
    password = str(cred.get('password') or '')
    if not password:
        password = secrets.token_urlsafe(24)
        write_json(PXE_CRED, {'username':'srv-pxe','password':password}, 0o600)
    run(['smbpasswd','-s','-a','srv-pxe'], input_text=password+'\n'+password+'\n', timeout=30)
    text = SMB_CONF.read_text(encoding='utf-8', errors='replace') if SMB_CONF.exists() else '[global]\nworkgroup = WORKGROUP\n'
    pattern = re.compile(re.escape(SMB_BEGIN)+r'.*?'+re.escape(SMB_END)+r'\n?', re.S)
    text = pattern.sub('', text)
    share = f"\n{SMB_BEGIN}\n[PXE$]\n    path = /srv/pxe\n    browseable = no\n    read only = yes\n    guest ok = no\n    valid users = srv-pxe\n{SMB_END}\n"
    SMB_CONF.write_text(text.rstrip()+share, encoding='utf-8')
    run(['testparm','-s',str(SMB_CONF)], timeout=30)
    for unit in ('samba-ad-dc.service','smbd.service','samba.service'):
        state = run(['systemctl','show',unit,'-p','LoadState','--value'],timeout=10,check=False).strip()
        if state and state != 'not-found': subprocess.run(['systemctl','restart',unit],check=False)
    return {'username':'srv-pxe','password':password}


def remove_pxe_samba_share() -> None:
    if SMB_CONF.exists():
        text=SMB_CONF.read_text(encoding='utf-8',errors='replace')
        text=re.sub(re.escape(SMB_BEGIN)+r'.*?'+re.escape(SMB_END)+r'\n?','',text,flags=re.S)
        SMB_CONF.write_text(text,encoding='utf-8')
        subprocess.run(['testparm','-s',str(SMB_CONF)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)
    subprocess.run(['smbpasswd','-x','srv-pxe'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)


def install_pxe() -> str:
    apt_install('tftpd-hpa','ipxe','wimtools','curl','samba-common-bin')
    for p in (TFTP_ROOT,PXE_ROOT,PXE_ROOT/'boot',PXE_ROOT/'images',PXE_ROOT/'profiles',PXE_ROOT/'isos',PXE_ROOT/'software'):
        p.mkdir(parents=True, exist_ok=True); os.chmod(p,0o755)
    for name in ('undionly.kpxe','ipxe.efi'):
        src=_find_ipxe(name)
        if not src: raise RuntimeError(f'iPXE binary {name} not found after package installation')
        shutil.copy2(src,TFTP_ROOT/name); os.chmod(TFTP_ROOT/name,0o644)
    (TFTP_ROOT/'autoexec.ipxe').write_text('#!ipxe\ndhcp\nchain http://${next-server}/pxe/boot.ipxe?mac=${net0/mac} || exit\n',encoding='utf-8')
    defaults=Path('/etc/default/tftpd-hpa')
    defaults.write_text('TFTP_USERNAME="tftp"\nTFTP_DIRECTORY="/srv/tftp"\nTFTP_ADDRESS=":69"\nTFTP_OPTIONS="--secure --create"\n',encoding='utf-8')
    wimboot=PXE_ROOT/'boot/wimboot'
    run(['curl','-fL','--retry','3','--connect-timeout','15','-o',str(wimboot),WIMBOOT_URL],timeout=180)
    if wimboot.stat().st_size < 50000: raise RuntimeError('downloaded wimboot is unexpectedly small')
    os.chmod(wimboot,0o644)
    ensure_pxe_samba_share()
    run(['systemctl','enable','--now','tftpd-hpa.service'],timeout=30)
    if shutil.which('dnsmasq') and DHCP_CONF.exists():
        try: apply_dhcp()
        except Exception: pass
    return 'PXE Server installed: TFTP/iPXE/wimboot and read-only PXE$ media share ready'


def remove_pxe() -> str:
    subprocess.run(['systemctl','disable','--now','tftpd-hpa.service'],check=False)
    remove_pxe_samba_share()
    run(['apt-get','remove','-y','tftpd-hpa'],timeout=900)
    return 'PXE service removed; /srv/pxe, images and profiles preserved'


def _mount_iso(source: Path):
    mount=Path(tempfile.mkdtemp(prefix='srvcc-iso.',dir='/mnt'))
    run(['mount','-o','loop,ro',str(source),str(mount)],timeout=60)
    return mount


def _umount(mount: Path):
    subprocess.run(['umount',str(mount)],check=False); shutil.rmtree(mount,ignore_errors=True)


def _windows_editions(path: Path) -> list[dict]:
    out=run(['wimlib-imagex','info',str(path),'--xml'],timeout=180)
    try:
        root=ET.fromstring(out); items=[]
        for image in root.findall('.//IMAGE'):
            idx=int(image.attrib.get('INDEX') or 0); name=image.findtext('NAME') or image.findtext('DISPLAYNAME') or f'Index {idx}'
            items.append({'index':idx,'name':name})
        return items
    except Exception:
        return []


def prepare_image(payload: dict) -> str:
