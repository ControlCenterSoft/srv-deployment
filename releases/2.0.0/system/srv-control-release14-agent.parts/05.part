        lines += [f'    {li}:',f'      addresses: [{_yaml_quote(lan.get("address"))}]','      dhcp4: false']
    if mode in {'client','repeater'}:
        iface=str(wifi.get('interface') or '').strip(); ssid=str(wifi.get('upstream_ssid') or wifi.get('ssid') or '').strip(); password=str(wifi.get('upstream_password') or wifi.get('password') or '')
        if not iface or not ssid: raise RuntimeError('Wi-Fi client/repeater requires upstream interface and SSID')
        lines += ['  wifis:',f'    {iface}:','      dhcp4: true','      optional: true','      access-points:',f'        {_yaml_quote(ssid)}:',f'          password: {_yaml_quote(password)}']
    return '\n'.join(lines)+'\n'


def _write_root_file(path: Path, text_value: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True,exist_ok=True); path.write_text(text_value,encoding='utf-8'); os.chmod(path,mode)


def stop_special_wan() -> None:
    for unit in ('srv-control-pppoe.service','srv-control-l2tp.service'):
        subprocess.run(['systemctl','disable','--now',unit],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)


def configure_special_wan(config: dict) -> None:
    stop_special_wan(); wan=config.get('wan') if isinstance(config.get('wan'),dict) else {}; mode=str(wan.get('mode') or 'dhcp')
    if mode in {'dhcp','static'}: return
    iface=str(wan.get('interface') or '').strip(); user=_safe_secret(wan.get('username'),'WAN username'); password=_safe_secret(wan.get('password'),'WAN password'); mtu=int(wan.get('mtu') or (1492 if mode=='pppoe' else 1460))
    if mode=='pppoe':
        peer=Path('/etc/ppp/peers/srv-control-pppoe')
        _write_root_file(peer, f'plugin rp-pppoe.so\n{iface}\nuser "{user}"\npassword "{password}"\nnoauth\npersist\nmaxfail 0\nholdoff 5\ndefaultroute\nreplacedefaultroute\nusepeerdns\nmtu {mtu}\nmru {mtu}\n',0o600)
        unit=Path('/etc/systemd/system/srv-control-pppoe.service')
        _write_root_file(unit, '[Unit]\nDescription=SRV Control Center PPPoE WAN\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nExecStart=/usr/sbin/pppd call srv-control-pppoe nodetach\nRestart=always\nRestartSec=5\n\n[Install]\nWantedBy=multi-user.target\n',0o644)
        run(['systemctl','daemon-reload'],timeout=30); run(['systemctl','enable','--now','srv-control-pppoe.service'],timeout=30); return
    if mode=='l2tp':
        server=_safe_secret(wan.get('server'),'L2TP server')
        _write_root_file(Path('/etc/ppp/options.srv-control-l2tp'), f'name {user}\npassword {password}\nrefuse-eap\nnoauth\npersist\nmtu {mtu}\nmru {mtu}\ndefaultroute\nreplacedefaultroute\nusepeerdns\n',0o600)
        _write_root_file(Path('/etc/xl2tpd/srv-control.conf'), f'[global]\nport = 1701\n\n[lac srv-control]\nlns = {server}\npppoptfile = /etc/ppp/options.srv-control-l2tp\nlength bit = yes\nredial = yes\nredial timeout = 5\nmax redials = 0\n',0o600)
        unit=Path('/etc/systemd/system/srv-control-l2tp.service')
        _write_root_file(unit, '[Unit]\nDescription=SRV Control Center L2TP WAN\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nExecStart=/usr/sbin/xl2tpd -D -c /etc/xl2tpd/srv-control.conf -C /run/xl2tpd/srv-control-control -p /run/xl2tpd/srv-control.pid\nExecStartPost=/bin/sh -c "sleep 2; echo c srv-control > /run/xl2tpd/srv-control-control"\nRestart=always\nRestartSec=5\n\n[Install]\nWantedBy=multi-user.target\n',0o644)
        run(['systemctl','daemon-reload'],timeout=30); run(['systemctl','enable','--now','srv-control-l2tp.service'],timeout=30)


def _hostapd_config(interface: str, ssid: str, password: str, band: str, channel: int, security: str, bridge: str='br0') -> str:
    if len(ssid.encode('utf-8'))>32 or not ssid: raise RuntimeError('Wi-Fi SSID must be 1..32 bytes')
    if len(password)<8 or len(password)>63: raise RuntimeError('Wi-Fi password must be 8..63 characters')
    if band=='2.4':
        radio='hw_mode=g\nieee80211n=1'; channel=max(1,min(14,int(channel or 6)))
    else:
        radio='hw_mode=a\nieee80211n=1\nieee80211ac=1'; channel=max(32,min(177,int(channel or 36)))
    keymgmt='WPA-PSK SAE\nieee80211w=1' if security=='wpa2-wpa3' else 'WPA-PSK'
    return f'interface={interface}\nbridge={bridge}\ndriver=nl80211\nssid={ssid}\n{radio}\nchannel={channel}\nwmm_enabled=1\nauth_algs=1\nwpa=2\nwpa_key_mgmt={keymgmt}\nrsn_pairwise=CCMP\nwpa_passphrase={password}\n'


def _stop_wifi_services() -> None:
    for unit in ('srv-control-hostapd-24.service','srv-control-hostapd-5.service','srv-control-repeater-nat.service'):
        subprocess.run(['systemctl','disable','--now',unit],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)
    subprocess.run(['iw','dev','srvap0','del'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)


def _write_hostapd_unit(name: str, conf: Path, pre: str | None = None) -> None:
    lines=['[Unit]',f'Description=SRV Control Center Wi-Fi AP {name}','After=network-online.target','Wants=network-online.target','','[Service]','Type=simple']
    if pre: lines.append('ExecStartPre='+pre)
    lines += [f'ExecStart=/usr/sbin/hostapd {conf}','Restart=on-failure','RestartSec=3','','[Install]','WantedBy=multi-user.target','']
    _write_root_file(Path(f'/etc/systemd/system/srv-control-hostapd-{name}.service'),'\n'.join(lines),0o644)


def configure_wifi(config: dict) -> str:
    _stop_wifi_services(); wifi=config.get('wifi') if isinstance(config.get('wifi'),dict) else {}; mode=str(wifi.get('mode') or 'disabled')
    if mode in {'disabled','client'}: return mode
