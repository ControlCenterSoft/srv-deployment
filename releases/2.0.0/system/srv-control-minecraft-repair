#!/usr/bin/env python3
from __future__ import annotations

import argparse
from datetime import datetime
import json
from pathlib import Path
import re
import subprocess
import sys
import time


CONTROL = Path("/usr/local/sbin/srv-control-minecraft")
WORLDS = Path("/usr/local/sbin/srv-control-minecraft-worlds")


def run(command: list[str], *, payload: dict | None = None, timeout: int = 1200, check: bool = True) -> subprocess.CompletedProcess[str]:
    completed = subprocess.run(
        command,
        input=json.dumps(payload, ensure_ascii=False) if payload is not None else None,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
    )
    if check and completed.returncode != 0:
        raise RuntimeError((completed.stdout or "")[-4000:] or f"command failed: {' '.join(command)}")
    return completed


def helper_json(helper: Path, *args: str, payload: dict | None = None, timeout: int = 1200) -> dict:
    if not helper.is_file():
        raise RuntimeError(f"required Minecraft helper is missing: {helper}")
    completed = run([str(helper), *args], payload=payload, timeout=timeout)
    try:
        value = json.loads((completed.stdout or "").strip())
    except Exception as exc:
        raise RuntimeError(f"invalid Minecraft helper response: {(completed.stdout or '')[-2000:]}") from exc
    if not isinstance(value, dict) or value.get("ok") is not True:
        raise RuntimeError(str(value.get("error") if isinstance(value, dict) else value))
    return value


def udp_listening(port: int) -> bool:
    completed = run(["ss", "-H", "-lun"], timeout=20, check=False)
    pattern = re.compile(rf"(?:^|[\]:.]){port}(?:\s|$)")
    for line in (completed.stdout or "").splitlines():
        if pattern.search(line) or f":{port} " in line:
            return True
    return False


def health() -> dict:
    errors: list[str] = []
    status: dict = {}
    worlds: dict = {}
    try:
        status = helper_json(CONTROL, "status", timeout=45)
    except Exception as exc:
        errors.append(f"status: {exc}")
    active = bool(status.get("active")) if status else False
    if not active:
        errors.append("bedrock service is not active")
    try:
        port = int(status.get("port") or 19132)
    except Exception:
        port = 19132
    if not udp_listening(port):
        errors.append(f"UDP port {port} is not listening")
    level_name = str(status.get("level_name") or "").strip()
    if not level_name:
        errors.append("active world name is missing")
    try:
        worlds = helper_json(WORLDS, "list", timeout=60)
        items = worlds.get("worlds") if isinstance(worlds.get("worlds"), list) else []
        if level_name and items and not any(str(item.get("name") or "") == level_name for item in items if isinstance(item, dict)):
            errors.append(f"active world {level_name!r} is absent from world inventory")
    except Exception as exc:
        errors.append(f"world inventory: {exc}")
    return {
        "ok": not errors,
        "active": active,
        "port": port,
        "port_listening": udp_listening(port),
        "version": status.get("version"),
        "level_name": level_name or None,
        "errors": errors,
    }


def wait_healthy(seconds: int = 50) -> dict:
    deadline = time.monotonic() + seconds
    last = health()
    while not last["ok"] and time.monotonic() < deadline:
        time.sleep(5)
        last = health()
    return last


def repair(replace_world: bool) -> dict:
    before = health()
    if before["ok"]:
        return {"ok": True, "result": "already-healthy", "before": before, "after": before}

    backup = None
    try:
        backup = helper_json(CONTROL, "backup", timeout=1000)
    except Exception as exc:
        # A repair may still continue when the legacy backup command itself is
        # broken, but destructive world replacement is forbidden without backup.
        if replace_world:
            raise RuntimeError(f"cannot replace world because safety backup failed: {exc}") from exc

    update_error = None
    try:
        helper_json(CONTROL, "update", timeout=1500)
    except Exception as exc:
        update_error = str(exc)

    try:
        helper_json(CONTROL, "service", "restart", timeout=300)
    except Exception:
        helper_json(CONTROL, "service", "start", timeout=300)
    after = wait_healthy()
    if after["ok"]:
        return {
            "ok": True,
            "result": "repaired",
            "before": before,
            "after": after,
            "backup": backup,
            "update_warning": update_error,
        }

    if not replace_world:
        return {
            "ok": False,
            "result": "repair-incomplete",
            "before": before,
            "after": after,
            "backup": backup,
            "update_warning": update_error,
        }

    replacement = "ControlCenter-Recovery-" + datetime.now().strftime("%Y%m%d-%H%M%S")
    helper_json(
        CONTROL,
        "properties-set",
        payload={"changes": {"level-name": replacement}},
        timeout=120,
    )
    helper_json(CONTROL, "service", "restart", timeout=300)
    final = wait_healthy(75)
    return {
        "ok": bool(final["ok"]),
        "result": "replacement-world-created" if final["ok"] else "replacement-world-failed",
        "before": before,
        "after": final,
        "backup": backup,
        "replacement_world": replacement,
        "update_warning": update_error,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("operation", choices=["check", "repair"])
    parser.add_argument("--replace-world-on-failure", action="store_true")
    args = parser.parse_args()
    try:
        result = health() if args.operation == "check" else repair(args.replace_world_on_failure)
    except Exception as exc:
        result = {"ok": False, "result": "error", "errors": [str(exc)]}
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
