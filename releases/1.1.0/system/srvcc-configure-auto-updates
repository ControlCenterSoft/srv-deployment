#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

REPO_URL="https://github.com/filosoff31/srv-deployment.git"
MODE="automatic"
INTERVAL_MINUTES=5
CHECK_NOW=0

PROJECT="/opt/srv-control"
STATE_DIR="/var/lib/srv-control"
RELEASE_META="${STATE_DIR}/release.json"
AGENT_ROOT="/var/lib/srvcc-agent"
AGENT_BIN="/usr/local/sbin/srvcc-github-agent"
CONFIGURATOR_BIN="/usr/local/sbin/srvcc-configure-auto-updates"
SERVICE="srvcc-github-agent.service"
TIMER="srvcc-github-agent.timer"

fail() {
    printf 'UPDATE CONFIG FAIL: %s\n' "$*" >&2
    exit 1
}

while (($#)); do
    case "$1" in
        --repo) REPO_URL="${2:?}"; shift 2 ;;
        --mode) MODE="${2:?}"; shift 2 ;;
        --interval-minutes) INTERVAL_MINUTES="${2:?}"; shift 2 ;;
        --check-now) CHECK_NOW=1; shift ;;
        --no-check-now) CHECK_NOW=0; shift ;;
        -h|--help)
            printf '%s\n' 'Usage: configure-auto-updates.sh [--repo URL] [--mode automatic|manual] [--interval-minutes 1..1440] [--check-now]'
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

[[ "$(id -u)" -eq 0 ]] || fail "must run as root"
[[ "$MODE" == "automatic" || "$MODE" == "manual" ]] || fail "invalid mode"
[[ "$INTERVAL_MINUTES" =~ ^[0-9]+$ ]] || fail "interval must be integer"
(( INTERVAL_MINUTES >= 1 && INTERVAL_MINUTES <= 1440 )) || fail "interval must be 1..1440"
[[ -d "$PROJECT" ]] || fail "Control Center is not installed"
[[ -s "$RELEASE_META" ]] || fail "release metadata missing"
for command in git python3 systemctl sha256sum flock readlink; do
    command -v "$command" >/dev/null 2>&1 || fail "missing command: $command"
done

install -d -m 0750 "$AGENT_ROOT" "$STATE_DIR"
# The configurator is also invoked from its installed destination by the web
# system agent. GNU install fails when source and destination are the same file,
# and set -e used to abort before the requested timer mode was applied.
source_real="$(readlink -f -- "$0")"
target_real="$(readlink -f -- "$CONFIGURATOR_BIN" 2>/dev/null || true)"
if [[ "$source_real" != "$target_real" ]]; then
    install -m 0755 "$0" "$CONFIGURATOR_BIN"
fi

touch /var/log/srvcc-agent.log
chmod 0640 /var/log/srvcc-agent.log || true

cat > "$AGENT_BIN" <<'AGENT'
#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

OPERATION="${1:-apply}"
shift || true
ACTOR="system"
while (($#)); do
    case "$1" in
        --actor) ACTOR="${2:?}"; shift 2 ;;
        *) printf 'UPDATER FAIL: unknown argument %s\n' "$1" >&2; exit 2 ;;
    esac
done
[[ "$OPERATION" == "check" || "$OPERATION" == "apply" ]] || { echo 'UPDATER FAIL: operation must be check or apply' >&2; exit 2; }

REPO_URL="${SRVCC_REPO_URL:-https://github.com/filosoff31/srv-deployment.git}"
PROJECT="/opt/srv-control"
STATE_DIR="/var/lib/srv-control"
RELEASE_META="${STATE_DIR}/release.json"
UPDATE_STATUS="${STATE_DIR}/github-update-status.json"
BACKUP_CONFIG="${STATE_DIR}/backup-config.json"
BACKUP_WORKER="/usr/local/libexec/srv-control-backup"
AGENT_ROOT="/var/lib/srvcc-agent"
DEPLOY_REPO="${AGENT_ROOT}/deploy-repo"
LAST_DEPLOYED_SHA="${AGENT_ROOT}/last-deployed-sha"
LAST_SEEN_SHA="${AGENT_ROOT}/last-seen-sha"
LAST_FINGERPRINT="${AGENT_ROOT}/last-release-fingerprint"
STATE_PUBLISHER="/usr/local/sbin/srvcc-github-agent.state-publisher"
LOG="/var/log/srvcc-agent.log"
LOCK="${AGENT_ROOT}/update.lock"

log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; }

write_status() {
    python3 - "$UPDATE_STATUS" "$1" "$2" "${3:-}" "${4:-}" "${5:-}" "${6:-false}" "$REPO_URL" <<'PY'
import json, pathlib, sys, tempfile
from datetime import datetime, timezone
path=pathlib.Path(sys.argv[1])
payload={
  "schema_version":2,
  "checked_at":datetime.now(timezone.utc).isoformat(),
  "result":sys.argv[2],
  "detail":sys.argv[3],
  "remote_sha":sys.argv[4] or None,
  "release_id":sys.argv[5] or None,
  "release_version":sys.argv[6] or None,
  "update_available":sys.argv[7].lower()=="true",
  "source":sys.argv[8],
}
path.parent.mkdir(parents=True,exist_ok=True)
with tempfile.NamedTemporaryFile(mode="w",encoding="utf-8",dir=path.parent,prefix=path.name+".tmp.",delete=False) as h:
    json.dump(payload,h,ensure_ascii=False,indent=2); h.write("\n"); tmp=pathlib.Path(h.name)
tmp.chmod(0o644); tmp.replace(path)
PY
}

publish_state() { [[ -x "$STATE_PUBLISHER" ]] && "$STATE_PUBLISHER" || true; }

current_value() {
    python3 - "$RELEASE_META" "$1" <<'PY'
import json,pathlib,sys
try: p=json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception: p={}
v=p.get(sys.argv[2]); print(v if isinstance(v,str) else "")
PY
}

release_info() {
    git -C "$DEPLOY_REPO" show "origin/main:deployment.json" | python3 -c '
import json,sys
c=json.load(sys.stdin)
a=[c.get("release_id") or c.get("release"),c.get("release_path"),c.get("manifest")]
if not all(isinstance(x,str) and x for x in a): raise SystemExit("invalid deployment.json")
print("\n".join(a))'
}

manifest_version() {
    git -C "$DEPLOY_REPO" show "origin/main:$1" | python3 -c '
import json,sys
v=json.load(sys.stdin).get("release_version")
if not isinstance(v,str) or not v: raise SystemExit("release_version missing")
print(v)'
}

backup_required() {
    python3 - "$BACKUP_CONFIG" <<'PY'
import json,pathlib,sys
try: p=json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception: p={"backup_before_update":True}
raise SystemExit(0 if bool(p.get("backup_before_update",True)) else 1)
PY
}

install -d -m 0750 "$AGENT_ROOT"
exec 9>"$LOCK"
if [[ "$OPERATION" == "apply" && "$ACTOR" != "system" ]]; then
    # A manual update must not report success just because a scheduled check or
    # apply currently owns the lock. Wait for the active updater transaction.
    if ! flock -w 180 9; then
        write_status error 'updater is busy; manual update timed out waiting for lock'
        log "Manual updater actor=${ACTOR} timed out waiting for update lock."
        exit 1
    fi
else
    flock -n 9 || { log 'Updater skipped: another run is active.'; exit 0; }
fi

if [[ ! -d "$DEPLOY_REPO/.git" ]]; then
    rm -rf "$DEPLOY_REPO"
    git clone --no-tags --single-branch --branch main "$REPO_URL" "$DEPLOY_REPO" >/dev/null 2>&1 || {
        write_status error 'git clone failed'; exit 1;
    }
fi

git -C "$DEPLOY_REPO" remote set-url origin "$REPO_URL" >/dev/null 2>&1 || true
if ! git -C "$DEPLOY_REPO" fetch --prune origin '+refs/heads/main:refs/remotes/origin/main' >/dev/null 2>&1; then
    write_status error 'git fetch failed'; publish_state; exit 1
fi

remote_sha="$(git -C "$DEPLOY_REPO" rev-parse origin/main)"
mapfile -t info < <(release_info)
release_id="${info[0]}"; release_path="${info[1]}"; manifest="${info[2]}"
release_version="$(manifest_version "$manifest")"
deployment_blob="$(git -C "$DEPLOY_REPO" rev-parse 'origin/main:deployment.json')"
release_tree="$(git -C "$DEPLOY_REPO" rev-parse "origin/main:${release_path}")"
fingerprint="$(printf '%s\n%s\n%s\n%s\n' "$release_id" "$release_version" "$deployment_blob" "$release_tree" | sha256sum | awk '{print $1}')"
current_id="$(current_value release_id)"
current_version="$(current_value version)"
current_git_sha="$(current_value git_sha)"
stored_fingerprint="$(cat "$LAST_FINGERPRINT" 2>/dev/null || true)"

if [[ -z "$stored_fingerprint" && "$current_id" == "$release_id" && "$current_version" == "$release_version" && -n "$current_git_sha" ]]; then
    current_tree="$(git -C "$DEPLOY_REPO" rev-parse "${current_git_sha}:${release_path}" 2>/dev/null || true)"
    if [[ -n "$current_tree" && "$current_tree" == "$release_tree" ]]; then
        printf '%s\n' "$fingerprint" > "$LAST_FINGERPRINT"
        printf '%s\n' "$current_git_sha" > "$LAST_DEPLOYED_SHA"
        printf '%s\n' "$remote_sha" > "$LAST_SEEN_SHA"
        chmod 0640 "$LAST_FINGERPRINT" "$LAST_DEPLOYED_SHA" "$LAST_SEEN_SHA"
        write_status ok 'existing installed release fingerprint adopted' "$remote_sha" "$release_id" "$release_version" false
        log "Adopted installed release ${release_id} ${release_version} without reapply."
        publish_state
        exit 0
    fi
fi

if [[ "$stored_fingerprint" == "$fingerprint" && "$current_id" == "$release_id" && "$current_version" == "$release_version" ]]; then
    printf '%s\n' "$remote_sha" > "$LAST_SEEN_SHA"
    chmod 0640 "$LAST_SEEN_SHA"
    write_status ok 'repository checked; active product release unchanged' "$remote_sha" "$release_id" "$release_version" false
    publish_state
    exit 0
fi

write_status update-available 'new product release is available' "$remote_sha" "$release_id" "$release_version" true
printf '%s\n' "$remote_sha" > "$LAST_SEEN_SHA"
chmod 0640 "$LAST_SEEN_SHA"
publish_state
[[ "$OPERATION" == "check" ]] && exit 0

if backup_required; then
    [[ -x "$BACKUP_WORKER" ]] || { write_status error 'pre-update backup worker missing' "$remote_sha" "$release_id" "$release_version" true; exit 1; }
    if ! "$BACKUP_WORKER" create --actor "$ACTOR" --reason pre-github-update >> "$LOG" 2>&1; then
        write_status error 'pre-update backup failed; update blocked' "$remote_sha" "$release_id" "$release_version" true
        publish_state
        exit 1
    fi
fi

git -C "$DEPLOY_REPO" reset --hard origin/main >/dev/null
git -C "$DEPLOY_REPO" clean -fd >/dev/null 2>&1 || true
[[ -x "$DEPLOY_REPO/deploy/deploy.sh" ]] || { write_status error 'deploy/deploy.sh missing' "$remote_sha" "$release_id" "$release_version" true; exit 1; }

log "Applying product release ${release_id} ${release_version} sha=${remote_sha} actor=${ACTOR}."
if ! bash "$DEPLOY_REPO/deploy/deploy.sh" "$PROJECT" "$remote_sha" >> "$LOG" 2>&1; then
    write_status error 'deployment failed' "$remote_sha" "$release_id" "$release_version" true
    publish_state
    exit 1
fi
if [[ -x "$DEPLOY_REPO/deploy/healthcheck.sh" ]] && ! bash "$DEPLOY_REPO/deploy/healthcheck.sh" "$PROJECT" "$remote_sha" >> "$LOG" 2>&1; then
    write_status error 'deployment healthcheck failed' "$remote_sha" "$release_id" "$release_version" true
    publish_state
    exit 1
fi

printf '%s\n' "$remote_sha" > "$LAST_DEPLOYED_SHA"
printf '%s\n' "$remote_sha" > "$LAST_SEEN_SHA"
printf '%s\n' "$fingerprint" > "$LAST_FINGERPRINT"
chmod 0640 "$LAST_DEPLOYED_SHA" "$LAST_SEEN_SHA" "$LAST_FINGERPRINT"
write_status updated 'product release applied and accepted' "$remote_sha" "$release_id" "$release_version" false
log "Deployment successful release=${release_id} version=${release_version}."
publish_state
AGENT
chmod 0755 "$AGENT_BIN"

cat > "/etc/systemd/system/${SERVICE}" <<EOF
[Unit]
Description=SRV Control Center GitHub scheduled updater
After=network-online.target srv-control.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=SRVCC_REPO_URL=${REPO_URL}
ExecStart=${AGENT_BIN} apply --actor system
EOF

cat > "/etc/systemd/system/${TIMER}" <<EOF
[Unit]
Description=SRV Control Center GitHub update schedule

[Timer]
OnBootSec=2min
OnUnitActiveSec=${INTERVAL_MINUTES}min
RandomizedDelaySec=30s
AccuracySec=15s
Persistent=true
Unit=${SERVICE}

[Install]
WantedBy=timers.target
EOF

python3 - "$STATE_DIR/github-update-config.json" "$REPO_URL" "$MODE" "$INTERVAL_MINUTES" <<'PY'
import json,pathlib,sys,tempfile
p=pathlib.Path(sys.argv[1]); data={"schema_version":2,"source":sys.argv[2],"mode":sys.argv[3],"interval_minutes":int(sys.argv[4])}
p.parent.mkdir(parents=True,exist_ok=True)
with tempfile.NamedTemporaryFile(mode="w",encoding="utf-8",dir=p.parent,prefix=p.name+".tmp.",delete=False) as h:
    json.dump(data,h,ensure_ascii=False,indent=2); h.write("\n"); tmp=pathlib.Path(h.name)
tmp.chmod(0o644); tmp.replace(p)
PY

systemctl daemon-reload
if [[ "$MODE" == "automatic" ]]; then
    systemctl enable --now "$TIMER" >/dev/null
else
    systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
fi

if (( CHECK_NOW )); then
    SRVCC_REPO_URL="$REPO_URL" "$AGENT_BIN" check --actor configure
fi

printf 'UPDATE CONFIG PASS\nsource=%s\nmode=%s\ninterval_minutes=%s\n' "$REPO_URL" "$MODE" "$INTERVAL_MINUTES"
