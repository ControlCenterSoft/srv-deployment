#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys

ROLE = Path(sys.argv[0]).name
DELEGATE_ROOT = Path('/usr/local/libexec/srv-control-minecraft-2.1.0')
CANONICAL_TIMER = 'srv-control-minecraft-bedrock-update.timer'
VALID_ROLES = {
    'srv-control-minecraft',
    'srv-control-minecraft-worlds',
    'srv-control-minecraft-players',
    'srv-control-minecraft-restore',
    'srv-control-minecraft-live',
}


def systemctl_state(kind: str, unit: str) -> str:
    result = subprocess.run(['systemctl', kind, unit], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False, timeout=20)
    return (result.stdout or '').strip()


def delegate_path() -> Path:
    if ROLE not in VALID_ROLES:
        raise RuntimeError(f'unsupported helper role: {ROLE}')
    path = DELEGATE_ROOT / ROLE
    if not path.is_file() or not os.access(path, os.X_OK):
        raise RuntimeError(f'2.1.0 delegate is unavailable: {path}')
    return path


def updater() -> int:
    delegate = delegate_path()
    result = subprocess.run([str(delegate), 'updater'], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=90)
    try:
        payload = json.loads(result.stdout or '{}')
    except Exception as exc:
        print(json.dumps({'ok': False, 'error': f'invalid 2.1.0 updater response: {exc}'}, ensure_ascii=False, indent=2))
        return 1
    if result.returncode != 0 or payload.get('ok') is not True:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 1
    enabled = systemctl_state('is-enabled', CANONICAL_TIMER) in {'enabled', 'enabled-runtime'}
    active = systemctl_state('is-active', CANONICAL_TIMER) == 'active'
    payload.update({
        'timer_enabled': enabled,
        'timer_active': active,
        'schedule': 'automatic' if enabled else 'manual',
        'timer_unit': CANONICAL_TIMER,
        'canonical_update_path': True,
    })
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def main() -> int:
    try:
        if ROLE == 'srv-control-minecraft' and len(sys.argv) > 1 and sys.argv[1] == 'updater':
            return updater()
        delegate = delegate_path()
        os.execv(str(delegate), [str(delegate), *sys.argv[1:]])
    except Exception as exc:
        print(json.dumps({'ok': False, 'error': str(exc)[-4000:]}, ensure_ascii=False, indent=2))
        return 1
    return 1


if __name__ == '__main__':
    raise SystemExit(main())
