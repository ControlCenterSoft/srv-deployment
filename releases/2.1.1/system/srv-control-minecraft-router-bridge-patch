#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import re
import sys

path = Path(sys.argv[1]) if len(sys.argv) > 1 else Path('/opt/srv-control/app/routers/minecraft_legacy.py')
text = path.read_text(encoding='utf-8')

if 'from app.core.minecraft_privileged import run_helper as run_privileged_minecraft_helper' not in text:
    anchor = 'from app.core.rbac import has_permission, is_full_admin, require_permission\n'
    if anchor not in text:
        raise SystemExit('RBAC import anchor not found in Minecraft legacy router')
    text = text.replace(
        anchor,
        'from app.core.minecraft_privileged import run_helper as run_privileged_minecraft_helper\n' + anchor,
        1,
    )

pattern = re.compile(
    r'def _run_args\(kind: str, \*args: str, payload: dict \| None = None, timeout: int = 90\) -> dict:\n'
    r'.*?\n\ndef _run_json\(',
    re.DOTALL,
)
replacement = '''def _run_args(kind: str, *args: str, payload: dict | None = None, timeout: int = 90) -> dict:\n    _helper(kind)\n    try:\n        return run_privileged_minecraft_helper(kind, list(args), payload=payload, timeout=timeout)\n    except TimeoutError as exc:\n        raise HTTPException(status_code=504, detail=f"Minecraft operation timed out after {timeout}s") from exc\n    except RuntimeError as exc:\n        raise HTTPException(status_code=400, detail=str(exc)) from exc\n    except Exception as exc:\n        raise HTTPException(status_code=500, detail=f"Minecraft privileged-agent execution failed: {exc}") from exc\n\n\ndef _run_json('''
updated, count = pattern.subn(replacement, text, count=1)
if count != 1:
    raise SystemExit(f'Minecraft _run_args patch anchor mismatch: replacements={count}')
if '["/usr/bin/sudo", "-n", str(helper), *args]' in updated or "['/usr/bin/sudo', '-n', str(helper), *args]" in updated:
    raise SystemExit('sudo execution remains in Minecraft legacy router after patch')
if 'run_privileged_minecraft_helper(kind, list(args)' not in updated:
    raise SystemExit('privileged Minecraft bridge was not installed into router')
path.write_text(updated, encoding='utf-8')
print(f'MINECRAFT ROUTER BRIDGE PATCH PASS: {path}')
