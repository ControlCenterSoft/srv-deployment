#!/usr/bin/env python3
from __future__ import annotations

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

UNIT = 'srv-control-minecraft-bedrock.service'
TIMER = 'srv-control-minecraft-bedrock-update.timer'
CONTROL = Path('/usr/local/sbin/srv-control-minecraft')
PERMISSIONS = Path('/usr/local/libexec/srv-control-minecraft-permissions')
VERSION_RE = re.compile(r'\b(?:Version|version)\s*[:= ]\s*v?(\d+(?:\.\d+){2,4})\b')
STATE = Path('/var/lib/srv-control/minecraft-2.1-update.json')


def run(cmd: list[str], *, check: bool = True, timeout: int = 900, stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(cmd, input=stdin, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False, timeout=timeout)
    if check and result.returncode != 0:
        raise RuntimeError((result.stdout or '')[-5000:] or f'command failed: {cmd}')
    return result


def json_command(args: list[str], *, timeout: int = 900) -> dict:
    result = run([str(CONTROL), *args], timeout=timeout, check=False)
    try:
        payload = json.loads(result.stdout or '{}')
    except Exception as exc:
        raise RuntimeError(f'invalid Minecraft helper response: {exc}: {(result.stdout or "")[-2000:]}')
    if result.returncode != 0 or payload.get('ok') is not True:
        raise RuntimeError(str(payload.get('error') or payload)[-4000:])
    return payload


def runtime() -> Path:
    raw = run(['systemctl', 'show', UNIT, '-p', 'WorkingDirectory', '--value'], timeout=30).stdout.strip()
    path = Path(raw).resolve() if raw else None
    if not path or not path.is_dir() or not (path / 'bedrock_server').is_file():
        raise RuntimeError(f'canonical Bedrock runtime is invalid: {raw!r}')
    return path


def journal_version() -> str | None:
    text = run(['journalctl', '-u', UNIT, '-n', '500', '--no-pager', '-o', 'cat'], check=False, timeout=30).stdout or ''
    values = VERSION_RE.findall(text)
    return values[-1] if values else None


def atomic_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o640)
        os.replace(tmp, path)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass


def establish_version() -> str | None:
    rt = runtime()
    for name in ('.version', 'version.txt', 'bedrock.version'):
        path = rt / name
        if path.is_file():
            text = path.read_text(encoding='utf-8', errors='ignore')
            match = re.search(r'\d+(?:\.\d+){2,4}', text)
            if match:
                return match.group(0)
    found = journal_version()
    if found:
        atomic_text(rt / '.version', found + '\n')
        run([str(PERMISSIONS), 'ensure'], timeout=120)
    return found


def write_state(payload: dict) -> None:
    payload = dict(payload)
    payload['checked_at'] = datetime.now(timezone.utc).isoformat()
    STATE.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.' + STATE.name + '.', dir=str(STATE.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
            json.dump(payload, handle, ensure_ascii=False, indent=2)
            handle.write('\n')
            handle.flush(); os.fsync(handle.fileno())
        os.chmod(tmp, 0o640)
        os.replace(tmp, STATE)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass


def check_payload() -> dict:
    installed = establish_version()
    upstream = json_command(['updater'], timeout=60)
    latest = upstream.get('latest_version')
    reported = upstream.get('installed_version')
    installed = str(reported or installed or '').strip() or None
    latest = str(latest or '').strip() or None
    return {
        'ok': True,
        'installed_version': installed,
        'latest_version': latest,
        'update_available': bool(installed and latest and installed != latest),
        'decision_ready': bool(installed and latest),
        'timer_enabled': run(['systemctl', 'is-enabled', TIMER], check=False, timeout=20).stdout.strip() in {'enabled','enabled-runtime'},
        'timer_active': run(['systemctl', 'is-active', TIMER], check=False, timeout=20).stdout.strip() == 'active',
    }


def apply_update() -> dict:
    before = check_payload()
    if not before['decision_ready']:
        result = {**before, 'result': 'skipped-version-unknown'}
        write_state(result)
        return result
    if not before['update_available']:
        result = {**before, 'result': 'already-current'}
        write_state(result)
        return result

    update = json_command(['update'], timeout=1200)
    version = str(update.get('version') or before['latest_version'] or '').strip()
    if version:
        atomic_text(runtime() / '.version', version + '\n')
    run([str(PERMISSIONS), 'ensure'], timeout=180)
    health = json_command(['status'], timeout=60)
    if health.get('service') != UNIT or health.get('active') is not True or health.get('healthy') is not True:
        raise RuntimeError(f'Bedrock health failed after update: {health}')
    after = check_payload()
    result = {**after, 'result': 'updated', 'previous_version': before['installed_version'], 'target_version': version or before['latest_version']}
    write_state(result)
    return result


def main() -> int:
    operation = sys.argv[1] if len(sys.argv) > 1 else 'apply'
    try:
        if operation == 'check':
            result = check_payload()
            result['result'] = 'checked'
            write_state(result)
        elif operation == 'apply':
            result = apply_update()
        else:
            raise RuntimeError('usage: srv-control-minecraft-bedrock-update check|apply')
    except Exception as exc:
        result = {'ok': False, 'result': 'error', 'error': str(exc)[-5000:]}
        try: write_state(result)
        except Exception: pass
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0 if result.get('ok') else 1


if __name__ == '__main__':
    raise SystemExit(main())
