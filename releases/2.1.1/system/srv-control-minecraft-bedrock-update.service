[Unit]
Description=Control Center Minecraft Bedrock canonical updater
After=network-online.target srv-control-minecraft-bedrock.service
Wants=network-online.target
ConditionPathExists=/usr/local/libexec/srv-control-minecraft-bedrock-update

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/srv-control-minecraft-bedrock-update apply
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
