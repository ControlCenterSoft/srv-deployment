#!/usr/bin/env python3
from __future__ import annotations

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import stat
import subprocess
import tempfile
from typing import Any

ACTION_DIR = Path('/var/lib/srv-control/minecraft-actions')
RESULT_DIR = Path('/var/lib/srv-control/system-results')
WORKER = Path('/usr/local/libexec/srv-control-minecraft-admin')
LEGACY_HELPERS = {
    'control': Path('/usr/local/sbin/srv-control-minecraft'),
    'players': Path('/usr/local/sbin/srv-control-minecraft-players'),
    'worlds': Path('/usr/local/sbin/srv-control-minecraft-worlds'),
    'restore': Path('/usr/local/sbin/srv-control-minecraft-restore'),
    'live': Path('/usr/local/sbin/srv-control-minecraft-live'),
}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def write_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode='w', encoding='utf-8', dir=path.parent, prefix=path.name + '.tmp.', delete=False
    )
    try:
        json.dump(value, handle, ensure_ascii=False, indent=2)
        handle.write('\n')
        handle.flush()
        os.fchmod(handle.fileno(), 0o644)
        temporary = Path(handle.name)
    finally:
        handle.close()
    os.replace(temporary, path)


def invoke_legacy(request: dict[str, Any]) -> tuple[bool, str]:
    payload = request.get('payload') if isinstance(request.get('payload'), dict) else {}
    kind = str(payload.get('kind') or '')
    helper = LEGACY_HELPERS.get(kind)
    if helper is None:
        return False, 'unsupported legacy Minecraft helper kind'
    if not helper.is_file() or not os.access(helper, os.X_OK):
        return False, f'legacy Minecraft helper is not installed: {helper}'

    raw_args = payload.get('args')
    if not isinstance(raw_args, list) or len(raw_args) > 16:
        return False, 'invalid legacy Minecraft helper argument list'
    args: list[str] = []
    for value in raw_args:
        if not isinstance(value, str) or len(value) > 512 or '\x00' in value or '\n' in value or '\r' in value:
            return False, 'invalid legacy Minecraft helper argument'
        args.append(value)

    stdin_text = payload.get('stdin')
    if stdin_text is None:
        stdin_text = ''
    if not isinstance(stdin_text, str) or len(stdin_text.encode('utf-8')) > 1024 * 1024:
        return False, 'legacy Minecraft helper input is invalid or too large'

    timeout = payload.get('timeout', 90)
    try:
        timeout = int(timeout)
    except Exception:
        timeout = 90
    timeout = max(5, min(timeout, 1800))

    completed = subprocess.run(
        [str(helper), *args],
        input=stdin_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
        env={**os.environ, 'LC_ALL': 'C.UTF-8', 'LANG': 'C.UTF-8', 'HOME': '/root'},
    )
    output = (completed.stdout or '')[-16000:]
    try:
        decoded = json.loads(output.strip()) if output.strip() else {}
    except Exception:
        decoded = {}
    ok = completed.returncode == 0 and isinstance(decoded, dict) and decoded.get('ok') is True
    return ok, json.dumps(decoded, ensure_ascii=False) if decoded else output


def invoke(request: dict[str, Any]) -> tuple[bool, str]:
    if request.get('action') == 'minecraft-legacy-helper':
        return invoke_legacy(request)
    if not WORKER.is_file() or not os.access(WORKER, os.X_OK):
        return False, 'Minecraft administration worker is not installed'
    completed = subprocess.run(
        [str(WORKER)],
        input=json.dumps(request, ensure_ascii=False),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=24 * 3600,
        check=False,
        env={**os.environ, 'LC_ALL': 'C.UTF-8', 'LANG': 'C.UTF-8', 'HOME': '/root'},
    )
    output = (completed.stdout or '')[-16000:]
    try:
        decoded = json.loads(output.strip().splitlines()[-1]) if output.strip() else {}
    except Exception:
        decoded = {}
    ok = completed.returncode == 0 and decoded.get('ok') is True
    detail = str(decoded.get('detail') or output or 'Minecraft action returned no detail')[-12000:]
    return ok, detail


def process(path: Path) -> None:
    request_id = path.stem
    request: dict[str, Any] = {}
    result: dict[str, Any] = {
        'request_id': request_id,
        'action': None,
        'actor': None,
        'started_at': now(),
        'finished_at': None,
        'result': 'failed',
        'detail': None,
    }
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or path.is_symlink():
            raise RuntimeError('Minecraft action request must be a regular file')
        request = json.loads(path.read_text(encoding='utf-8'))
        if not isinstance(request, dict):
            raise RuntimeError('Minecraft action request must be a JSON object')
        if str(request.get('request_id') or '') != request_id:
            raise RuntimeError('Minecraft action request id does not match filename')
        result['action'] = request.get('action')
        result['actor'] = request.get('actor')
        ok, detail = invoke(request)
        result['result'] = 'success' if ok else 'failed'
        result['detail'] = detail
    except Exception as exc:
        result['detail'] = str(exc)[-12000:]
    finally:
        result['finished_at'] = now()
        write_json(RESULT_DIR / f'{request_id}.json', result)
        path.unlink(missing_ok=True)


def main() -> int:
    ACTION_DIR.mkdir(parents=True, exist_ok=True)
    requests = sorted(ACTION_DIR.glob('*.json'), key=lambda item: item.stat().st_mtime)
    if not requests:
        return 0
    process(requests[0])
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
