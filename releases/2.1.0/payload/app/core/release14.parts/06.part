def save_pxe_configuration_profile(payload: dict) -> dict:
    name = str(payload.get('name') or '').strip()
    kind = str(payload.get('kind') or 'both').strip().lower()
    description = str(payload.get('description') or '').strip() or None
    config = payload.get('config') if isinstance(payload.get('config'), dict) else {}
    if not name or len(name) > 160:
        raise ValueError('имя профиля параметров обязательно')
    if kind not in {'windows', 'linux', 'both'}:
        raise ValueError('тип профиля должен быть windows, linux или both')
    row = _one(
        '''INSERT INTO pxe_configuration_profiles (name,kind,description,config,enabled,updated_at)
           VALUES (:name,:kind,:description,CAST(:config AS jsonb),true,now())
           RETURNING id,name,kind,description,config,enabled,created_at,updated_at''',
        {'name': name, 'kind': kind, 'description': description, 'config': json.dumps(config)},
    )
    return row or {}


def delete_pxe_configuration_profile(profile_id: int) -> None:
    _execute('DELETE FROM pxe_configuration_profiles WHERE id=:id', {'id': profile_id})
