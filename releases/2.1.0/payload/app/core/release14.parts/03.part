        raise ValueError('при вводе в домен необходимо выбрать домен')
    token = secrets.token_urlsafe(32)
    config = payload.get('config') if isinstance(payload.get('config'), dict) else {}
    config = {**config, 'kind': kind, 'report_token': token}
    with engine.begin() as connection:
        device = connection.execute(text('SELECT id FROM devices WHERE mac=:mac'), {'mac': mac}).mappings().first()
        if device:
            device_id = int(device['id'])
            connection.execute(text('UPDATE devices SET computer_name=:name,pxe_enabled=true,updated_at=now() WHERE id=:id'), {'name': name, 'id': device_id})
        else:
            device_id = int(connection.execute(text('INSERT INTO devices (mac,computer_name,pxe_enabled) VALUES (:mac,:name,true) RETURNING id'), {'mac': mac, 'name': name}).scalar_one())
        profile_id = int(connection.execute(text(
            '''INSERT INTO pxe_profiles (device_id,os_image_id,computer_name,windows_edition,locale,timezone,auto_install,domain_join,config,
                                         status,install_authorized,one_time,domain_name,ip_address)
               VALUES (:device,:image,:name,:edition,:locale,:timezone,true,:domain_join,CAST(:config AS jsonb),'draft',false,true,:domain_name,:ip)
               RETURNING id'''), {
                    'device': device_id, 'image': image_id, 'name': name,
                    'edition': str(payload.get('windows_edition') or '').strip() or None,
                    'locale': str(payload.get('locale') or 'ru-RU'), 'timezone': str(payload.get('timezone') or 'Europe/Moscow'),
                    'domain_join': domain_join, 'config': json.dumps(config), 'domain_name': domain_name, 'ip': ip_value,
                }).scalar_one())
        for group_id in sorted({int(x) for x in payload.get('software_group_ids', []) if int(x) > 0}):
            connection.execute(text('INSERT INTO pxe_profile_software_groups (pxe_profile_id,software_group_id) VALUES (:p,:g) ON CONFLICT DO NOTHING'), {'p': profile_id, 'g': group_id})
        for config_id in sorted({int(x) for x in payload.get('configuration_profile_ids', []) if int(x) > 0}):
            connection.execute(text('INSERT INTO pxe_profile_configuration_profiles (pxe_profile_id,configuration_profile_id) VALUES (:p,:c) ON CONFLICT DO NOTHING'), {'p': profile_id, 'c': config_id})
    return {'id': profile_id, 'mac': mac, 'computer_name': name, 'status': 'draft', 'install_authorized': False}


def authorize_pxe_profile(profile_id: int) -> dict:
    profile = _one(
        '''SELECT p.id,p.computer_name,p.os_image_id,p.status,p.config,i.kind,i.enabled,i.metadata,d.mac
           FROM pxe_profiles p JOIN devices d ON d.id=p.device_id LEFT JOIN os_images i ON i.id=p.os_image_id WHERE p.id=:id''', {'id': profile_id}
    )
    if not profile:
        raise ValueError('PXE-профиль не найден')
    if not profile.get('os_image_id') or not profile.get('kind') or not profile.get('enabled'):
        raise ValueError('PXE-профиль не связан с доступным образом ОС')
    metadata = profile.get('metadata') or {}
    if isinstance(metadata, str):
        try: metadata = json.loads(metadata)
        except Exception: metadata = {}
    if metadata.get('status') not in {'ready', 'published'}:
        raise ValueError('образ ОС ещё не подготовлен для PXE')
    validate_computer_name(str(profile.get('computer_name') or ''), str(profile['kind']))
    _execute("UPDATE pxe_profiles SET status='publishing',install_authorized=false,authorized_at=NULL,updated_at=now() WHERE id=:id", {'id': profile_id})
    return {'id': profile_id, 'status': 'publishing', 'install_authorized': False}


def revoke_pxe_profile(profile_id: int) -> None:
    _execute("UPDATE pxe_profiles SET install_authorized=false,status=CASE WHEN status='installed' THEN status ELSE 'disabled' END,updated_at=now() WHERE id=:id", {'id': profile_id})


def delete_pxe_profile(profile_id: int) -> None:
    _execute('DELETE FROM pxe_profiles WHERE id=:id', {'id': profile_id})


def boot_profile(mac_value: str) -> dict | None:
    mac = normalize_mac(mac_value)
    with engine.begin() as connection:
        row = connection.execute(text(
            '''SELECT p.id,p.status,p.install_authorized,p.one_time,p.config,i.kind,i.id AS image_id,i.metadata,d.mac
               FROM pxe_profiles p JOIN devices d ON d.id=p.device_id JOIN os_images i ON i.id=p.os_image_id
               WHERE d.mac=:mac FOR UPDATE'''), {'mac': mac}).mappings().first()
        if not row or not row['install_authorized'] or row['status'] != 'authorized':
            return None
        profile_id = int(row['id'])
        connection.execute(text(
            "UPDATE pxe_profiles SET install_authorized=false,status='installing',consumed_at=now(),last_boot_at=now(),updated_at=now() WHERE id=:id"
        ), {'id': profile_id})
        return dict(row)


def report_pxe(profile_id: int, token: str, result: str) -> bool:
    row = _one('SELECT id,config FROM pxe_profiles WHERE id=:id', {'id': profile_id})
    if not row:
        return False
    config = row.get('config') or {}
    if isinstance(config, str):
        try: config = json.loads(config)
        except Exception: config = {}
    if not secrets.compare_digest(str(config.get('report_token') or ''), str(token or '')):
        return False
    status = 'installed' if result == 'success' else 'failed'
