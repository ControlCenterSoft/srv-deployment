    row = _one('INSERT INTO dhcp_options (code,value,enabled) VALUES (:code,:value,true) RETURNING id,code,value,enabled,updated_at', {'code': code, 'value': clean})
    return row or {}


def update_dhcp_option(option_id: int, payload: dict) -> None:
    code = int(payload.get('code'))
    value = str(payload.get('value') or '').strip()
    enabled = bool(payload.get('enabled', True))
    if code < 1 or code > 254 or not value or any(ch in value for ch in '\r\n\x00'):
        raise ValueError('некорректный DHCP option')
    _execute('UPDATE dhcp_options SET code=:code,value=:value,enabled=:enabled,updated_at=now() WHERE id=:id', {'id': option_id, 'code': code, 'value': value, 'enabled': enabled})


def delete_dhcp_option(option_id: int) -> None:
    _execute('DELETE FROM dhcp_options WHERE id=:id', {'id': option_id})


def save_reservation(payload: dict) -> dict:
    mac = normalize_mac(str(payload.get('mac') or ''))
    ip_value = str(ip_address(str(payload.get('ip_address') or '').strip()))
    hostname = str(payload.get('hostname') or '').strip() or None
    if hostname and len(hostname) > 255:
        raise ValueError('слишком длинное имя DHCP клиента')
    row = _one(
        '''INSERT INTO dhcp_reservations (mac,ip_address,hostname,enabled,updated_at)
           VALUES (:mac,:ip,:hostname,true,now())
           ON CONFLICT (mac) DO UPDATE SET ip_address=EXCLUDED.ip_address,hostname=EXCLUDED.hostname,enabled=true,updated_at=now()
           RETURNING id,mac,ip_address,hostname,enabled,updated_at''',
        {'mac': mac, 'ip': ip_value, 'hostname': hostname},
    )
    return row or {}


def delete_reservation(reservation_id: int) -> None:
    _execute('DELETE FROM dhcp_reservations WHERE id=:id', {'id': reservation_id})


def pxe_snapshot(kind: str) -> dict:
    if kind not in {'windows', 'linux'}:
        raise ValueError('invalid PXE kind')
    images = _rows(
        '''SELECT id,kind,name,version,architecture,source_path,sha256,enabled,metadata,created_at
           FROM os_images WHERE kind=:kind ORDER BY created_at DESC''', {'kind': kind}
    )
    profiles = _rows(
        '''SELECT p.id,d.mac,COALESCE(p.computer_name,d.computer_name,d.hostname) AS computer_name,p.ip_address,
                  p.os_image_id,i.name AS image_name,p.windows_edition,p.domain_join,p.domain_name,p.status,p.install_authorized,
                  p.one_time,p.authorized_at,p.consumed_at,p.last_boot_at,p.last_result,p.config,p.created_at,p.updated_at
           FROM pxe_profiles p JOIN devices d ON d.id=p.device_id
           LEFT JOIN os_images i ON i.id=p.os_image_id
           WHERE i.kind=:kind OR (i.id IS NULL AND (p.config->>'kind')=:kind)
           ORDER BY p.updated_at DESC''', {'kind': kind}
    )
    config_profiles = _rows('SELECT id,name,kind,description,config,enabled,created_at,updated_at FROM pxe_configuration_profiles WHERE kind IN (:kind,\'both\') ORDER BY name', {'kind': kind})
    software_groups = _rows(
        '''SELECT g.id,g.name,g.description,COUNT(m.software_item_id)::int AS item_count
           FROM software_groups g LEFT JOIN software_group_members m ON m.software_group_id=g.id
           GROUP BY g.id,g.name,g.description ORDER BY g.name'''
    )
    return {'kind': kind, 'images': images, 'profiles': profiles, 'configuration_profiles': config_profiles, 'software_groups': software_groups}


def create_image(kind: str, name: str, version: str | None, architecture: str, source_path: str, sha256: str) -> dict:
    if kind not in {'windows', 'linux'}:
        raise ValueError('invalid image kind')
    row = _one(
        '''INSERT INTO os_images (kind,name,version,architecture,source_path,sha256,enabled,metadata)
           VALUES (:kind,:name,:version,:arch,:path,:sha,true,CAST(:metadata AS jsonb))
           RETURNING id,kind,name,version,architecture,source_path,sha256,enabled,metadata,created_at''',
        {'kind': kind, 'name': name, 'version': version, 'arch': architecture or 'amd64', 'path': source_path, 'sha': sha256,
         'metadata': json.dumps({'release': '1.4.0', 'status': 'uploaded'})},
    )
    return row or {}


def _existing_profile_for_mac(mac: str) -> dict | None:
    return _one('''SELECT p.id,d.mac,p.status,i.kind FROM pxe_profiles p JOIN devices d ON d.id=p.device_id LEFT JOIN os_images i ON i.id=p.os_image_id WHERE d.mac=:mac''', {'mac': mac})


def create_pxe_profile(kind: str, payload: dict) -> dict:
    if kind not in {'windows', 'linux'}:
        raise ValueError('invalid PXE kind')
    mac = normalize_mac(str(payload.get('mac') or ''))
    duplicate = _existing_profile_for_mac(mac)
    if duplicate:
        raise ValueError(f"MAC {mac} уже находится в PXE-профиле #{duplicate['id']} ({duplicate.get('kind') or 'не определено'})")
    name = validate_computer_name(str(payload.get('computer_name') or ''), kind)
    image_id = int(payload.get('os_image_id') or 0)
    image = _one('SELECT id,kind,enabled FROM os_images WHERE id=:id', {'id': image_id})
    if not image or image['kind'] != kind or not image['enabled']:
        raise ValueError('выбранный образ ОС не найден или не опубликован для этого типа PXE')
    ip_value = str(payload.get('ip_address') or '').strip() or None
    if ip_value:
        ip_value = str(ip_address(ip_value))
    domain_join = bool(payload.get('domain_join')) if kind == 'windows' else False
    domain_name = str(payload.get('domain_name') or '').strip() or None
