@router.post('/api/v1/release14/pxe/{kind}/images')
async def pxe_image_upload(kind: str, request: Request, image: UploadFile = File(...)):
    _, identity = _identity(request, 'pxe', 'write', csrf=True)
    if kind not in {'windows', 'linux'}:
        raise HTTPException(status_code=404, detail='invalid PXE kind')
    original = Path(image.filename or 'image.iso').name
    if not original.lower().endswith('.iso'):
        raise HTTPException(status_code=400, detail='ожидается ISO-образ')
    PXE_UPLOAD_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(PXE_UPLOAD_DIR, 0o750)
    free = shutil.disk_usage(PXE_UPLOAD_DIR).free
    limit = min(MAX_ISO, int(free * 0.85))
    token = uuid.uuid4().hex
    target = PXE_UPLOAD_DIR / f'{token}.iso'
    digest = hashlib.sha256()
    written = 0
    try:
        with target.open('xb') as handle:
            os.chmod(target, 0o640)
            while True:
                chunk = await image.read(UPLOAD_CHUNK)
                if not chunk:
                    break
                written += len(chunk)
                if written > limit:
                    raise HTTPException(status_code=413, detail='ISO превышает безопасный лимит свободного места')
                digest.update(chunk)
                handle.write(chunk)
            handle.flush()
            os.fsync(handle.fileno())
    except Exception:
        target.unlink(missing_ok=True)
        raise
    if written < 1024 * 1024:
        target.unlink(missing_ok=True)
        raise HTTPException(status_code=400, detail='загруженный ISO слишком мал')
    name = str(request.query_params.get('name') or Path(original).stem).strip()[:255]
    version = str(request.query_params.get('version') or '').strip()[:120] or None
    row = create_image(kind, name, version, 'amd64', str(target), digest.hexdigest())
    queued = enqueue('pxe-image-prepare', identity.username, _client_ip(request), {'image_id': int(row['id']), 'kind': kind, 'source_path': str(target), 'original_name': original})
    return {'ok': True, 'data': {'image': row, 'action': queued}, 'error': None}


