async def redirects_create(request: Request):
    _identity(request, 'shares', 'write', csrf=True)
    try:
        item = save_folder_redirect(await _json(request))
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    return {'ok': True, 'data': item, 'error': None}


@router.get('/api/v1/release14/folder-redirects/{profile_id}/script.ps1', response_class=PlainTextResponse)
def redirects_script(profile_id: int, request: Request):
    _identity(request, 'shares', 'read')
    try:
        script = folder_redirect_script(profile_id)
    except ValueError as exc:
        raise HTTPException(status_code=404, detail=str(exc)) from exc
    return PlainTextResponse(
        script,
        media_type='text/plain; charset=utf-8',
        headers={'Content-Disposition': f'attachment; filename=srv-folder-redirect-{profile_id}.ps1'},
    )


@router.delete('/api/v1/release14/folder-redirects/{profile_id}')
def redirects_delete(profile_id: int, request: Request):
    _identity(request, 'shares', 'write', csrf=True)
    delete_folder_redirect(profile_id)
    return {'ok': True, 'data': {'deleted': profile_id}, 'error': None}


@router.post('/api/v1/release14/folder-redirects/{profile_id}/assignments')
async def redirect_assignment_create(profile_id: int, request: Request):
    _identity(request, 'shares', 'write', csrf=True)
    try:
        item = add_folder_assignment(profile_id, await _json(request))
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc
    return {'ok': True, 'data': item, 'error': None}


@router.delete('/api/v1/release14/folder-redirect-assignments/{assignment_id}')
def redirect_assignment_delete(assignment_id: int, request: Request):
    _identity(request, 'shares', 'write', csrf=True)
    delete_folder_assignment(assignment_id)
    return {'ok': True, 'data': {'deleted': assignment_id}, 'error': None}
