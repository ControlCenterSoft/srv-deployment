#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path
import sys


CONFIG = Path("/var/lib/srv-control/backup-config.json")
DEFAULT = {
    "scheduled": False,
    "daily_time": "03:00",
    "backup_before_update": True,
}


def load() -> dict:
    try:
        value = json.loads(CONFIG.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else dict(DEFAULT)
    except Exception:
        return dict(DEFAULT)


def effective() -> dict:
    raw = load()
    return {
        "schema_version": 1,
        "scheduled": raw.get("scheduled") is True,
        "daily_time": str(raw.get("daily_time") or "03:00"),
        "backup_before_update": raw.get("backup_before_update") is True,
    }


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    data = effective()
    if command == "status":
        print(json.dumps(data, ensure_ascii=False, sort_keys=True))
        return 0
    if command == "required-for-update":
        return 0 if data["backup_before_update"] else 1
    if command == "scheduled":
        return 0 if data["scheduled"] else 1
    print("usage: srv-control-backup-policy status|required-for-update|scheduled", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
