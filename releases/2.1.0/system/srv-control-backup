#!/usr/bin/env python3
from __future__ import annotations

import argparse
import grp
import hashlib
import json
import os
from pathlib import Path
import pwd
import shutil
import subprocess
import tarfile
import tempfile
from datetime import datetime, timezone
import urllib.request
import uuid

APP_USER = "srv-control"
APP_GROUP = "srv-control"
BACKUP_DIR = Path("/var/lib/srv-control/backups")
RELEASE_META = Path("/var/lib/srv-control/release.json")
PROJECT = Path("/opt/srv-control")
MANAGED_PATHS = (
    Path("/etc/srv-control"),
    Path("/var/lib/srv-control/github-update-config.json"),
    Path("/var/lib/srv-control/os-update-config.json"),
    Path("/var/lib/srv-control/backup-config.json"),
    Path("/var/lib/srv-control/network-config.json"),
    Path("/var/lib/srv-control/pxe/smb-credential.json"),
    Path("/etc/dnsmasq.d/srv-control.conf"),
    Path("/etc/default/tftpd-hpa"),
    Path("/etc/samba/smb.conf"),
    Path("/etc/pam.d/srv-control"),
    Path("/etc/nginx/sites-available/srv-control"),
    Path("/etc/apt/apt.conf.d/20auto-upgrades"),
    Path("/etc/systemd/system/srvcc-github-agent.service"),
    Path("/etc/systemd/system/srvcc-github-agent.timer"),
    Path("/etc/systemd/system/srv-control-os-auto-update.service"),
    Path("/etc/systemd/system/srv-control-os-auto-update.timer"),
    Path("/etc/systemd/system/srv-control-system-agent.service"),
    Path("/etc/systemd/system/srv-control-system-agent.path"),
    Path("/etc/systemd/system/srv-control-os-update.service"),
    Path("/etc/systemd/system/srv-control-backup.service"),
    Path("/etc/systemd/system/srv-control-backup.timer"),
    Path("/etc/systemd/system/srv-control-release14-agent.service"),
    Path("/etc/systemd/system/srv-control-release14-agent.path"),
    Path("/etc/systemd/system/srv-control-backup-retention.service"),
    Path("/etc/systemd/system/srv-control-backup-retention.path"),
    Path("/usr/local/sbin/srvcc-github-agent"),
    Path("/usr/local/sbin/srvcc-configure-auto-updates"),
    Path("/usr/local/libexec/srv-control-system-agent"),
    Path("/usr/local/libexec/srv-control-os-update"),
    Path("/usr/local/libexec/srv-control-os-auto-update"),
    Path("/usr/local/libexec/srv-control-release14-agent"),
    Path("/usr/local/libexec/srv-control-pxe-probe"),
)


def run(command: list[str], *, timeout: int = 300) -> str:
    result = subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
        env={**os.environ, "DEBIAN_FRONTEND": "noninteractive", "HOME": "/root"},
    )
    output = result.stdout or ""
    if result.returncode != 0:
        raise RuntimeError(f"command failed ({result.returncode}): {' '.join(command)}\n{output[-4000:]}")
    return output


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def service_ids() -> tuple[int, int]:
    user = pwd.getpwnam(APP_USER)
    group = grp.getgrnam(APP_GROUP)
    return user.pw_uid, group.gr_gid


def prepare_backup_dir() -> tuple[int, int]:
    uid, gid = service_ids()
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    os.chown(BACKUP_DIR, 0, gid)
    os.chmod(BACKUP_DIR, 0o750)
    return uid, gid


def release_version() -> str:
    try:
        payload = json.loads(RELEASE_META.read_text(encoding="utf-8"))
        return str(payload.get("version") or "unknown")
    except Exception:
        return "unknown"


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def make_shared_temp(prefix: str) -> Path:
    uid, gid = service_ids()
    path = Path(tempfile.mkdtemp(prefix=prefix, dir="/var/tmp"))
    os.chown(path, 0, gid)
    os.chmod(path, 0o750)
    return path


def remove_tree(path: Path) -> None:
    shutil.rmtree(path, ignore_errors=True)


def _copy_managed(stage: Path) -> None:
    files_root = stage / "files"
    for source in MANAGED_PATHS:
        if not source.exists():
            continue
        target = files_root / source.relative_to("/")
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            shutil.copytree(source, target, symlinks=True)
        else:
            shutil.copy2(source, target, follow_symlinks=False)


def create_backup(actor: str, reason: str) -> dict:
    uid, gid = prepare_backup_dir()
    backup_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:10]
    archive = BACKUP_DIR / f"{backup_id}.tar.gz"
    metadata_path = BACKUP_DIR / f"{backup_id}.json"
    root = make_shared_temp("srvcc-backup.")
    try:
        stage = root / "content"
        stage.mkdir(mode=0o750)
        os.chown(stage, uid, gid)
        dump = stage / "srv_control.dump"
        run(["runuser", "-u", APP_USER, "--", "pg_dump", "-Fc", "-d", "srv_control", "-f", str(dump)], timeout=600)
        if not dump.is_file() or dump.stat().st_size == 0:
            raise RuntimeError("database dump was not created")
        os.chown(dump, uid, gid)
        os.chmod(dump, 0o640)
        _copy_managed(stage)
        (stage / "backup-info.json").write_text(
            json.dumps({
                "schema_version": 2,
                "id": backup_id,
                "created_at": now(),
                "release": release_version(),
                "actor": actor,
                "reason": reason,
                "pxe_media_included": False,
                "pxe_restore_policy": "revoke-active-authorizations",
            }, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )
        with tarfile.open(archive, "w:gz") as tar:
            tar.add(stage, arcname="content", recursive=True)
    finally:
        remove_tree(root)
    os.chown(archive, 0, gid)
    os.chmod(archive, 0o640)
    metadata = {
        "schema_version": 2,
        "id": backup_id,
        "created_at": now(),
        "release": release_version(),
        "actor": actor,
        "reason": reason,
        "archive": archive.name,
        "size": archive.stat().st_size,
        "sha256": sha256(archive),
        "pxe_media_included": False,
        "pxe_restore_policy": "revoke-active-authorizations",
    }
    metadata_path.write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chown(metadata_path, 0, gid)
    os.chmod(metadata_path, 0o640)
    return metadata


def load_metadata(backup_id: str) -> tuple[dict, Path]:
    if not backup_id or any(ch not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" for ch in backup_id):
        raise RuntimeError("invalid backup id")
    metadata_path = BACKUP_DIR / f"{backup_id}.json"
    if not metadata_path.is_file():
        raise RuntimeError("backup metadata not found")
    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    archive = BACKUP_DIR / str(metadata.get("archive") or "")
    if not archive.is_file():
        raise RuntimeError("backup archive not found")
    if sha256(archive) != metadata.get("sha256"):
        raise RuntimeError("backup checksum mismatch")
    return metadata, archive


def delete_backup(backup_id: str) -> dict:
    metadata, archive = load_metadata(backup_id)
    archive.unlink()
    (BACKUP_DIR / f"{backup_id}.json").unlink(missing_ok=True)
    return {"deleted": backup_id, "size": metadata.get("size")}


def _safe_extract(archive: Path, target: Path) -> None:
    target_root = target.resolve()
    with tarfile.open(archive, "r:gz") as tar:
        for member in tar.getmembers():
            resolved = (target / member.name).resolve()
            if resolved != target_root and target_root not in resolved.parents:
                raise RuntimeError("unsafe path in backup archive")
            if member.issym() or member.islnk():
                raise RuntimeError("backup archive contains links")
        tar.extractall(target, filter="data")


def _restore_files(content: Path) -> None:
    files_root = content / "files"
    for destination in MANAGED_PATHS:
        source = files_root / destination.relative_to("/")
        if not source.exists():
            continue
        if destination.is_dir() and not destination.is_symlink():
            shutil.rmtree(destination)
        elif destination.exists() or destination.is_symlink():
            destination.unlink()
        destination.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            shutil.copytree(source, destination, symlinks=False)
        else:
            shutil.copy2(source, destination, follow_symlinks=False)


def migrate_restored_database() -> None:
    alembic = PROJECT / "venv/bin/alembic"
    config = PROJECT / "alembic.ini"
    if not alembic.is_file() or not config.is_file():
        raise RuntimeError("current Control Center migration environment is missing")
    run([
        "runuser", "-u", APP_USER, "--", "env", f"PYTHONPATH={PROJECT}", "PYTHONDONTWRITEBYTECODE=1",
        str(alembic), "-c", str(config), "upgrade", "head",
    ], timeout=600)


def invalidate_restored_pxe_authorizations() -> None:
    """Never reactivate an old installation attempt after restoring a backup."""
    sql = r"""
DO $$
BEGIN
  IF to_regclass('public.pxe_profiles') IS NOT NULL THEN
    UPDATE pxe_profiles
       SET install_authorized = false,
           status = CASE WHEN status = 'installed' THEN 'installed' ELSE 'disabled' END,
           consumed_at = NULL,
           last_result = CASE WHEN status = 'installed' THEN last_result ELSE 'restore-requires-reauthorization' END,
           config = COALESCE(config, '{}'::jsonb) - 'boot_token' - 'report_token',
           updated_at = now();
  END IF;
END $$;
"""
    run(["runuser", "-u", APP_USER, "--", "psql", "-d", "srv_control", "-v", "ON_ERROR_STOP=1", "-c", sql], timeout=60)


def _is_active(unit: str) -> bool:
    return subprocess.run(
        ["systemctl", "is-active", "--quiet", unit],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def _validate_and_reload_restored_services(previously_active: dict[str, bool]) -> None:
    """Validate restored configs before restarting only services that were active."""
    dnsmasq_conf = Path("/etc/dnsmasq.d/srv-control.conf")
    if dnsmasq_conf.is_file() and shutil.which("dnsmasq"):
        run(["dnsmasq", "--test"], timeout=30)
        if previously_active.get("dnsmasq.service"):
            run(["systemctl", "restart", "dnsmasq.service"], timeout=60)

    samba_conf = Path("/etc/samba/smb.conf")
    if samba_conf.is_file() and shutil.which("testparm"):
        run(["testparm", "-s", str(samba_conf)], timeout=30)
        for unit in ("samba-ad-dc.service", "smbd.service", "samba.service"):
            if previously_active.get(unit):
                run(["systemctl", "restart", unit], timeout=90)
                break

    if previously_active.get("tftpd-hpa.service"):
        run(["systemctl", "restart", "tftpd-hpa.service"], timeout=60)

    if Path("/etc/nginx/sites-available/srv-control").is_file() and shutil.which("nginx"):
        run(["nginx", "-t"], timeout=30)
        if previously_active.get("nginx.service"):
            run(["systemctl", "reload", "nginx.service"], timeout=60)


def _restore_raw(backup_id: str) -> dict:
    uid, gid = service_ids()
    metadata, archive = load_metadata(backup_id)
    root = make_shared_temp("srvcc-restore.")
    managed_units = (
        "dnsmasq.service", "tftpd-hpa.service", "samba-ad-dc.service",
        "smbd.service", "samba.service", "nginx.service",
    )
    previously_active = {unit: _is_active(unit) for unit in managed_units}
    try:
        _safe_extract(archive, root)
        content = root / "content"
        dump = content / "srv_control.dump"
        if not dump.is_file():
            raise RuntimeError("database dump missing from backup")
        os.chown(content, 0, gid)
        os.chmod(content, 0o750)
        os.chown(dump, uid, gid)
        os.chmod(dump, 0o640)

        run(["systemctl", "stop", "srv-control.service"], timeout=30)
        try:
            run([
                "runuser", "-u", "postgres", "--", "psql", "-d", "postgres", "-v", "ON_ERROR_STOP=1", "-c",
                "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='srv_control' AND pid <> pg_backend_pid();",
            ])
            run(["runuser", "-u", "postgres", "--", "dropdb", "--if-exists", "srv_control"])
            run(["runuser", "-u", "postgres", "--", "createdb", "--owner=srv-control", "srv_control"])
            run(["runuser", "-u", APP_USER, "--", "pg_restore", "--no-owner", "-d", "srv_control", str(dump)], timeout=600)
            migrate_restored_database()
            invalidate_restored_pxe_authorizations()
            _restore_files(content)
            run(["systemctl", "daemon-reload"])
            _validate_and_reload_restored_services(previously_active)
        finally:
            run(["systemctl", "start", "srv-control.service"], timeout=30)
    finally:
        remove_tree(root)

    with urllib.request.urlopen("http://127.0.0.1:8876/api/v1/health", timeout=10) as response:
        health = json.load(response)
    if health.get("ok") is not True:
        raise RuntimeError("Control Center healthcheck failed after restore")
    return {
        "restored": backup_id,
        "backup_release": metadata.get("release"),
        "pxe_authorizations_revoked": True,
    }


def restore_backup(backup_id: str, actor: str) -> dict:
    safety = create_backup(actor, "pre-restore")
    try:
        result = _restore_raw(backup_id)
        result["safety_backup"] = safety["id"]
        return result
    except Exception as original:
        try:
            _restore_raw(str(safety["id"]))
        except Exception as rollback_error:
            raise RuntimeError(f"restore failed: {original}; safety rollback failed: {rollback_error}") from original
        raise RuntimeError(f"restore failed and safety backup was restored: {original}") from original


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    create = sub.add_parser("create")
    create.add_argument("--actor", required=True)
    create.add_argument("--reason", default="manual")
    delete = sub.add_parser("delete")
    delete.add_argument("backup_id")
    restore = sub.add_parser("restore")
    restore.add_argument("backup_id")
    restore.add_argument("--actor", required=True)
    args = parser.parse_args()
    if args.command == "create":
        result = create_backup(args.actor, args.reason)
    elif args.command == "delete":
        result = delete_backup(args.backup_id)
    else:
        result = restore_backup(args.backup_id, args.actor)
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
