#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

REPO_URL="https://github.com/filosoff31/srv-deployment.git"
MODE="automatic"
INTERVAL_MINUTES=5
CHECK_NOW=0

STATE_DIR="/var/lib/srv-control"
CONFIG="${STATE_DIR}/github-update-config.json"
CONTROLLER="/usr/local/sbin/srvcc-update-controller"
COMPAT_AGENT="/usr/local/sbin/srvcc-github-agent"
CONFIGURATOR="/usr/local/sbin/srvcc-configure-auto-updates"
STATE_PUBLISHER="/usr/local/sbin/srvcc-github-agent.state-publisher"
SERVICE="srvcc-github-agent.service"
TIMER="srvcc-github-agent.timer"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

fail(){ printf 'UPDATE CONFIG 2.0 FAIL: %s\n' "$*" >&2; exit 1; }

same_file(){
    local source="$1" target="$2" source_real target_real
    source_real="$(readlink -f -- "$source" 2>/dev/null || true)"
    target_real="$(readlink -f -- "$target" 2>/dev/null || true)"
    [[ -n "$source_real" && -n "$target_real" && "$source_real" == "$target_real" ]]
}

while (($#)); do
    case "$1" in
        --repo) REPO_URL="${2:?}"; shift 2 ;;
        --mode) MODE="${2:?}"; shift 2 ;;
        --interval-minutes) INTERVAL_MINUTES="${2:?}"; shift 2 ;;
        --check-now) CHECK_NOW=1; shift ;;
        --no-check-now) CHECK_NOW=0; shift ;;
        -h|--help)
            printf '%s\n' 'Usage: srvcc-configure-auto-updates [--repo URL] [--mode automatic|manual] [--interval-minutes 1..1440] [--check-now]'
            exit 0
            ;;
        *) fail "unknown argument: $1" ;;
    esac
done

[[ "$(id -u)" -eq 0 ]] || fail "must run as root"
[[ "$MODE" == "automatic" || "$MODE" == "manual" ]] || fail "mode must be automatic or manual"
[[ "$INTERVAL_MINUTES" =~ ^[0-9]+$ ]] || fail "interval must be an integer"
(( INTERVAL_MINUTES >= 1 && INTERVAL_MINUTES <= 1440 )) || fail "interval must be 1..1440 minutes"
python3 - "$REPO_URL" <<'PY'
from urllib.parse import urlparse
import sys
p=urlparse(sys.argv[1])
if p.scheme != 'https' or p.hostname not in {'github.com','www.github.com'} or p.path.count('/') < 2:
    raise SystemExit('invalid GitHub update source')
PY

install -d -m 0750 "$STATE_DIR" /var/lib/srvcc-agent

controller_source="${SCRIPT_DIR}/srvcc-update-controller"
if [[ -s "$controller_source" ]]; then
    if ! same_file "$controller_source" "$CONTROLLER"; then
        install -m 0755 -o root -g root "$controller_source" "$CONTROLLER"
    fi
elif [[ ! -x "$CONTROLLER" ]]; then
    fail "2.0 update controller is not installed"
fi

if ! same_file "$0" "$CONFIGURATOR"; then
    install -m 0755 -o root -g root "$0" "$CONFIGURATOR"
fi

publisher_source="${SCRIPT_DIR}/srvcc-github-state-publisher"
if [[ -s "$publisher_source" ]]; then
    if ! same_file "$publisher_source" "$STATE_PUBLISHER"; then
        install -m 0755 -o root -g root "$publisher_source" "$STATE_PUBLISHER"
    fi
fi

cat > "$COMPAT_AGENT" <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
exec /usr/local/sbin/srvcc-update-controller "$@"
EOF
chmod 0755 "$COMPAT_AGENT"

cat > "/etc/systemd/system/${SERVICE}" <<EOF
[Unit]
Description=Control Center 2.x transactional GitHub updater
After=network-online.target srv-control.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=SRVCC_REPO_URL=${REPO_URL}
ExecStart=${CONTROLLER} apply --actor system
TimeoutStartSec=45min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
EOF

cat > "/etc/systemd/system/${TIMER}" <<EOF
[Unit]
Description=Control Center 2.x update check/apply schedule

[Timer]
OnBootSec=2min
OnUnitInactiveSec=${INTERVAL_MINUTES}min
RandomizedDelaySec=20s
AccuracySec=15s
Persistent=true
Unit=${SERVICE}

[Install]
WantedBy=timers.target
EOF

python3 - "$CONFIG" "$REPO_URL" "$MODE" "$INTERVAL_MINUTES" <<'PY'
import json, os, pathlib, sys, tempfile
path=pathlib.Path(sys.argv[1])
payload={
    'schema_version':4,
    'source':sys.argv[2],
    'mode':sys.argv[3],
    'interval_minutes':int(sys.argv[4]),
}
path.parent.mkdir(parents=True,exist_ok=True)
fd,tmp=tempfile.mkstemp(prefix='.'+path.name+'.',dir=str(path.parent))
try:
    with os.fdopen(fd,'w',encoding='utf-8') as h:
        json.dump(payload,h,ensure_ascii=False,indent=2); h.write('\n'); h.flush(); os.fsync(h.fileno())
    os.chmod(tmp,0o644); os.replace(tmp,path)
finally:
    try: os.unlink(tmp)
    except FileNotFoundError: pass
PY

systemctl daemon-reload
systemctl reset-failed "$SERVICE" >/dev/null 2>&1 || true
if [[ "$MODE" == "automatic" ]]; then
    systemctl enable --now "$TIMER" >/dev/null
    systemctl is-enabled --quiet "$TIMER" || fail "automatic update timer is not enabled"
    systemctl is-active --quiet "$TIMER" || fail "automatic update timer is not active"
else
    systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
fi

if (( CHECK_NOW )); then
    "$CONTROLLER" check --actor admin
fi

printf 'UPDATE CONFIG 2.0 PASS\nsource=%s\nmode=%s\ninterval_minutes=%s\n' "$REPO_URL" "$MODE" "$INTERVAL_MINUTES"
