SMB_END = '# END SRV CONTROL CENTER PXE 1.4'
WIMBOOT_URL = 'https://github.com/ipxe/wimboot/releases/download/v2.9.0/wimboot'


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def run(cmd: list[str], *, input_text: str | None = None, timeout: int = 900, check: bool = True) -> str:
    p = subprocess.run(cmd, input=input_text, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       timeout=timeout, check=False, env={**os.environ, 'DEBIAN_FRONTEND': 'noninteractive', 'HOME': '/root'})
    out = p.stdout or ''
    if check and p.returncode != 0:
        raise RuntimeError(f"command failed ({p.returncode}): {' '.join(cmd)}\n{out[-6000:]}")
    return out


def write_json(path: Path, payload: dict, mode: int = 0o640) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as h:
            json.dump(payload, h, ensure_ascii=False, indent=2); h.write('\n'); h.flush(); os.fsync(h.fileno()); os.fchmod(h.fileno(), mode)
        os.replace(name, path)
        if str(path).startswith('/var/lib/srv-control') and (mode & 0o040):
            try: os.chown(path, 0, grp.getgrnam('srv-control').gr_gid)
            except Exception: pass
    finally:
        try: os.unlink(name)
        except FileNotFoundError: pass


def read_json(path: Path, default):
    try: return json.loads(path.read_text(encoding='utf-8'))
    except Exception: return default


def psql_json(sql: str) -> dict | list | None:
    wrapped = f"SELECT COALESCE(json_agg(x),'[]'::json)::text FROM ({sql}) x;"
    out = run(['runuser','-u','srv-control','--','psql','-d','srv_control','-At','-v','ON_ERROR_STOP=1','-c',wrapped], timeout=60).strip()
    return json.loads(out or '[]')


def psql_exec(sql: str) -> None:
    run(['runuser','-u','srv-control','--','psql','-d','srv_control','-v','ON_ERROR_STOP=1','-c',sql], timeout=60)


def sql_literal(value: str) -> str:
    return "'" + str(value).replace("'", "''") + "'"


def apt_install(*packages: str) -> None:
    run(['apt-get','update','-y'], timeout=300)
    run(['apt-get','install','-y','--no-install-recommends',*packages], timeout=1200)


def install_dhcp() -> str:
    apt_install('dnsmasq-base','dnsmasq')
    Path('/etc/dnsmasq.d').mkdir(parents=True, exist_ok=True)
    subprocess.run(['systemctl','disable','--now','dnsmasq.service'], check=False)
    rows = psql_json('SELECT * FROM dhcp_configs WHERE id=1') or []
    if rows and rows[0].get('interface'):
        return apply_dhcp()
    return 'DHCP server installed; waiting for configuration'


def remove_dhcp() -> str:
    subprocess.run(['systemctl','disable','--now','dnsmasq.service'], check=False)
    run(['apt-get','remove','-y','dnsmasq'], timeout=900)
    return 'DHCP server removed; Control Center DHCP data and config file preserved'


def apply_dhcp() -> str:
    rows = psql_json('SELECT * FROM dhcp_configs WHERE id=1') or []
    if not rows:
        raise RuntimeError('DHCP configuration is not defined')
    c = rows[0]
    if not c.get('enabled'):
        subprocess.run(['systemctl','disable','--now','dnsmasq.service'], check=False)
        return 'DHCP configuration saved; service disabled'
    required = ['interface','network','netmask','range_start','range_end','gateway']
    if any(not c.get(k) for k in required):
        raise RuntimeError('DHCP configuration is incomplete')
    options = psql_json('SELECT code,value FROM dhcp_options WHERE enabled=true ORDER BY code,id') or []
    reservations = psql_json('SELECT mac,ip_address,hostname FROM dhcp_reservations WHERE enabled=true ORDER BY ip_address') or []
    dns = c.get('dns') or []
    lines = [
        '# Managed by SRV Control Center 1.4.0',
        'port=0', 'bind-interfaces', f"interface={c['interface']}", 'dhcp-authoritative',
        f"dhcp-range={c['range_start']},{c['range_end']},{c['netmask']},{c.get('lease_time') or '12h'}",
        f"dhcp-option=option:router,{c['gateway']}",
    ]
    if dns: lines.append('dhcp-option=option:dns-server,' + ','.join(str(x) for x in dns))
    for item in options:
        value = str(item['value']).replace('\n','').replace('\r','')
        lines.append(f"dhcp-option={int(item['code'])},{value}")
    for item in reservations:
        host = (',' + str(item['hostname'])) if item.get('hostname') else ''
        lines.append(f"dhcp-host={item['mac']},{item['ip_address']}{host}")
    if TFTP_ROOT.is_dir():
        # Chain PXE ROM -> iPXE -> per-MAC HTTP authorization script.
        lines += [
