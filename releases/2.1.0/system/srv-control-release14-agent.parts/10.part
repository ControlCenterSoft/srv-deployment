
def _software_commands(profile_id: int, server: str, cred: dict) -> list[str]:
    rows = psql_json(f"""SELECT DISTINCT s.name,s.package_path,s.install_args
      FROM pxe_profile_software_groups pg
      JOIN software_group_members gm ON gm.software_group_id=pg.software_group_id
      JOIN software_items s ON s.id=gm.software_item_id
      WHERE pg.pxe_profile_id={profile_id} AND s.enabled=true ORDER BY s.name""") or []
    commands = []
    for row in rows:
        name = str(row.get('name') or 'software').replace('\r', ' ').replace('\n', ' ')[:120]
        path = str(row.get('package_path') or '')
        package = Path(path)
        try:
            rel = package.resolve().relative_to(PXE_MEDIA.resolve())
        except Exception as exc:
            raise RuntimeError(f'PXE software package is outside managed media root: {name}') from exc
        if not package.is_file():
            raise RuntimeError(f'PXE software package is missing: {name} ({package})')
        unc = 'Z:\\' + str(rel).replace('/', '\\')
        args = str(row.get('install_args') or '').replace('\r', ' ').replace('\n', ' ')
        low = path.lower()
        commands.append(f'echo Installing {name}')
        if low.endswith('.msi'):
            commands += [
                f'msiexec /i "{unc}" /qn /norestart {args}'.strip(),
                'set "SRV_RC=%ERRORLEVEL%"',
                'if "%SRV_RC%"=="3010" set "SRV_REBOOT=1"',
                'if not "%SRV_RC%"=="0" if not "%SRV_RC%"=="3010" goto setup_failed',
            ]
        elif low.endswith('.exe'):
            commands += [
                f'"{unc}" {args}'.strip(),
                'set "SRV_RC=%ERRORLEVEL%"',
                'if "%SRV_RC%"=="3010" set "SRV_REBOOT=1"',
                'if not "%SRV_RC%"=="0" if not "%SRV_RC%"=="3010" goto setup_failed',
            ]
        elif low.endswith(('.cmd', '.bat')):
            commands += [
                f'call "{unc}" {args}'.strip(),
                'if errorlevel 1 goto setup_failed',
            ]
        else:
            raise RuntimeError(f'unsupported PXE software package type: {name} ({package.suffix})')
    return commands


def publish_windows(profile: dict, config: dict, target: Path, server: str, cred: dict) -> None:
    image_id = int(profile['image_id'])
    meta = profile.get('metadata') or {}
    if isinstance(meta, str):
        meta = json.loads(meta)
    install_name = str(meta.get('install_image') or 'install.wim')
    arch = str(meta.get('architecture') or 'amd64').lower()
    component_arch = {'amd64': 'amd64', 'i386': 'x86', 'arm64': 'arm64'}.get(arch)
    if not component_arch:
        raise RuntimeError(f'Windows PXE architecture is not supported: {arch}')
    wimboot_name = {'amd64': 'wimboot', 'i386': 'wimboot.i386', 'arm64': 'wimboot.arm64'}[arch]
    if not (PXE_MEDIA / 'boot' / wimboot_name).is_file():
        raise RuntimeError(f'{wimboot_name} is missing for Windows {arch}')

    editions = meta.get('editions') if isinstance(meta.get('editions'), list) else []
    edition = str(profile.get('windows_edition') or '').strip()
    index = 1
    for item in editions:
        if edition and edition.lower() in str(item.get('name') or '').lower():
            index = int(item.get('index') or 1)
            break

    profile_config = profile.get('config') or {}
    if isinstance(profile_config, str):
        profile_config = json.loads(profile_config)
    report_token = str(profile_config.get('report_token') or '')
    boot_token = str(profile_config.get('boot_token') or '')
    if not report_token or not boot_token:
        raise RuntimeError('PXE profile tokens are missing')

    disk_number_raw = config.get('install_disk_number')
    disk_serial = str(config.get('install_disk_serial') or '').strip()
    if disk_number_raw not in (None, '') and disk_serial:
        raise RuntimeError('Windows PXE: use only install_disk_number or install_disk_serial, not both')
    disk_number = None
    if disk_number_raw not in (None, ''):
        try:
            disk_number = int(disk_number_raw)
        except Exception as exc:
            raise RuntimeError('Windows PXE install_disk_number must be an integer') from exc
        if disk_number < 0 or disk_number > 255:
            raise RuntimeError('Windows PXE install_disk_number must be 0..255')
    if disk_serial and (len(disk_serial) > 160 or any(ch in disk_serial for ch in '\r\n\x00')):
        raise RuntimeError('invalid Windows PXE install_disk_serial')

    # Disk templates intentionally do not select a disk. WinPE creates a
    # temporary script with the validated runtime disk number prepended.
    diskpart_uefi = '''clean\nconvert gpt\ncreate partition efi size=260\nformat quick fs=fat32 label=SYSTEM\nassign letter=S\ncreate partition msr size=16\ncreate partition primary\nformat quick fs=ntfs label=Windows\nassign letter=W\nexit\n'''
    diskpart_bios = '''clean\nconvert mbr\ncreate partition primary size=550\nformat quick fs=ntfs label=SYSTEM\nactive\nassign letter=S\ncreate partition primary\nformat quick fs=ntfs label=Windows\nassign letter=W\nexit\n'''
    (target / 'diskpart-uefi.txt').write_text(diskpart_uefi, encoding='utf-8')
    (target / 'diskpart-bios.txt').write_text(diskpart_bios, encoding='utf-8')

    locale = profile.get('locale') or 'ru-RU'
    unattend = f'''<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="{component_arch}" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>{profile['computer_name']}</ComputerName>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="{component_arch}" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>{locale}</InputLocale><SystemLocale>{locale}</SystemLocale><UILanguage>{locale}</UILanguage><UserLocale>{locale}</UserLocale>
    </component>
  </settings>
</unattend>'''
    (target / 'unattend.xml').write_text(unattend, encoding='utf-8')

    setup = [
        '@echo off',
        'setlocal',
        'set "SRV_REBOOT=0"',
        f'net use Z: \\\\{server}\\PXE$ /user:{cred["username"]} {cred["password"]}',
        'if errorlevel 1 goto setup_failed',
    ]
    setup += _software_commands(int(profile['id']), server, cred)
    if profile.get('domain_join') and config.get('domain_user') and config.get('domain_password') and profile.get('domain_name'):
        du = str(config['domain_user']).replace("'", "''")
        dp = str(config['domain_password']).replace("'", "''")
        domain = str(profile['domain_name']).replace("'", "''")
        setup += [
            f'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$p=ConvertTo-SecureString \'{dp}\' -AsPlainText -Force;$c=New-Object System.Management.Automation.PSCredential(\'{du}\',$p);Add-Computer -DomainName \'{domain}\' -Credential $c -Force"',
            'if errorlevel 1 goto setup_failed',
            'set "SRV_REBOOT=1"',
        ]
    setup += [
        f'curl.exe -fsS --retry 5 --retry-delay 2 -X POST http://{server}/pxe/report/{profile["id"]}/{report_token}/success >NUL 2>NUL',
        'net use Z: /delete /y >NUL 2>NUL',
        'del /f /q "%~f0" >NUL 2>NUL',
        'if "%SRV_REBOOT%"=="1" shutdown.exe /r /t 5 /c "SRV Control Center post-install completed"',
        'exit /b 0',
        ':setup_failed',
        f'curl.exe -fsS --retry 5 --retry-delay 2 -X POST http://{server}/pxe/report/{profile["id"]}/{report_token}/failed >NUL 2>NUL',
        'net use Z: /delete /y >NUL 2>NUL',
        'del /f /q "%~f0" >NUL 2>NUL',
        'exit /b 1',
    ]
    (target / 'SetupComplete.cmd').write_text('\r\n'.join(setup) + '\r\n', encoding='utf-8')

    if disk_number is not None:
        disk_selector = f'set "InstallDisk={disk_number}"\r\n'
    elif disk_serial:
        serial_ps = disk_serial.replace("'", "''")
        disk_selector = (
            'set "InstallDisk="\r\n'
            f'for /f "usebackq delims=" %%D in (`powershell.exe -NoProfile -Command "$d=@(Get-Disk ^| Where-Object {{ $_.SerialNumber -and $_.SerialNumber.Trim() -eq \'{serial_ps}\' }}); if($d.Count -eq 1){{ $d[0].Number }} else {{ exit 42 }}"`) do set "InstallDisk=%%D"\r\n'
            'if not defined InstallDisk goto disk_failed\r\n'
        )
    else:
        disk_selector = (
            'set "InstallDisk="\r\n'
            'for /f "usebackq delims=" %%D in (`powershell.exe -NoProfile -Command "$d=@(Get-Disk ^| Where-Object { $_.OperationalStatus -eq \'Online\' -and $_.BusType -ne \'USB\' }); if($d.Count -eq 1){ $d[0].Number } else { exit 42 }"`) do set "InstallDisk=%%D"\r\n'
            'if not defined InstallDisk goto disk_failed\r\n'
        )

    start = f'''@echo off\r\nsetlocal\r\nwpeinit\r\nwpeutil WaitForNetwork\r\nwpeutil UpdateBootInfo\r\nset Firmware=\r\nfor /f "tokens=3" %%A in ('reg query HKLM\\System\\CurrentControlSet\\Control /v PEFirmwareType ^| find "PEFirmwareType"') do set Firmware=%%A\r\nif /I "%Firmware%"=="0x1" goto bios\r\nif /I "%Firmware%"=="0x2" goto uefi\r\ngoto firmware_failed\r\n\r\n:bios\r\nif /I "{arch}"=="arm64" goto unsupported\r\nset DiskTemplate=X:\\Windows\\System32\\diskpart-bios.txt\r\nset BootMode=BIOS\r\ngoto network\r\n\r\n:uefi\r\nset DiskTemplate=X:\\Windows\\System32\\diskpart-uefi.txt\r\nset BootMode=UEFI\r\ngoto network\r\n\r\n:network\r\nnet use Z: \\\\{server}\\PXE$ /user:{cred['username']} {cred['password']}\r\nif errorlevel 1 goto failed\r\nif not exist Z:\\images\\{image_id}\\{install_name} goto failed\r\n{disk_selector}set DiskScript=X:\\Windows\\System32\\diskpart-selected.txt\r\n> "%DiskScript%" echo select disk %InstallDisk%\r\ntype "%DiskTemplate%" >> "%DiskScript%"\r\ndiskpart /s %DiskScript%\r\nif errorlevel 1 goto failed\r\ndism /Apply-Image /ImageFile:Z:\\images\\{image_id}\\{install_name} /Index:{index} /ApplyDir:W:\\\r\nif errorlevel 1 goto failed\r\nmkdir W:\\Windows\\Panther 2>NUL\r\ncopy /y X:\\Windows\\System32\\unattend.xml W:\\Windows\\Panther\\Unattend.xml\r\nmkdir W:\\Windows\\Setup\\Scripts 2>NUL\r\ncopy /y X:\\Windows\\System32\\SetupComplete.cmd W:\\Windows\\Setup\\Scripts\\SetupComplete.cmd\r\nbcdboot W:\\Windows /s S: /f %BootMode%\r\nif errorlevel 1 goto failed\r\nnet use Z: /delete /y >NUL 2>NUL\r\nwpeutil reboot\r\n\r\n:disk_failed\r\necho Cannot select exactly one Windows installation disk. Configure install_disk_serial or install_disk_number.\r\ngoto failed\r\n\r\n:unsupported\r\necho Windows ARM64 cannot be installed in Legacy BIOS mode.\r\ngoto failed\r\n\r\n:firmware_failed\r\necho Cannot determine WinPE firmware mode. Installation stopped before disk erase.\r\ngoto failed_noreport\r\n\r\n:failed\r\ncurl.exe -fsS --retry 5 --retry-delay 2 -X POST http://{server}/pxe/report/{profile['id']}/{report_token}/failed >NUL 2>NUL\r\n:failed_noreport\r\necho Installation failed.\r\npause\r\n'''
    (target / 'startnet.cmd').write_text(start, encoding='utf-8')
    (target / 'winpeshl.ini').write_text('[LaunchApp]\r\nAppPath = %SYSTEMROOT%\\System32\\startnet.cmd\r\n', encoding='utf-8')

    base = 'http://${next-server}/pxe/files'
    private = f'http://${{next-server}}/pxe/profile/{profile["id"]}/{boot_token}'
    lines = [
        '#!ipxe',
        f'kernel {base}/boot/{wimboot_name} gui',
        f'initrd {private}/winpeshl.ini winpeshl.ini',
        f'initrd {private}/startnet.cmd startnet.cmd',
        f'initrd {private}/diskpart-uefi.txt diskpart-uefi.txt',
        f'initrd {private}/diskpart-bios.txt diskpart-bios.txt',
        f'initrd {private}/unattend.xml unattend.xml',
        f'initrd {private}/SetupComplete.cmd SetupComplete.cmd',
    ]
    if (PXE_MEDIA / f'images/{image_id}/BCD').is_file():
        lines.append(f'initrd {base}/images/{image_id}/BCD BCD')
    if (PXE_MEDIA / f'images/{image_id}/boot.sdi').is_file():
        lines.append(f'initrd {base}/images/{image_id}/boot.sdi boot.sdi')
    lines += [
        f'initrd {base}/images/{image_id}/boot.wim boot.wim',
        f'imgfetch --name srv-consume http://${{next-server}}/pxe/consume/{profile["id"]}/{boot_token}?mac=${{net0/mac}} || goto denied',
        'imgfree srv-consume',
        'boot || goto denied',
        ':denied',
        'echo SRV PXE authorization or boot failed. Installation was not started twice.',
        'sleep 5',
        'exit',
    ]
    (target / 'boot.ipxe').write_text('\n'.join(lines) + '\n', encoding='utf-8')
