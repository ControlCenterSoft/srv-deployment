#!/usr/bin/env python3
from __future__ import annotations

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import subprocess
import tempfile
import uuid
from typing import Any


REGISTRY = Path("/var/lib/srv-control/minecraft-instances.json")
RESULT_DIR = Path("/var/lib/srv-control/system-results")
ADMIN = Path("/usr/local/libexec/srv-control-minecraft-admin")


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def read_registry() -> dict[str, Any]:
    try:
        value = json.loads(REGISTRY.read_text(encoding="utf-8"))
    except Exception:
        return {"instances": []}
    if not isinstance(value, dict) or not isinstance(value.get("instances"), list):
        return {"instances": []}
    return value


def write_result(request_id: str, value: dict[str, Any]) -> None:
    RESULT_DIR.mkdir(parents=True, exist_ok=True)
    path = RESULT_DIR / f"{request_id}.json"
    handle = tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=RESULT_DIR, prefix=path.name + ".tmp.", delete=False)
    try:
        json.dump(value, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), 0o644)
        temporary = Path(handle.name)
    finally:
        handle.close()
    os.replace(temporary, path)


def run_instance(instance_id: str) -> bool:
    request_id = uuid.uuid4().hex
    request = {
        "schema_version": 3,
        "request_id": request_id,
        "action": "minecraft-update-apply",
        "actor": "minecraft-auto-update",
        "client_ip": None,
        "payload": {"id": instance_id},
    }
    result: dict[str, Any] = {
        "request_id": request_id,
        "action": request["action"],
        "actor": request["actor"],
        "started_at": now(),
        "finished_at": None,
        "result": "failed",
        "detail": None,
    }
    try:
        completed = subprocess.run(
            [str(ADMIN)],
            input=json.dumps(request, ensure_ascii=False),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=24 * 3600,
            check=False,
            env={**os.environ, "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8", "HOME": "/root"},
        )
        output = (completed.stdout or "")[-16000:]
        try:
            decoded = json.loads(output.strip().splitlines()[-1]) if output.strip() else {}
        except Exception:
            decoded = {}
        ok = completed.returncode == 0 and decoded.get("ok") is True
        result["result"] = "success" if ok else "failed"
        result["detail"] = str(decoded.get("detail") or output or "no update detail")[-12000:]
        return ok
    except Exception as exc:
        result["detail"] = str(exc)[-12000:]
        return False
    finally:
        result["finished_at"] = now()
        write_result(request_id, result)


def main() -> int:
    if not ADMIN.is_file() or not os.access(ADMIN, os.X_OK):
        raise SystemExit("Minecraft administration worker is not installed")
    registry = read_registry()
    instances = [
        item for item in registry.get("instances", [])
        if isinstance(item, dict)
        and str(item.get("update_mode") or "manual") == "automatic"
        and bool(item.get("eula_accepted"))
    ]
    failed = 0
    for item in instances:
        raw_id = str(item.get("id") or "").strip()
        if not raw_id:
            continue
        if not run_instance(raw_id):
            failed += 1
    print(json.dumps({"automatic_instances": len(instances), "failed": failed}, ensure_ascii=False))
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
