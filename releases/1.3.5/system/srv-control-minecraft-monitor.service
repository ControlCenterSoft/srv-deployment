[Unit]
Description=SRV Control Center Minecraft instance monitor
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/srv-control-minecraft-monitor
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/srv-control

[Install]
WantedBy=multi-user.target
