#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import selectors
import signal
import socket
import subprocess
import sys


RUN_DIR = Path("/run/srv-control/minecraft")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--instance-id", required=True)
    parser.add_argument("--working-directory", required=True)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    instance_id = args.instance_id
    if not instance_id or any(ch not in "abcdefghijklmnopqrstuvwxyz0123456789-_" for ch in instance_id):
        raise SystemExit("invalid instance id")
    working = Path(args.working_directory).resolve(strict=True)
    binary = working / "bedrock_server"
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise SystemExit("bedrock_server executable is missing")

    RUN_DIR.mkdir(parents=True, exist_ok=True)
    socket_path = RUN_DIR / f"{instance_id}.sock"
    socket_path.unlink(missing_ok=True)
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(str(socket_path))
    os.chmod(socket_path, 0o660)
    listener.listen(8)
    listener.setblocking(False)

    process = subprocess.Popen(
        [str(binary)],
        cwd=working,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        env={**os.environ, "LD_LIBRARY_PATH": str(working), "HOME": str(working)},
    )
    if process.stdin is None or process.stdout is None:
        raise SystemExit("failed to create Bedrock process pipes")

    selector = selectors.DefaultSelector()
    selector.register(listener, selectors.EVENT_READ, ("listener", None))
    selector.register(process.stdout, selectors.EVENT_READ, ("stdout", None))
    clients: dict[socket.socket, bytearray] = {}

    stopping = False

    def stop_handler(signum, frame):
        nonlocal stopping
        if stopping:
            return
        stopping = True
        try:
            process.stdin.write("stop\n")
            process.stdin.flush()
        except Exception:
            process.terminate()

    signal.signal(signal.SIGTERM, stop_handler)
    signal.signal(signal.SIGINT, stop_handler)

    try:
        while True:
            if process.poll() is not None:
                break
            events = selector.select(timeout=1.0)
            for key, _ in events:
                kind, _ = key.data
                if kind == "stdout":
                    line = process.stdout.readline()
                    if line:
                        sys.stdout.write(line)
                        sys.stdout.flush()
                    continue
                if kind == "listener":
                    client, _ = listener.accept()
                    client.setblocking(False)
                    clients[client] = bytearray()
                    selector.register(client, selectors.EVENT_READ, ("client", client))
                    continue
                client = key.fileobj
                try:
                    data = client.recv(4096)
                except Exception:
                    data = b""
                if not data:
                    selector.unregister(client)
                    clients.pop(client, None)
                    client.close()
                    continue
                buffer = clients[client]
                buffer.extend(data)
                if len(buffer) > 8192:
                    client.sendall(b"ERR command too long\n")
                    selector.unregister(client)
                    clients.pop(client, None)
                    client.close()
                    continue
                if b"\n" not in buffer:
                    continue
                raw, _, rest = bytes(buffer).partition(b"\n")
                clients[client] = bytearray(rest)
                try:
                    command = raw.decode("utf-8", errors="strict").strip()
                except Exception:
                    client.sendall(b"ERR invalid utf-8\n")
                    continue
                if not command or "\x00" in command or "\r" in command or "\n" in command:
                    client.sendall(b"ERR invalid command\n")
                    continue
                try:
                    process.stdin.write(command + "\n")
                    process.stdin.flush()
                    client.sendall(b"OK\n")
                except Exception:
                    client.sendall(b"ERR server stdin unavailable\n")
            if stopping and process.poll() is None:
                try:
                    process.wait(timeout=20)
                except subprocess.TimeoutExpired:
                    process.terminate()
                    try:
                        process.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        process.kill()
                break
    finally:
        for client in list(clients):
            try:
                selector.unregister(client)
            except Exception:
                pass
            client.close()
        try:
            selector.unregister(listener)
        except Exception:
            pass
        listener.close()
        socket_path.unlink(missing_ok=True)
        try:
            selector.close()
        except Exception:
            pass
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                process.kill()
    return int(process.returncode or 0)


if __name__ == "__main__":
    raise SystemExit(main())
