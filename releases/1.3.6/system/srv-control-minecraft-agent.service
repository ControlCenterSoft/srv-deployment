[Unit]
Description=SRV Control Center privileged Minecraft action agent
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/srv-control-minecraft-agent
User=root
Group=root
UMask=0027
Nice=5
PrivateTmp=true
ProtectHome=true
ProtectSystem=false

[Install]
WantedBy=multi-user.target
