[Unit]
Description=SRV Control Center Samba shares snapshot collector
After=network.target samba-ad-dc.service samba.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/srv-control-samba-shares-monitor
User=root
Group=root
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/srv-control

[Install]
WantedBy=multi-user.target
