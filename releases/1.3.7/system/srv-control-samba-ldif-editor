#!/usr/bin/env python3
from __future__ import annotations

import base64
import json
import os
from pathlib import Path
import sys


ALLOWED_ATTRIBUTES = {
    "description",
    "telephoneNumber",
    "homeDrive",
    "homeDirectory",
    "profilePath",
    "scriptPath",
}


def unfold(lines: list[str]) -> list[str]:
    result: list[str] = []
    for raw in lines:
        line = raw.rstrip("\r\n")
        if line.startswith(" ") and result:
            result[-1] += line[1:]
        else:
            result.append(line)
    return result


def attr_name(line: str) -> str | None:
    if not line or line.startswith("#"):
        return None
    for separator in (":: ", ": ", ":< "):
        if separator in line:
            return line.split(separator, 1)[0].strip()
    if line.endswith(":"):
        return line[:-1].strip()
    return None


def encode_line(name: str, value: str) -> str:
    raw = value.encode("utf-8")
    needs_base64 = (
        not value
        or value[0] in {" ", ":", "<"}
        or value[-1] == " "
        or any(byte < 0x20 or byte >= 0x7F for byte in raw)
    )
    if needs_base64:
        return f"{name}:: {base64.b64encode(raw).decode('ascii')}"
    return f"{name}: {value}"


def main() -> int:
    if len(sys.argv) != 2:
        raise SystemExit("editor expects exactly one LDIF path")
    patch_path = Path(os.environ.get("SRVCC_LDIF_PATCH", ""))
    if not patch_path.is_file():
        raise SystemExit("SRVCC_LDIF_PATCH is missing")
    patch = json.loads(patch_path.read_text(encoding="utf-8"))
    if not isinstance(patch, dict):
        raise SystemExit("LDIF patch must be an object")

    normalized: dict[str, str | None] = {}
    canonical = {item.casefold(): item for item in ALLOWED_ATTRIBUTES}
    for raw_name, raw_value in patch.items():
        name = canonical.get(str(raw_name).casefold())
        if name is None:
            raise SystemExit(f"unsupported LDIF attribute: {raw_name}")
        if raw_value is None or str(raw_value) == "":
            normalized[name] = None
            continue
        value = str(raw_value)
        if "\x00" in value or "\r" in value or "\n" in value:
            raise SystemExit(f"invalid LDIF value for {name}")
        if len(value) > 2048:
            raise SystemExit(f"LDIF value too long for {name}")
        normalized[name] = value

    target = Path(sys.argv[1])
    lines = unfold(target.read_text(encoding="utf-8", errors="strict").splitlines(True))
    existing_names = {name.casefold() for name in normalized}
    output: list[str] = []
    insert_at: int | None = None
    for line in lines:
        if line == "" and insert_at is None:
            insert_at = len(output)
        name = attr_name(line)
        if name is not None and name.casefold() in existing_names:
            continue
        output.append(line)
    if insert_at is None:
        insert_at = len(output)
    additions = [
        encode_line(name, value)
        for name, value in normalized.items()
        if value is not None
    ]
    output[insert_at:insert_at] = additions
    target.write_text("\n".join(output).rstrip() + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
