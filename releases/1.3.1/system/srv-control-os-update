#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
from datetime import datetime, timezone


STATUS = Path("/var/lib/srv-control/os-update-status.json")


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def write(payload: dict) -> None:
    tmp = STATUS.with_suffix(".json.tmp")
    tmp.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATUS)


def execute(command: list[str]) -> str:
    completed = subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
        env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"},
    )
    output = (completed.stdout or "")[-12000:]
    if completed.returncode != 0:
        raise RuntimeError(
            f"{' '.join(command)} failed ({completed.returncode})\n{output}"
        )
    return output


def main() -> int:
    payload = {
        "stage": "running",
        "result": None,
        "started_at": now(),
        "finished_at": None,
        "detail": None,
    }
    write(payload)

    try:
        execute(["apt-get", "update", "-y"])
        output = execute(
            [
                "apt-get",
                "upgrade",
                "-y",
                "--with-new-pkgs",
            ]
        )
        payload["stage"] = "complete"
        payload["result"] = "success"
        payload["detail"] = output[-4000:]
    except Exception as exc:
        payload["stage"] = "complete"
        payload["result"] = "failed"
        payload["detail"] = str(exc)[-4000:]

    payload["finished_at"] = now()
    write(payload)
    return 0 if payload["result"] == "success" else 1


if __name__ == "__main__":
    raise SystemExit(main())
