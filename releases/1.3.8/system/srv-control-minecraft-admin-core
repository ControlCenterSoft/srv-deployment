def chown_tree(path: Path, uid: int, gid: int) -> None:
    for root, dirs, files in os.walk(path):
        os.chown(root, uid, gid)
        for name in dirs:
            os.chown(Path(root) / name, uid, gid)
        for name in files:
            os.chown(Path(root) / name, uid, gid)


def create_instance(payload: dict[str, Any]) -> str:
    registry = load_registry()
    iid = instance_id(payload.get("id"))
    if any(isinstance(item, dict) and str(item.get("id")) == iid for item in registry["instances"]):
        raise RuntimeError("Minecraft instance id already exists")
    display = clean_text(payload.get("display_name") or iid, 80, True)
    port = int(payload.get("server_port") or 19132)
    port6 = int(payload.get("server_portv6") or (port + 1))
    validate_ports(registry, iid, port, port6)
    update_mode = str(payload.get("update_mode") or "manual").strip().lower()
    if update_mode not in {"manual", "automatic"}:
        raise RuntimeError("update mode must be manual or automatic")
    if update_mode == "automatic" and not bool(payload.get("eula_accepted")):
        raise RuntimeError("automatic updates require explicit Minecraft EULA/privacy acceptance")
    target = INSTANCE_ROOT / iid
    if target.exists():
        raise RuntimeError("Minecraft instance directory already exists")
    uid, gid = ensure_minecraft_account()
    INSTANCE_ROOT.mkdir(parents=True, exist_ok=True)
    source = runtime_source(registry, payload.get("source_instance"))
    if source is None:
        raise RuntimeError("no existing Bedrock runtime is available to create the instance")
    target.mkdir(mode=0o750)
    try:
        copy_runtime(source, target)
        level_name = clean_text(payload.get("level_name") or f"world-{iid}", 80, True)
        (target / "server.properties").write_text(default_properties(display, port, port6, level_name), encoding="utf-8")
        (target / "allowlist.json").write_text("[]\n", encoding="utf-8")
        (target / "permissions.json").write_text("[]\n", encoding="utf-8")
        (target / "worlds").mkdir(exist_ok=True)
        if (target / "bedrock_server").is_file():
            os.chmod(target / "bedrock_server", 0o750)
        chown_tree(target, uid, gid)
        item = {
            "id": iid,
            "display_name": display,
            "working_directory": str(target),
            "service": f"srv-minecraft@{iid}.service",
            "managed": True,
            "published": bool(payload.get("published", False)),
            "update_mode": update_mode,
            "update_channel": "stable",
            "eula_accepted": bool(payload.get("eula_accepted")),
            "server_port": port,
            "server_portv6": port6,
            "created_at": now(),
            "imported": False,
        }
        install_unit(item)
        registry["instances"].append(item)
        save_registry(registry)
        apply_firewall()
        if bool(payload.get("start")):
            run(["systemctl", "enable", "--now", str(item["service"])], timeout=90)
        refresh()
        return f"Minecraft instance created: {iid}"
    except Exception:
        try:
            unit_path({"id": iid}).unlink(missing_ok=True)
            run(["systemctl", "daemon-reload"], timeout=30, check=False)
        except Exception:
            pass
        shutil.rmtree(target, ignore_errors=True)
        raise


def update_instance(payload: dict[str, Any]) -> str:
    registry = load_registry()
    item = find_instance(registry, payload.get("id"))
    iid = str(item["id"])
    was_active = service_active(str(item.get("service") or ""))
    properties = payload.get("properties") if isinstance(payload.get("properties"), dict) else {}
    current_lines, current_values = read_properties(properties_path(item))
    port = int(properties.get("server-port") or current_values.get("server-port") or item.get("server_port") or 19132)
    port6 = int(properties.get("server-portv6") or current_values.get("server-portv6") or item.get("server_portv6") or 19133)
    validate_ports(registry, iid, port, port6)
    if "display_name" in payload:
        item["display_name"] = clean_text(payload.get("display_name"), 80, True)
        properties.setdefault("server-name", item["display_name"])
    if "update_mode" in payload:
        mode = str(payload.get("update_mode") or "").strip().lower()
        if mode not in {"manual", "automatic"}:
            raise RuntimeError("update mode must be manual or automatic")
        if mode == "automatic" and not (bool(payload.get("eula_accepted")) or bool(item.get("eula_accepted"))):
            raise RuntimeError("automatic updates require explicit Minecraft EULA/privacy acceptance")
        item["update_mode"] = mode
    if "eula_accepted" in payload and bool(payload.get("eula_accepted")):
        item["eula_accepted"] = True
    if "published" in payload:
        item["published"] = bool(payload.get("published"))
    if properties:
        save_properties(item, properties)
    item["server_port"] = port
    item["server_portv6"] = port6
    save_registry(registry)
    apply_firewall()
    if was_active and properties:
        run(["systemctl", "restart", str(item.get("service"))], timeout=90)
    refresh()
    return f"Minecraft instance updated: {iid}"


def control_instance(payload: dict[str, Any], operation: str) -> str:
    registry = load_registry()
    item = find_instance(registry, payload.get("id"))
    unit = clean_text(item.get("service"), 128, True)
    if operation == "start":
        run(["systemctl", "enable", "--now", unit], timeout=90)
    elif operation == "stop":
        run(["systemctl", "stop", unit], timeout=90)
    elif operation == "restart":
        run(["systemctl", "restart", unit], timeout=90)
    else:
        raise RuntimeError("invalid Minecraft operation")
    refresh()
    return f"Minecraft {operation}: {item['id']}"


def delete_instance(payload: dict[str, Any]) -> str:
    registry = load_registry()
    item = find_instance(registry, payload.get("id"))
    iid = str(item["id"])
    if not bool(item.get("managed")):
        raise RuntimeError("legacy/imported instance cannot be deleted; remove it manually or import it into managed runtime")
    unit = str(item.get("service") or "")
    subprocess.run(["systemctl", "disable", "--now", unit], check=False)
    unit_path(item).unlink(missing_ok=True)
    run(["systemctl", "daemon-reload"], timeout=30, check=False)
    registry["instances"] = [entry for entry in registry["instances"] if entry is not item]
    save_registry(registry)
    apply_firewall()
    if bool(payload.get("delete_data")):
        working = Path(str(item.get("working_directory") or ""))
        if working.parent != INSTANCE_ROOT or working.name != iid or working.is_symlink():
            raise RuntimeError("refusing unsafe Minecraft instance data deletion")
        shutil.rmtree(working)
    refresh()
    return f"Minecraft instance removed: {iid}; data_deleted={bool(payload.get('delete_data'))}"


def socket_command(item: dict[str, Any], command: str) -> None:
    command = clean_text(command, 4096, True)
    path = Path("/run/srv-control/minecraft") / f"{item['id']}.sock"
    if not path.is_socket():
        raise RuntimeError("Minecraft command channel is not available for this instance")
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(5)
    try:
        client.connect(str(path))
        client.sendall((command + "\n").encode("utf-8"))
        answer = client.recv(256).decode("utf-8", errors="replace").strip()
        if not answer.startswith("OK"):
            raise RuntimeError("Minecraft command was rejected: " + answer)
    finally:
        client.close()


def player_operation(action: str, payload: dict[str, Any]) -> str:
    registry = load_registry()
    item = find_instance(registry, payload.get("id"))
    working = Path(str(item.get("working_directory") or ""))
    name = clean_text(payload.get("name"), 64, True)
    xuid = clean_text(payload.get("xuid") or "", 64)
    active = service_active(str(item.get("service") or ""))
    if action in {"minecraft-player-allow", "minecraft-player-deny"}:
        path = working / "allowlist.json"
        value = read_json(path, [])
        if not isinstance(value, list):
            value = []
        value = [entry for entry in value if not (isinstance(entry, dict) and str(entry.get("name") or "").casefold() == name.casefold())]
        if action == "minecraft-player-allow":
            value.append({"ignoresPlayerLimit": bool(payload.get("ignores_player_limit")), "name": name, "xuid": xuid})
        write_json(path, value, 0o640)
        if active and (Path("/run/srv-control/minecraft") / f"{item['id']}.sock").is_socket():
            socket_command(item, "allowlist reload")
        elif active:
            run(["systemctl", "restart", str(item.get("service"))], timeout=90)
        refresh()
        return f"allowlist updated: {name}"
    if action == "minecraft-player-permission":
        permission = str(payload.get("permission") or "").strip().lower()
        if permission not in {"visitor", "member", "operator"}:
            raise RuntimeError("invalid Bedrock permission level")
        if not xuid:
            raise RuntimeError("XUID is required to set Bedrock permission")
        path = working / "permissions.json"
        value = read_json(path, [])
        if not isinstance(value, list):
            value = []
        value = [entry for entry in value if not (isinstance(entry, dict) and str(entry.get("xuid") or "") == xuid)]
        value.append({"permission": permission, "xuid": xuid})
        write_json(path, value, 0o640)
        if active and (Path("/run/srv-control/minecraft") / f"{item['id']}.sock").is_socket():
            socket_command(item, "permission reload")
        elif active:
            run(["systemctl", "restart", str(item.get("service"))], timeout=90)
        refresh()
        return f"player permission updated: {name}={permission}"
    if action == "minecraft-player-kick":
        reason = clean_text(payload.get("reason") or "Отключено администратором", 256, True)
        safe_name = name.replace('"', "")
        safe_reason = reason.replace('"', "")
        socket_command(item, f'kick "{safe_name}" "{safe_reason}"')
        return f"kick command sent: {name}"
    raise RuntimeError("unsupported Minecraft player operation")


def latest_official_package() -> tuple[str, str]:
    request = urllib.request.Request(OFFICIAL_PAGE, headers={"User-Agent": "SRV-Control-Center/1.3"})
    with urllib.request.urlopen(request, timeout=30) as response:
        raw = response.read(8 * 1024 * 1024).decode("utf-8", errors="replace")
    normalized = html.unescape(raw).replace("\\u002F", "/").replace("\\/", "/")
    matches = DOWNLOAD_RE.findall(normalized)
    urls = DOWNLOAD_RE.finditer(normalized)
    found = [(match.group(1), match.group(0)) for match in urls]
    if not found:
        raise RuntimeError("official Minecraft page did not expose a Linux Bedrock package URL")
    found.sort(key=lambda item: tuple(int(part) for part in item[0].split(".")))
    return found[-1]


def version_tuple(value: str | None) -> tuple[int, ...]:
    if not value:
        return ()
    try:
        return tuple(int(part) for part in value.split("."))
    except Exception:
        return ()


def current_version(item: dict[str, Any]) -> str | None:
    status = read_json(STATUS, {})
    if isinstance(status, dict):
        for row in status.get("instances") or []:
            if isinstance(row, dict) and str(row.get("id")) == str(item.get("id")):
                value = str(row.get("version") or "").strip()
                return value or None
    return str(item.get("version") or "").strip() or None


def backup_instance(item: dict[str, Any], reason: str) -> Path:
    iid = str(item["id"])
    working = Path(str(item.get("working_directory") or ""))
    target_dir = BACKUP_ROOT / iid
    target_dir.mkdir(parents=True, exist_ok=True)
    backup = target_dir / (datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + f"-{reason}.tar.gz")
    names = [name for name in ("worlds", "server.properties", "allowlist.json", "permissions.json") if (working / name).exists()]
    if names:
        run(["tar", "--xattrs", "--acls", "-czf", str(backup), "-C", str(working), *names], timeout=3600)
    else:
        with tarfile.open(backup, "w:gz"):
            pass
    os.chmod(backup, 0o600)
    return backup


def copy_runtime_backup(working: Path, destination: Path) -> None:
    destination.mkdir(parents=True, exist_ok=False)
    for child in working.iterdir():
        if child.name in RUNTIME_EXCLUDES:
            continue
        target = destination / child.name
        if child.is_symlink():
            raise RuntimeError("runtime contains unsupported symbolic links")
        if child.is_dir():
            shutil.copytree(child, target)
        elif child.is_file():
            shutil.copy2(child, target)


def replace_runtime(working: Path, extracted: Path) -> None:
    for child in extracted.iterdir():
        if child.name in RUNTIME_EXCLUDES:
            continue
        target = working / child.name
        if target.exists():
            if target.is_dir() and not target.is_symlink():
                shutil.rmtree(target)
            else:
                target.unlink()
        if child.is_dir():
            shutil.copytree(child, target)
        else:
            shutil.copy2(child, target)
    if (working / "bedrock_server").is_file():
        os.chmod(working / "bedrock_server", 0o750)


def restore_runtime(working: Path, backup: Path) -> None:
    for child in list(working.iterdir()):
        if child.name in RUNTIME_EXCLUDES:
            continue
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()
    for child in backup.iterdir():
        target = working / child.name
        if child.is_dir():
            shutil.copytree(child, target)
        else:
            shutil.copy2(child, target)


def apply_update(payload: dict[str, Any]) -> str:
    registry = load_registry()
    item = find_instance(registry, payload.get("id"))
    if not bool(item.get("eula_accepted")) and not bool(payload.get("eula_accepted")):
        raise RuntimeError("Minecraft EULA/privacy acceptance is required before downloading an update")
    if bool(payload.get("eula_accepted")):
        item["eula_accepted"] = True
        save_registry(registry)
    latest, url = latest_official_package()
    installed = current_version(item)
    if version_tuple(installed) and version_tuple(latest) <= version_tuple(installed):
        return f"Minecraft instance {item['id']} is current: {installed}"
    working = Path(str(item.get("working_directory") or ""))
    if not working.is_dir():
        raise RuntimeError("Minecraft working directory is missing")
    unit = str(item.get("service") or "")
    was_active = service_active(unit)
    backup_instance(item, "pre-update")
    runtime_backup = working / ".runtime-backups" / (installed or "unknown") / datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    copy_runtime_backup(working, runtime_backup)
    with tempfile.TemporaryDirectory(prefix="minecraft-update.", dir=STATE_DIR) as temp_name:
        temp = Path(temp_name)
        archive = temp / "bedrock.zip"
        request = urllib.request.Request(url, headers={"User-Agent": "SRV-Control-Center/1.3"})
        with urllib.request.urlopen(request, timeout=60) as response, archive.open("wb") as output:
            shutil.copyfileobj(response, output, length=4 * 1024 * 1024)
        if archive.stat().st_size < 10 * 1024 * 1024:
            raise RuntimeError("downloaded Bedrock package is unexpectedly small")
        extracted = temp / "extracted"
        extracted.mkdir()
        with zipfile.ZipFile(archive) as package:
            for member in package.infolist():
                pure = Path(member.filename)
                if pure.is_absolute() or ".." in pure.parts:
                    raise RuntimeError("unsafe path in Bedrock package")
            package.extractall(extracted)
        if not (extracted / "bedrock_server").is_file():
            raise RuntimeError("Bedrock package does not contain bedrock_server")
        if was_active:
            run(["systemctl", "stop", unit], timeout=90)
        try:
            replace_runtime(working, extracted)
            uid, gid = ensure_minecraft_account()
            if bool(item.get("managed")):
                chown_tree(working, uid, gid)
            if was_active:
                run(["systemctl", "start", unit], timeout=90)
                if not service_active(unit):
                    raise RuntimeError("updated Minecraft service did not become active")
            item["version"] = latest
            item["last_updated_at"] = now()
            save_registry(registry)
        except Exception:
            if was_active:
                subprocess.run(["systemctl", "stop", unit], check=False)
            restore_runtime(working, runtime_backup)
            if was_active:
                subprocess.run(["systemctl", "start", unit], check=False)
            raise
    refresh()
    return f"Minecraft updated: {item['id']} {installed or 'unknown'} -> {latest}"


def check_update(payload: dict[str, Any]) -> str:
    registry = load_registry()
    item = find_instance(registry, payload.get("id"))
    latest, _ = latest_official_package()
    installed = current_version(item)
    available = not version_tuple(installed) or version_tuple(latest) > version_tuple(installed)
    return json.dumps({"id": item["id"], "installed": installed, "latest": latest, "update_available": available}, ensure_ascii=False)


def handle(request: dict[str, Any]) -> str:
    action = str(request.get("action") or "")
    payload = request.get("payload") if isinstance(request.get("payload"), dict) else {}
    if action == "minecraft-instance-create":
        return create_instance(payload)
    if action == "minecraft-instance-update":
        return update_instance(payload)
    if action == "minecraft-instance-delete":
        return delete_instance(payload)
    if action == "minecraft-instance-start":
        return control_instance(payload, "start")
    if action == "minecraft-instance-stop":
        return control_instance(payload, "stop")
    if action == "minecraft-instance-restart":
        return control_instance(payload, "restart")
    if action in {"minecraft-player-allow", "minecraft-player-deny", "minecraft-player-permission", "minecraft-player-kick"}:
        return player_operation(action, payload)
    if action == "minecraft-update-check":
        return check_update(payload)
    if action == "minecraft-update-apply":
        return apply_update(payload)
    raise RuntimeError("unsupported Minecraft administration action")


def main() -> int:
    try:
        request = json.loads(sys.stdin.read())
    except Exception as exc:
        raise SystemExit(f"invalid request JSON: {exc}")
    if not isinstance(request, dict):
        raise SystemExit("request must be a JSON object")
    try:
        detail = handle(request)
        print(json.dumps({"ok": True, "detail": detail}, ensure_ascii=False))
        return 0
    except Exception as exc:
        print(json.dumps({"ok": False, "detail": str(exc)[-12000:]}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
