}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def run(command: list[str], *, timeout: int = 300, check: bool = True) -> str:
    completed = subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
        env={**os.environ, "LC_ALL": "C.UTF-8", "LANG": "C.UTF-8", "HOME": "/root"},
    )
    output = (completed.stdout or "")[-12000:]
    if check and completed.returncode != 0:
        raise RuntimeError(f"command failed ({completed.returncode}): {' '.join(command)}\n{output}")
    return output.strip()


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def write_json(path: Path, value: Any, mode: int = 0o640) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        json.dump(value, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fchmod(handle.fileno(), mode)
        tmp = Path(handle.name)
    finally:
        handle.close()
    try:
        gid = grp.getgrnam("srv-control").gr_gid
        os.chown(tmp, 0, gid)
    except Exception:
        pass
    os.replace(tmp, path)


def ensure_minecraft_account() -> tuple[int, int]:
    try:
        account = pwd.getpwnam(MINECRAFT_USER)
        return account.pw_uid, account.pw_gid
    except KeyError:
        run(["useradd", "--system", "--home-dir", str(INSTANCE_ROOT), "--shell", "/usr/sbin/nologin", MINECRAFT_USER], timeout=30)
        account = pwd.getpwnam(MINECRAFT_USER)
        return account.pw_uid, account.pw_gid


def clean_text(value: object, maximum: int = 256, required: bool = False) -> str:
    raw = str(value if value is not None else "").strip()
    if any(ch in raw for ch in "\r\n\x00"):
        raise RuntimeError("value contains forbidden control characters")
    if len(raw) > maximum:
        raise RuntimeError("value is too long")
    if required and not raw:
        raise RuntimeError("value is required")
    return raw


def instance_id(value: object) -> str:
    raw = clean_text(value, 32, True).lower()
    if not INSTANCE_RE.fullmatch(raw):
        raise RuntimeError("instance id must contain lowercase ASCII letters, digits, '_' or '-'")
    return raw


def load_registry() -> dict[str, Any]:
    value = read_json(REGISTRY, {"schema_version": 1, "instances": []})
    if not isinstance(value, dict) or not isinstance(value.get("instances"), list):
        raise RuntimeError("Minecraft instance registry is invalid")
    value["schema_version"] = 1
    return value


def save_registry(registry: dict[str, Any]) -> None:
    write_json(REGISTRY, registry, 0o640)


def find_instance(registry: dict[str, Any], value: object) -> dict[str, Any]:
    target = instance_id(value)
    for item in registry.get("instances", []):
        if isinstance(item, dict) and str(item.get("id") or "") == target:
            return item
    raise RuntimeError("Minecraft instance not found")


def service_active(unit: str | None) -> bool:
    return bool(unit) and subprocess.run(["systemctl", "is-active", "--quiet", str(unit)], check=False).returncode == 0


def properties_path(instance: dict[str, Any]) -> Path:
    working = Path(str(instance.get("working_directory") or ""))
    if not working.is_absolute() or not working.is_dir():
        raise RuntimeError("Minecraft working directory is missing")
    return working / "server.properties"


def read_properties(path: Path) -> tuple[list[str], dict[str, str]]:
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines() if path.is_file() else []
    values: dict[str, str] = {}
    for line in lines:
        raw = line.strip()
        if not raw or raw.startswith("#") or "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        values[key.strip()] = value.strip()
    return lines, values


def property_value(key: str, value: object) -> str:
    raw = clean_text(value, 256)
    if key in {"allow-cheats", "online-mode", "allow-list"}:
        normalized = raw.casefold()
        if normalized in {"1", "yes", "on"}:
            normalized = "true"
        if normalized in {"0", "no", "off"}:
            normalized = "false"
        if normalized not in {"true", "false"}:
            raise RuntimeError(f"{key} must be true or false")
        return normalized
    if key == "gamemode" and raw not in {"survival", "creative", "adventure"}:
        raise RuntimeError("invalid gamemode")
    if key == "difficulty" and raw not in {"peaceful", "easy", "normal", "hard"}:
        raise RuntimeError("invalid difficulty")
    ranges = {
        "max-players": (1, 1000),
        "server-port": (1, 65535),
        "server-portv6": (1, 65535),
        "view-distance": (5, 64),
        "tick-distance": (4, 12),
        "player-idle-timeout": (0, 100000),
    }
    if key in ranges:
        number = int(raw)
        low, high = ranges[key]
        if number < low or number > high:
            raise RuntimeError(f"{key} must be between {low} and {high}")
        return str(number)
    if key in {"server-name", "level-name"} and (not raw or len(raw) > 80):
        raise RuntimeError(f"invalid {key}")
    return raw


def used_ports(registry: dict[str, Any], excluding: str | None = None) -> set[int]:
    ports: set[int] = set()
    for item in registry.get("instances", []):
        if not isinstance(item, dict) or str(item.get("id")) == excluding:
            continue
        for key in ("server_port", "server_portv6"):
            try:
                ports.add(int(item.get(key)))
            except Exception:
                pass
        try:
            path = properties_path(item)
            _, values = read_properties(path)
            for key in ("server-port", "server-portv6"):
                if key in values:
                    ports.add(int(values[key]))
        except Exception:
            pass
    return ports


def validate_ports(registry: dict[str, Any], current_id: str, port: int, port6: int) -> None:
    if port < 1 or port > 65535 or port6 < 1 or port6 > 65535:
        raise RuntimeError("Minecraft ports must be between 1 and 65535")
    if port == port6:
        raise RuntimeError("IPv4 and IPv6 Bedrock ports must be different")
    used = used_ports(registry, current_id)
    collisions = sorted({port, port6} & used)
    if collisions:
        raise RuntimeError("Minecraft port collision: " + ", ".join(map(str, collisions)))


def save_properties(instance: dict[str, Any], updates: dict[str, Any]) -> None:
    path = properties_path(instance)
    lines, values = read_properties(path)
    clean = {key: property_value(key, value) for key, value in updates.items() if key in EDITABLE_KEYS}
    if not clean:
        return
    found: set[str] = set()
    output: list[str] = []
    for line in lines:
        raw = line.strip()
        if raw and not raw.startswith("#") and "=" in line:
            key = line.split("=", 1)[0].strip()
            if key in clean:
                output.append(f"{key}={clean[key]}")
                found.add(key)
                continue
        output.append(line)
    for key, value in clean.items():
        if key not in found:
            output.append(f"{key}={value}")
    stat_info = path.stat() if path.exists() else None
    handle = tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=path.name + ".tmp.", delete=False
    )
    try:
        handle.write("\n".join(output).rstrip() + "\n")
        handle.flush()
        os.fchmod(handle.fileno(), (stat_info.st_mode & 0o777) if stat_info else 0o640)
        tmp = Path(handle.name)
    finally:
        handle.close()
    if stat_info:
        os.chown(tmp, stat_info.st_uid, stat_info.st_gid)
    os.replace(tmp, path)


def refresh() -> None:
    if MONITOR.is_file() and os.access(MONITOR, os.X_OK):
        run([str(MONITOR)], timeout=90, check=False)


def apply_firewall() -> None:
    if FIREWALL.is_file() and os.access(FIREWALL, os.X_OK):
        run([str(FIREWALL)], timeout=30)


def unit_path(instance: dict[str, Any]) -> Path:
    return SYSTEMD_DIR / f"srv-minecraft@{instance_id(instance.get('id'))}.service"


def install_unit(instance: dict[str, Any]) -> str:
    iid = instance_id(instance.get("id"))
    working = Path(str(instance.get("working_directory") or ""))
    if working != INSTANCE_ROOT / iid:
        raise RuntimeError("managed Minecraft instance path is invalid")
    unit = f"srv-minecraft@{iid}.service"
    text = f"""[Unit]\nDescription=SRV Minecraft Bedrock instance {iid}\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nUser={MINECRAFT_USER}\nGroup={MINECRAFT_GROUP}\nWorkingDirectory={working}\nExecStart={RUNNER} --instance-id {iid} --working-directory {working}\nRestart=on-failure\nRestartSec=5s\nTimeoutStopSec=45s\nLimitNOFILE=65536\nNoNewPrivileges=true\nPrivateTmp=true\nProtectHome=true\nProtectSystem=strict\nReadWritePaths={working} /run/srv-control/minecraft\n\n[Install]\nWantedBy=multi-user.target\n"""
    path = unit_path(instance)
    path.write_text(text, encoding="utf-8")
    os.chmod(path, 0o644)
    run(["systemctl", "daemon-reload"], timeout=30)
    instance["service"] = unit
    return unit


def runtime_source(registry: dict[str, Any], requested: object | None = None) -> Path | None:
    candidates: list[dict[str, Any]] = []
    if requested:
        candidates.append(find_instance(registry, requested))
    candidates.extend(item for item in registry.get("instances", []) if isinstance(item, dict))
    seen: set[str] = set()
    for item in candidates:
        raw = str(item.get("working_directory") or "")
        if raw in seen:
            continue
        seen.add(raw)
        path = Path(raw)
        if path.is_dir() and (path / "bedrock_server").is_file():
            return path
    return None


def copy_runtime(source: Path, target: Path) -> None:
    for child in source.iterdir():
        if child.name in RUNTIME_EXCLUDES:
            continue
        destination = target / child.name
        if child.is_symlink():
            raise RuntimeError("runtime source contains unsupported symbolic links")
        if child.is_dir():
            shutil.copytree(child, destination, symlinks=False)
        elif child.is_file():
            shutil.copy2(child, destination)


