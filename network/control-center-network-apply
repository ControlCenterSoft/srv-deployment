#!/usr/bin/env bash
set -Eeuo pipefail
STATE=/var/lib/control-center
SYSTEM_STATE=/var/lib/control-center-system
ROOT_STATE=/var/lib/control-center-root
PENDING="$STATE/network-pending.json"
CURRENT="$SYSTEM_STATE/network-config.json"
STATUS="$SYSTEM_STATE/network-status.json"
NETPLAN=/etc/netplan/90-control-center.yaml
BACKUP="$ROOT_STATE/90-control-center.yaml.rollback"
[[ -s "$PENDING" ]] || exit 0
install -d -o root -g control-center -m 0750 "$SYSTEM_STATE"
install -d -o root -g root -m 0700 "$ROOT_STATE"
status(){ python3 - "$STATUS" "$1" "$2" <<'PY'
import json,sys,time
open(sys.argv[1],'w').write(json.dumps({'state':sys.argv[2],'message':sys.argv[3],'timestamp':int(time.time())},ensure_ascii=False,indent=2)+'\n')
PY
chown root:control-center "$STATUS"; chmod 0640 "$STATUS"; }
status applying 'Проверка и применение сетевой конфигурации…'
[[ -f "$NETPLAN" ]] && cp -a "$NETPLAN" "$BACKUP" || rm -f "$BACKUP"
TMP=$(mktemp /etc/netplan/90-control-center.yaml.XXXXXX)
cleanup(){ rm -f "$TMP"; }
trap cleanup EXIT
if ! python3 - "$PENDING" "$TMP" <<'PY'
import json,sys,ipaddress,pathlib,re
src,out=sys.argv[1:]
cfg=json.load(open(src))
if not isinstance(cfg,dict): raise SystemExit('invalid configuration')
known={p.name for p in pathlib.Path('/sys/class/net').iterdir() if p.name!='lo'}
roles={}; used=set(); nets=[]
for role in ('wan','lan'):
    c=cfg.get(role)
    if not isinstance(c,dict): raise SystemExit(f'{role}: missing configuration')
    name=str(c.get('interface',''))
    if name not in known or not re.fullmatch(r'[A-Za-z0-9_.:-]{1,15}',name): raise SystemExit(f'{role}: invalid interface')
    if name in used: raise SystemExit('WAN and LAN must use different interfaces')
    used.add(name)
    method=str(c.get('method','')).lower()
    if method not in ('dhcp','static'): raise SystemExit(f'{role}: invalid method')
    clean={'interface':name,'method':method}
    if method=='static':
        try:
            prefix=int(c.get('mask'))
            if not 0<=prefix<=32: raise ValueError
            addr=ipaddress.IPv4Interface(f"{c.get('ip','')}/{prefix}")
        except Exception: raise SystemExit(f'{role}: invalid address/mask')
        if addr.ip.is_unspecified or addr.ip.is_multicast or addr.ip.is_loopback: raise SystemExit(f'{role}: forbidden address')
        gateway=str(c.get('gateway','')).strip()
        if role=='wan' and not gateway: raise SystemExit('wan: gateway required')
        if gateway:
            try: gw=ipaddress.IPv4Address(gateway)
            except Exception: raise SystemExit(f'{role}: invalid gateway')
            if gw not in addr.network or gw==addr.ip: raise SystemExit(f'{role}: gateway outside subnet')
        dns=c.get('dns')
        if not isinstance(dns,list) or not dns: raise SystemExit(f'{role}: DNS required')
        clean_dns=[]
        for item in dns:
            try: clean_dns.append(str(ipaddress.IPv4Address(str(item))))
            except Exception: raise SystemExit(f'{role}: invalid DNS')
        clean.update({'ip':str(addr.ip),'mask':prefix,'gateway':gateway,'dns':clean_dns})
        nets.append(addr.network)
    roles[role]=clean
if len(nets)==2 and nets[0].overlaps(nets[1]): raise SystemExit('WAN/LAN subnets overlap')
lines=['network:','  version: 2','  renderer: networkd','  ethernets:']
for role in ('wan','lan'):
    c=roles[role]; name=c['interface']
    lines += [f'    {name}:','      dhcp6: false','      optional: true']
    if c['method']=='dhcp':
        lines += ['      dhcp4: true']
        if role=='lan': lines += ['      dhcp4-overrides:','        use-routes: false']
    else:
        lines += ['      dhcp4: false',f"      addresses: [{c['ip']}/{c['mask']}]"]
        if c.get('gateway'):
            lines += ['      routes:','        - to: default',f"          via: {c['gateway']}"]
            if role=='lan': lines += ['          metric: 500']
        lines += ['      nameservers:','        addresses: ['+', '.join(c['dns'])+']']
pathlib.Path(out).write_text('\n'.join(lines)+'\n')
PY
then
  rm -f "$PENDING"
  status rejected 'Сетевая конфигурация отклонена привилегированной проверкой.'
  exit 1
fi
chown root:control-center "$TMP"
chmod 0640 "$TMP"
mv "$TMP" "$NETPLAN"
if netplan generate && netplan apply; then
  cp "$PENDING" "$CURRENT"
  rm -f "$PENDING"
  chown root:control-center "$CURRENT"; chmod 0640 "$CURRENT"
  status applied 'Сетевая конфигурация применена'
  exit 0
fi
if [[ -f "$BACKUP" ]]; then cp -a "$BACKUP" "$NETPLAN"; else rm -f "$NETPLAN"; fi
netplan generate || true
netplan apply || true
rm -f "$PENDING"
status rollback 'Ошибка применения. Предыдущая конфигурация восстановлена.'
exit 1
