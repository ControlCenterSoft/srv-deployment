[[ "$actual_entries" == "$expected_entries" ]]
: > "$AUTH_WORK/diag-expanded"
while IFS= read -r entry; do tar -xOzf "$DIAG_BUNDLE" "$entry" >> "$AUTH_WORK/diag-expanded"; done < <(tar -tzf "$DIAG_BUNDLE")
for forbidden in 'pbkdf2-sha256' 'bootstrap-admin.secret' 'cc_session'; do ! grep -q "$forbidden" "$AUTH_WORK/diag-expanded"; done
