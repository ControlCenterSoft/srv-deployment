grep -Fq 'rbac.user.create' "$AUTH_WORK/operations.json"
grep -Fq 'auth.login' "$AUTH_WORK/audit.json"
grep -Fq '"audit_readable":true' "$AUTH_WORK/diagnostics-summary.json"
