    echo "secrets_sha256_after=$(safe_hash /var/lib/control-center/secrets.json)"
    echo "panel_url=$PANEL_URL"
    echo
    echo "--- BACKEND VERSION ---"
    curl -fsS "$BACKEND_URL/api/v1/version" 2>/dev/null || true
    echo
    echo "--- BACKEND READINESS ---"
    curl -fsS "$BACKEND_URL/api/v1/readiness" 2>/dev/null || true
    echo
    echo "--- PROXY HEALTH ---"
    curl -fsS -H "Host: $PUBLIC_IP:8876" "http://127.0.0.1:8876/api/v1/health" 2>/dev/null || true
    echo
    echo "--- SYSTEMD STATUS ---"
    systemctl status control-center.service --no-pager -l 2>&1 | tail -n 100 || true
    echo
