C_IP="$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  [[ -n "$PUBLIC_IP" ]] || PUBLIC_IP="$(hostname -I | awk '{print $1}')"
  PANEL_URL="http://$PUBLIC_IP:8876"
  ensure_dependencies
  setup_arch
  load_backend_url
  wait_ready "$BACKEND_URL" || die "current backend is not ready"
  [[ "$(current_version)" == "$BETA_VERSION" ]] || die "host is not on accepted beta.1"
  [[ "$(current_commit)" == "$BETA_COMMIT" ]] || die "host beta.1 commit is not the accepted source identity"
  systemctl is-active --quiet nginx.service || die "test HTTP ingress nginx is not active"

  STATE_HASH_BEFORE="$(safe_hash /var/lib/control-center/state.json)"
  SECRETS_HASH_BEFORE="$(safe_hash /var/lib/control-center/secrets.json)"
  OLD_BOOT_ID="$(cat /proc/sys/kernel/random/boot_id)"

  ensure_pinned_go
  build_exact_candidate
  package_exact_candidate

  STEP="upgrade-beta1-to-rc1"
  log "Upgrade accepted beta.1 to exact rc.1"
  install_test_trust
  PRODUCT_CHANGED=1
  CONTROL_CENTER_UPDATE_HEALTH_URL="$BACKEND_URL" /usr/local/sbin/control-center-update --package "$RC_PACKAGE"
  wait_ready "$BACKEND_URL" || die "rc.1 did not become ready"
  [[ "$(current_version)" == "$RC_VERSION" && "$(current_commit)" == "$RC_COMMIT" ]] || die "installed rc.1 identity mismatch"
  printf '%s  %s\n' "$EXPECTED_RC_SHA" /usr/local/lib/control-center/current/control-center | sha256sum -c -
  BETA_UPGRADE="passed"

  STEP="pre-reboot-auth-security"
  log "Pre-reboot browser/security regression"
  api_security_regression pre-reboot
  PRE_REBOOT_AUTH="passed"
  [[ "$(safe_hash /var/lib/control-center/state.json)" == "$STATE_HASH_BEFORE" ]] || die "state changed during rc upgrade/security read-only acceptance"
  [[ "$(safe_hash /var/lib/control-center/secrets.json)" == "$SECRETS_HASH_BEFORE" ]] || die "secrets changed during rc upgrade/security read-only acceptance"

  STEP="schedule-reboot-resume"
  write_state_file
  install_resume_unit
  sync
  log "Intentional reboot for rc.1 boot acceptance; resume unit is armed"
  systemctl reboot
  sleep 20
  exit 0
}

phase_resume() {
  load_state_file
  ensure_dependencies
  ensure_pinned_go
  load_backend_url
  PANEL_URL="http://$PUBLIC_IP:8876"

  STEP="post-reboot-readiness"
  log "Post-reboot service/readiness acceptance"
  local new_boot_id="$(cat /proc/sys/kernel/random/boot_id)"
  [[ "$new_boot_id" != "$OLD_BOOT_ID" ]] || die "boot ID did not change"
  systemctl is-enabled --quiet control-center.service || die "control-center service is not enabled"
  systemctl is-active --quiet control-center.service || die "control-center service is not active after reboot"
  wait_ready "$BACKEND_URL" || die "control-center not ready after reboot"
  [[ "$(current_version)" == "$RC_VERSION" && "$(current_commit)" == "$RC_COMMIT" ]] || die "rc.1 identity changed across reboot"
  printf '%s  %s\n' "$EXPECTED_RC_SHA" /usr/local/lib/control-center/current/control-center | sha256sum -c -
  REBOOT_ACCEPTANCE="passed"

  STEP="post-reboot-auth-security"
  api_security_regression post-reboot
  POST_REBOOT_AUTH="passed"

  STEP="rc-forward-update-broken-rollback"
  log "Signed rc.2 forward update and broken rc.3 rollback regression"
  CONTROL_CENTER_UPDATE_PRIVATE_KEY="$PRIVATE_KEY" CONTROL_CENTER_ACCEPTANCE_URL="$BACKEND_URL" \
    "$SOURCE_DIR/scripts/rc1-update-acceptance.sh"
  RC_UPDATE_ROLLBACK="passed"

  STEP="restore-exact-rc1"
  log "Restore exact rc.1 after synthetic update tests"
  CONTROL_CENTER_UPDATE_HEALTH_URL="$BACKEND_URL" /usr/local/sbin/control-center-update --package "$RC_PACKAGE" --allow-downgrade
  wait_ready "$BACKEND_URL" || die "exact rc.1 restore not ready"
  [[ "$(current_version)" == "$RC_VERSION" && "$(current_commit)" == "$RC_COMMIT" ]] || die "exact rc.1 restore identity mismatch"
  printf '%s  %s\n' "$EXPECTED_RC_SHA" /usr/local/lib/control-center/current/control-center | sha256sum -c -

  STEP="repair-reinstall"
  log "Repair and reinstall exact rc.1"
  CONTROL_CENTER_BINARY="$SOURCE_DIR/dist/control-center-linux-$GOARCH" CONTROL_CENTER_UPDATE_PUBLIC_KEY="$PUBLIC_KEY" CONTROL_CENTER_ACCEPTANCE_URL="$BACKEND_URL" \
    "$SOURCE_DIR/install/install.sh" --repair
  CONTROL_CENTER_BINARY="$SOURCE_DIR/dist/control-center-linux-$GOARCH" CONTROL_CENTER_UPDATE_PUBLIC_KEY="$PUBLIC_KEY" CONTROL_CENTER_ACCEPTANCE_URL="$BACKEND_URL" \
    "$SOURCE_DIR/install/install.sh" --reinstall
  wait_ready "$BACKEND_URL" || die "rc.1 not ready after repair/reinstall"
  REPAIR_REINSTALL="passed"

  STEP="preserve-state-uninstall-reinstall"
  log "Non-purge uninstall/reinstall with state and trust preservation"
  "$SOURCE_DIR/install/uninstall.sh"
  [[ -f /etc/control-center/control-center.env ]] || die "configuration was not preserved"
  [[ -f /etc/control-center/update-public-key.pem ]] || die "update trust was not preserved"
  [[ -d /var/lib/control-center ]] || die "state directory was not preserved"
  CONTROL_CENTER_BINARY="$SOURCE_DIR/dist/control-center-linux-$GOARCH" CONTROL_CENTER_UPDATE_PUBLIC_KEY="$PUBLIC_KEY" CONTROL_CENTER_ACCEPTANCE_URL="$BACKEND_URL" \
    "$SOURCE_DIR/install/install.sh"
  wait_ready "$BACKEND_URL" || die "rc.1 not ready after preserve-state reinstall"
  [[ "$(current_version)" == "$RC_VERSION" && "$(current_commit)" == "$RC_COMMIT" ]] || die "identity mismatch after preserve-state reinstall"
  [[ "$(safe_hash /var/lib/control-center/state.json)" == "$STATE_HASH_BEFORE" ]] || die "state hash changed across lifecycle"
  [[ "$(safe_hash /var/lib/control-center/secrets.json)" == "$SECRETS_HASH_BEFORE" ]] || die "secrets hash changed across lifecycle"
  PRESERVE_STATE_REINSTALL="passed"
  STATE_PRESERVED="passed"

  STEP="final-auth-diagnostics"
  log "Final browser path and diagnostics"
  api_security_regression final
  DIAGNOSTICS="passed"

  STEP="restore-original-trust"
  restore_original_trust
  [[ "$(safe_hash /var/lib/control-center/state.json)" == "$STATE_HASH_BEFORE" ]] || die "final state hash mismatch"
  [[ "$(safe_hash /var/lib/control-center/secrets.json)" == "$SECRETS_HASH_BEFORE" ]] || die "final secrets hash mismatch"
  rm -f "$PRIVATE_KEY" "$PUBLIC_KEY"

  STEP="completed"
  FINAL_STATUS="PASSED"
  write_report
  push_report || die "unable to push final diagnostics evidence"
  remove_resume_unit
  printf 'PASSED\n' > "$BASE/FINAL_STATUS"
  chmod 0600 "$BASE/FINAL_STATUS"
  logger -t control-center-rc1-acceptance "RC1 real-host acceptance PASSED commit=$RC_COMMIT report=${REPORT_BRANCH:-unknown}"
  echo
  echo "=== RC1 REAL-HOST ACCEPTANCE PASSED ==="
  echo "REPORT_SENT=$REPORT_SENT"
  echo "REPORT_BRANCH=${REPORT_BRANCH:-}"
  echo "FINAL_STATUS=PASSED"
  echo "LOCAL_REPORT=$REPORT_FILE"
  echo "PANEL_URL=$PANEL_URL"
}

if [[ ${1:-} == "--resume" ]]; then
  phase_resume
else
  if [[ -f "$STATE_FILE" ]]; then
    old_phase="$(sed -n 's/^PHASE=//p' "$STATE_FILE" | head -1)"
    [[ "$old_phase" != post-reboot ]] || die "an rc.1 acceptance run is already awaiting/resuming after reboot"
  fi
  rm -rf "$BASE"
  mkdir -p "$BASE" "$REPORT_DIR"
  chmod 0700 "$BASE" "$REPORT_DIR"
  touch "$LOG_FILE"; chmod 0600 "$LOG_FILE"
  phase_initial
fi
