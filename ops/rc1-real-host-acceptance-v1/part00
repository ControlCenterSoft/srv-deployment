log() { printf '=== %s ===\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; return 1; }

safe_hash() {
  local path="$1"
  if [[ -f "$path" ]]; then sha256sum "$path" | awk '{print $1}'; else printf 'missing'; fi
}

current_version() {
  /usr/local/lib/control-center/current/control-center build-info --field version 2>/dev/null || true
}
current_commit() {
  /usr/local/lib/control-center/current/control-center build-info --field commit 2>/dev/null || true
}

wait_ready() {
  local url="$1"
  for _ in {1..80}; do
    if curl -fsS --max-time 2 "$url/api/v1/readiness" 2>/dev/null | grep -Fq '"ready":true'; then return 0; fi
    sleep 0.25
  done
  return 1
}

load_backend_url() {
  local listen host port
  listen="$(sed -n 's/^CONTROL_CENTER_LISTEN=//p' /etc/control-center/control-center.env | tail -1)"
  [[ -n "$listen" ]] || die "CONTROL_CENTER_LISTEN missing"
  host="${listen%:*}"; port="${listen##*:}"
  case "$host" in 0.0.0.0|'') host=127.0.0.1 ;; esac
  BACKEND_URL="http://$host:$port"
}

ensure_dependencies() {
  local cmd
  for cmd in curl git tar sha256sum openssl python3 systemctl install sed awk grep find stat ss; do
    command -v "$cmd" >/dev/null || die "$cmd is required"
  done
  [[ -d /run/systemd/system ]] || die "systemd is not running"
}

setup_arch() {
  case "$(uname -m)" in
    x86_64) GOARCH=amd64; EXPECTED_RC_SHA="$RC_AMD64_SHA256"; GO_ARCHIVE_SHA="$GO_AMD64_SHA256" ;;
    aarch64|arm64) GOARCH=arm64; EXPECTED_RC_SHA="$RC_ARM64_SHA256"; GO_ARCHIVE_SHA="$GO_ARM64_SHA256" ;;
    *) die "unsupported host architecture: $(uname -m)" ;;
  esac
}

ensure_pinned_go() {
  setup_arch
  local archive="$BASE/go${GO_VERSION}.linux-${GOARCH}.tar.gz"
  if [[ ! -x "$TOOLCHAIN_ROOT/go/bin/go" ]]; then
    rm -rf "$TOOLCHAIN_ROOT"
    mkdir -p "$TOOLCHAIN_ROOT"
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GOARCH}.tar.gz" -o "$archive"
    printf '%s  %s\n' "$GO_ARCHIVE_SHA" "$archive" | sha256sum -c -
    tar -C "$TOOLCHAIN_ROOT" -xzf "$archive"
    rm -f "$archive"
  fi
  export GOROOT="$TOOLCHAIN_ROOT/go"
  export PATH="$GOROOT/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  export GOTOOLCHAIN=local
  [[ "$(go env GOVERSION)" == "go$GO_VERSION" ]] || die "pinned Go toolchain mismatch"
}

build_exact_candidate() {
  STEP="build-exact-candidate"
  log "Fetch and build exact rc.1 with pinned Go $GO_VERSION"
  rm -rf "$SOURCE_DIR"
  git clone -q "$PRODUCT_REPO" "$SOURCE_DIR"
  git -C "$SOURCE_DIR" checkout -q --detach "$RC_COMMIT"
  [[ "$(git -C "$SOURCE_DIR" rev-parse HEAD)" == "$RC_COMMIT" ]] || die "source commit mismatch"
  [[ -z "$(git -C "$SOURCE_DIR" status --porcelain)" ]] || die "source checkout is not clean"
  (cd "$SOURCE_DIR" && ./scripts/secret-scan.sh && go test ./... && go vet ./...)
  bash -n "$SOURCE_DIR"/install/install.sh "$SOURCE_DIR"/install/uninstall.sh "$SOURCE_DIR"/install/update.sh \
    "$SOURCE_DIR"/scripts/build.sh "$SOURCE_DIR"/scripts/build-release.sh "$SOURCE_DIR"/scripts/rc1-update-acceptance.sh
  (cd "$SOURCE_DIR" && ./scripts/build-release.sh)
  printf '%s  %s\n' "$EXPECTED_RC_SHA" "$SOURCE_DIR/dist/control-center-linux-$GOARCH" | sha256sum -c -
  [[ "$($SOURCE_DIR/dist/control-center-linux-$GOARCH build-info --field version)" == "$RC_VERSION" ]] || die "built version mismatch"
  [[ "$($SOURCE_DIR/dist/control-center-linux-$GOARCH build-info --field commit)" == "$RC_COMMIT" ]] || die "built commit mismatch"

  cp "$SOURCE_DIR/dist/SHA256SUMS" "$BASE/first-SHA256SUMS"
  cp "$SOURCE_DIR/dist/BUILDINFO.env" "$BASE/first-BUILDINFO.env"
  rm -rf "$SOURCE_DIR/dist"
  (cd "$SOURCE_DIR" && ./scripts/build-release.sh)
  cmp "$BASE/first-SHA256SUMS" "$SOURCE_DIR/dist/SHA256SUMS"
  cmp "$BASE/first-BUILDINFO.env" "$SOURCE_DIR/dist/BUILDINFO.env"
  printf '%s  %s\n' "$EXPECTED_RC_SHA" "$SOURCE_DIR/dist/control-center-linux-$GOARCH" | sha256sum -c -
}

package_exact_candidate() {
  STEP="package-exact-candidate"
  log "Package exact signed rc.1 candidate"
  openssl genpkey -algorithm ED25519 -out "$PRIVATE_KEY" >/dev/null 2>&1
  chmod 0600 "$PRIVATE_KEY"
  openssl pkey -in "$PRIVATE_KEY" -pubout -out "$PUBLIC_KEY" >/dev/null 2>&1
  chmod 0644 "$PUBLIC_KEY"
  # shellcheck disable=SC1090
  source "$SOURCE_DIR/dist/BUILDINFO.env"
  (cd "$SOURCE_DIR" && go run ./cmd/release-tool package \
    --binary "$SOURCE_DIR/dist/control-center-linux-$GOARCH" \
    --version "$VERSION" --commit "$COMMIT" --built-at "$BUILT_AT" --arch "$GOARCH" \
    --private-key "$PRIVATE_KEY" --output "$RC_PACKAGE" >/dev/null)
  local check="$BASE/package-check"
  rm -rf "$check"; mkdir -p "$check"
  tar -xzf "$RC_PACKAGE" -C "$check"
  [[ "$(find "$check" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort | paste -sd ' ' -)" == "control-center manifest.json manifest.sig" ]] || die "package whitelist mismatch"
  "$SOURCE_DIR/dist/control-center-linux-$GOARCH" verify-release \
    --manifest "$ch