 true)"
    echo "log_mode=$(stat -c %a /var/log/control-center 2>/dev/null || true)"
    echo "state_sha256_before=$STATE_HASH_BEFORE"
    echo "state_sha256_after=$(safe_hash /var/lib/control-center/state.json)"
    echo "secrets_sha256_before=$SECRETS_HASH_BEFORE"
    echo "secrets_sha256_after=$(safe_hash /var/lib/control-center/secrets.json)"
    echo "panel_url=$PANEL_URL"
    echo
    echo "--- BACKEND VERSION ---"
    curl -fsS "$BACKEND_URL/api/v1/version" 2>/dev/null || true
    echo
    echo "--- BACKEND READINESS ---"
    curl -fsS "$BACKEND_URL/api/v1/readiness" 2>/dev/null || true
    echo
    echo "--- PROXY HEALTH ---"
    curl -fsS -H "Host: $PUBLIC_IP:8876" "http://127.0.0.1:8876/api/v1/health" 2>/dev/null || true
    echo
    echo "--- SYSTEMD STATUS ---"
    systemctl status control-center.service --no-pager -l 2>&1 | tail -n 100 || true
    echo
    echo "--- JOURNAL TAIL ---"
    journalctl -u control-center.service --no-pager -n 160 2>&1 || true
    echo
    echo "NOTE: no passwords, password hashes, session cookies, CSRF tokens, request bodies or private signing keys are included intentionally."
  } > "$REPORT_FILE"
  chmod 0600 "$REPORT_FILE"
}

