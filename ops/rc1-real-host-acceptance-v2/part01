POST_REBOOT_AUTH="pending"
RC_UPDATE_ROLLBACK="pending"
REPAIR_REINSTALL="pending"
PRESERVE_STATE_REINSTALL="pending"
STATE_PRESERVED="pending"
DIAGNOSTICS="pending"
TRUST_RESTORED="pending"
REPORT_SENT="NO"
