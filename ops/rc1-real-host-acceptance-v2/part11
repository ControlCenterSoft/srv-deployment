  fi
  systemctl reset-failed control-center.service >/dev/null 2>&1 || true
  systemctl start control-center.service >/dev/null 2>&1 || true
  set -e
}

on_error() {
  local rc="$1" line="$2"
  [[ "$FAILURE_ACTIVE" == 0 ]] || exit "$rc"
  FAILURE_ACTIVE=1
  trap - ERR
  set +e
  printf 'ACCEPTANCE FAILURE: step=%s line=%s rc=%s\n' "$STEP" "$line" "$rc" >&2
  FINAL_STATUS="FAILED"
  recover_exact_rc
  restore_original_trust
  rm -f "$PRIVATE_KEY" "$PUBLIC_KEY"
  rm -rf -- "$BASE"/api-* "$BASE/package-check" 2>/dev/null || true
  write_report
  push_report || true
  rm -f "$STATE_FILE"
  remove_resume_unit
  printf '\nFINAL_STATUS=FAILED\nLOCAL_REPORT=%s\nPANEL_URL=%s\n' "$REPORT_FILE" "$PANEL_URL"
  exit "$rc"
}
