#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
from datetime import datetime, timezone
import urllib.request


ACTION_DIR = Path("/var/lib/srv-control/system-actions")
RESULT_DIR = Path("/var/lib/srv-control/system-results")
AUTO_UPDATES_FILE = Path("/etc/apt/apt.conf.d/20auto-upgrades")
ADGUARD_INSTALLER = (
    "https://raw.githubusercontent.com/"
    "AdguardTeam/AdGuardVPNCLI/master/scripts/release/install.sh"
)


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def write_result(request_id: str, payload: dict) -> None:
    RESULT_DIR.mkdir(parents=True, exist_ok=True)
    path = RESULT_DIR / f"{request_id}.json"
    tmp = RESULT_DIR / f".{request_id}.tmp"
    tmp.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def run(command: list[str], *, input_text: str | None = None, timeout: int = 900) -> str:
    completed = subprocess.run(
        command,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        timeout=timeout,
        check=False,
        env={
            **os.environ,
            "DEBIAN_FRONTEND": "noninteractive",
        },
    )
    output = (completed.stdout or "")[-6000:]
    if completed.returncode != 0:
        raise RuntimeError(
            f"command failed ({completed.returncode}): {' '.join(command)}\n{output}"
        )
    return output


def set_auto_updates(enabled: bool) -> str:
    if enabled:
        run(["apt-get", "update", "-y"], timeout=300)
        run(
            [
                "apt-get",
                "install",
                "-y",
                "--no-install-recommends",
                "unattended-upgrades",
            ],
            timeout=600,
        )

    value = "1" if enabled else "0"
    AUTO_UPDATES_FILE.write_text(
        'APT::Periodic::Update-Package-Lists "1";\n'
        f'APT::Periodic::Unattended-Upgrade "{value}";\n',
        encoding="utf-8",
    )
    os.chmod(AUTO_UPDATES_FILE, 0o644)

    if enabled:
        subprocess.run(
            ["systemctl", "enable", "--now", "apt-daily.timer", "apt-daily-upgrade.timer"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    return f"automatic updates {'enabled' if enabled else 'disabled'}"


def download_adguard_installer() -> str:
    request = urllib.request.Request(
        ADGUARD_INSTALLER,
        headers={"User-Agent": "SRV-Control-Center/0.8"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        data = response.read()

    if not data.startswith(b"#!/"):
        raise RuntimeError("unexpected AdGuard VPN installer payload")

    handle = tempfile.NamedTemporaryFile(
        prefix="adguardvpn-install.",
        suffix=".sh",
        delete=False,
    )
    try:
        handle.write(data)
        handle.flush()
        return handle.name
    finally:
        handle.close()


def manage_adguard(uninstall: bool) -> str:
    script = download_adguard_installer()
    try:
        args = ["sh", script, "-v"]
        if uninstall:
            args.append("-u")
        return run(
            args,
            input_text="y\ny\ny\n",
            timeout=900,
        )
    finally:
        try:
            os.unlink(script)
        except FileNotFoundError:
            pass


def handle(request: dict) -> dict:
    request_id = str(request.get("request_id") or "")
    action = str(request.get("action") or "")
    actor = str(request.get("actor") or "unknown")

    result = {
        "request_id": request_id,
        "action": action,
        "actor": actor,
        "started_at": now(),
        "finished_at": None,
        "result": "running",
        "detail": None,
    }
    write_result(request_id, result)

    try:
        if action == "reboot":
            result["detail"] = "reboot scheduled in 3 seconds"
            run(
                [
                    "systemd-run",
                    "--unit=srv-control-reboot",
                    "--on-active=3s",
                    "/usr/bin/systemctl",
                    "reboot",
                ],
                timeout=20,
            )
        elif action == "os-update":
            active = subprocess.run(
                ["systemctl", "is-active", "--quiet", "srv-control-os-update.service"],
                check=False,
            ).returncode == 0
            if active:
                raise RuntimeError("OS update job is already running")
            run(["systemctl", "start", "srv-control-os-update.service"], timeout=20)
            result["detail"] = "OS update job started"
        elif action == "auto-updates-enable":
            result["detail"] = set_auto_updates(True)
        elif action == "auto-updates-disable":
            result["detail"] = set_auto_updates(False)
        elif action == "service-install-adguard-vpn":
            if shutil.which("adguardvpn-cli") or Path("/opt/adguardvpn_cli/adguardvpn-cli").exists():
                result["detail"] = "AdGuard VPN is already installed"
            else:
                manage_adguard(False)
                result["detail"] = "AdGuard VPN installed; account login/configuration is still required"
        elif action == "service-remove-adguard-vpn":
            if not shutil.which("adguardvpn-cli") and not Path("/opt/adguardvpn_cli/adguardvpn-cli").exists():
                result["detail"] = "AdGuard VPN is already absent"
            else:
                manage_adguard(True)
                result["detail"] = "AdGuard VPN removed"
        else:
            raise RuntimeError("unsupported system action")

        result["result"] = "success"
    except Exception as exc:
        result["result"] = "failed"
        result["detail"] = str(exc)[-6000:]

    result["finished_at"] = now()
    write_result(request_id, result)
    return result


def main() -> int:
    ACTION_DIR.mkdir(parents=True, exist_ok=True)
    requests = sorted(ACTION_DIR.glob("*.json"), key=lambda p: p.stat().st_mtime)
    if not requests:
        return 0

    path = requests[0]
    try:
        request = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(request, dict):
            raise ValueError("request must be a JSON object")
        request_id = str(request.get("request_id") or path.stem)
        if request_id != path.stem:
            raise ValueError("request id does not match filename")
        handle(request)
    except Exception as exc:
        request_id = path.stem
        write_result(
            request_id,
            {
                "request_id": request_id,
                "action": None,
                "started_at": now(),
                "finished_at": now(),
                "result": "failed",
                "detail": str(exc),
            },
        )
    finally:
        try:
            path.unlink()
        except FileNotFoundError:
            pass

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
