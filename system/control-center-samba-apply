#!/usr/bin/env bash
set -Eeuo pipefail

RUN_DIR=/run/control-center
ROOT_RUN=/run/control-center-root
STATE=/var/lib/control-center
SYSTEM_STATE=/var/lib/control-center-system
ROOT_STATE=/var/lib/control-center-root
PENDING="$RUN_DIR/samba-provision.json"
APPROVAL="$ROOT_RUN/samba-approval.json"
STATUS="$SYSTEM_STATE/samba-status.json"
MODULE="$SYSTEM_STATE/modules/samba.json"
EVENTS="$SYSTEM_STATE/market-events.jsonl"
LOG="$SYSTEM_STATE/samba-last.log"
BACKUP_ROOT="$ROOT_STATE/samba-backups"
APT_LOCK=/run/control-center-apt.lock
POLICY=/usr/sbin/policy-rc.d
POLICY_BACKUP=""
POLICY_HAD=0
POLICY_ACTIVE=0
JOB_ID="unknown"
ADMINPASS=""
BACKUP=""
ARCHIVE=""
MANIFEST=""

[[ -s "$PENDING" ]] || exit 0
install -d -o root -g control-center -m 0750 "$SYSTEM_STATE" "$SYSTEM_STATE/modules"
install -d -o root -g root -m 0700 "$ROOT_STATE" "$BACKUP_ROOT" "$ROOT_RUN"
: >"$LOG"; chown root:control-center "$LOG"; chmod 0640 "$LOG"
exec > >(tee -a "$LOG") 2>&1

status(){
  local state="$1" message="$2" detail="${3:-}" job="${4:-$JOB_ID}" backup="${5:-$BACKUP}"
  python3 - "$STATUS" "$state" "$message" "$detail" "$job" "$backup" <<'PY'
import json,sys,time,os,tempfile
p,state,message,detail,job,backup=sys.argv[1:]
data={'state':state,'message':message,'detail':detail,'job_id':job,'backup_path':backup,'timestamp':int(time.time())}
fd,tmp=tempfile.mkstemp(prefix='.samba-status.',dir=os.path.dirname(p))
with os.fdopen(fd,'w',encoding='utf-8') as f:
    json.dump(data,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,p)
PY
  chown root:control-center "$STATUS"; chmod 0640 "$STATUS"
}

event(){
  local phase="$1" state="$2" message="$3" detail="${4:-}" action="${5:-provision}"
  python3 - "$EVENTS" "$phase" "$state" "$message" "$detail" "$action" <<'PY'
import json,sys,time,os,tempfile
p,phase,state,message,detail,action=sys.argv[1:]
e={'module':'samba','service':'Samba AD-DC','action':action,'phase':phase,'state':state,'message':message,'detail':detail,'timestamp':int(time.time())}
try: lines=open(p,encoding='utf-8').read().splitlines()
except Exception: lines=[]
lines.append(json.dumps(e,ensure_ascii=False,separators=(',',':')));lines=lines[-300:]
fd,tmp=tempfile.mkstemp(prefix='.market-events.',dir=os.path.dirname(p))
with os.fdopen(fd,'w',encoding='utf-8') as f:
    f.write('\n'.join(lines)+'\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,p)
PY
  chown root:control-center "$EVENTS"; chmod 0640 "$EVENTS"
}

log_tail(){ tail -n 35 "$LOG" 2>/dev/null | sed -E 's/\x1B\[[0-9;]*[A-Za-z]//g' | tail -c 3500 || true; }

db_job(){
  local state="$1" result="${2:-{}}" error="${3:-}" backup="${4:-$BACKUP}"
  [[ -x /opt/control-center/venv/bin/python ]] || return 0
  runuser -u control-center -- env CONTROL_CENTER_DB_DSN="${CONTROL_CENTER_DB_DSN:-dbname=control_center user=control-center host=/var/run/postgresql}" \
    /opt/control-center/venv/bin/python - "$JOB_ID" "$state" "$result" "$error" "$backup" <<'PY' >/dev/null 2>&1 || true
import json,sys
sys.path.insert(0,'/opt/control-center/app')
import database
job,state,result,error,backup=sys.argv[1:]
try:r=json.loads(result)
except Exception:r={}
with database.connect() as c:
    c.execute("UPDATE control_center.ad_dc_lifecycle_jobs SET state=%s,result=%s::jsonb,error=NULLIF(%s,''),backup_path=NULLIF(%s,''),started_at=CASE WHEN %s='running' AND started_at IS NULL THEN now() ELSE started_at END,finished_at=CASE WHEN %s IN ('done','failed','rollback') THEN now() ELSE finished_at END,updated_at=now() WHERE job_id=%s",(state,json.dumps(r),error,backup,state,state,job))
PY
}

cleanup_policy(){
  [[ "$POLICY_ACTIVE" == 1 ]] || return 0
  rm -f "$POLICY"
  if [[ "$POLICY_HAD" == 1 && -n "$POLICY_BACKUP" && -e "$POLICY_BACKUP" ]]; then cp -a "$POLICY_BACKUP" "$POLICY"; fi
  [[ -n "$POLICY_BACKUP" ]] && rm -f "$POLICY_BACKUP"
  POLICY_ACTIVE=0
}
prepare_policy(){
  POLICY_BACKUP="$BACKUP/policy-rc.d.backup"
  if [[ -e "$POLICY" || -L "$POLICY" ]]; then
    cp -a "$POLICY" "$POLICY_BACKUP"; POLICY_HAD=1
    cat >"$POLICY" <<EOF
#!/bin/sh
case "\${1:-}" in samba-ad-dc|smbd|nmbd|winbind|chrony|chronyd) exit 101;; esac
exec "$POLICY_BACKUP" "\$@"
EOF
  else
    POLICY_HAD=0
    cat >"$POLICY" <<'EOF'
#!/bin/sh
case "${1:-}" in samba-ad-dc|smbd|nmbd|winbind|chrony|chronyd) exit 101;; esac
exit 0
EOF
  fi
  chmod 0755 "$POLICY"; POLICY_ACTIVE=1
}

consume_approval(){
  local supplied="$1"
  [[ -s "$APPROVAL" ]] || return 1
  local rc=0
  python3 - "$APPROVAL" "$supplied" <<'PY' || rc=$?
import hashlib,json,re,sys,time
p,token=sys.argv[1:]
if not re.fullmatch(r'[0-9a-f]{8}',token): raise SystemExit(4)
j=json.load(open(p))
if j.get('purpose')!='samba-ad-dc-provision': raise SystemExit(5)
if int(j.get('expires_at') or 0)<int(time.time()): raise SystemExit(2)
if hashlib.sha256(token.encode()).hexdigest()!=str(j.get('sha256') or ''): raise SystemExit(3)
PY
  rm -f "$APPROVAL"
  return "$rc"
}

# Parse and independently validate all Web-supplied data before any mutation.
readarray -t REQ < <(python3 - "$PENDING" <<'PY'
import ipaddress,json,re,sys
j=json.load(open(sys.argv[1]))
job=str(j.get('job_id') or '')
realm=str(j.get('realm') or '').strip().rstrip('.').upper()
domain=str(j.get('netbios_domain') or '').strip().upper()
iface=str(j.get('interface') or '').strip()
role=str(j.get('network_role') or '').strip().lower()
ip=str(j.get('ipv4') or '').strip(); prefix=str(j.get('prefix') or '').strip(); network=str(j.get('network') or '').strip()
forwarder=str(j.get('dns_forwarder') or '').strip(); password=str(j.get('administrator_password') or '')
approval=str(j.get('approval_code') or '').strip().lower(); replace=bool(j.get('replace_existing')); allow_wan=bool(j.get('allow_wan'))
if not re.fullmatch(r'samba-provision-[0-9]{9,12}-[0-9a-f]{8}',job): raise SystemExit('invalid job id')
labels=realm.lower().split('.')
if len(labels)<2 or realm.lower().endswith('.local') or len(realm)>253: raise SystemExit('invalid realm')
if any(not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?',x) for x in labels): raise SystemExit('invalid realm label')
if not re.fullmatch(r'[A-Z0-9](?:[A-Z0-9-]{0,13}[A-Z0-9])?',domain): raise SystemExit('invalid NetBIOS domain')
if not re.fullmatch(r'[A-Za-z0-9_.:-]{1,15}',iface): raise SystemExit('invalid interface')
if role not in {'lan','wan'}: raise SystemExit('invalid role')
if role=='wan' and not allow_wan: raise SystemExit('WAN approval missing')
try:
    addr=ipaddress.IPv4Interface(f'{ip}/{int(prefix)}'); declared=ipaddress.IPv4Network(network,strict=False); fwd=ipaddress.IPv4Address(forwarder)
except Exception: raise SystemExit('invalid IPv4 configuration')
if addr.network!=declared: raise SystemExit('network mismatch')
if fwd==addr.ip or fwd.is_loopback or fwd.is_multicast or fwd.is_unspecified: raise SystemExit('invalid DNS forwarder')
if not 12<=len(password)<=128 or any(ord(c)<32 for c in password): raise SystemExit('invalid administrator password')
cats=sum((any(c.islower() for c in password),any(c.isupper() for c in password),any(c.isdigit() for c in password),any(not c.isalnum() for c in password)))
if cats<3: raise SystemExit('weak administrator password')
if not re.fullmatch(r'[0-9a-f]{8}',approval): raise SystemExit('invalid approval code')
for value in (job,realm,domain,iface,role,str(addr.ip),str(addr.network.prefixlen),str(addr.network),str(fwd),password,approval,'1' if replace else '0','1' if allow_wan else '0'): print(value)
PY
) || { rm -f "$PENDING"; status error 'Запрос Samba AD-DC отклонён привилегированной проверкой'; event failed error 'Samba AD-DC: root validation rejected request'; exit 2; }
JOB_ID="${REQ[0]}"; REALM="${REQ[1]}"; DOMAIN="${REQ[2]}"; IFACE="${REQ[3]}"; ROLE="${REQ[4]}"; AD_IP="${REQ[5]}"; PREFIX="${REQ[6]}"; NETWORK="${REQ[7]}"; FORWARDER="${REQ[8]}"; ADMINPASS="${REQ[9]}"; APPROVAL_CODE="${REQ[10]}"; REPLACE_EXISTING="${REQ[11]}"; ALLOW_WAN="${REQ[12]}"
rm -f "$PENDING"

if ! ip -j -4 addr show dev "$IFACE" | python3 -c 'import ipaddress,json,sys; target=ipaddress.IPv4Interface(sys.argv[1]); rows=json.load(sys.stdin); found=False
for row in rows:
  for a in row.get("addr_info",[]):
    if a.get("family")=="inet" and a.get("local")==str(target.ip) and int(a.get("prefixlen",-1))==target.network.prefixlen: found=True
raise SystemExit(0 if found else 1)' "$AD_IP/$PREFIX"; then
  unset ADMINPASS APPROVAL_CODE
  status error 'Статический IP выбранной роли не найден на интерфейсе.' "$IFACE · $AD_IP/$PREFIX"
  event failed error 'Samba AD-DC: root network validation failed' "$IFACE · $AD_IP/$PREFIX"
  db_job failed '{}' 'static IP not present on interface'
  exit 3
fi

if ! consume_approval "$APPROVAL_CODE"; then
  unset ADMINPASS APPROVAL_CODE
  status error 'Одноразовый код локального подтверждения отсутствует, истёк или неверен.'
  event failed error 'Создание Samba AD-DC отклонено: локальное подтверждение не пройдено'
  db_job failed '{}' 'local approval failed'
  exit 1
fi
unset APPROVAL_CODE

status provisioning "Создание домена $REALM выполняется…" 'Backup → packages → DNS/Kerberos → provision → acceptance'
event started installing "Создание Samba AD-DC началось: $REALM" "Интерфейс $IFACE, IP $AD_IP"
db_job running '{}'

exec 8>"$APT_LOCK"
flock -w 900 8 || { unset ADMINPASS; status error 'Менеджер пакетов занят'; event failed error 'Samba AD-DC: менеджер пакетов занят'; db_job failed '{}' 'apt lock timeout'; exit 75; }

BACKUP="$BACKUP_ROOT/$JOB_ID"; ARCHIVE="$BACKUP/pre-provision.tar.gz"; MANIFEST="$BACKUP/manifest.json"
install -d -o root -g root -m 0700 "$BACKUP"
EXISTING_SAMBA=0; [[ -s /etc/samba/smb.conf ]] && EXISTING_SAMBA=1
if [[ "$EXISTING_SAMBA" == 1 && "$REPLACE_EXISTING" != 1 && ! -s "$MODULE" ]]; then
  unset ADMINPASS; status error 'Обнаружена существующая Samba-конфигурация. Автоматическая замена запрещена.' 'Включите явное подтверждение замены только после проверки backup.'; event failed error 'Samba AD-DC не создан: существующая Samba-конфигурация не захвачена'; db_job failed '{}' 'existing Samba configuration detected'; exit 3
fi
if [[ -s "$MODULE" ]]; then
  ACTIVE="$(python3 - "$MODULE" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except Exception: print(0);raise SystemExit
print(1 if j.get('managed') and j.get('state')=='active' else 0)
PY
)"
  if [[ "$ACTIVE" == 1 ]]; then unset ADMINPASS; status active 'Samba AD-DC уже активен'; event succeeded running 'Samba AD-DC уже был активен'; db_job done '{"already_active":true}'; exit 0; fi
fi

python3 - "$MANIFEST" <<'PY'
import json,subprocess,sys,time,os
p=sys.argv[1];services=['systemd-resolved.service','systemd-timesyncd.service','chrony.service','smbd.service','nmbd.service','winbind.service','samba-ad-dc.service','control-center-dhcp-server.service']
def q(args):
    try:return subprocess.run(args,text=True,capture_output=True,timeout=4).stdout.strip()
    except Exception:return ''
data={'created_at':int(time.time()),'services':{s:{'active':q(['systemctl','is-active',s]),'enabled':q(['systemctl','is-enabled',s])} for s in services}}
with open(p,'w') as f:json.dump(data,f,indent=2);f.write('\n')
os.chmod(p,0o600)
PY
PATHS=(); for p in etc/samba var/lib/samba var/cache/samba etc/krb5.conf etc/resolv.conf etc/hosts etc/systemd/resolved.conf etc/chrony var/lib/control-center-system/dhcp-config.json etc/dnsmasq.d/control-center-dhcp.conf; do [[ -e "/$p" || -L "/$p" ]] && PATHS+=("$p"); done
if (( ${#PATHS[@]} )); then tar -C / --acls --xattrs -czpf "$ARCHIVE" "${PATHS[@]}"; else tar -czpf "$ARCHIVE" --files-from /dev/null; fi
chmod 0600 "$ARCHIVE" "$MANIFEST"; status provisioning 'Backup завершён. Установка пакетов Samba AD-DC…' "$BACKUP"; db_job running '{}' '' "$BACKUP"

restore_services(){
  python3 - "$MANIFEST" <<'PY'
import json,subprocess,sys
j=json.load(open(sys.argv[1]))
for s,v in j.get('services',{}).items():
    enabled=v.get('enabled',''); active=v.get('active','')
    if enabled=='enabled': subprocess.run(['systemctl','enable',s],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    elif enabled=='disabled': subprocess.run(['systemctl','disable',s],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    elif enabled=='masked': subprocess.run(['systemctl','mask',s],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    if active=='active': subprocess.run(['systemctl','start',s],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    else: subprocess.run(['systemctl','stop',s],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
PY
}
rollback(){
  local reason="$1"; trap - ERR; cleanup_policy || true; unset ADMINPASS; rm -f "$ROOT_RUN"/samba-auth-"$JOB_ID" 2>/dev/null || true
  systemctl stop samba-ad-dc.service chrony.service >/dev/null 2>&1 || true
  rm -rf /etc/samba /var/lib/samba /var/cache/samba; rm -f /etc/krb5.conf /etc/resolv.conf /etc/chrony/conf.d/control-center-ad-dc.conf
  [[ -s "$ARCHIVE" ]] && tar -C / -xzpf "$ARCHIVE" --acls --xattrs >/dev/null 2>&1 || true
  systemctl daemon-reload || true; [[ -s "$MANIFEST" ]] && restore_services || true
  if [[ -f /etc/dnsmasq.d/control-center-dhcp.conf ]] && systemctl is-active --quiet control-center-dhcp-server.service; then dnsmasq --test --conf-file=/etc/dnsmasq.d/control-center-dhcp.conf >/dev/null 2>&1 && systemctl restart control-center-dhcp-server.service >/dev/null 2>&1 || true; fi
  rm -f "$MODULE"; status rollback 'Создание Samba AD-DC не завершено. Предыдущее состояние восстановлено.' "$reason"; event failed error 'Samba AD-DC: provisioning завершился rollback' "$reason"; db_job rollback '{}' "$reason" "$BACKUP"
}
on_error(){ local rc=$?; local detail; detail="$(log_tail)"; rollback "Ошибка $rc. $detail"; exit "$rc"; }
trap on_error ERR; trap cleanup_policy EXIT

export DEBIAN_FRONTEND=noninteractive
prepare_policy; apt-get update; apt-get -f install -y; apt-get install -y samba samba-dsdb-modules samba-vfs-modules winbind krb5-user dnsutils acl attr smbclient chrony; cleanup_policy
command -v samba-tool >/dev/null; command -v smbclient >/dev/null; command -v kinit >/dev/null; command -v host >/dev/null
rm -f /etc/samba/smb.conf
if [[ "$EXISTING_SAMBA" == 1 || "$REPLACE_EXISTING" == 1 ]]; then rm -rf /var/lib/samba/* /var/cache/samba/*; fi
systemctl disable --now smbd.service nmbd.service winbind.service >/dev/null 2>&1 || true; systemctl stop samba-ad-dc.service >/dev/null 2>&1 || true
systemctl stop systemd-resolved.service >/dev/null 2>&1 || true; systemctl disable systemd-resolved.service >/dev/null 2>&1 || true; systemctl stop systemd-timesyncd.service >/dev/null 2>&1 || true

port_busy(){ local p="$1"; ss -H -lntup 2>/dev/null | awk -v p=":$p" '{for(i=1;i<=NF;i++) if($i ~ p"$") found=1} END{exit found?0:1}'; }
for port in 53 88 389 445; do if port_busy "$port"; then echo "Port $port is still occupied after managed service cutover" >&2; ss -H -lntup | grep -E ":${port}([[:space:]]|$)" >&2 || true; false; fi; done

HOST_SHORT="$(hostname -s)"; REALM_LC="$(printf '%s' "$REALM" | tr '[:upper:]' '[:lower:]')"; FQDN="${HOST_SHORT}.${REALM_LC}"
[[ "${HOST_SHORT^^}" != "$DOMAIN" ]] || { echo 'DC hostname must not match NetBIOS domain' >&2; false; }
python3 - /etc/hosts "$HOST_SHORT" "$FQDN" "$AD_IP" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); short,fqdn,ip=sys.argv[2:]; lines=p.read_text(errors='replace').splitlines() if p.exists() else [];out=[]
for line in lines:
    if line.lstrip().startswith('#') or not line.strip(): out.append(line); continue
    parts=line.split()
    if parts and parts[0] in {'127.0.0.1','::1'}: out.append(line); continue
    names=set(parts[1:]) if len(parts)>1 else set()
    if short in names or fqdn in names: continue
    out.append(line)
out.append(f'{ip}\t{fqdn}\t{short}');p.write_text('\n'.join(out).rstrip()+'\n')
PY
getent hosts "$FQDN" | grep -Fq "$AD_IP"

status provisioning "Provisioning домена $REALM…" "DC $FQDN / $AD_IP"
printf '%s\n%s\n' "$ADMINPASS" "$ADMINPASS" | samba-tool domain provision --realm="$REALM" --domain="$DOMAIN" --server-role=dc --dns-backend=SAMBA_INTERNAL --dns-forwarder="$FORWARDER" --use-rfc2307 --interactive --option="interfaces=lo $IFACE" --option="bind interfaces only=yes"
test -s /etc/samba/smb.conf; test -s /var/lib/samba/private/krb5.conf; install -o root -g root -m 0644 /var/lib/samba/private/krb5.conf /etc/krb5.conf
rm -f /etc/resolv.conf; cat >/etc/resolv.conf <<EOF
# Managed by Control Center Samba AD-DC.
search $REALM_LC
nameserver $AD_IP
EOF
chmod 0644 /etc/resolv.conf
CHRONY_GROUP=_chrony; getent group "$CHRONY_GROUP" >/dev/null || CHRONY_GROUP=chrony
install -d -o root -g "$CHRONY_GROUP" -m 0750 /var/lib/samba/ntp_signd; install -d -m 0755 /etc/chrony/conf.d
cat >/etc/chrony/conf.d/control-center-ad-dc.conf <<EOF
# Managed by Control Center Samba AD-DC.
allow $NETWORK
ntpsigndsocket /var/lib/samba/ntp_signd
EOF
chmod 0644 /etc/chrony/conf.d/control-center-ad-dc.conf
systemctl unmask samba-ad-dc.service >/dev/null 2>&1 || true; systemctl enable --now samba-ad-dc.service; systemctl enable --now chrony.service
for _ in $(seq 1 30); do systemctl is-active --quiet samba-ad-dc.service && break; sleep 1; done; systemctl is-active --quiet samba-ad-dc.service
samba-tool testparm >/dev/null; samba-tool ntacl sysvolcheck >/dev/null; samba-tool domain info "$AD_IP" >/tmp/control-center-samba-domain-info.txt; samba-tool drs showrepl --summary >/tmp/control-center-samba-repl.txt
host -W 3 -t A "$FQDN" "$AD_IP" >/tmp/control-center-samba-dns-a.txt; host -W 3 -t SRV "_ldap._tcp.${REALM_LC}" "$AD_IP" >/tmp/control-center-samba-dns-ldap.txt; host -W 3 -t SRV "_kerberos._udp.${REALM_LC}" "$AD_IP" >/tmp/control-center-samba-dns-kerberos.txt
printf '%s\n' "$ADMINPASS" | kinit "Administrator@$REALM"; klist >/tmp/control-center-samba-klist.txt; kdestroy || true
AUTH_FILE="$ROOT_RUN/samba-auth-$JOB_ID"; cat >"$AUTH_FILE" <<EOF
username = Administrator
password = $ADMINPASS
domain = $DOMAIN
EOF
chmod 0600 "$AUTH_FILE"; smbclient -A "$AUTH_FILE" -L "//$FQDN" >/tmp/control-center-samba-smbclient.txt; rm -f "$AUTH_FILE"; unset ADMINPASS

if [[ -s "$SYSTEM_STATE/dhcp-config.json" ]] && command -v /usr/local/sbin/control-center-dhcp-apply >/dev/null 2>&1; then
  SAME_IFACE="$(python3 - "$SYSTEM_STATE/dhcp-config.json" "$IFACE" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except Exception: print(0);raise SystemExit
print(1 if j.get('interface')==sys.argv[2] else 0)
PY
)"
  if [[ "$SAME_IFACE" == 1 ]]; then
    python3 - "$SYSTEM_STATE/dhcp-config.json" "$STATE/dhcp-pending.json" "$AD_IP" <<'PY'
import json,sys,os
src,dst,ip=sys.argv[1:];j=json.load(open(src));j['dns']=[ip]
with open(dst,'w') as f:json.dump(j,f,ensure_ascii=False,indent=2);f.write('\n')
os.chown(dst,0,0);os.chmod(dst,0o600)
PY
    /usr/local/sbin/control-center-dhcp-apply
  fi
fi

NOW="$(date +%s)"
python3 - "$MODULE" "$REALM" "$DOMAIN" "$FQDN" "$IFACE" "$ROLE" "$AD_IP" "$PREFIX" "$NETWORK" "$FORWARDER" "$BACKUP" "$NOW" <<'PY'
import json,sys,os,tempfile
p,realm,domain,fqdn,iface,role,ip,prefix,network,forwarder,backup,now=sys.argv[1:]
data={'installed':True,'managed':True,'state':'active','service':'samba-ad-dc','realm':realm,'dns_domain':realm.lower(),'netbios_domain':domain,'fqdn':fqdn,'interface':iface,'network_role':role,'ipv4':ip,'prefix':int(prefix),'network':network,'dns_backend':'SAMBA_INTERNAL','dns_forwarder':forwarder,'backup_path':backup,'provisioned_at':int(now),'last_health_at':int(now),'health_state':'healthy'}
fd,tmp=tempfile.mkstemp(prefix='.samba-module.',dir=os.path.dirname(p))
with os.fdopen(fd,'w') as f:json.dump(data,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,p);os.chmod(p,0o640)
PY
chown root:control-center "$MODULE"
RESULT="$(python3 - "$REALM" "$DOMAIN" "$FQDN" "$AD_IP" "$IFACE" <<'PY'
import json,sys
realm,domain,fqdn,ip,iface=sys.argv[1:];print(json.dumps({'realm':realm,'netbios_domain':domain,'fqdn':fqdn,'ipv4':ip,'interface':iface,'health':'healthy'}))
PY
)"; db_job done "$RESULT" '' "$BACKUP"
runuser -u control-center -- env CONTROL_CENTER_DB_DSN="${CONTROL_CENTER_DB_DSN:-dbname=control_center user=control-center host=/var/run/postgresql}" /opt/control-center/venv/bin/python - "$REALM" "$DOMAIN" "$FQDN" "$IFACE" "$AD_IP" "$FORWARDER" <<'PY' >/dev/null 2>&1 || true
import sys
sys.path.insert(0,'/opt/control-center/app');import database
from psycopg.types.json import Jsonb
