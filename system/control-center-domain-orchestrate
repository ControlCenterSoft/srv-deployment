#!/usr/bin/env bash
set -Eeuo pipefail
SYSTEM=/var/lib/control-center-system
ROOT=/var/lib/control-center-root
ROOT_RUN=/run/control-center-root
CTX="$ROOT/domain-install-context.json"
STATUS="$SYSTEM/samba-status.json"
PRE=/usr/local/sbin/control-center-domain-pre
CORE=/usr/local/sbin/control-center-samba-apply-core
POST=/usr/local/sbin/control-center-domain-post
RESTORE=/usr/local/sbin/control-center-domain-restore-prestate
KRB_SHIM="$ROOT_RUN/krb-shim-$$"
KRB_CACHE="$ROOT_RUN/krb5cc-domain-$$"

write_status(){ python3 - "$STATUS" "$1" "$2" "${3:-}" <<'PY'
import json,sys,time,os,tempfile
p,state,msg,detail=sys.argv[1:]
try:old=json.load(open(p))
except Exception:old={}
old.update({'state':state,'message':msg,'detail':detail,'timestamp':int(time.time())})
fd,tmp=tempfile.mkstemp(prefix='.samba-status.',dir=os.path.dirname(p))
with os.fdopen(fd,'w') as f:json.dump(old,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(tmp,p)
PY
chown root:control-center "$STATUS";chmod 0640 "$STATUS"; }

restart_preserved_dns(){
  [[ -s "$CTX" ]]||return 0
  ACTIVE="$(python3 - "$CTX" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]));print('1' if j.get('unbound_active') else '0')
PY
)"
  [[ "$ACTIVE" == 1 ]]&&systemctl start unbound.service >/dev/null 2>&1||true
}

cleanup_kerberos_shim(){
  rm -rf "$KRB_SHIM" 2>/dev/null||true
  rm -f "$KRB_CACHE" 2>/dev/null||true
}

prepare_kerberos_shim(){
  install -d -o root -g root -m 0700 "$ROOT_RUN" "$KRB_SHIM"
  cat >"$KRB_SHIM/kinit" <<'PY'
#!/usr/bin/env python3
from __future__ import annotations
import errno
import os
import pty
import select
import signal
import sys
import time

cache = os.environ.get('CONTROL_CENTER_KRB5CCACHE', '')
if not cache.startswith('/run/control-center-root/krb5cc-domain-'):
    raise SystemExit('invalid Control Center Kerberos cache path')
password = sys.stdin.read(512).rstrip('\r\n')
if not password:
    raise SystemExit('empty Kerberos password input')
secret = password.encode('utf-8')
env = os.environ.copy()
env['KRB5CCNAME'] = 'FILE:' + cache
argv = ['/usr/bin/kinit', *sys.argv[1:]]
pid, fd = pty.fork()
if pid == 0:
    os.environ.clear()
    os.environ.update(env)
    os.execv(argv[0], argv)

buf = b''
sent = False
deadline = time.time() + 45
status = None
try:
    while True:
        if time.time() > deadline:
            os.kill(pid, signal.SIGKILL)
            raise SystemExit('kinit pseudo-TTY timeout')
        ready, _, _ = select.select([fd], [], [], 0.25)
        if ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError as exc:
                if exc.errno == errno.EIO:
                    break
                raise
            if not chunk:
                break
            os.write(1, chunk.replace(secret, b'***'))
            buf = (buf + chunk)[-4096:]
            if not sent and b'Password for ' in buf and b':' in buf[buf.rfind(b'Password for '):]:
                os.write(fd, secret + b'\n')
                sent = True
        done, status = os.waitpid(pid, os.WNOHANG)
        if done == pid:
            break
finally:
    password = ''
    secret = b''
try:
    if status is None or status == 0:
        _, status = os.waitpid(pid, 0)
except ChildProcessError:
    pass
if not sent:
    raise SystemExit('kinit password prompt was not observed')
rc = os.waitstatus_to_exitcode(status)
if rc == 0:
    os.write(2, b'CONTROL_CENTER_ACCEPT: Kerberos kinit OK\n')
else:
    os.write(2, f'CONTROL_CENTER_ACCEPT: Kerberos kinit FAILED rc={rc}\n'.encode())
raise SystemExit(rc)
PY
  cat >"$KRB_SHIM/klist" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
CACHE="${CONTROL_CENTER_KRB5CCACHE:?}"
[[ "$CACHE" == /run/control-center-root/krb5cc-domain-* ]]||exit 2
rc=0
env KRB5CCNAME="FILE:$CACHE" /usr/bin/klist "$@"||rc=$?
if [[ $rc -eq 0 ]];then
  echo 'CONTROL_CENTER_ACCEPT: Kerberos klist OK' >&2
else
  echo "CONTROL_CENTER_ACCEPT: Kerberos klist FAILED rc=$rc" >&2
fi
exit "$rc"
SH
  cat >"$KRB_SHIM/kdestroy" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
CACHE="${CONTROL_CENTER_KRB5CCACHE:?}"
[[ "$CACHE" == /run/control-center-root/krb5cc-domain-* ]]||exit 2
rc=0
env KRB5CCNAME="FILE:$CACHE" /usr/bin/kdestroy "$@"||rc=$?
rm -f "$CACHE"
exit "$rc"
SH
  cat >"$KRB_SHIM/smbclient" <<'SH'
#!/usr/bin/env bash
set -uo pipefail
args=("$@")
list_host=''
for ((i=0;i<${#args[@]};i++));do
  if [[ "${args[$i]}" == '-L' || "${args[$i]}" == '--list' ]];then
    j=$((i+1))
    if (( j < ${#args[@]} ));then
      args[$j]="${args[$j]#//}"
      list_host="${args[$j]}"
    fi
  elif [[ "${args[$i]}" == --list=* ]];then
    value="${args[$i]#--list=}"
    value="${value#//}"
    args[$i]="--list=$value"
    list_host="$value"
  fi
done
[[ -n "$list_host" ]] && echo "CONTROL_CENTER_ACCEPT: SMB list start host=$list_host" >&2
rc=0
/usr/bin/smbclient "${args[@]}"||rc=$?
if [[ $rc -eq 0 ]];then
  echo 'CONTROL_CENTER_ACCEPT: SMB smbclient OK' >&2
else
  echo "CONTROL_CENTER_ACCEPT: SMB smbclient FAILED rc=$rc" >&2
fi
exit "$rc"
SH
  chmod 0700 "$KRB_SHIM/kinit" "$KRB_SHIM/klist" "$KRB_SHIM/kdestroy" "$KRB_SHIM/smbclient"
}

trap cleanup_kerberos_shim EXIT
"$PRE"
prepare_kerberos_shim
set +e
PATH="$KRB_SHIM:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" CONTROL_CENTER_KRB5CCACHE="$KRB_CACHE" "$CORE"
rc=$?
set -e
cleanup_kerberos_shim
if [[ $rc -ne 0 ]];then
  BACKUP="$(python3 - "$STATUS" <<'PY'
import json,sys
try:j=json.load(open(sys.argv[1]))
except Exception:j={}
print(j.get('backup_path') or '')
PY
)"
  if [[ -n "$BACKUP" && -s "$BACKUP/pre-provision.tar.gz" ]];then "$RESTORE" rollback >/dev/null 2>&1||true;else restart_preserved_dns;fi
  exit "$rc"
fi

# Core has passed Samba/Kerberos/LDAP/SMB acceptance. Keep the public status in
# a non-final state until mandatory DNS/Storage/Auth post-integration finishes.
write_status postconfig 'Базовый контроллер создан. Завершается интеграция DNS, хранилища и авторизации…'
set +e
"$POST"
rc=$?
set -e
if [[ $rc -ne 0 ]];then
  DETAIL='Домен был создан ядром provisioning, но обязательные DNS/Storage/Auth post-checks не завершились. Выполняется полный rollback.'
  write_status rollback 'Domain post-provision failed; restoring pre-state' "$DETAIL"
  "$RESTORE" rollback || true
  write_status rollback 'Создание Домена отменено. Предыдущее состояние восстановлено.' "$DETAIL"
  exit "$rc"
fi

# Final active means the complete Domain product, including required services
# and portal authentication integration, is ready—not merely the Samba daemon.
write_status active 'Домен полностью активирован: Samba AD-DC, DNS, Сетевое хранилище и авторизация работают.'
exit 0
