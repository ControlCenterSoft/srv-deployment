#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo 'Запустите: sudo control-center-samba-approve [--remove]' >&2; exit 1; }
DIR=/run/control-center-root
FILE="$DIR/samba-approval.json"
PURPOSE=samba-ad-dc-provision
LABEL='создании домена'
OUTPUT_LABEL='Control Center Samba AD-DC approval code'
if [[ "${1:-}" == '--remove' ]];then
  PURPOSE=domain-destroy
  LABEL='удалении домена'
  OUTPUT_LABEL='Control Center Domain removal approval code'
elif [[ -n "${1:-}" ]];then
  echo 'Использование: sudo control-center-samba-approve [--remove]' >&2
  exit 2
fi
install -d -o root -g root -m 0700 "$DIR"
TOKEN="$(openssl rand -hex 4)"
HASH="$(printf '%s' "$TOKEN" | sha256sum | awk '{print $1}')"
NOW="$(date +%s)";EXPIRES="$((NOW+600))"
python3 - "$FILE" "$HASH" "$NOW" "$EXPIRES" "$PURPOSE" <<'PY'
import json,sys,os
p,h,issued,expires,purpose=sys.argv[1:]
with open(p,'w',encoding='utf-8') as f:
    json.dump({'sha256':h,'issued_at':int(issued),'expires_at':int(expires),'purpose':purpose},f,ensure_ascii=False,indent=2);f.write('\n')
os.chmod(p,0o600)
PY
chown root:root "$FILE"
printf '\n%s: %s\n' "$OUTPUT_LABEL" "$TOKEN"
printf 'Назначение: %s. Действует 10 минут и используется один раз. Введите его в Web UI при %s.\n\n' "$PURPOSE" "$LABEL"
