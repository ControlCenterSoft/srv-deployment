#!/usr/bin/env bash
set -Eeuo pipefail
STATE=/var/lib/control-center
SYSTEM_STATE=/var/lib/control-center-system
PENDING="$STATE/web-pending.json"
STATUS="$SYSTEM_STATE/web-status.json"
CONFIG="$SYSTEM_STATE/web-config.json"
ENV_FILE=/etc/control-center/web.env
UNIT=control-center.service
DB_CLI=/opt/control-center/app/db_cli.py
PY=/opt/control-center/venv/bin/python
[[ -s "$PENDING" ]] || exit 0
install -d -o root -g control-center -m 0750 "$SYSTEM_STATE"

status(){
  python3 - "$STATUS" "$1" "$2" "$3" <<'PY'
import json,sys,time
p,state,msg,port=sys.argv[1:]
open(p,'w').write(json.dumps({'state':state,'message':msg,'port':int(port),'timestamp':int(time.time())},ensure_ascii=False,indent=2)+'\n')
PY
  chown root:control-center "$STATUS"; chmod 0640 "$STATUS"
}

readarray -t REQ < <(python3 - "$PENDING" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]))
p=j.get('port'); old=j.get('previous_port',8080); job=str(j.get('job_id',''))
if isinstance(p,bool): raise SystemExit(2)
p=int(p); old=int(old)
if not 1024 <= p <= 65535: raise SystemExit(3)
if not 1024 <= old <= 65535: old=8080
print(p); print(old); print(job)
PY
) || { rm -f "$PENDING"; status rejected 'Некорректный запрос изменения порта' 8080; exit 1; }
PORT="${REQ[0]}"; OLD_PORT="${REQ[1]}"; JOB_ID="${REQ[2]}"
rm -f "$PENDING"
status applying "Применение порта Web UI $PORT…" "$PORT"

if [[ "$PORT" != "$OLD_PORT" ]]; then
  if ! python3 - "$PORT" <<'PY'
import socket,sys
p=int(sys.argv[1]); s=socket.socket(socket.AF_INET,socket.SOCK_STREAM)
try:
    s.bind(('0.0.0.0',p))
except OSError as e:
    print(e); raise SystemExit(1)
finally:
    s.close()
PY
  then
    status rejected "Порт $PORT уже занят или недоступен" "$OLD_PORT"
    exit 1
  fi
fi

OLD_ENV="$(cat "$ENV_FILE" 2>/dev/null || true)"
OLD_CONFIG="$(cat "$CONFIG" 2>/dev/null || true)"
TMP_ENV=$(mktemp /etc/control-center/web.env.XXXXXX)
printf 'CONTROL_CENTER_PORT=%s\n' "$PORT" >"$TMP_ENV"
chown root:root "$TMP_ENV"; chmod 0600 "$TMP_ENV"
mv "$TMP_ENV" "$ENV_FILE"
python3 - "$CONFIG" "$PORT" <<'PY'
import json,sys,time
open(sys.argv[1],'w').write(json.dumps({'port':int(sys.argv[2]),'updated_at':int(time.time())},indent=2)+'\n')
PY
chown root:control-center "$CONFIG"; chmod 0640 "$CONFIG"

set_db_port(){
  local value="$1"
  [[ -x "$PY" && -f "$DB_CLI" ]] || return 1
  runuser -u control-center -- env CONTROL_CENTER_DB_DSN="${CONTROL_CENTER_DB_DSN:-dbname=control_center user=control-center host=/var/run/postgresql}" "$PY" "$DB_CLI" set-web-port "$value" >/dev/null
}

rollback(){
  if [[ -n "$OLD_ENV" ]]; then printf '%s\n' "$OLD_ENV" >"$ENV_FILE"; chmod 0600 "$ENV_FILE"; else printf 'CONTROL_CENTER_PORT=%s\n' "$OLD_PORT" >"$ENV_FILE"; chmod 0600 "$ENV_FILE"; fi
  if [[ -n "$OLD_CONFIG" ]]; then printf '%s\n' "$OLD_CONFIG" >"$CONFIG"; chown root:control-center "$CONFIG"; chmod 0640 "$CONFIG"; else rm -f "$CONFIG"; fi
  set_db_port "$OLD_PORT" || true
  systemctl daemon-reload
  systemctl restart "$UNIT" || true
}

if ! set_db_port "$PORT"; then
  rollback
  status rollback 'PostgreSQL не принял новый порт; предыдущая конфигурация восстановлена' "$OLD_PORT"
  exit 1
fi

systemctl daemon-reload
if ! systemctl restart "$UNIT"; then
  rollback
  status rollback 'Web service не перезапустился; предыдущий порт восстановлен' "$OLD_PORT"
  exit 1
fi

OK=0
for _ in $(seq 1 20); do
  if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; then OK=1; break; fi
  sleep 1
done
if [[ "$OK" != 1 ]]; then
  rollback
  status rollback 'Health-check нового порта не пройден; предыдущий порт восстановлен' "$OLD_PORT"
  exit 1
fi

status applied "Web UI переведён на порт $PORT" "$PORT"
if [[ -n "$JOB_ID" ]]; then
  runuser -u control-center -- env CONTROL_CENTER_DB_DSN="${CONTROL_CENTER_DB_DSN:-dbname=control_center user=control-center host=/var/run/postgresql}" "$PY" - "$JOB_ID" "$PORT" <<'PY' 2>/dev/null || true
import sys
sys.path.insert(0,'/opt/control-center/app')
import database
database.upsert_job(sys.argv[1],'web-port-change','done',message=f'Web UI port {sys.argv[2]} applied',result={'port':int(sys.argv[2])})
PY
fi
