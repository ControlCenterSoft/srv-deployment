#!/usr/bin/env bash
set -Eeuo pipefail
SYSTEM=/var/lib/control-center-system
ROOT=/var/lib/control-center-root
SAMBA="$SYSTEM/modules/samba.json"
DNS="$SYSTEM/modules/dns.json"
STORAGE="$SYSTEM/modules/storage.json"
DNS_STATUS="$SYSTEM/dns-status.json"
STORAGE_STATUS="$SYSTEM/storage-status.json"
CTX="$ROOT/domain-install-context.json"
CTX_DIR="$ROOT/domain-install-context"
SMB=/etc/samba/smb.conf
DATA=/srv/control-center/storage/public
[[ -s "$SAMBA" && -s "$CTX" ]] || { echo 'Missing Samba module/domain context' >&2;exit 2; }
readarray -t META < <(python3 - "$SAMBA" "$CTX_DIR/storage.json" <<'PY'
import json,sys
s=json.load(open(sys.argv[1]));name='Public';path='/srv/control-center/storage/public';explicit=False;owned=False
try:
 old=json.load(open(sys.argv[2]));name=old.get('share_name') or name;path=old.get('path') or path;explicit=bool(old.get('explicit'));owned=bool(old.get('package_owned'))
except Exception:pass
print(s.get('netbios_domain',''));print(s.get('ipv4',''));print(s.get('interface',''));print(s.get('dns_forwarder',''));print(name);print(path);print('1' if explicit else '0');print('1' if owned else '0')
PY
)
DOMAIN="${META[0]}";IP="${META[1]}";IFACE="${META[2]}";FORWARDER="${META[3]}";SHARE="${META[4]}";DATA="${META[5]}";STORAGE_EXPLICIT="${META[6]}";STORAGE_OWNED="${META[7]}"
DNS_EXPLICIT=0;DNS_OWNED=0
if [[ -s "$CTX_DIR/dns.json" ]];then readarray -t DM < <(python3 - "$CTX_DIR/dns.json" <<'PY'
import json,sys
j=json.load(open(sys.argv[1]));print('1' if j.get('explicit') else '0');print('1' if j.get('package_owned') else '0')
PY
);DNS_EXPLICIT="${DM[0]}";DNS_OWNED="${DM[1]}";fi

install -d -m 0750 "$(dirname "$DATA")"
install -d -m 0770 "$DATA"
cp -a "$SMB" "$ROOT/smb.conf.domain-post.rollback"
python3 - "$SMB" "$SHARE" "$DATA" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]);name,path=sys.argv[2:];text=p.read_text(errors='replace');b='\n# BEGIN CONTROL CENTER STORAGE\n';e='# END CONTROL CENTER STORAGE\n'
if b in text and e in text:text=text.split(b,1)[0]+text.split(e,1)[1]
block=f'''\n# BEGIN CONTROL CENTER STORAGE\n[{name}]\n\tpath = {path}\n\tbrowseable = yes\n\tread only = no\n\tguest ok = no\n\tinherit acls = yes\n\tmap acl inherit = yes\n\tvfs objects = acl_xattr\n\tacl_xattr:ignore system acls = yes\n# END CONTROL CENTER STORAGE\n'''
p.write_text(text.rstrip()+block)
PY
if ! samba-tool testparm >/dev/null 2>&1;then cp -a "$ROOT/smb.conf.domain-post.rollback" "$SMB";exit 3;fi
systemctl restart samba-ad-dc.service
systemctl is-active --quiet samba-ad-dc.service
# Bootstrap group used until the RBAC editor becomes authoritative.
samba-tool group add 'Control Center Admins' --description='Control Center portal administrators' >/dev/null 2>&1 || true
samba-tool group addmembers 'Control Center Admins' Administrator >/dev/null 2>&1 || true

python3 - "$SAMBA" "$DNS" "$STORAGE" "$CTX" "$DOMAIN" "$IP" "$IFACE" "$FORWARDER" "$SHARE" "$DATA" "$DNS_EXPLICIT" "$DNS_OWNED" "$STORAGE_EXPLICIT" "$STORAGE_OWNED" <<'PY'
import json,sys,time,os
sp,dp,fp,ctxp,domain,ip,iface,fwd,share,path,dexp,downed,fexp,fowned=sys.argv[1:]
s=json.load(open(sp));ctx=json.load(open(ctxp));now=int(time.time())
s['dependencies']={'dns':{'required':True,'explicit_before':dexp=='1','standalone_preserved':bool(ctx.get('dns_snapshot'))},'storage':{'required':True,'explicit_before':fexp=='1','standalone_preserved':bool(ctx.get('storage_snapshot'))},'install_context':ctxp}
s['portal_auth']={'local':True,'domain':True,'admin_group':'Control Center Admins','rbac_mode':'bootstrap','auth_daemon':'control-center-authd'}
open(sp,'w').write(json.dumps(s,ensure_ascii=False,indent=2)+'\n');os.chmod(sp,0o640)
d={'installed':True,'provider':'samba_internal','explicit':dexp=='1','package_owned':downed=='1','dependency_by':['domain'],'interface':iface,'ipv4':ip,'forwarders':[fwd] if fwd else [],'installed_at':now,'standalone_preserved':bool(ctx.get('dns_snapshot'))}
f={'installed':True,'provider':'samba_ad_dc','mode':'domain','explicit':fexp=='1','package_owned':fowned=='1','dependency_by':['domain'],'share_name':share,'path':path,'rbac_ready':True,'installed_at':now,'standalone_preserved':bool(ctx.get('storage_snapshot'))}
for p,obj in ((dp,d),(fp,f)):
 open(p,'w').write(json.dumps(obj,ensure_ascii=False,indent=2)+'\n');os.chmod(p,0o640)
PY
chown root:control-center "$SAMBA" "$DNS" "$STORAGE"
python3 - "$DNS_STATUS" "$STORAGE_STATUS" "$IP" "$SHARE" <<'PY'
import json,sys,time,os
for p,msg in [(sys.argv[1],f'Samba Internal DNS работает на {sys.argv[3]}'),(sys.argv[2],f'Доменное SMB-хранилище [{sys.argv[4]}] работает')]:
 open(p,'w').write(json.dumps({'state':'active','message':msg,'timestamp':int(time.time())},ensure_ascii=False,indent=2)+'\n');os.chmod(p,0o640)
PY
chown root:control-center "$DNS_STATUS" "$STORAGE_STATUS"
# control-center-authd is root-isolated and reads the managed domain state on
# every login attempt; the Web process never joins winbindd_priv.
systemctl restart control-center-authd.service >/dev/null 2>&1 || true
