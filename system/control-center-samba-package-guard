#!/usr/bin/env bash
set -Eeuo pipefail

MODE="${1:-}"
ROOT_RUN=/run/control-center-root
SNAPSHOT="$ROOT_RUN/samba-packages-before.tsv"
SERVICE_SNAPSHOT="$ROOT_RUN/samba-time-services-before.tsv"
APT_LOCK=/run/control-center-apt.lock
PACKAGES=(
  samba samba-dsdb-modules samba-vfs-modules winbind krb5-user dnsutils acl attr smbclient chrony systemd-timesyncd
)
TIME_SERVICES=(chrony.service systemd-timesyncd.service)

installed(){
  dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -qx 'install ok installed'
}

service_value(){
  systemctl "$1" "$2" 2>/dev/null | head -1 || true
}

case "$MODE" in
  snapshot)
    install -d -o root -g root -m 0700 "$ROOT_RUN"
    TMP="$(mktemp "$ROOT_RUN/.samba-packages.XXXXXX")"
    for pkg in "${PACKAGES[@]}"; do
      if installed "$pkg"; then
        version="$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || true)"
        printf '%s\t1\t%s\n' "$pkg" "$version" >>"$TMP"
      else
        printf '%s\t0\t-\n' "$pkg" >>"$TMP"
      fi
    done
    chmod 0600 "$TMP"
    mv "$TMP" "$SNAPSHOT"

    TMP="$(mktemp "$ROOT_RUN/.samba-time-services.XXXXXX")"
    for svc in "${TIME_SERVICES[@]}"; do
      active="$(service_value is-active "$svc")"
      enabled="$(service_value is-enabled "$svc")"
      printf '%s\t%s\t%s\n' "$svc" "${active:-unknown}" "${enabled:-unknown}" >>"$TMP"
    done
    chmod 0600 "$TMP"
    mv "$TMP" "$SERVICE_SNAPSHOT"
    ;;

  commit)
    # ExecStartPost reaches this point only after the provisioning worker exits
    # successfully. Removing snapshots commits both package and time-service state.
    rm -f "$SNAPSHOT" "$SERVICE_SNAPSHOT"
    ;;

  restore)
    # ExecStopPost always calls restore. On success the preceding commit removed
    # snapshots, so this is a no-op. A failure/timeout before commit reconciles
    # only packages that the Samba operation was explicitly allowed to change.
    [[ -s "$SNAPSHOT" ]] || { rm -f "$SERVICE_SNAPSHOT"; exit 0; }

    exec 8>"$APT_LOCK"
    flock -w 900 8 || { echo 'Samba package rollback: APT lock timeout' >&2; exit 75; }
    export DEBIAN_FRONTEND=noninteractive

    remove=()
    restore=()
    while IFS=$'\t' read -r pkg was_installed version; do
      [[ -n "$pkg" ]] || continue
      if [[ "$was_installed" == 0 ]] && installed "$pkg"; then
        remove+=("$pkg")
      elif [[ "$was_installed" == 1 ]] && ! installed "$pkg"; then
        restore+=("$pkg")
      fi
    done <"$SNAPSHOT"

    # Do not autoremove: dependencies may be shared with unrelated software.
    if (( ${#remove[@]} )); then
      apt-get remove -y "${remove[@]}" || true
    fi
    if (( ${#restore[@]} )); then
      apt-get update || true
      apt-get install -y "${restore[@]}" || true
    fi

    # Re-apply the original active/enabled state after package reconciliation.
    if [[ -s "$SERVICE_SNAPSHOT" ]]; then
      while IFS=$'\t' read -r svc active enabled; do
        case "$enabled" in
          enabled) systemctl enable "$svc" >/dev/null 2>&1 || true ;;
          disabled) systemctl disable "$svc" >/dev/null 2>&1 || true ;;
          masked) systemctl mask "$svc" >/dev/null 2>&1 || true ;;
        esac
        case "$active" in
          active) systemctl start "$svc" >/dev/null 2>&1 || true ;;
          inactive|failed|unknown) systemctl stop "$svc" >/dev/null 2>&1 || true ;;
        esac
      done <"$SERVICE_SNAPSHOT"
    fi

    missing=()
    while IFS=$'\t' read -r pkg was_installed version; do
      if [[ "$was_installed" == 1 ]] && ! installed "$pkg"; then missing+=("$pkg"); fi
    done <"$SNAPSHOT"
    rm -f "$SNAPSHOT" "$SERVICE_SNAPSHOT"
    if (( ${#missing[@]} )); then
      printf 'Samba package rollback incomplete; missing:' >&2
      printf ' %s' "${missing[@]}" >&2
      printf '\n' >&2
      exit 1
    fi
    ;;

  *)
    echo 'Usage: control-center-samba-package-guard snapshot|commit|restore' >&2
    exit 2
    ;;
esac
